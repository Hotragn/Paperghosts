{"parentUuid":"418d019e-fb2e-47a8-b8c4-71b34bc6de26","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_budget_probe.py","snippet":"20\t        \"bbox_list\": [{\"x0\": 1, \"y0\": 2, \"x1\": 30, \"y1\": 40}],\n21\t        \"headline\": \"A GHOST\",\n22\t        \"text\": text,\n23\t        \"terms\": {\"ghost\": [\"ghost\"]},\n24\t    }\n25\t\n26\t\n27\tdef test_a_scan_records_edition_and_page_become_numbers_when_they_are_numbers():\n28\t    assert [number(v) for v in (\"ed-01\", \"8\", \"na\", None, \"\")] == [\n29\t        1,\n30\t        8,\n31\t        None,\n32\t        None,\n33\t        None,\n34\t    ]\n35\t\n36\t\n37\tdef test_a_story_is_its_earliest_printing_and_each_lever_changes_only_its_part():\n38\t    rows = [\n39\t        row(\"17\", \"Later it was told again. \" * 9),\n40\t        row(\"16\", \"The ghost walked in Brooklyn. \" * 9),\n41\t    ]\n42\t\n43\t    doc, members = story(random.Random(1), rows)\n44\t    sizes = {\n45\t        k: len(bson.encode(v))\n46\t        for k, v in levers(doc, members, doc[\"embedding\"]).items()\n47\t    }\n48\t\n49\t    assert doc[\"primary_article_id\"].startswith(\"3_1875-12-16\")\n50\t    assert [p.get(\"page\") for p in doc[\"printings\"]] == [None, None]\n51\t    base = sizes[\"all levers on (float32)\"]\n52\t    assert sizes[\"int8 embedding\"] == base - (1536 - 384)\n53\t    for lever in (\n54\t        \"embedding as an array of doubles\",\n55\t        \"crop URLs stored\",\n56\t        \"printings with their own text\",\n57\t    ):\n58\t        assert sizes[lever] > base, lever\n59\t    assert sizes[\"all levers off\"] > max(\n60\t        v for k, v in sizes.items() if k != \"all levers off\"\n61\t    )"},"type":"attachment","uuid":"0532b6f8-627f-497c-a139-6113471c3cbe","timestamp":"2026-10-30T17:49:43.134Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberFest/w