{"parentUuid":"013b661e-f08e-47f8-a8cc-db3bc81011ee","isSidechain":false,"promptId":"cfc7125e-bacb-48e4-917e-c396bc7253de","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FYwiZWgSnkvP9sqTqmvgY1","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py (file state is current in your context — no need to Read it back)"}]},"uuid":"ce54c334-a7d9-4191-a8f8-c23282bb762d","timestamp":"2026-10-30T17:45:53.790Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py","content":"\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents for a seeded\n1,000 of lexicon v2's candidates, with their real text, their reprint clusters' printings, a\nBinData embedding, and reader fields whose quotes are real sentences of the article.\n\n1. The BSON bytes of each document, with each of rule 6's levers on and off.\n2. Atlas's own data and index sizes, with the documents loaded into `reports` 500 at a time\n   past its validator. Every probe document is deleted afterwards.\n3. Each database's use of M0's storage, data size plus index size as Atlas counts it.\n\nWrites eval/results/phase2b/budget.json; Docs/BUDGET.md reads it.\"\"\"\n\nimport json\nimport random\nimport re\nimport statistics\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport bson\nimport numpy as np\nimport zstandard\nfrom bson.binary import Binary, BinaryVectorDtype\nfrom pymongo import MongoClient\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.config import setting\nfrom paperghosts.ingest.crops import BATCH_PATH, MEMBER, crop_urls, service_id\nfrom paperghosts.ingest.headline import display_headline\nfrom paperghosts.schemas import DIMENSIONS, Report\n\nROOT = Path(__file__).parents[1]\nDATA = ROOT / \"data\"\nOUT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"budget.json\"\nSEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500\nSETTLE = 75  # seconds for WiredTiger's checkpoint, once a minute, to count new index pages\nCODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length\nOUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]\nPLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]\n\n\ndef year_keys(year):\n    \"\"\"Each candidate's reprint keys, in file order, as eval A takes them.\"\"\"\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        return year, [tuple(keys(json.loads(row)[\"text\"])) for row in rows]\n\n\ndef year_rows(job):\n    year, wanted = job\n    found = {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(rows):\n            if index in wanted:\n                found[index] = json.loads(row)\n    return year, found\n\n\ndef sentences(text):\n    flat = \" \".join((text or \"\").replace(\"-\\n\", \"\").split())\n    return [s for s in re.split(r\"(?<=[.!?])\\s+\", flat) if len(s) >= 30] or [flat[:200]]\n\n\ndef quote(sentence, most=200):\n    \"\"\"A verbatim span, as the reader quotes one: a sentence, cut at a word under `most`.\"\"\"\n    return sentence if len(sentence) <= most else sentence[:most].rsplit(\" \", 1)[0]\n\n\ndef stated(rng, said, value=None):\n    sentence = rng.choice(said)\n    if value is None:\n        words = sentence.split()\n        start = rng.randrange(max(1, len(words) - 6))\n        value = \" \".join(words[start : start + rng.randint(3, 6)])\n    return {\n        \"value\": value,\n        \"quote\": quote(sentence),\n        \"verified\": True,\n        \"score\": round(rng.random(), 3),\n    }\n\n\ndef name(rng, said, words):\n    \"\"\"A run of capitalized words from the text, as a place or a person reads.\"\"\"\n    runs = re.findall(rf\"\\b[A-Z][a-z]{{2,}}(?: [A-Z][a-z]{{2,}}){{{words - 1}}}\\b\", \" \".join(said))\n    return rng.choice(runs) if runs else rng.choice(\" \".join(said).split()[:8] or [\"?\"])\n\n\ndef printing(row):\n    path = BATCH_PATH.search((row.get(\"scan\") or {}).get(\"raw_data_loc\") or \"\")\n    scan = row.get(\"scan\") or {}\n    return {\n        \"article_id\": row[\"article_id\"],\n        \"lccn\": row[\"lccn\"],\n        \"paper\": row[\"paper\"] or \"\",\n        \"state\": row[\"state\"],\n        \"date\": row[\"date\"],\n        \"edition\": int(re.sub(r\"\\D\", \"\", scan.get(\"edition\") or \"\") or 1),\n        \"page\": int(re.sub(r\"\\D\", \"\", str(scan.get(\"page\") or \"\")) or 1),\n        \"service\": service_id(path.string) if path else None,\n        \"bbox_list\": [\n            {k: max(0, int(box[k])) for k in (\"x0\", \"y0\", \"x1\", \"y1\")}\n            for box in row[\"bbox_list\"]\n        ],\n    }\n\n\ndef story(rng, members):\n    \"\"\"A full reports document for one cluster's printings, primary first: the earliest.\"\"\"\n    members = sorted(members, key=lambda row: (row[\"date\"], row[\"article_id\"]))\n    primary = members[0]\n    said = sentences(primary[\"text\"])\n    town = name(rng, said, 1)\n    people = [stated(rng, said, name(rng, said, 2)) for _ in range(rng.choice([0, 0, 1, 1, 2, 3]))]\n    vector = np.random.default_rng(rng.randrange(2**32)).normal(size=DIMENSIONS)\n    year = int(primary[\"date\"][:4])\n    doc = {\n        \"_id\": f\"r_{primary['article_id']}\",\n        \"primary_article_id\": primary[\"article_id\"],\n        \"printings\": [printing(row) for row in members],\n        \"headline\": primary[\"headline\"] or \"\",\n        \"text\": primary[\"text\"] or \"\",\n        \"display_headline\": display_headline(\n            primary[\"headline\"] or \"\", primary[\"paper\"], primary[\"date\"]\n        ),\n        \"date\": primary[\"date\"],\n        \"year\": year,\n        \"month_day\": primary[\"date\"][5:],\n        \"decade\": year // 10 * 10,\n        \"kind\": \"report\",\n        \"fields\": {\n            \"place\": stated(rng, said, town),\n            \"people\": people,\n            \"seen\": stated(rng, said),\n            \"outcome\": stated(rng, said, rng.choice(OUTCOMES)),\n            \"specific_place\": stated(rng, said),\n            \"place_type\": stated(rng, said, rng.choice(PLACE_TYPES)),\n            \"precision\": stated(rng, said, \"town\"),\n        },\n        \"location\": {\n            \"type\": \"Point\",\n            \"coordinates\": [round(rng.uniform(-124, -67), 6), round(rng.uniform(25, 49), 6)],\n        },\n        \"location_precision\": \"town\",\n        \"location_source\": f\"geonames:{rng.randrange(4_000_000, 6_000_000)}\",\n        \"place_id\": rng.randrange(4_000_000, 6_000_000),\n        \"town\": town,\n        \"state\": primary[\"state\"],\n        \"embedding\": Binary.from_vector(vector.tolist(), BinaryVectorDtype.FLOAT32),\n        \"versions\": {\n            \"code\": CODE,\n            \"lexicon\": \"v2\",\n            \"model\": \"Qwen/Qwen3.5-4B\",\n            \"adapter\": \"paperghosts-reader-lora-v1\",\n            \"prompt\": \"reader-v1\",\n        },\n        \"lexicon_terms\": sorted(primary[\"terms\"]),\n    }\n    return Report.model_validate(doc).model_dump(by_alias=True, exclude_none=True), members\n\n\ndef levers(doc, members, vector):\n    \"\"\"The document with each of rule 6's levers turned off, and with all of them off.\"\"\"\n    texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}\n\n    def crops(p):\n        service = p[\"service\"]\n        if service is None:  # its service would be looked up: one of the usual length\n            m = MEMBER.search(p[\"article_id\"])\n            service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{p['lccn']}:{m['reel']}:{m['issue']}:{m['seq']}\"\n        return crop_urls(service, p[\"bbox_list\"])\n\n    stored_crops = [p | {\"crop_urls\": crops(p)} for p in doc[\"printings\"]]\n    with_text = [p | {\"text\": texts[p[\"article_id\"]]} for p in doc[\"printings\"]]\n    doubles = vector.as_vector().data\n    return {\n        \"all levers on (float32)\": doc,\n        \"int8 embedding\": doc | {\"embedding\": int8(doubles)},\n        \"embedding as an array of doubles\": doc | {\"embedding\": [float(x) for x in doubles]},\n        \"crop URLs stored\": doc | {\"printings\": stored_crops},\n        \"printings with their own text\": doc | {\"printings\": with_text},\n        \"all levers off\": doc\n        | {\n            \"embedding\": [float(x) for x in doubles],\n            \"printings\": [c | {\"text\": t[\"text\"]} for c, t in zip(stored_crops, with_text, strict=True)],\n        },\n    }\n\n\ndef int8(values):\n    v = np.asarray(values)\n    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)\n    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)\n\n\ndef summary(sizes):\n    ordered = sorted(sizes)\n    return {\n        \"total\": sum(ordered),\n        \"mean\": round(statistics.fmean(ordered), 1),\n        \"median\": statistics.median(ordered),\n        \"p90\": ordered[int(0.9 * (len(ordered) - 1))],\n        \"max\": ordered[-1],\n    }\n\n\ndef size(value):\n    return len(bson.encode({\"v\": value})) - len(bson.encode({}))\n\n\ndef settled(collection, db):\n    time.sleep(SETTLE)\n    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))[\"storageStats\"]\n    whole = db.command(\"dbStats\")\n    return {\n        \"count\": stats[\"count\"],\n        \"data_bytes\": stats[\"size\"],\n        \"storage_bytes\": stats[\"storageSize\"],\n        \"index_bytes\": stats[\"totalIndexSize\"],\n        \"index_bytes_by_index\": stats[\"indexSizes\"],\n        \"database\": {k: whole[k] for k in (\"dataSize\", \"storageSize\", \"indexSize\")},\n    }\n\n\ndef main():\n    counts = {\n        c[\"year\"]: c[\"candidates\"]\n        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(y for y in counts if counts[y])\n    starts, total = {}, 0\n    for year in years:\n        starts[year], total = total, total + counts[year]\n    rng = random.Random(SEED)\n    picks = sorted(rng.sample(range(total), PICKS))\n\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        held = dict(pool.map(year_keys, years))\n    doc_keys = [k for year in years for k in held.pop(year)]\n    assert len(doc_keys) == total\n    group_of = {}\n    for group in clusters(doc_keys, least=2):\n        for doc in group:\n            group_of[doc] = group\n    del doc_keys\n    groups, seen = [], set()\n    for pick in picks:\n        group = tuple(group_of.get(pick, (pick,)))\n        if group not in seen:  # two picks from one cluster are one story\n            seen.add(group)\n            groups.append(group)\n    wanted = defaultdict(set)\n    year_of = {}\n    for group in groups:\n        for doc in group:\n            year = max(y for y in years if starts[y] <= doc)\n            wanted[year].add(doc - starts[year])\n            year_of[doc] = year\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        rows = {\n            starts[year] + index: row\n            for year, found in pool.map(year_rows, wanted.items())\n            for index, row in found.items()\n        }\n\n    stories, variants, parts = [], defaultdict(list), defaultdict(list)\n    for group in groups:\n        doc, members = story(rng, [rows[d] for d in group])\n        stories.append(doc)\n        for label, variant in levers(doc, members, doc[\"embedding\"]).items():\n            variants[label].append(len(bson.encode(variant)))\n        parts[\"text, headline and display headline\"].append(\n            size(doc[\"text\"]) + size(doc[\"headline\"]) + size(doc[\"display_headline\"])\n        )\n        parts[\"reader fields\"].append(size(doc[\"fields\"]))\n        parts[\"embedding (float32)\"].append(size(doc[\"embedding\"]))\n        parts[\"printings\"].append(size(doc[\"printings\"]))\n        parts[\"each printing\"] += [size(p) for p in doc[\"printings\"]]\n    printings = [len(doc[\"printings\"]) for doc in stories]\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"seed\": SEED,\n        \"candidates_drawn\": PICKS,\n        \"of_candidates\": total,\n        \"stories\": len(stories),\n        \"printings\": {\n            \"total\": sum(printings),\n            \"stories_with_more_than_one\": sum(n > 1 for n in printings),\n            \"most\": max(printings),\n        },\n        \"bson_bytes\": {label: summary(sizes) for label, sizes in variants.items()},\n        \"bson_bytes_of_parts\": {label: summary(sizes) for label, sizes in parts.items()},\n    }\n\n    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:\n        db = client[\"paperghosts\"]\n        reports = db[\"reports\"]\n        assert reports.estimated_document_count() == 0, \"reports already holds documents\"\n        ids = [doc[\"_id\"] for doc in stories]\n        atlas = {\"empty\": settled(reports, db)}\n        try:\n            for start in range(0, len(stories), BATCH):\n                reports.insert_many(stories[start : start + BATCH], ordered=False)\n                atlas[f\"after {min(start + BATCH, len(stories))}\"] = settled(reports, db)\n        finally:\n            deleted = reports.delete_many({\"_id\": {\"$in\": ids}}).deleted_count\n            report[\"cleaned_up\"] = {\n                \"deleted\": deleted,\n                \"left_in_reports\": reports.count_documents({}),\n            }\n        report[\"atlas\"] = atlas\n        report[\"storage_by_database\"] = {\n            name: {\n                k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")\n            }\n            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}\n            for name in client.list_database_names()\n            if name not in (\"admin\", \"local\")\n            for s in [client[name].command(\"dbStats\")]\n        }\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    OUT.write_text(json.dumps(report, indent=1) + \"\\n\")\n    base = report[\"bson_bytes\"][\"all levers on (float32)\"]\n    print(\n        f\"{len(stories)} stories, {sum(printings)} printings; BSON mean {base['mean']:,} bytes, \"\n        f\"median {base['median']:,}; deleted {deleted}\"\n    )\n    print(f\"wrote {OUT.relative_to(ROOT)}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"013b661e-f08e-47f8-a8cc-db3bc81011ee","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
