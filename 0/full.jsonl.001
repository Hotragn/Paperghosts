"+            need = (","+                stories * (story_bytes + index_per_story)","+                + PRINTINGS * printing_bytes","+                + fixed","+            )","             per = story_bytes + index_per_story + PRINTINGS / stories * printing_bytes","             rows[scenario] = {","                 \"stories\": stories,","                 \"bytes\": round(need),","                 \"fits\": {k: need <= v for k, v in free.items()},","-                \"stories_that_fit\": {k: int((v - fixed) // per) for k, v in free.items()},","+                \"stories_that_fit\": {","+                    k: int((v - fixed) // per) for k, v in free.items()","+                },","             }","         out[\"variants\"][label] = {","             \"story_bytes\": story_bytes,"]},{"oldStart":371,"oldLines":7,"newStart":401,"newLines":9,"lines":["     screen = json.loads((RESULTS / \"eval_a\" / \"screen.json\").read_text())","     added = json.loads((RESULTS / \"eval_a_v2\" / \"added.json\").read_text())","     return {","-        \"eval A\": [i[\"article_id\"] for i in composition if i[\"category\"] == \"ghost_report\"],","+        \"eval A\": [","+            i[\"article_id\"] for i in composition if i[\"category\"] == \"ghost_report\"","+        ],","         \"screen\": [i[\"article_id\"] for i in screen if i[\"ghost_report\"]],","         \"2A.8\": [i[\"article_id\"] for i in added if i[\"ghost_report\"]],","     }"]},{"oldStart":404,"oldLines":7,"newStart":436,"newLines":9,"lines":["     del doc_keys","     index_of = {article: i for i, article in enumerate(ids)}","     judged = judged_reports()","-    not_candidates = sorted(a for found in judged.values() for a in found if a not in index_of)","+    not_candidates = sorted(","+        a for found in judged.values() for a in found if a not in index_of","+    )"," ","     def groups_of(docs):","         found, seen = [], set()"]},{"oldStart":417,"oldLines":7,"newStart":451,"newLines":9,"lines":[" ","     sampled = groups_of(picks)","     reports = groups_of(","-        sorted({index_of[a] for found in judged.values() for a in found if a in index_of})","+        sorted(","+            {index_of[a] for found in judged.values() for a in found if a in index_of}","+        )","     )","     wanted = defaultdict(set)","     for group in sampled + reports:"]},{"oldStart":432,"oldLines":7,"newStart":468,"newLines":13,"lines":["         }","     built = [story(rng, [rows[d] for d in group]) for group in sampled]","     judged_built = [story(rng, [rows[d] for d in group]) for group in reports]","-    boxes = [v for doc, _ in built + judged_built for p in doc[\"printings\"] for b in p[\"bbox_list\"] for v in b.values()]","+    boxes = [","+        v","+        for doc, _ in built + judged_built","+        for p in doc[\"printings\"]","+        for b in p[\"bbox_list\"]","+        for v in b.values()","+    ]","     title_entries = [","         len(bson.encode({\"_id\": lccn} | {k: v for k, v in t.items() if v}))","         for lccn, t in titles.items()"]}]},{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_budget_probe.py","hunks":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":11,"lines":[" \"\"\"The budget probe's documents: a story is its earliest printing, a scan record's \"na\" page is","-left unset, and each of rule 6's levers changes only its own part of the document.\"\"\"","+left unset, its parts add up to the whole, and each lever changes only its own part: rule 6's,","+turned off, add bytes, and the further ones save them.\"\"\""," "," import random"," "," import bson","-from budget_probe import levers, story","+from budget_probe import BASE, parts, story, variants"," "," RAW = \"https://chroniclingamerica.loc.gov/data/batches/dlc_deadnettle_ver01/data/sn83030313/00271743919/1875121601/0981.jp2\""," "]},{"oldStart":33,"oldLines":21,"newStart":34,"newLines":17,"lines":["     ]"," ","     doc, members = story(random.Random(1), rows)","-    sizes = {","-        k: len(bson.encode(v))","-        for k, v in levers(doc, members, doc[\"embedding\"]).items()","-    }","+    sizes = {k: len(bson.encode(v)) for k, v in variants(doc, members).items()}"," ","     assert doc[\"primary_article_id\"].startswith(\"3_1875-12-16\")","     assert [p.get(\"page\") for p in doc[\"printings\"]] == [None, None]","-    base = sizes[\"all levers on (float32)\"]","-    assert sizes[\"int8 embedding\"] == base - (1536 - 384)","-    for lever in (","-        \"embedding as an array of doubles\",","-        \"crop URLs stored\",","-        \"printings with their own text\",","-    ):","-        assert sizes[lever] > base, lever","-    assert sizes[\"all levers off\"] > max(","-        v for k, v in sizes.items() if k != \"all levers off\"","+    base = sizes.pop(BASE)","+    assert sum(parts(doc).values()) == base","+    assert sizes.pop(\"int8 embedding\") == base - (1536 - 384)","+    for label, found in sizes.items():","+        assert (found > base) == label.startswith(\"rule 6 off\"), label","+    assert (","+        sizes[\"the three, int8\"]","+        < sizes[\"the three, float32\"]","+        < min(sizes[k] for k in sizes if not k.startswith((\"rule 6 off\", \"the three\")))","     )"]}]}],"moreFiles":0,"changedFiles":["/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py","/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_budget_probe.py"]}},"serverClassifierContext":{"request":"54e39746-e793-452a-965b-e8d1c9b4e59f","context":{"git_state":{"cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","root":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","branch":"phase-2b-data-layer","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":3,"untracked":null,"untracked_normal":3},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotra