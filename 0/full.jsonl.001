ms()\n        },\n        \"bson_bytes_per\": {\n            label: {\n                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),\n                \"printing\": round(statistics.fmean(each[label]), 1),\n            }\n            for label in variants\n        },\n    }"},"caller":{"type":"direct"}}]}}
