text[i] == \")\" and 1 or text[i] == \"(\" and -1 or 0\n        if depth == 0:\n            return text[:i].rstrip(), text[i + 1 : -1]\n    return text, None","new_string":"    depth = 0\n    for i in range(len(text) - 1, -1, -1):\n        if text[i] == \")\":\n            depth += 1\n        elif text[i] == \"(\":\n            depth -= 1\n            if depth == 0:\n                return text[:i].rstrip(), text[i + 1 : -1]\n    return text, None"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01VE3CSidA1wA9oPiiVeK88i","name":"Bash","input":{"command":"cd \"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts\" && uv run pytest tests/test_titles.py -q 2>&1 | tail -n 25","description":"Run the title parser tests"},"caller":{"type":"direct"}}]}}
