-lexicon-v2","slug":"sunny-popping-comet"}
{"parentUuid":"189aa22b-c89f-4adb-a969-7d27ee9e8c12","isSidechain":false,"promptId":"10e32944-f26c-4e52-a7ee-6e5ea350bb2b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0122ASd3RnBVyshe1MXsnLhn","type":"tool_result","content":"174\tdef year_pass(job):\n175\t    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n176\t    paper and opening; plus the composition, recall and screen picks that fall in this year.\"\"\"\n177\t    year, wanted, near, rand, screen = job\n178\t    words, docs, picked, no_batch_path = dictionary(), [], [], 0\n179\t    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n180\t        for index, row in enumerate(map(json.loads, rows)):\n181\t            text = row[\"text\"] or \"\"\n182\t            no_batch_path += not BATCH_PATH.search(\n183\t                (row.get(\"scan\") or {}).get(\"raw_data_loc\") or \"\"\n184\t            )\n185\t            quality = None\n186\t            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n187\t                quality = ocr_quality(text, words)\n188\t            docs.append(\n189\t                (\n190\t                    len(text.split()),\n191\t                    quality,\n192\t                    tuple(keys(text)),\n193\t                    row[\"lccn\"],\n194\t                    row[\"article_id\"],\n195\t                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n196\t                )\n197\t            )\n198\t            if index in wanted:\n199\t                both = f\"{row['headline'] or ''}\\n{text}\"\n200\t                forms = [form for found in row[\"terms\"].values() for form in found]\n201\t                picked.append(\n202\t                    {\n203\t                        \"article_id\": row[\"article_id\"],\n204\t                        \"year\": year,\n205\t                        \"date\": row[\"date\"],\n206\t                        \"paper\": row[\"paper\"],\n207\t                        \"state\": row[\"state\"],\n208\t                        \"terms\": sorted(row[\"terms\"]),\n209\t                        \"words\": len(text.split()),\n210\t                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[\n211\t                            :200\n212\t                        ],\n213\t                        \"context\": window(both, first_match(both, forms), 600),\n214\t                        # what the screen would still find had the lexicon missed it\n215\t                        \"flags_without_terms\": flagged(\n216\t                            lexicon.GHOST_MATCHER.sub(\"▒\", both.replace(\"-\\n\", \"\"))\n217\t                        ),\n218\t                        \"category\": None,\n219\t                        \"note\": None,\n220\t                    }\n221\t                )\n222\t    recalled, screened, tally = [], [], Counter()\n223\t    if near or rand or screen:\n224\t        seen = Counter()\n225\t        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n226\t            for row in map(json.loads, rows):\n227\t                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n228\t                seen[pool] += 1\n229\t                if pool == \"random\" and index in screen:"}]},"uuid":"c1cf6bb6-09cb-4902-8d67-116b5fdc9c0f","timestamp":"2026-10-30T14:50:33.431Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","content":"def year_pass(job):\n    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n    paper and opening; plus the composition, recall and screen picks that fall in this year.\"\"\"\n    year, wanted, near, rand, screen = job\n    words, docs, picked, no_batch_path = dictionary(), [], [], 0\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(map(json.loads, rows)):\n            text = row[\"text\"] or \"\"\n            no_batch_path += not BATCH_PATH.search(\n                (row.get(\"scan\") or {}).get(\"raw_data_loc\") or \"\"\n            )\n            quality = None\n            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n                quality = ocr_quality(text, words)\n            docs.append(\n                (\n                    len(text.split()),\n                    quality,\n                    tuple(keys(text)),\n                    row[\"lccn\"],\n                    row[\"article_id\"],\n                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n                )\n            )\n            if index in wanted:\n                both = f\"{row['headline'] or ''}\\n{text}\"\n                forms = [form for found in row[\"terms\"].values() for form in found]\n                picked.append(\n                    {\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"state\": row[\"state\"],\n                        \"terms\": sorted(row[\"terms\"]),\n                        \"words\": len(text.split()),\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[\n                            :200\n                        ],\n                        \"context\": window(both, first_match(both, forms), 600),\n                        # what the screen would still find had the lexicon missed it\n                        \"flags_without_terms\": flagged(\n                            lexicon.GHOST_MATCHER.sub(\"▒\", both.replace(\"-\\n\", \"\"))\n                        ),\n                        \"category\": None,\n                        \"note\": None,\n                    }\n                )\n    recalled, screened, tally = [], [], Counter()\n    if near or rand or screen:\n        seen = Counter()\n        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n            for row in map(json.loads, rows):\n                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n                seen[pool] += 1\n                if pool == \"random\" and index in screen:","numLines":56,"startLine":174,"totalLines":717}},"sourceToolAssistantUUID":"189aa22b-c89f-4adb-a969-7d27ee9e8c12","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-lexicon-v2","slug":"sunny-popping-comet"}
