Iowa\\nUS.MI\\tMichigan\\nUS.SD\\tSouth Dakota\\nUS.WV\\tWest Virginia\\nUS.ID\\tIdaho\\nUS.NE\\tNebraska\\n\"\nADMIN2 = \"US.IA.169\\tStory County\\nUS.IA.139\\tMuscatine County\\nUS.MI.145\\tSaginaw County\\nUS.SD.119\\tSully County\\nUS.WV.037\\tJefferson County\\nUS.NE.001\\tAdams County\\n\"\n\n\n@pytest.fixture\ndef gazetteer(tmp_path):\n    places = tmp_path / \"US.txt\"\n    places.write_text(\n        \"\".join(\"\\t\".join(map(str, (*r, \"\", \"\", \"America/Chicago\", \"2026-10-30\"))) + \"\\n\" for r in ROWS)\n    )\n    admin1 = tmp_path / \"admin1CodesASCII.txt\"\n    admin1.write_text(\"\".join(f\"{line}\\tx\\t1\\n\" for line in ADMIN1.splitlines()))\n    admin2 = tmp_path / \"admin2Codes.txt\"\n    admin2.write_text(\"\".join(f\"{line}\\tx\\t1\\n\" for line in ADMIN2.splitlines()))\n    return Gazetteer([places], admin1, admin2, source=\"geonames dumps of 2026-10-30\")\n\n\ndef title(place, state, modern):\n    return {\"place\": place, \"state\": state, \"modern_state\": modern}\n\n\ndef record(place, county, state):\n    return {\"place\": place, \"state\": state, \"counties\": [county] if county else []}\n\n\ndef test_a_printed_place_in_its_records_county_stands(gazetteer):\n    found = paper_place(gazetteer, title(\"Charlestown\", \"Va.\", \"West Virginia\"), record(\"Charles Town\", \"jefferson\", \"West Virginia\"))\n\n    assert found[\"place_id\"] == 4801850 and found[\"record\"] == \"agrees\"\n\n\ndef test_a_printed_place_in_another_county_gives_way_to_the_records(gazetteer):\n    # Muscatine journal (Bloomington, Iowa): Bloomington was Muscatine's name until 1849\n    found = paper_place(gazetteer, title(\"Bloomington\", \"Iowa\", \"Iowa\"), record(\"Muscatine\", \"muscatine\", \"Iowa\"))\n\n    assert found[\"place_id\"] == 4868404 and found[\"record\"] == \"replaced the printed place\"\n\n\ndef test_a_merged_town_is_found_under_its_successor(gazetteer):\n    found = paper_place(gazetteer, title(\"East Saginaw\", \"Mich.\", \"Michigan\"), record(\"Saginaw\", \"saginaw\", \"Michigan\"))\n\n    assert found[\"place_id\"] == 5007989 and found[\"record\"] == \"found what the printed place didn't\"\n\n\ndef test_a_ghost_town_is_taken_only_in_its_records_county(gazetteer):\n    found = paper_place(gazetteer, title(\"Clifton\", \"Dakota\", \"South Dakota\"), record(\"Clifton\", \"sully\", \"South Dakota\"))\n\n    assert found[\"place_id\"] == 5763634 and found[\"historical\"] is True\n    assert found[\"record\"] == \"a ghost town in the record's county\"\n\n\ndef test_with_nothing_that_agrees_with_the_record_there_is_no_point(gazetteer):\n    # a same-named place elsewhere is the dangerous kind of answer\n    found = paper_place(gazetteer, title(\"Lardo\", \"Idaho\", \"Nebraska\"), record(\"McCall\", \"valley\", \"Idaho\"))\n\n    assert found[\"place_id\"] is None\n    assert found[\"record\"] == \"disagrees, and its own place isn't in GeoNames\"\n\n\ndef test_without_a_record_or_its_county_the_printed_place_stands(gazetteer):\n    printed = title(\"Bloomington\", \"Iowa\", \"Iowa\")\n\n    assert paper_place(gazetteer, printed, None)[\"record\"] == \"none\"\n    unchecked = paper_place(gazetteer, printed, record(\"Bloomington\", None, \"Iowa\"))\n    assert unchecked[\"place_id\"] == 4848880 and unchecked[\"record\"] == \"has no county to check\"\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"49023beb-e75d-401f-895d-c2685b022228","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
