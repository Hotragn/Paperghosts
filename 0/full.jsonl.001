{"parentUuid":"f7567fc8-779d-4f84-8805-45a1ba8f25c0","isSidechain":false,"promptId":"cfc7125e-bacb-48e4-917e-c396bc7253de","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DRJYQmDY7duq9T2g66R7xh","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/paperghosts/store/validators.py (file state is current in your context — no need to Read it back)"}]},"uuid":"2ccfa2ce-890e-4226-b474-dfbbcbfac9f6","timestamp":"2026-10-30T17:36:02.913Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/paperghosts/store/validators.py","content":"\"\"\"Atlas $jsonSchema validators, generated from the Pydantic models so the two can't drift apart\n(ARCHITECTURE section 4). Atlas reads JSON Schema draft 4 with bsonType, and has no $ref, const,\nformat or integer type, so Pydantic's schema is rewritten for it.\"\"\"\n\nfrom pydantic import BaseModel\n\nTYPES = {\n    \"string\": \"string\",\n    \"integer\": [\"int\", \"long\"],\n    \"number\": \"number\",\n    \"boolean\": \"bool\",\n    \"object\": \"object\",\n    \"array\": \"array\",\n    \"null\": \"null\",\n}\nDROPPED = {\"title\", \"description\", \"default\", \"examples\"}\nKEPT = {\n    \"bsonType\", \"enum\", \"required\", \"additionalProperties\", \"minItems\", \"maxItems\",\n    \"minLength\", \"maxLength\", \"pattern\", \"minimum\", \"maximum\", \"multipleOf\",\n}  # fmt: skip\n\n\ndef validator(model: type[BaseModel]) -> dict:\n    \"\"\"The collection validator for model's documents, as stored with by_alias.\"\"\"\n    schema = model.model_json_schema(by_alias=True)\n    defs = schema.pop(\"$defs\", {})\n    return {\"$jsonSchema\": convert(schema, defs)}\n\n\ndef convert(schema: dict, defs: dict) -> dict:\n    if \"$ref\" in schema:\n        rest = {k: v for k, v in schema.items() if k != \"$ref\"}\n        return convert(defs[schema[\"$ref\"].rsplit(\"/\", 1)[1]], defs) | convert(rest, defs)\n    out = {}\n    for key, value in schema.items():\n        if key in DROPPED:\n            continue\n        if key == \"type\":\n            out[\"bsonType\"] = TYPES[value]\n        elif key == \"const\":\n            out[\"enum\"] = [value]\n        elif key == \"properties\":\n            out[key] = {name: convert(field, defs) for name, field in value.items()}\n        elif key == \"prefixItems\":  # a tuple\n            out[\"items\"] = [convert(item, defs) for item in value]\n            out[\"additionalItems\"] = False\n        elif key in (\"items\", \"additionalProperties\") and isinstance(value, dict):\n            out[key] = convert(value, defs)\n        elif key == \"anyOf\":\n            options = [convert(option, defs) for option in value]\n            if all(option.keys() == {\"bsonType\"} for option in options):\n                # a plain union of types, such as str | None, is one bsonType list\n                types = [option[\"bsonType\"] for option in options]\n                out[\"bsonType\"] = [t for found in types for t in ([found] if isinstance(found, str) else found)]\n            else:\n                out[\"anyOf\"] = options\n        elif key in KEPT:\n            out[key] = value\n        else:\n            raise ValueError(f\"Atlas's $jsonSchema has no {key!r}\")\n    return out\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"f7567fc8-779d-4f84-8805-45a1ba8f25c0","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
