ember)","+    if not scan.get(\"raw_data_loc\"):","+        service = service or page_service(member, scan)","+        why = page_check(service, scan, boxes, text)","+        if why == NO_SUCH_PAGE:","+            service = listed(page[\"lccn\"], page[\"reel\"], page[\"issue\"], page[\"seq\"])","+            why = page_check(service, scan, boxes, text)","+        if why:","+            raise LookupError(f\"{member}: {why}\")","+        return service, [crop(url) for url in crop_urls(service, boxes)]","     service = service or page_service(member, scan)","     try:","         return service, [crop(url) for url in crop_urls(service, boxes)]","     except httpx.HTTPStatusError as exc:","-        if exc.response.status_code != 404 or not scan.get(\"raw_data_loc\"):","+        if exc.response.status_code != 404:","             raise","-    path = BATCH_PATH.search(scan[\"raw_data_loc\"])","-    service = listed(path[\"lccn\"], path[\"reel\"], path[\"issue\"], path[\"seq\"])","+    service = listed(page[\"lccn\"], page[\"reel\"], page[\"issue\"], page[\"seq\"])","     return service, [crop(url) for url in crop_urls(service, boxes)]"]}]},{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/crop_check.py","hunks":[{"oldStart":84,"oldLines":7,"newStart":84,"newLines":7,"lines":["     if service:","         try:","             service, paths = crops_for(","-                row[\"member\"], row[\"scan\"], row[\"bbox_list\"], service","+                row[\"member\"], row[\"scan\"], row[\"bbox_list\"], service, row[\"text\"]","             )","             files = [path.name for path in paths]","         except (httpx.HTTPError, LookupError, ValueError) as exc:"]}]},{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_crops.py","hunks":[{"oldStart":314,"oldLines":37,"newStart":314,"newLines":6,"lines":["     assert len(requests) == 1"," "," ","-def test_a_reissued_batch_is_found_by_the_batch_paths_fr