their\n    indexes. Keys are sorted with their documents packed beside them, which takes far less\n    memory than a dictionary of lists for a million articles.\"\"\"\n    assert len(doc_keys) < 1 << DOC_BITS\n    parent = list(range(len(doc_keys)))\n\n    def root(doc):\n        while parent[doc] != doc:\n            parent[doc] = parent[parent[doc]]\n            doc = parent[doc]\n        return doc\n\n    mask = (1 << DOC_BITS) - 1\n    entries = sorted(key << DOC_BITS | doc for doc, held in enumerate(doc_keys) for key in held)\n    start = 0\n    for end in range(1, len(entries) + 1):\n        if end < len(entries) and entries[end] >> DOC_BITS == entries[start] >> DOC_BITS:\n            continue\n        if 2 <= end - start <= boilerplate:\n            first = root(entries[start] & mask)\n            for entry in entries[start + 1 : end]:\n                other = root(entry & mask)\n                if other != first:\n                    parent[other] = first\n        start = end\n    groups = {}\n    for doc in range(len(doc_keys)):\n        groups.setdefault(root(doc), []).append(doc)\n    return [group for group in groups.values() if len(group) > 1]\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"335d049c-a25b-4b30-8ed9-3d69d8b82927","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
