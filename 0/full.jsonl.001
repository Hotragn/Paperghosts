{"clean":false,"counts":{"staged":0,"modified":364,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}]}},"live_cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"429a4fe4-8314-4a1b-9197-b857f2ee1f76","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-lexicon-v2","slug":"sunny-popping-comet"}
