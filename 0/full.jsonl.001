{"type":"api-request","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","id":"fe96954a-0116-481a-898a-7933e8d64f2c","timestamp":"2026-10-30T18:45:08.299Z","version":"2.1.309","querySource":"sdk","shapeHash":"7b35af0d1ba22d1b1b7d4c91038d50b583ea5d544dd1607adac5368903cb8a35","params":{"model":"claude-opus-5-5","betas":["claude-code-20250219","oauth-2025-04-20","interleaved-thinking-2025-05-14","thinking-token-count-2026-05-13","context-management-2025-06-27","prompt-caching-scope-2026-01-05","per-turn-control-2026-07-01","mid-conversation-tool-changes-2026-07-01","inline-tools-2026-09-15","advisor-tool-2026-03-01","advanced-tool-use-2025-11-20","mid-conversation-system-clear-at-2026-08-21","effort-2025-11-24","dangerous-tool-use-2026-09-03","thinking-binding-controls-2026-08-01","thinking-display-updates-2026-08-18","afk-mode-2026-01-31","extended-cache-ttl-2025-04-11","cache-diagnosis-2026-04-07","message-threads-2026-08-12"],"max_tokens":128000,"thinking":{"type":"adaptive","display":"updates"},"context_management":{"edits":[{"type":"clear_thinking_20251015","keep":"all"}]},"output_config":{"effort":"max"}},"base":"0cf68218-afaf-418b-bc32-b681a59c38c4","keep":614,"tail":["d4ca4f60b5896c02663c00801fd32a0983f8de4bfc403ca09f37a1a17de58fa1","1ce3e2a6daeafb26388922ee68274eee3f7b5ae3f984ad5fae9d581dd430b1e6"],"cacheControl":[{"path":["system",1],"value":{"type":"ephemeral","ttl":"1h","scope":"global"}},{"path":["system",2],"value":{"type":"ephemeral","ttl":"1h"}},{"path":["messages",615,"content",1],"value":{"type":"ephemeral","ttl":"1h"}}],"requestDigest":"6179f028c3ab2151a756a3ab40446803017f36c942d3c06c2e63f80f7c371b2b"}
