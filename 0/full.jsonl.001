_session_mgmt__unarchive_session","mcp__ccd_settings__get_settings","mcp__ccd_settings__set_setting","mcp__ccd_sidebar__create_group","mcp__ccd_sidebar__create_section","mcp__ccd_sidebar__delete_group","mcp__ccd_sidebar__delete_section","mcp__ccd_sidebar__list_groups","mcp__ccd_sidebar__list_sections","mcp__ccd_sidebar__mark_completed","mcp__ccd_sidebar__move_sessions","mcp__ccd_sidebar__rename_group","mcp__ccd_sidebar__rename_section","mcp__ccd_sidebar__set_pinned","mcp__ccd_sidebar__set_unread","mcp__ccd_sidebar__set_view","mcp__ccd_view__close_pane","mcp__ccd_view__get_layout","mcp__ccd_view__set_transcript_view","mcp__ccd_view__show_pane","mcp__ccd_window__close_split","mcp__ccd_window__get_window_layout","mcp__ccd_window__open_session_in","mcp__ccd_window__set_sidebar_collapsed","mcp__claude-in-chrome__browser_batch","mcp__claude-in-chrome__computer","mcp__claude-in-chrome__file_upload","mcp__claude-in-chrome__find","mcp__claude-in-chrome__form_input","mcp__claude-in-chrome__get_page_text","mcp__claude-in-chrome__gif_creator","mcp__claude-in-chrome__javascript_tool","mcp__claude-in-chrome__list_connected_browsers","mcp__claude-in-chrome__navigate","mcp__claude-in-chrome__read_console_messages","mcp__claude-in-chrome__read_network_requests","mcp__claude-in-chrome__read_page","mcp__claude-in-chrome__resize_window","mcp__claude-in-chrome__select_browser","mcp__claude-in-chrome__shortcuts_execute","mcp__claude-in-chrome__shortcuts_list","mcp__claude-in-chrome__switch_browser","mcp__claude-in-chrome__tabs_close_mcp","mcp__claude-in-chrome__tabs_context_mcp","mcp__claude-in-chrome__tabs_create_mcp","mcp__claude-in-chrome__upload_image","mcp__devrelay-gateway__check_in_to_mlh_event","mcp__devrelay-gateway__claim_promo_code","mcp__devrelay-gateway__connect_mlh_account","mcp__devrelay-gateway__create_article","mcp__devrelay-gateway__create_concept","mcp__devrelay-gateway__create_project","mcp__devrelay-gateway__create_project_invite","mcp__devrelay-gateway__delete_concept","mcp__devrelay-gateway__disconnect_mlh_account","mcp__devrelay-gateway__enter_challenge","mcp__devrelay-gateway__execute_dev_api_request","mcp__devrelay-gateway__get_agent_session","mcp__devrelay-gateway__get_agent_session_raw_url","mcp__devrelay-gateway__get_article_by_path","mcp__devrelay-gateway__get_article_content","mcp__devrelay-gateway__get_articles","mcp__devrelay-gateway__get_authenticated_user","mcp__devrelay-gateway__get_challenge_details","mcp__devrelay-gateway__get_challenges","mcp__devrelay-gateway__get_comment_by_id","mcp__devrelay-gateway__get_comments","mcp__devrelay-gateway__get_concept_articles","mcp__devrelay-gateway__get_concept_details","mcp__devrelay-gateway__get_event_by_id","mcp__devrelay-gateway__get_events","mcp__devrelay-gateway__get_followed_tags","mcp__devrelay-gateway__get_followers","mcp__devrelay-gateway__get_knowledge_document","mcp__devrelay-gateway__get_latest_articles","mcp__devrelay-gateway__get_mlh_event","mcp__devrelay-gateway__get_my_articles","mcp__devrelay-gateway__get_my_mlh_profile","mcp__devrelay-gateway__get_organization","mcp__devrelay-gateway__get_organization_articles","mcp__devrelay-gateway__get_organization_users","mcp__devrelay-gateway__get_page_by_id","mcp__devrelay-gateway__get_pages","mcp__devrelay-gateway__get_reading_list","mcp__devrelay-gateway__get_tag_by_id","mcp__devrelay-gateway__get_user_by_id","mcp__devrelay-gateway__get_user_by_username","mcp__devrelay-gateway__get_user_contributions","mcp__devrelay-gateway__join_project","mcp__devrelay-gateway__list_agent_sessions","mcp__devrelay-gateway__list_concepts","mcp__devrelay-gateway__list_event_agent_skills","mcp__devrelay-gateway__list_event_offers","mcp__devrelay-gateway__list_my_mlh_events","mcp__devrelay-gateway__list_my_projects","mcp__devrelay-gateway__list_my_promo_code_redemptions","mcp__devrelay-gateway__list_tags","mcp__devrelay-gateway__mlh_connection_status","mcp__devrelay-gateway__presign_agent_session_upload","mcp__devrelay-gateway__reacti