{"parentUuid":"6f862668-45b8-4c2c-b96e-f89fa6dbc628","isSidechain":false,"promptId":"f40c2187-e8b4-47d5-9c53-ee1f5c6e6ab4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018GcmdR11q851Zduuyg7trN","type":"tool_result","content":"68\tdef page(height, title, subtitle, body, label):\n69\t    return (\n70\t        f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {WIDTH} {height}\" width=\"{WIDTH}\" height=\"{height}\" role=\"img\" aria-label=\"{escape(label)}\">'\n71\t        f'<title>{escape(title)}</title>{STYLE}<rect class=\"bg\" width=\"{WIDTH}\" height=\"{height}\"/>'\n72\t        + text(24, 30, title, \"ink title\")\n73\t        + text(24, 50, subtitle, \"muted\")\n74\t        + body\n75\t        + \"</svg>\\n\"\n76\t    )\n77\t\n78\t\n79\tdef bars(\n80\t    path, title, subtitle, rows, fmt, series=None, intervals=None, label_width=170\n81\t):\n82\t    \"\"\"Horizontal bars: rows of (label, value) or (label, value, second value), with an\n83\t    optional 95% interval per row as (low, high).\"\"\"\n84\t    top = (\n85\t        max(max(r[1:]) if not intervals else max(i[1] for i in intervals) for r in rows)\n86\t        if not intervals\n87\t        else max(i[1] for i in intervals)\n88\t    )\n89\t    top, step = nice(max(top, max(max(r[1:]) for r in rows)))\n90\t    left, right, band = 24 + label_width, WIDTH - 80, 22 if not series else 30\n91\t    y0 = 78 if series else 68\n92\t    scale = (right - left) / top\n93\t    body = []\n94\t    if series:\n95\t        for i, (name, cls) in enumerate(series):\n96\t            body += [\n97\t                f'<rect x=\"{left + i * 150}\" y=\"58\" width=\"12\" height=\"12\" rx=\"3\" class=\"{cls}\"/>',\n98\t                text(left + i * 150 + 18, 68, name, \"muted\"),\n99\t            ]\n100\t    height = y0 + band * len(rows) + 30\n101\t    for k in range(round(top / step) + 1):\n102\t        x = left + k * step * scale\n103\t        body += [\n104\t            f'<line x1=\"{x:.1f}\" x2=\"{x:.1f}\" y1=\"{y0 - 4}\" y2=\"{height - 26}\" class=\"grid\"/>',\n105\t            text(x, height - 10, fmt(k * step), \"muted\", \"middle\"),\n106\t        ]\n107\t    for n, row in enumerate(rows):\n108\t        y = y0 + n * band\n109\t        body.append(text(left - 8, y + band / 2 + 4, row[0], \"ink\", \"end\"))\n110\t        values = row[1:]\n111\t        thick = min(24, (band - 6) / len(values))\n112\t        for i, value in enumerate(values):\n113\t            cls = series[i][1] if series else \"s1\"\n114\t            body.append(\n115\t                hbar(\n116\t                    left,\n117\t                    y + 3 + i * (thick + 2),\n118\t                    value * scale,\n119\t                    thick,\n120\t                    cls,\n121\t                    f\"{row[0]}: {fmt(value)}\",\n122\t                )\n123\t            )\n124\t        end = max(values) * scale\n125\t        if intervals:\n126\t            low, high = intervals[n]\n127\t            yc = y + 3 + thick / 2\n128\t            body += [\n129\t                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc:.1f}\" y2=\"{yc:.1f}\" class=\"whisker\"/>',\n130\t                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + low * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n131\t                f'<line x1=\"{left + high * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n132\t            ]\n133\t            end = high * scale\n134\t        body.append(\n135\t            text(\n136\t                left + end + 6,\n137\t                y + band / 2 + 4,\n138\t                row[-1]\n139\t                if isinstance(row[-1], str)\n140\t                else \" / \".join(fmt(v) for v in values),\n141\t                \"muted\",\n142\t            )\n143\t        )\n144\t    path.write_text(page(height, title, subtitle, \"\".join(body), title))\n145\t    return path\n146\t\n147\t\n148\tdef columns(path, title, subtitle, rows, fmt, marker=None):\n149\t    \"\"\"Vertical columns: rows of (label, value, tooltip). marker, if given, is (index, label)\n150\t    for a hairline at a column, such as the median.\"\"\"\n151\t    left, right, base, top_y = 70, WIDTH - 24, 300, 70\n152\t    top, step = nice(max(r[1] for r in rows))\n153\t    scale = (base - top_y) / top\n154\t    slot = (right - left) / len(rows)\n155\t    width = min(24, slot - 2)\n156\t    body = []\n157\t    for k in range(round(top / step) + 1):\n158\t        y = base - k * step * scale\n159\t        body += [\n160\t            f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{y:.1f}\" y2=\"{y:.1f}\" class=\"grid\"/>',\n161\t            text(left - 8, y + 4, fmt(k * step), \"muted\", \"end\"),\n162\t        ]\n163\t    for i, (label, value, tip) in enumerate(rows):\n164\t        x = left + i * slot + (slot - width) / 2\n165\t        body.append(vbar(x, base, width, value * scale, \"s1\", tip))\n166\t        if len(rows) <= 12 or i % 2 == 0:\n167\t            body.append(text(x + width / 2, base + 16, label, \"muted\", \"middle\"))\n168\t    if marker:\n169\t        index, label = marker\n170\t        x = left + index * slot + slot / 2\n171\t        body += [\n172\t            f'<line x1=\"{x:.1f}\" x2=\"{x:.1f}\" y1=\"{top_y - 6}\" y2=\"{base}\" class=\"axis\"/>',\n173\t            text(x + 4, top_y - 8, label, \"ink\"),\n174\t        ]\n175\t    body.append(\n176\t        f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{base}\" y2=\"{base}\" class=\"axis\"/>'\n177\t    )\n178\t    path.write_text(page(base + 30, title, subtitle, \"\".join(body), title))\n179\t    return path\n180\t\n181\t\n182\tdef years_chart(path, by_year):\n183\t    \"\"\"Two panels on one time axis: articles per year, and candidates per million articles.\"\"\"\n184\t    left, right = 70, WIDTH - 24\n185\t    first, last = by_year[0][\"year\"], by_year[-1][\"year\"]\n186\t    x = lambda year: left + (year - first) / (last - first) * (right - left)\n187\t    body = []\n188\t    panels = (\n189\t        (\"Articles per year\", \"articles\", 80, 230),\n190\t        (\"Candidates per million articles\", \"candidates_per_million\", 290, 440),\n191\t    )\n192\t    for name, key, top_y, base in panels:\n193\t        top, step = nice(max(r[key] for r in by_year))\n194\t        y = lambda v, top=top, top_y=top_y, base=base: base - v / top * (base - top_y)\n195\t        body.append(text(left, top_y - 10, name, \"ink\"))\n196\t        for k in range(round(top / step) + 1):\n197\t            body += [\n198\t                f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{y(k * step):.1f}\" y2=\"{y(k * step):.1f}\" class=\"grid\"/>',\n199\t                text(left - 8, y(k * step) + 4, compact(k * step), \"muted\", \"end\"),\n200\t            ]\n201\t        runs, run = [], []\n202\t        for r in by_year:  # a gap in the years breaks the line\n203\t            if run and r[\"year\"] != run[-1][\"year\"] + 1:\n204\t                runs.append(run)\n205\t                run = []\n206\t            run.append(r)\n207\t        runs.append(run)\n208\t        for run in runs:\n209\t            points = \" \".join(f\"{x(r['year']):.1f},{y(r[key]):.1f}\" for r in run)\n210\t            if key == \"articles\" and len(run) > 1:\n211\t                body.append(\n212\t                    f'<polygon class=\"wash\" points=\"{x(run[0][\"year\"]):.1f},{base} {points} {x(run[-1][\"year\"]):.1f},{base}\"/>'\n213\t                )\n214\t            body.append(\n215\t                f'<polyline class=\"line\" points=\"{points}\"/>'\n216\t                if len(run) > 1\n217\t                else f'<circle cx=\"{x(run[0][\"year\"]):.1f}\" cy=\"{y(run[0][key]):.1f}\" r=\"2\" class=\"s1\"/>'\n218\t            )\n219\t        body.append(\n220\t            f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{base}\" y2=\"{base}\" class=\"axis\"/>'\n221\t        )\n222\t    for r in by_year:  # hover targets, one per year across both panels\n223\t        tip = f\"{r['year']}: {r['articles']:,} articles, {r['candidates']:,} candidates, {r['candidates_per_million']:.0f} per million\"\n224\t        body.append(\n225\t            f'<rect class=\"hit\" x=\"{x(r[\"year\"]) - 2:.1f}\" y=\"70\" width=\"4\" height=\"372\"><title>{escape(tip)}</title></rect>'\n226\t        )\n227\t    for year in range(1780, last + 1, 20):\n228\t        body.append(text(x(year), 460, year, \"muted\", \"middle\"))\n229\t    path.write_text(\n230\t        page(\n231\t            476,\n232\t            \"Articles and candidates by year\",\n233\t            \"AmericanStories, all 180 year files; gaps are years with no file\",\n234\t            \"\".join(body),\n235\t            \"Articles and candidates by year\",\n236\t        )\n237\t    )\n238\t    return path\n239\t\n240\t\n241\tdef draw_all(report, out):\n242\t    made = [years_chart(out / \"years.svg\", report[\"by_year\"])]\n243\t    states = [s for s in report[\"by_state\"] if s[\"articles\"] >= 1_000_000]\n244\t    states.sort(key=lambda s: -s[\"candidates_per_million\"])\n245\t    made.append(\n246\t        bars(\n247\t            out / \"states.svg\",\n248\t            \"Candidates per million articles, by state\",\n249\t            f\"States with a million articles or more; {report['no_state']['share_of_candidates']:.1%} of candidates have no state on record\",\n250\t            [\n251\t                (\n252\t                    \"No state on record\" if s[\"state\"] == \"unknown\" else s[\"state\"],\n253\t                    s[\"candidates_per_million\"],\n254\t                )\n255\t                for s in states\n256\t            ],\n257\t            lambda v: f\"{v:,.0f}\",\n258\t        )\n259\t    )\n260\t    terms = sorted(report[\"terms\"][\"any\"], key=lambda t: -report[\"terms\"][\"any\"][t])\n261\t    made.append(\n262\t        bars(\n263\t            out / \"terms.svg\",\n264\t            \"Candidates by ghost term\",\n265\t            \"A candidate can hold several terms; 'only' counts those holding just this one\",\n266\t            [(t, report[\"terms\"][\"any\"][t], report[\"terms\"][\"only\"][t]) for t in terms],\n267\t            compact,\n268\t            series=[(\"Holds the term\", \"s1\"), (\"Holds only this term\", \"s2\")],\n269\t        )\n270\t    )\n271\t    lengths = report[\"lengths\"][\"histogram\"]\n272\t    made.append(\n273\t        columns(\n274\t            out / \"lengths.svg\",\n275\t            \"Candidate length\",\n276\t            f\"Words in the article's text; median {report['lengths']['p50']}\",\n277\t            [\n278\t                (\n279\t                    f\"{b['from']}+\" if b[\"to\"] is None else f\"{b['from']}–{b['to']}\",\n280\t                    b[\"candidates\"],\n281\t                    f\"{b['candidates']:,} candidates\",\n282\t                )\n283\t                for b in lengths\n284\t            ],\n285\t            compact,\n286\t        )\n287\t    )\n288\t    ocr = report[\"ocr_quality\"]\n289\t    made.append(\n290\t        columns(\n291\t            out / \"ocr.svg\",\n292\t            \"OCR quality of candidates\",\n293\t            f\"Share of words a standard dictionary knows; {ocr['sample']}\",\n294\t            [\n295\t                (f\"{i * 5}%\", n, f\"{i * 5}–{i * 5 + 5}%: {n:,} candidates\")\n296\t                for i, n in enumerate(ocr[\"histogram\"])\n297\t            ],\n298\t            compact,\n299\t            marker=(min(19, int(ocr[\"p50\"] * 20)), f\"median {ocr['p50']:.0%}\"),\n300\t        )\n301\t    )\n302\t    sizes = report[\"reprints\"][\"size_histogram\"]\n303\t    made.append(\n304\t        columns(\n305\t            out / \"reprints.svg\",\n306\t            \"Reprint clusters by size\",\n307\t            f\"{report['reprints']['clusters']:,} clusters hold {report['reprints']['clustered_candidates']:,} candidates ({report['reprints']['share_clustered']:.0%})\",\n308\t            [\n309\t                (\n310\t                    f\"{b['from']}+\"\n311\t                    if b[\"to\"] is None\n312\t                    else (\n313\t                        f\"{b['from']}\"\n314\t                        if b[\"from\"] == b[\"to\"]\n315\t                        else f\"{b['from']}–{b['to']}\"\n316\t                    ),\n317\t                    b[\"clusters\"],\n318\t                    f\"{b['clusters']:,} clusters, {b['candidates']:,} candidates\",\n319\t                )\n320\t                for b in sizes\n321\t            ],\n322\t            compact,\n323\t        )\n324\t    )\n325\t    composition = report[\"composition\"].get(\"categories\")\n326\t    if composition:\n327\t        rows = sorted(composition.items(), key=lambda kv: -kv[1][\"share\"])\n328\t        made.append(\n329\t            bars(\n330\t                out / \"composition.svg\",\n331\t                \"What the candidates are\",\n332\t                f\"{report['composition']['judged']} candidates at random, judged by hand; whiskers are 95% intervals\",\n333\t                [\n334\t                    (\n335\t                        name.replace(\"_\", \" \"),\n336\t                        c[\"share\"] * 100,\n337\t                        f\"{c['count']} ({c['share']:.0%}, {c['low']:.0%}–{c['high']:.0%})\",\n338\t                    )\n339\t                    for name, c in rows\n340\t                ],\n341\t                lambda v: f\"{v:.0f}%\",\n342\t                intervals=[(c[\"low\"] * 100, c[\"high\"] * 100) for _, c in rows],\n343\t            )\n344\t        )\n345\t    recall = report[\"recall\"]\n346\t    if all(\"share\" in recall[p] for p in (\"near_miss\", \"random\")):\n347\t        rows = [\n348\t            (\"Near-miss pool\", recall[\"near_miss\"]),\n349\t            (\"All non-candidates\", recall[\"random\"]),\n350\t        ]\n351\t        made.append(\n352\t            bars(\n353\t                out / \"recall.svg\",\n354\t                \"Ghost reports the lexicon missed\",\n355\t                \"Share of each pool's sample that is a ghost report; whiskers are 95% intervals\",\n356\t                [\n357\t                    (\n358\t                        name,\n359\t                        r[\"share\"] * 100,\n360\t                        f\"{r['count']} of {r['n']} ({r['low']:.1%}–{r['high']:.1%})\",\n361\t                    )\n362\t                    for name, r in rows\n363\t                ],\n364\t                lambda v: f\"{v:.1f}%\",\n365\t                intervals=[(r[\"low\"] * 100, r[\"high\"] * 100) for _, r in rows],\n366\t            )\n367\t        )"}]},"uuid":"ac412d9a-6484-4ef4-934e-25bb1a3ea913","timestamp":"2026-10-30T07:36:46.264Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/charts.py","content":"def page(height, title, subtitle, body, label):\n    return (\n        f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {WIDTH} {height}\" width=\"{WIDTH}\" height=\"{height}\" role=\"img\" aria-label=\"{escape(label)}\">'\n        f'<title>{escape(title)}</title>{STYLE}<rect class=\"bg\" width=\"{WIDTH}\" height=\"{height}\"/>'\n        + text(24, 30, title, \"ink title\")\n        + text(24, 50, subtitle, \"muted\")\n        + body\n        + \"</svg>\\n\"\n    )\n\n\ndef bars(\n    path, title, subtitle, rows, fmt, series=None, intervals=None, label_width=170\n):\n    \"\"\"Horizontal bars: rows of (label, value) or (label, value, second value), with an\n    optional 95% interval per row as (low, high).\"\"\"\n    top = (\n        max(max(r[1:]) if not intervals else max(i[1] for i in intervals) for r in rows)\n        if not intervals\n        else max(i[1] for i in intervals)\n    )\n    top, step = nice(max(top, max(max(r[1:]) for r in rows)))\n    left, right, band = 24 + label_width, WIDTH - 80, 22 if not series else 30\n    y0 = 78 if series else 68\n    scale = (right - left) / top\n    body = []\n    if series:\n        for i, (name, cls) in enumerate(series):\n            body += [\n                f'<rect x=\"{left + i * 150}\" y=\"58\" width=\"12\" height=\"12\" rx=\"3\" class=\"{cls}\"/>',\n                text(left + i * 150 + 18, 68, name, \"muted\"),\n            ]\n    height = y0 + band * len(rows) + 30\n    for k in range(round(top / step) + 1):\n        x = left + k * step * scale\n        body += [\n            f'<line x1=\"{x:.1f}\" x2=\"{x:.1f}\" y1=\"{y0 - 4}\" y2=\"{height - 26}\" class=\"grid\"/>',\n            text(x, height - 10, fmt(k * step), \"muted\", \"middle\"),\n        ]\n    for n, row in enumerate(rows):\n        y = y0 + n * band\n        body.append(text(left - 8, y + band / 2 + 4, row[0], \"ink\", \"end\"))\n        values = row[1:]\n        thick = min(24, (band - 6) / len(values))\n        for i, value in enumerate(values):\n            cls = series[i][1] if series else \"s1\"\n            body.append(\n                hbar(\n                    left,\n                    y + 3 + i * (thick + 2),\n                    value * scale,\n                    thick,\n                    cls,\n                    f\"{row[0]}: {fmt(value)}\",\n                )\n            )\n        end = max(values) * scale\n        if intervals:\n            low, high = intervals[n]\n            yc = y + 3 + thick / 2\n            body += [\n                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc:.1f}\" y2=\"{yc:.1f}\" class=\"whisker\"/>',\n                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + low * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n                f'<line x1=\"{left + high * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n            ]\n            end = high * scale\n        body.append(\n            text(\n                left + end + 6,\n                y + band / 2 + 4,\n                row[-1]\n                if isinstance(row[-1], str)\n                else \" / \".join(fmt(v) for v in values),\n                \"muted\",\n            )\n        )\n    path.write_text(page(height, title, subtitle, \"\".join(body), title))\n    return path\n\n\ndef columns(path, title, subtitle, rows, fmt, marker=None):\n    \"\"\"Vertical columns: rows of (label, value, tooltip). marker, if given, is (index, label)\n    for a hairline at a column, such as the median.\"\"\"\n    left, right, base, top_y = 70, WIDTH - 24, 300, 70\n    top, step = nice(max(r[1] for r in rows))\n    scale = (base - top_y) / top\n    slot = (right - left) / len(rows)\n    width = min(24, slot - 2)\n    body = []\n    for k in range(round(top / step) + 1):\n        y = base - k * step * scale\n        body += [\n            f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{y:.1f}\" y2=\"{y:.1f}\" class=\"grid\"/>',\n            text(left - 8, y + 4, fmt(k * step), \"muted\", \"end\"),\n        ]\n    for i, (label, value, tip) in enumerate(rows):\n        x = left + i * slot + (slot - width) / 2\n        body.append(vbar(x, base, width, value * scale, \"s1\", tip))\n        if len(rows) <= 12 or i % 2 == 0:\n            body.append(text(x + width / 2, base + 16, label, \"muted\", \"middle\"))\n    if marker:\n        index, label = marker\n        x = left + index * slot + slot / 2\n        body += [\n            f'<line x1=\"{x:.1f}\" x2=\"{x:.1f}\" y1=\"{top_y - 6}\" y2=\"{base}\" class=\"axis\"/>',\n            text(x + 4, top_y - 8, label, \"ink\"),\n        ]\n    body.append(\n        f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{base}\" y2=\"{base}\" class=\"axis\"/>'\n    )\n    path.write_text(page(base + 30, title, subtitle, \"\".join(body), title))\n    return path\n\n\ndef years_chart(path, by_year):\n    \"\"\"Two panels on one time axis: articles per year, and candidates per million articles.\"\"\"\n    left, right = 70, WIDTH - 24\n    first, last = by_year[0][\"year\"], by_year[-1][\"year\"]\n    x = lambda year: left + (year - first) / (last - first) * (right - left)\n    body = []\n    panels = (\n        (\"Articles per year\", \"articles\", 80, 230),\n        (\"Candidates per million articles\", \"candidates_per_million\", 290, 440),\n    )\n    for name, key, top_y, base in panels:\n        top, step = nice(max(r[key] for r in by_year))\n        y = lambda v, top=top, top_y=top_y, base=base: base - v / top * (base - top_y)\n        body.append(text(left, top_y - 10, name, \"ink\"))\n        for k in range(round(top / step) + 1):\n            body += [\n                f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{y(k * step):.1f}\" y2=\"{y(k * step):.1f}\" class=\"grid\"/>',\n                text(left - 8, y(k * step) + 4, compact(k * step), \"muted\", \"end\"),\n            ]\n        runs, run = [], []\n        for r in by_year:  # a gap in the years breaks the line\n            if run and r[\"year\"] != run[-1][\"year\"] + 1:\n                runs.append(run)\n                run = []\n            run.append(r)\n        runs.append(run)\n        for run in runs:\n            points = \" \".join(f\"{x(r['year']):.1f},{y(r[key]):.1f}\" for r in run)\n            if key == \"articles\" and len(run) > 1:\n                body.append(\n                    f'<polygon class=\"wash\" points=\"{x(run[0][\"year\"]):.1f},{base} {points} {x(run[-1][\"year\"]):.1f},{base}\"/>'\n                )\n            body.append(\n                f'<polyline class=\"line\" points=\"{points}\"/>'\n                if len(run) > 1\n                else f'<circle cx=\"{x(run[0][\"year\"]):.1f}\" cy=\"{y(run[0][key]):.1f}\" r=\"2\" class=\"s1\"/>'\n            )\n        body.append(\n            f'<line x1=\"{left}\" x2=\"{right}\" y1=\"{base}\" y2=\"{base}\" class=\"axis\"/>'\n        )\n    for r in by_year:  # hover targets, one per year across both panels\n        tip = f\"{r['year']}: {r['articles']:,} articles, {r['candidates']:,} candidates, {r['candidates_per_million']:.0f} per million\"\n        body.append(\n            f'<rect class=\"hit\" x=\"{x(r[\"year\"]) - 2:.1f}\" y=\"70\" width=\"4\" height=\"372\"><title>{escape(tip)}</title></rect>'\n        )\n    for year in range(1780, last + 1, 20):\n        body.append(text(x(year), 460, year, \"muted\", \"middle\"))\n    path.write_text(\n        page(\n            476,\n            \"Articles and candidates by year\",\n            \"AmericanStories, all 180 year files; gaps are years with no file\",\n            \"\".join(body),\n            \"Articles and candidates by year\",\n        )\n    )\n    return path\n\n\ndef draw_all(report, out):\n    made = [years_chart(out / \"years.svg\", report[\"by_year\"])]\n    states = [s for s in report[\"by_state\"] if s[\"articles\"] >= 1_000_000]\n    states.sort(key=lambda s: -s[\"candidates_per_million\"])\n    made.append(\n        bars(\n            out / \"states.svg\",\n            \"Candidates per million articles, by state\",\n            f\"States with a million articles or more; {report['no_state']['share_of_candidates']:.1%} of candidates have no state on record\",\n            [\n                (\n                    \"No state on record\" if s[\"state\"] == \"unknown\" else s[\"state\"],\n                    s[\"candidates_per_million\"],\n                )\n                for s in states\n            ],\n            lambda v: f\"{v:,.0f}\",\n        )\n    )\n    terms = sorted(report[\"terms\"][\"any\"], key=lambda t: -report[\"terms\"][\"any\"][t])\n    made.append(\n        bars(\n            out / \"terms.svg\",\n            \"Candidates by ghost term\",\n            \"A candidate can hold several terms; 'only' counts those holding just this one\",\n            [(t, report[\"terms\"][\"any\"][t], report[\"terms\"][\"only\"][t]) for t in terms],\n            compact,\n            series=[(\"Holds the term\", \"s1\"), (\"Holds only this term\", \"s2\")],\n        )\n    )\n    lengths = report[\"lengths\"][\"histogram\"]\n    made.append(\n        columns(\n            out / \"lengths.svg\",\n            \"Candidate length\",\n            f\"Words in the article's text; median {report['lengths']['p50']}\",\n            [\n                (\n                    f\"{b['from']}+\" if b[\"to\"] is None else f\"{b['from']}–{b['to']}\",\n                    b[\"candidates\"],\n                    f\"{b['candidates']:,} candidates\",\n                )\n                for b in lengths\n            ],\n            compact,\n        )\n    )\n    ocr = report[\"ocr_quality\"]\n    made.append(\n        columns(\n            out / \"ocr.svg\",\n            \"OCR quality of candidates\",\n            f\"Share of words a standard dictionary knows; {ocr['sample']}\",\n            [\n                (f\"{i * 5}%\", n, f\"{i * 5}–{i * 5 + 5}%: {n:,} candidates\")\n                for i, n in enumerate(ocr[\"histogram\"])\n            ],\n            compact,\n            marker=(min(19, int(ocr[\"p50\"] * 20)), f\"median {ocr['p50']:.0%}\"),\n        )\n    )\n    sizes = report[\"reprints\"][\"size_histogram\"]\n    made.append(\n        columns(\n            out / \"reprints.svg\",\n            \"Reprint clusters by size\",\n            f\"{report['reprints']['clusters']:,} clusters hold {report['reprints']['clustered_candidates']:,} candidates ({report['reprints']['share_clustered']:.0%})\",\n            [\n                (\n                    f\"{b['from']}+\"\n                    if b[\"to\"] is None\n                    else (\n                        f\"{b['from']}\"\n                        if b[\"from\"] == b[\"to\"]\n                        else f\"{b['from']}–{b['to']}\"\n                    ),\n                    b[\"clusters\"],\n                    f\"{b['clusters']:,} clusters, {b['candidates']:,} candidates\",\n                )\n                for b in sizes\n            ],\n            compact,\n        )\n    )\n    composition = report[\"composition\"].get(\"categories\")\n    if composition:\n        rows = sorted(composition.items(), key=lambda kv: -kv[1][\"share\"])\n        made.append(\n            bars(\n                out / \"composition.svg\",\n                \"What the candidates are\",\n                f\"{report['composition']['judged']} candidates at random, judged by hand; whiskers are 95% intervals\",\n                [\n                    (\n                        name.replace(\"_\", \" \"),\n                        c[\"share\"] * 100,\n                        f\"{c['count']} ({c['share']:.0%}, {c['low']:.0%}–{c['high']:.0%})\",\n                    )\n                    for name, c in rows\n                ],\n                lambda v: f\"{v:.0f}%\",\n                intervals=[(c[\"low\"] * 100, c[\"high\"] * 100) for _, c in rows],\n            )\n        )\n    recall = report[\"recall\"]\n    if all(\"share\" in recall[p] for p in (\"near_miss\", \"random\")):\n        rows = [\n            (\"Near-miss pool\", recall[\"near_miss\"]),\n            (\"All non-candidates\", recall[\"random\"]),\n        ]\n        made.append(\n            bars(\n                out / \"recall.svg\",\n                \"Ghost reports the lexicon missed\",\n                \"Share of each pool's sample that is a ghost report; whiskers are 95% intervals\",\n                [\n                    (\n                        name,\n                        r[\"share\"] * 100,\n                        f\"{r['count']} of {r['n']} ({r['low']:.1%}–{r['high']:.1%})\",\n                    )\n                    for name, r in rows\n                ],\n                lambda v: f\"{v:.1f}%\",\n                intervals=[(r[\"low\"] * 100, r[\"high\"] * 100) for _, r in rows],\n            )\n        )","numLines":300,"startLine":68,"totalLines":369}},"sourceToolAssistantUUID":"6f862668-45b8-4c2c-b96e-f89fa6dbc628","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
