{"parentUuid":"8c9b85ba-77a4-4a26-9662-7bbe9b74d565","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgY1qap3CPbNFeTpVtubV","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018H4yrndiZjCkfrCoMSGnR7","name":"Write","input":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","content":"\"\"\"make eval: eval A over the archive read in Phase 2A. It writes eval/results/eval_a.json,\nand its charts and hand-judged samples to eval/results/eval_a/.\n\n1. EDA: by year, by state and by term; candidate lengths; OCR quality, as the share of words\n   /usr/share/dict/words knows; and reprint clusters among the candidates.\n2. Composition: 200 candidates at random, each put in a category by hand in\n   composition.json.\n3. Recall: 300 articles from the near-miss reservoirs and 300 from the random ones, each\n   weighted by its year's share of the pool, marked by hand in recall.json.\n\nEvery sample is seeded, so a rerun draws the same articles and keeps the judgments made.\n\"\"\"\n\nimport json\nimport random\nimport re\nimport zlib\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport zstandard\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.ingest import lexicon\nfrom paperghosts.ingest.prefilter import SAMPLE_SIZE\nfrom paperghosts.ingest.year import code_version\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"eval_a\"\nDICTIONARY = Path(\"/usr/share/dict/words\")\nOCR_ONE_IN = 20  # OCR quality is measured on one candidate in twenty, chosen by its id\nCOMPOSITION, RECALL, REPRINT_CHECK = 200, 300, 20\nCATEGORIES = (\n    \"ghost_report\",\n    \"fiction\",\n    \"religious\",\n    \"figurative\",\n    \"name_or_title\",\n    \"social_event\",\n    \"other\",\n)\nWORD = re.compile(r\"[a-z]{3,}\")\n# common endings, tried in turn when a word isn't in the list as it stands\nENDINGS = (\n    (\"ies\", \"y\"),\n    (\"ied\", \"y\"),\n    (\"ing\", \"e\"),\n    (\"ing\", \"\"),\n    (\"ed\", \"e\"),\n    (\"ed\", \"\"),\n    (\"es\", \"\"),\n    (\"s\", \"\"),\n    (\"ly\", \"\"),\n)\n# words to look around in a random-pool article, besides its opening; a guide to reading\nFLAGS = re.compile(\n    r\"\\b(?:spirit|spectral|unearthly|uncanny|weird|supernatural|seance|apparit|phantasm\"\n    r\"|spook|wraith|goblin|banshee|witch|hoodoo|voodoo|superstiti|haint|bogey|boogey\"\n    r\"|corpse|graveyard|midnight|in white|strange (?:noise|light|sound)|mysterious|knock\"\n    r\"|rapp|haunt|spectre|specter|phantom|[gq][hbk]?[o0ae][a-z]?sts?\\b)\\w*\",\n    re.IGNORECASE,\n)\n_words = None\n\n\ndef dictionary():\n    global _words\n    if _words is None:\n        _words = frozenset(w.strip().lower() for w in DICTIONARY.read_text().splitlines())\n    return _words\n\n\ndef known(word, words):\n    if word in words:\n        return True\n    return any(\n        len(word) > len(end) + 2 and word.endswith(end) and word[: -len(end)] + back in words\n        for end, back in ENDINGS\n    )\n\n\ndef ocr_quality(text, words, least=20):\n    \"\"\"The share of the article's words of three letters or more that the dictionary knows,\n    once line-break hyphens are joined and common endings come off; None under `least`.\"\"\"\n    found = WORD.findall((text or \"\").replace(\"-\\n\", \"\").lower())\n    if len(found) < least:\n        return None\n    return sum(known(word, words) for word in found) / len(found)\n\n\ndef draw(pools, sizes, n, seed):\n    \"\"\"n (year, item) pairs, each year drawn in proportion to its share of the pool across the\n    archive, so the sample stands for every article in the pool rather than for each year\n    equally. pools maps a year to its reservoir, and sizes to the pool's full size.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(year for year in pools if sizes.get(year) and pools[year])\n    wanted = Counter(rng.choices(years, weights=[sizes[year] for year in years], k=n))\n    return [\n        (year, item)\n        for year in years\n        for item in rng.sample(list(pools[year]), min(wanted[year], len(pools[year])))\n    ]\n\n\ndef uniform(counts, n, seed):\n    \"\"\"n (year, index) pairs without replacement, every candidate equally likely.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(counts)\n    picks = []\n    for left in sorted(rng.sample(range(sum(counts.values())), n)):\n        for year in years:\n            if left < counts[year]:\n                picks.append((year, left))\n                break\n            left -= counts[year]\n    return picks\n\n\ndef window(text, position, width=320):\n    start = max(0, position - width // 2)\n    return \" \".join(text[start : start + width].split())\n\n\ndef first_match(text, forms):\n    low = text.lower()\n    found = [low.find(form.lower()) for form in forms]\n    return min([p for p in found if p >= 0], default=0)\n\n\ndef year_pass(job):\n    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n    paper and opening; plus the composition picks and recall picks that fall in this year.\"\"\"\n    year, wanted, near, rand = job\n    words, docs, picked = dictionary(), [], []\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(map(json.loads, rows)):\n            text = row[\"text\"] or \"\"\n            quality = None\n            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n                quality = ocr_quality(text, words)\n            docs.append(\n                (\n                    len(text.split()),\n                    quality,\n                    tuple(keys(text)),\n                    row[\"lccn\"],\n                    row[\"article_id\"],\n                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n                )\n            )\n            if index in wanted:\n                both = f\"{row['headline'] or ''}\\n{text}\"\n                forms = [form for found in row[\"terms\"].values() for form in found]\n                picked.append(\n                    {\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"state\": row[\"state\"],\n                        \"terms\": sorted(row[\"terms\"]),\n                        \"words\": len(text.split()),\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[:200],\n                        \"context\": window(both, first_match(both, forms), 600),\n                        \"category\": None,\n                        \"note\": None,\n                    }\n                )\n    recalled = []\n    if near or rand:\n        seen = Counter()\n        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n            for row in map(json.loads, rows):\n                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n                seen[pool] += 1\n                if index not in (near if pool == \"near_miss\" else rand):\n                    continue\n                text = row[\"text\"] or \"\"\n                low = text.lower()\n                spots = [m.start() for m in FLAGS.finditer(text)]\n                spots += [low.find(t) for t in row[\"near_miss_terms\"] for t in (t[:5],)]\n                recalled.append(\n                    {\n                        \"pool\": pool,\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[:200],\n                        \"near_miss_terms\": sorted(row[\"near_miss_terms\"]),\n                        \"words\": len(text.split()),\n                        \"opening\": \" \".join(text[:420].split()),\n                        \"contexts\": [window(text, p, 300) for p in sorted(set(spots))[:4] if p >= 0],\n                        \"ghost_report\": None,\n                        \"note\": None,\n                    }\n                )\n    return year, docs, picked, recalled\n\n\ndef quantiles(values, points=(0.1, 0.25, 0.5, 0.75, 0.9, 0.99)):\n    ordered = sorted(values)\n    return {f\"p{round(q * 100)}\": ordered[round(q * (len(ordered) - 1))] for q in points}\n\n\ndef keep_judgments(path, items, key, fields):\n    \"\"\"The freshly drawn items, with any judgment already made on them carried over.\"\"\"\n    if path.exists():\n        made = {key(old): old for old in json.loads(path.read_text())}\n        for item in items:\n            for field in fields:\n                item[field] = made.get(key(item), {}).get(field)\n    path.write_text(json.dumps(items, indent=1, ensure_ascii=False) + \"\\n\")\n    return items\n\n\ndef rate(hits, n, of):\n    low, high = wilson(hits, n)\n    return {\n        \"count\": hits,\n        \"n\": n,\n        \"share\": hits / n,\n        \"low\": low,\n        \"high\": high,\n        \"implied\": round(hits / n * of),\n        \"implied_low\": round(low * of),\n        \"implied_high\": round(high * of),\n    }\n\n\ndef main():\n    from charts import draw_all  # noqa: PLC0415 (the charts are only needed here)\n\n    counts = {\n        c[\"year\"]: c for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(counts)\n    total = {k: sum(counts[y][k] for y in years) for k in (\"pages\", \"articles\", \"candidates\", \"near_miss\")}\n    others = {y: counts[y][\"articles\"] - counts[y][\"candidates\"] for y in years}\n    total[\"non_candidates\"] = sum(others.values())\n\n    composition = defaultdict(set)\n    for year, index in uniform({y: counts[y][\"candidates\"] for y in years}, COMPOSITION, \"eval A composition\"):\n        composition[year].add(index)\n    near, rand = defaultdict(set), defaultdict(set)\n    reservoirs = {y: range(min(SAMPLE_SIZE, counts[y][\"near_miss\"])) for y in years}\n    for year, index in draw(reservoirs, {y: counts[y][\"near_miss\"] for y in years}, RECALL, \"eval A recall near-miss\"):\n        near[year].add(index)\n    reservoirs = {y: range(min(SAMPLE_SIZE, others[y])) for y in years}\n    for year, index in draw(reservoirs, others, RECALL, \"eval A recall random\"):\n        rand[year].add(index)\n\n    jobs = [(y, composition[y], near[y], rand[y]) for y in years if counts[y][\"candidates\"] or near[y] or rand[y]]\n    docs, years_of, picked, recalled = [], [], [], []\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for year, found, chosen, reread in pool.map(year_pass, sorted(jobs, key=lambda job: -counts[job[0]][\"articles\"])):\n            docs += found\n            years_of += [year] * len(found)\n            picked += chosen\n            recalled += reread\n\n    lengths = [doc[0] for doc in docs]\n    qualities = [(year, doc[1]) for year, doc in zip(years_of, docs, strict=True) if doc[1] is not None]\n    groups = clusters([doc[2] for doc in docs])\n    group_sizes = sorted((len(g) for g in groups), reverse=True)\n    cross = [g for g in groups if len({docs[d][3] for d in g}) > 1]\n    rng = random.Random(\"eval A reprint check\")\n    checks = []\n    for group in rng.sample(groups, min(REPRINT_CHECK, len(groups))):\n        a, b = rng.sample(group, 2)\n        checks.append(\n            {\n                \"size\": len(group),\n                \"papers\": len({docs[d][3] for d in group}),\n                \"years\": [min(years_of[d] for d in group), max(years_of[d] for d in group)],\n                \"members\": [docs[a][4], docs[b][4]],\n                \"openings\": [docs[a][5], docs[b][5]],\n                \"same_story\": None,\n            }\n        )\n    largest = [\n        {\n            \"size\": len(g),\n            \"papers\": len({docs[d][3] for d in g}),\n            \"years\": [min(years_of[d] for d in g), max(years_of[d] for d in g)],\n            \"example\": docs[g[0]][5][:160],\n        }\n        for g in sorted(groups, key=len, reverse=True)[:10]\n    ]\n\n    OUT.mkdir(parents=True, exist_ok=True)\n    picked = keep_judgments(OUT / \"composition.json\", sorted(picked, key=lambda p: (p[\"year\"], p[\"article_id\"])), lambda p: p[\"article_id\"], (\"category\", \"note\"))\n    recalled = keep_judgments(OUT / \"recall.json\", sorted(recalled, key=lambda r: (r[\"pool\"], r[\"year\"], r[\"article_id\"])), lambda r: (r[\"pool\"], r[\"article_id\"]), (\"ghost_report\", \"note\"))\n    checks = keep_judgments(OUT / \"reprint-check.json\", checks, lambda c: tuple(c[\"members\"]), (\"same_story\",))\n\n    by_state = defaultdict(Counter)\n    for year in years:\n        for state, row in counts[year][\"by_state\"].items():\n            by_state[state].update(row)\n    terms = {term: sum(counts[y][\"by_term\"].get(term, 0) for y in years) for term in lexicon.GHOST}\n    only = {term: sum(counts[y][\"only_by_term\"].get(term, 0) for y in years) for term in lexicon.GHOST}\n    decade_quality = defaultdict(list)\n    for year, quality in qualities:\n        decade_quality[year // 10 * 10].append(quality)\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"lexicon_version\": lexicon.VERSION,\n        \"code_version\": code_version(),\n        \"totals\": {**total, \"candidates_per_million\": total[\"candidates\"] / total[\"articles\"] * 1e6},\n        \"by_year\": [\n            {\n                \"year\": y,\n                \"pages\": counts[y][\"pages\"],\n                \"articles\": counts[y][\"articles\"],\n                \"candidates\": counts[y][\"candidates\"],\n                \"near_miss\": counts[y][\"near_miss\"],\n                \"candidates_per_million\": counts[y][\"candidates\"] / counts[y][\"articles\"] * 1e6 if counts[y][\"articles\"] else 0,\n            }\n            for y in years\n        ],\n        \"by_state\": [\n            {\n                \"state\": state,\n                **row,\n                \"candidates_per_million\": row[\"candidates\"] / row[\"articles\"] * 1e6 if row[\"articles\"] else 0,\n            }\n            for state, row in sorted(by_state.items(), key=lambda kv: -kv[1][\"candidates\"])\n        ],\n        \"no_state\": {\n            \"candidates\": by_state[\"unknown\"][\"candidates\"],\n            \"share_of_candidates\": by_state[\"unknown\"][\"candidates\"] / total[\"candidates\"],\n            \"share_of_articles\": by_state[\"unknown\"][\"articles\"] / total[\"articles\"],\n        },\n        \"terms\": {\"any\": terms, \"only\": only},\n        \"lengths\": {\"unit\": \"words of the article's text\", \"mean\": sum(lengths) / len(lengths), **quantiles(lengths), \"max\": max(lengths), \"histogram\": length_histogram(lengths)},\n        \"ocr_quality\": {\n            \"method\": \"share of words of 3+ letters in /usr/share/dict/words (Webster's 2nd), once line-break hyphens are joined and -s, -es, -ed, -ing, -ly, -ies, -ied come off\",\n            \"sample\": f\"1 candidate in {OCR_ONE_IN}, by the CRC of its id: {len(qualities):,}\",\n            **quantiles([q for _, q in qualities]),\n            \"histogram\": [sum(1 for _, q in qualities if lo <= q < lo + 0.05 or (lo == 0.95 and q == 1.0)) for lo in [i / 20 for i in range(20)]],\n            \"median_by_decade\": {d: quantiles(v, (0.5,))[\"p50\"] for d, v in sorted(decade_quality.items())},\n        },\n        \"reprints\": {\n            \"method\": \"runs of 7 words of 3+ letters from each candidate's first 120, one in 8 kept by its hash; candidates sharing a run held by at most 1,000 candidates are joined\",\n            \"clusters\": len(groups),\n            \"clustered_candidates\": sum(group_sizes),\n            \"share_clustered\": sum(group_sizes) / len(docs),\n            \"distinct_stories\": len(docs) - sum(group_sizes) + len(groups),\n            \"cross_paper_clusters\": len(cross),\n            \"cross_paper_candidates\": sum(len(g) for g in cross),\n            \"size_histogram\": size_histogram(group_sizes),\n            \"largest\": largest,\n            \"check\": summarise_checks(checks),\n        },\n        \"composition\": summarise_composition(picked, total[\"candidates\"]),\n        \"recall\": summarise_recall(recalled, total),\n    }\n    (RESULTS / \"eval_a.json\").write_text(json.dumps(report, indent=1) + \"\\n\")\n    charts = draw_all(report, OUT)\n    print(f\"wrote {(RESULTS / 'eval_a.json').relative_to(ROOT)} and {len(charts)} charts in {OUT.relative_to(ROOT)}\")\n    for line in headline_numbers(report):\n        print(line)\n\n\nLENGTH_BINS = (0, 25, 50, 100, 200, 400, 800, 1600, 3200)\nSIZE_BINS = ((2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, 10**9))\n\n\ndef length_histogram(lengths):\n    edges = list(LENGTH_BINS) + [10**9]\n    return [\n        {\"from\": lo, \"to\": hi - 1 if hi < 10**9 else None, \"candidates\": sum(1 for n in lengths if lo <= n < hi)}\n        for lo, hi in zip(edges, edges[1:], strict=False)\n    ]\n\n\ndef size_histogram(sizes):\n    return [\n        {\"from\": lo, \"to\": hi if hi < 10**9 else None, \"clusters\": sum(1 for s in sizes if lo <= s <= hi), \"candidates\": sum(s for s in sizes if lo <= s <= hi)}\n        for lo, hi in SIZE_BINS\n    ]\n\n\ndef summarise_checks(checks):\n    judged = [c for c in checks if c[\"same_story\"] is not None]\n    same = sum(bool(c[\"same_story\"]) for c in judged)\n    return {\"judged\": len(judged), \"same_story\": same, **({\"low\": wilson(same, len(judged))[0], \"high\": wilson(same, len(judged))[1]} if judged else {})}\n\n\ndef summarise_composition(picked, candidates):\n    judged = [p for p in picked if p[\"category\"]]\n    out = {\"sample\": len(picked), \"judged\": len(judged), \"seed\": \"eval A composition\"}\n    if judged:\n        out[\"categories\"] = {c: rate(sum(p[\"category\"] == c for p in judged), len(judged), candidates) for c in CATEGORIES}\n    return out\n\n\ndef summarise_recall(recalled, total):\n    out = {}\n    for pool, size, seed in ((\"near_miss\", total[\"near_miss\"], \"eval A recall near-miss\"), (\"random\", total[\"non_candidates\"], \"eval A recall random\")):\n        items = [r for r in recalled if r[\"pool\"] == pool]\n        judged = [r for r in items if r[\"ghost_report\"] is not None]\n        found = [r for r in judged if r[\"ghost_report\"]]\n        out[pool] = {\"sample\": len(items), \"judged\": len(judged), \"seed\": seed, \"pool_size\": size}\n        if judged:\n            out[pool].update(rate(len(found), len(judged), size))\n            out[pool][\"reports\"] = [{k: r[k] for k in (\"article_id\", \"year\", \"date\", \"paper\", \"headline\", \"note\")} for r in found]\n    return out\n\n\ndef headline_numbers(report):\n    t = report[\"totals\"]\n    r = report[\"reprints\"]\n    yield f\"{t['articles']:,} articles in {t['pages']:,} pages; {t['candidates']:,} candidates ({t['candidates_per_million']:.0f} per million), {t['near_miss']:,} near-miss\"\n    yield f\"no state: {report['no_state']['share_of_candidates']:.1%} of candidates; median length {report['lengths']['p50']} words; median OCR quality {report['ocr_quality']['p50']:.1%}\"\n    yield f\"reprints: {r['clusters']:,} clusters hold {r['clustered_candidates']:,} candidates ({r['share_clustered']:.1%}); {r['distinct_stories']:,} distinct stories; {r['cross_paper_clusters']:,} clusters span papers\"\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2204,"cache_read_input_tokens":807045,"output_tokens":12757,"output_tokens_details":{"thinking_tokens":5375},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2204,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":12757,"cache_read_input_tokens":807045,"cache_creation_input_tokens":2204,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2204},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_018H4yrndiZjCkfrCoMSGnR7":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","content":"\"\"\"make eval: eval A over the archive read in Phase 2A. It writes eval/results/eval_a.json,\nand its charts and hand-judged samples to eval/results/eval_a/.\n\n1. EDA: by year, by state and by term; candidate lengths; OCR quality, as the share of words\n   /usr/share/dict/words knows; and reprint clusters among the candidates.\n2. Composition: 200 candidates at random, each put in a category by hand in\n   composition.json.\n3. Recall: 300 articles from the near-miss reservoirs and 300 from the random ones, each\n   weighted by its year's share of the pool, marked by hand in recall.json.\n\nEvery sample is seeded, so a rerun draws the same articles and keeps the judgments made.\n\"\"\"\n\nimport json\nimport random\nimport re\nimport zlib\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport zstandard\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.ingest import lexicon\nfrom paperghosts.ingest.prefilter import SAMPLE_SIZE\nfrom paperghosts.ingest.year import code_version\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"eval_a\"\nDICTIONARY = Path(\"/usr/share/dict/words\")\nOCR_ONE_IN = 20  # OCR quality is measured on one candidate in twenty, chosen by its id\nCOMPOSITION, RECALL, REPRINT_CHECK = 200, 300, 20\nCATEGORIES = (\n    \"ghost_report\",\n    \"fiction\",\n    \"religious\",\n    \"figurative\",\n    \"name_or_title\",\n    \"social_event\",\n    \"other\",\n)\nWORD = re.compile(r\"[a-z]{3,}\")\n# common endings, tried in turn when a word isn't in the list as it stands\nENDINGS = (\n    (\"ies\", \"y\"),\n    (\"ied\", \"y\"),\n    (\"ing\", \"e\"),\n    (\"ing\", \"\"),\n    (\"ed\", \"e\"),\n    (\"ed\", \"\"),\n    (\"es\", \"\"),\n    (\"s\", \"\"),\n    (\"ly\", \"\"),\n)\n# words to look around in a random-pool article, besides its opening; a guide to reading\nFLAGS = re.compile(\n    r\"\\b(?:spirit|spectral|unearthly|uncanny|weird|supernatural|seance|apparit|phantasm\"\n    r\"|spook|wraith|goblin|banshee|witch|hoodoo|voodoo|superstiti|haint|bogey|boogey\"\n    r\"|corpse|graveyard|midnight|in white|strange (?:noise|light|sound)|mysterious|knock\"\n    r\"|rapp|haunt|spectre|specter|phantom|[gq][hbk]?[o0ae][a-z]?sts?\\b)\\w*\",\n    re.IGNORECASE,\n)\n_words = None\n\n\ndef dictionary():\n    global _words\n    if _words is None:\n        _words = frozenset(w.strip().lower() for w in DICTIONARY.read_text().splitlines())\n    return _words\n\n\ndef known(word, words):\n    if word in words:\n        return True\n    return any(\n        len(word) > len(end) + 2 and word.endswith(end) and word[: -len(end)] + back in words\n        for end, back in ENDINGS\n    )\n\n\ndef ocr_quality(text, words, least=20):\n    \"\"\"The share of the article's words of three letters or more that the dictionary knows,\n    once line-break hyphens are joined and common endings come off; None under `least`.\"\"\"\n    found = WORD.findall((text or \"\").replace(\"-\\n\", \"\").lower())\n    if len(found) < least:\n        return None\n    return sum(known(word, words) for word in found) / len(found)\n\n\ndef draw(pools, sizes, n, seed):\n    \"\"\"n (year, item) pairs, each year drawn in proportion to its share of the pool across the\n    archive, so the sample stands for every article in the pool rather than for each year\n    equally. pools maps a year to its reservoir, and sizes to the pool's full size.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(year for year in pools if sizes.get(year) and pools[year])\n    wanted = Counter(rng.choices(years, weights=[sizes[year] for year in years], k=n))\n    return [\n        (year, item)\n        for year in years\n        for item in rng.sample(list(pools[year]), min(wanted[year], len(pools[year])))\n    ]\n\n\ndef uniform(counts, n, seed):\n    \"\"\"n (year, index) pairs without replacement, every candidate equally likely.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(counts)\n    picks = []\n    for left in sorted(rng.sample(range(sum(counts.values())), n)):\n        for year in years:\n            if left < counts[year]:\n                picks.append((year, left))\n                break\n            left -= counts[year]\n    return picks\n\n\ndef window(text, position, width=320):\n    start = max(0, position - width // 2)\n    return \" \".join(text[start : start + width].split())\n\n\ndef first_match(text, forms):\n    low = text.lower()\n    found = [low.find(form.lower()) for form in forms]\n    return min([p for p in found if p >= 0], default=0)\n\n\ndef year_pass(job):\n    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n    paper and opening; plus the composition picks and recall picks that fall in this year.\"\"\"\n    year, wanted, near, rand = job\n    words, docs, picked = dictionary(), [], []\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(map(json.loads, rows)):\n            text = row[\"text\"] or \"\"\n            quality = None\n            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n                quality = ocr_quality(text, words)\n            docs.append(\n                (\n                    len(text.split()),\n                    quality,\n                    tuple(keys(text)),\n                    row[\"lccn\"],\n                    row[\"article_id\"],\n                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n                )\n            )\n            if index in wanted:\n                both = f\"{row['headline'] or ''}\\n{text}\"\n                forms = [form for found in row[\"terms\"].values() for form in found]\n                picked.append(\n                    {\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"state\": row[\"state\"],\n                        \"terms\": sorted(row[\"terms\"]),\n                        \"words\": len(text.split()),\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[:200],\n                        \"context\": window(both, first_match(both, forms), 600),\n                        \"category\": None,\n                        \"note\": None,\n                    }\n                )\n    recalled = []\n    if near or rand:\n        seen = Counter()\n        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n            for row in map(json.loads, rows):\n                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n                seen[pool] += 1\n                if index not in (near if pool == \"near_miss\" else rand):\n                    continue\n                text = row[\"text\"] or \"\"\n                low = text.lower()\n                spots = [m.start() for m in FLAGS.finditer(text)]\n                spots += [low.find(t) for t in row[\"near_miss_terms\"] for t in (t[:5],)]\n                recalled.append(\n                    {\n                        \"pool\": pool,\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[:200],\n                        \"near_miss_terms\": sorted(row[\"near_miss_terms\"]),\n                        \"words\": len(text.split()),\n                        \"opening\": \" \".join(text[:420].split()),\n                        \"contexts\": [window(text, p, 300) for p in sorted(set(spots))[:4] if p >= 0],\n                        \"ghost_report\": None,\n                        \"note\": None,\n                    }\n                )\n    return year, docs, picked, recalled\n\n\ndef quantiles(values, points=(0.1, 0.25, 0.5, 0.75, 0.9, 0.99)):\n    ordered = sorted(values)\n    return {f\"p{round(q * 100)}\": ordered[round(q * (len(ordered) - 1))] for q in points}\n\n\ndef keep_judgments(path, items, key, fields):\n    \"\"\"The freshly drawn items, with any judgment already made on them carried over.\"\"\"\n    if path.exists():\n        made = {key(old): old for old in json.loads(path.read_text())}\n        for item in items:\n            for field in fields:\n                item[field] = made.get(key(item), {}).get(field)\n    path.write_text(json.dumps(items, indent=1, ensure_ascii=False) + \"\\n\")\n    return items\n\n\ndef rate(hits, n, of):\n    low, high = wilson(hits, n)\n    return {\n        \"count\": hits,\n        \"n\": n,\n        \"share\": hits / n,\n        \"low\": low,\n        \"high\": high,\n        \"implied\": round(hits / n * of),\n        \"implied_low\": round(low * of),\n        \"implied_high\": round(high * of),\n    }\n\n\ndef main():\n    from charts import draw_all  # noqa: PLC0415 (the charts are only needed here)\n\n    counts = {\n        c[\"year\"]: c for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(counts)\n    total = {k: sum(counts[y][k] for y in years) for k in (\"pages\", \"articles\", \"candidates\", \"near_miss\")}\n    others = {y: counts[y][\"articles\"] - counts[y][\"candidates\"] for y in years}\n    total[\"non_candidates\"] = sum(others.values())\n\n    composition = defaultdict(set)\n    for year, index in uniform({y: counts[y][\"candidates\"] for y in years}, COMPOSITION, \"eval A composition\"):\n        composition[year].add(index)\n    near, rand = defaultdict(set), defaultdict(set)\n    reservoirs = {y: range(min(SAMPLE_SIZE, counts[y][\"near_miss\"])) for y in years}\n    for year, index in draw(reservoirs, {y: counts[y][\"near_miss\"] for y in years}, RECALL, \"eval A recall near-miss\"):\n        near[year].add(index)\n    reservoirs = {y: range(min(SAMPLE_SIZE, others[y])) for y in years}\n    for year, index in draw(reservoirs, others, RECALL, \"eval A recall random\"):\n        rand[year].add(index)\n\n    jobs = [(y, composition[y], near[y], rand[y]) for y in years if counts[y][\"candidates\"] or near[y] or rand[y]]\n    docs, years_of, picked, recalled = [], [], [], []\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for year, found, chosen, reread in pool.map(year_pass, sorted(jobs, key=lambda job: -counts[job[0]][\"articles\"])):\n            docs += found\n            years_of += [year] * len(found)\n            picked += chosen\n            recalled += reread\n\n    lengths = [doc[0] for doc in docs]\n    qualities = [(year, doc[1]) for year, doc in zip(years_of, docs, strict=True) if doc[1] is not None]\n    groups = clusters([doc[2] for doc in docs])\n    group_sizes = sorted((len(g) for g in groups), reverse=True)\n    cross = [g for g in groups if len({docs[d][3] for d in g}) > 1]\n    rng = random.Random(\"eval A reprint check\")\n    checks = []\n    for group in rng.sample(groups, min(REPRINT_CHECK, len(groups))):\n        a, b = rng.sample(group, 2)\n        checks.append(\n            {\n                \"size\": len(group),\n                \"papers\": len({docs[d][3] for d in group}),\n                \"years\": [min(years_of[d] for d in group), max(years_of[d] for d in group)],\n                \"members\": [docs[a][4], docs[b][4]],\n                \"openings\": [docs[a][5], docs[b][5]],\n                \"same_story\": None,\n            }\n        )\n    largest = [\n        {\n            \"size\": len(g),\n            \"papers\": len({docs[d][3] for d in g}),\n            \"years\": [min(years_of[d] for d in g), max(years_of[d] for d in g)],\n            \"example\": docs[g[0]][5][:160],\n        }\n        for g in sorted(groups, key=len, reverse=True)[:10]\n    ]\n\n    OUT.mkdir(parents=True, exist_ok=True)\n    picked = keep_judgments(OUT / \"composition.json\", sorted(picked, key=lambda p: (p[\"year\"], p[\"article_id\"])), lambda p: p[\"article_id\"], (\"category\", \"note\"))\n    recalled = keep_judgments(OUT / \"recall.json\", sorted(recalled, key=lambda r: (r[\"pool\"], r[\"year\"], r[\"article_id\"])), lambda r: (r[\"pool\"], r[\"article_id\"]), (\"ghost_report\", \"note\"))\n    checks = keep_judgments(OUT / \"reprint-check.json\", checks, lambda c: tuple(c[\"members\"]), (\"same_story\",))\n\n    by_state = defaultdict(Counter)\n    for year in years:\n        for state, row in counts[year][\"by_state\"].items():\n            by_state[state].update(row)\n    terms = {term: sum(counts[y][\"by_term\"].get(term, 0) for y in years) for term in lexicon.GHOST}\n    only = {term: sum(counts[y][\"only_by_term\"].get(term, 0) for y in years) for term in lexicon.GHOST}\n    decade_quality = defaultdict(list)\n    for year, quality in qualities:\n        decade_quality[year // 10 * 10].append(quality)\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"lexicon_version\": lexicon.VERSION,\n        \"code_version\": code_version(),\n        \"totals\": {**total, \"candidates_per_million\": total[\"candidates\"] / total[\"articles\"] * 1e6},\n        \"by_year\": [\n            {\n                \"year\": y,\n                \"pages\": counts[y][\"pages\"],\n                \"articles\": counts[y][\"articles\"],\n                \"candidates\": counts[y][\"candidates\"],\n                \"near_miss\": counts[y][\"near_miss\"],\n                \"candidates_per_million\": counts[y][\"candidates\"] / counts[y][\"articles\"] * 1e6 if counts[y][\"articles\"] else 0,\n            }\n            for y in years\n        ],\n        \"by_state\": [\n            {\n                \"state\": state,\n                **row,\n                \"candidates_per_million\": row[\"candidates\"] / row[\"articles\"] * 1e6 if row[\"articles\"] else 0,\n            }\n            for state, row in sorted(by_state.items(), key=lambda kv: -kv[1][\"candidates\"])\n        ],\n        \"no_state\": {\n            \"candidates\": by_state[\"unknown\"][\"candidates\"],\n            \"share_of_candidates\": by_state[\"unknown\"][\"candidates\"] / total[\"candidates\"],\n            \"share_of_articles\": by_state[\"unknown\"][\"articles\"] / total[\"articles\"],\n        },\n        \"terms\": {\"any\": terms, \"only\": only},\n        \"lengths\": {\"unit\": \"words of the article's text\", \"mean\": sum(lengths) / len(lengths), **quantiles(lengths), \"max\": max(lengths), \"histogram\": length_histogram(lengths)},\n        \"ocr_quality\": {\n            \"method\": \"share of words of 3+ letters in /usr/share/dict/words (Webster's 2nd), once line-break hyphens are joined and -s, -es, -ed, -ing, -ly, -ies, -ied come off\",\n            \"sample\": f\"1 candidate in {OCR_ONE_IN}, by the CRC of its id: {len(qualities):,}\",\n            **quantiles([q for _, q in qualities]),\n            \"histogram\": [sum(1 for _, q in qualities if lo <= q < lo + 0.05 or (lo == 0.95 and q == 1.0)) for lo in [i / 20 for i in range(20)]],\n            \"median_by_decade\": {d: quantiles(v, (0.5,))[\"p50\"] for d, v in sorted(decade_quality.items())},\n        },\n        \"reprints\": {\n            \"method\": \"runs of 7 words of 3+ letters from each candidate's first 120, one in 8 kept by its hash; candidates sharing a run held by at most 1,000 candidates are joined\",\n            \"clusters\": len(groups),\n            \"clustered_candidates\": sum(group_sizes),\n            \"share_clustered\": sum(group_sizes) / len(docs),\n            \"distinct_stories\": len(docs) - sum(group_sizes) + len(groups),\n            \"cross_paper_clusters\": len(cross),\n            \"cross_paper_candidates\": sum(len(g) for g in cross),\n            \"size_histogram\": size_histogram(group_sizes),\n            \"largest\": largest,\n            \"check\": summarise_checks(checks),\n        },\n        \"composition\": summarise_composition(picked, total[\"candidates\"]),\n        \"recall\": summarise_recall(recalled, total),\n    }\n    (RESULTS / \"eval_a.json\").write_text(json.dumps(report, indent=1) + \"\\n\")\n    charts = draw_all(report, OUT)\n    print(f\"wrote {(RESULTS / 'eval_a.json').relative_to(ROOT)} and {len(charts)} charts in {OUT.relative_to(ROOT)}\")\n    for line in headline_numbers(report):\n        print(line)\n\n\nLENGTH_BINS = (0, 25, 50, 100, 200, 400, 800, 1600, 3200)\nSIZE_BINS = ((2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, 10**9))\n\n\ndef length_histogram(lengths):\n    edges = list(LENGTH_BINS) + [10**9]\n    return [\n        {\"from\": lo, \"to\": hi - 1 if hi < 10**9 else None, \"candidates\": sum(1 for n in lengths if lo <= n < hi)}\n        for lo, hi in zip(edges, edges[1:], strict=False)\n    ]\n\n\ndef size_histogram(sizes):\n    return [\n        {\"from\": lo, \"to\": hi if hi < 10**9 else None, \"clusters\": sum(1 for s in sizes if lo <= s <= hi), \"candidates\": sum(s for s in sizes if lo <= s <= hi)}\n        for lo, hi in SIZE_BINS\n    ]\n\n\ndef summarise_checks(checks):\n    judged = [c for c in checks if c[\"same_story\"] is not None]\n    same = sum(bool(c[\"same_story\"]) for c in judged)\n    return {\"judged\": len(judged), \"same_story\": same, **({\"low\": wilson(same, len(judged))[0], \"high\": wilson(same, len(judged))[1]} if judged else {})}\n\n\ndef summarise_composition(picked, candidates):\n    judged = [p for p in picked if p[\"category\"]]\n    out = {\"sample\": len(picked), \"judged\": len(judged), \"seed\": \"eval A composition\"}\n    if judged:\n        out[\"categories\"] = {c: rate(sum(p[\"category\"] == c for p in judged), len(judged), candidates) for c in CATEGORIES}\n    return out\n\n\ndef summarise_recall(recalled, total):\n    out = {}\n    for pool, size, seed in ((\"near_miss\", total[\"near_miss\"], \"eval A recall near-miss\"), (\"random\", total[\"non_candidates\"], \"eval A recall random\")):\n        items = [r for r in recalled if r[\"pool\"] == pool]\n        judged = [r for r in items if r[\"ghost_report\"] is not None]\n        found = [r for r in judged if r[\"ghost_report\"]]\n        out[pool] = {\"sample\": len(items), \"judged\": len(judged), \"seed\": seed, \"pool_size\": size}\n        if judged:\n            out[pool].update(rate(len(found), len(judged), size))\n            out[pool][\"reports\"] = [{k: r[k] for k in (\"article_id\", \"year\", \"date\", \"paper\", \"headline\", \"note\")} for r in found]\n    return out\n\n\ndef headline_numbers(report):\n    t = report[\"totals\"]\n    r = report[\"reprints\"]\n    yield f\"{t['articles']:,} articles in {t['pages']:,} pages; {t['candidates']:,} candidates ({t['candidates_per_million']:.0f} per million), {t['near_miss']:,} near-miss\"\n    yield f\"no state: {report['no_state']['share_of_candidates']:.1%} of candidates; median length {report['lengths']['p50']} words; median OCR quality {report['ocr_quality']['p50']:.1%}\"\n    yield f\"reprints: {r['clusters']:,} clusters hold {r['clustered_candidates']:,} candidates ({r['share_clustered']:.1%}); {r['distinct_stories']:,} distinct stories; {r['cross_paper_clusters']:,} clusters span papers\"\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"serverClassifierRequest":"d5cf14eb-18da-4685-b79e-add7d13d6327","apiBlockIndex":2,"requestId":"req_011CgY1qZmXxvkMGPKdvmqPJ","requestRef":"d0fae6cc-2130-4d91-bfc6-fc3a5dd778f1","requestedModel":"claude-opus-5-5","attributionSkill":"dataviz","type":"assistant","uuid":"d57ee52f-63f7-41d8-b31d-9dbd0534b8ab","timestamp":"2026-10-30T07:21:01.734Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
{"type":"file-history-delta","messageId":"d57ee52f-63f7-41d8-b31d-9dbd0534b8ab","snapshotMessageId":"fa9e06ba-ee0e-47ae-b821-eb76f7248503","trackingPath":"scripts/eval_a.py","backup":{"backupFileName":null,"version":1,"backupTime":"2026-10-30T07:21:01.758Z","realParentDir":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts"},"timestamp":"2026-10-30T07:21:01.758Z"}
{"parentUuid":"d57ee52f-63f7-41d8-b31d-9dbd0534b8ab","isSidechain":false,"promptId":"70d9dafa-1f14-4678-b8ce-ac74f472bc00","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018H4yrndiZjCkfrCoMSGnR7","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py (file state is current in your context — no need to Read it back)"}]},"uuid":"2a849f90-91f3-4332-9cd4-2c697879cbad","timestamp":"2026-10-30T07:21:01.760Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","content":"\"\"\"make eval: eval A over the archive read in Phase 2A. It writes eval/results/eval_a.json,\nand its charts and hand-judged samples to eval/results/eval_a/.\n\n1. EDA: by year, by state and by term; candidate lengths; OCR quality, as the share of words\n   /usr/share/dict/words knows; and reprint clusters among the candidates.\n2. Composition: 200 candidates at random, each put in a category by hand in\n   composition.json.\n3. Recall: 300 articles from the near-miss reservoirs and 300 from the random ones, each\n   weighted by its year's share of the pool, marked by hand in recall.json.\n\nEvery sample is seeded, so a rerun draws the same articles and keeps the judgments made.\n\"\"\"\n\nimport json\nimport random\nimport re\nimport zlib\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport zstandard\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.ingest import lexicon\nfrom paperghosts.ingest.prefilter import SAMPLE_SIZE\nfrom paperghosts.ingest.year import code_version\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"eval_a\"\nDICTIONARY = Path(\"/usr/share/dict/words\")\nOCR_ONE_IN = 20  # OCR quality is measured on one candidate in twenty, chosen by its id\nCOMPOSITION, RECALL, REPRINT_CHECK = 200, 300, 20\nCATEGORIES = (\n    \"ghost_report\",\n    \"fiction\",\n    \"religious\",\n    \"figurative\",\n    \"name_or_title\",\n    \"social_event\",\n    \"other\",\n)\nWORD = re.compile(r\"[a-z]{3,}\")\n# common endings, tried in turn when a word isn't in the list as it stands\nENDINGS = (\n    (\"ies\", \"y\"),\n    (\"ied\", \"y\"),\n    (\"ing\", \"e\"),\n    (\"ing\", \"\"),\n    (\"ed\", \"e\"),\n    (\"ed\", \"\"),\n    (\"es\", \"\"),\n    (\"s\", \"\"),\n    (\"ly\", \"\"),\n)\n# words to look around in a random-pool article, besides its opening; a guide to reading\nFLAGS = re.compile(\n    r\"\\b(?:spirit|spectral|unearthly|uncanny|weird|supernatural|seance|apparit|phantasm\"\n    r\"|spook|wraith|goblin|banshee|witch|hoodoo|voodoo|superstiti|haint|bogey|boogey\"\n    r\"|corpse|graveyard|midnight|in white|strange (?:noise|light|sound)|mysterious|knock\"\n    r\"|rapp|haunt|spectre|specter|phantom|[gq][hbk]?[o0ae][a-z]?sts?\\b)\\w*\",\n    re.IGNORECASE,\n)\n_words = None\n\n\ndef dictionary():\n    global _words\n    if _words is None:\n        _words = frozenset(w.strip().lower() for w in DICTIONARY.read_text().splitlines())\n    return _words\n\n\ndef known(word, words):\n    if word in words:\n        return True\n    return any(\n        len(word) > len(end) + 2 and word.endswith(end) and word[: -len(end)] + back in words\n        for end, back in ENDINGS\n    )\n\n\ndef ocr_quality(text, words, least=20):\n    \"\"\"The share of the article's words of three letters or more that the dictionary knows,\n    once line-break hyphens are joined and common endings come off; None under `least`.\"\"\"\n    found = WORD.findall((text or \"\").replace(\"-\\n\", \"\").lower())\n    if len(found) < least:\n        return None\n    return sum(known(word, words) for word in found) / len(found)\n\n\ndef draw(pools, sizes, n, seed):\n    \"\"\"n (year, item) pairs, each year drawn in proportion to its share of the pool across the\n    archive, so the sample stands for every article in the pool rather than for each year\n    equally. pools maps a year to its reservoir, and sizes to the pool's full size.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(year for year in pools if sizes.get(year) and pools[year])\n    wanted = Counter(rng.choices(years, weights=[sizes[year] for year in years], k=n))\n    return [\n        (year, item)\n        for year in years\n        for item in rng.sample(list(pools[year]), min(wanted[year], len(pools[year])))\n    ]\n\n\ndef uniform(counts, n, seed):\n    \"\"\"n (year, index) pairs without replacement, every candidate equally likely.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(counts)\n    picks = []\n    for left in sorted(rng.sample(range(sum(counts.values())), n)):\n        for year in years:\n            if left < counts[year]:\n                picks.append((year, left))\n                break\n            left -= counts[year]\n    return picks\n\n\ndef window(text, position, width=320):\n    start = max(0, position - width // 2)\n    return \" \".join(text[start : start + width].split())\n\n\ndef first_match(text, forms):\n    low = text.lower()\n    found = [low.find(form.lower()) for form in forms]\n    return min([p for p in found if p >= 0], default=0)\n\n\ndef year_pass(job):\n    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n    paper and opening; plus the composition picks and recall picks that fall in this year.\"\"\"\n    year, wanted, near, rand = job\n    words, docs, picked = dictionary(), [], []\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(map(json.loads, rows)):\n            text = row[\"text\"] or \"\"\n            quality = None\n            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n                quality = ocr_quality(text, words)\n            docs.append(\n                (\n                    len(text.split()),\n                    quality,\n                    tuple(keys(text)),\n                    row[\"lccn\"],\n                    row[\"article_id\"],\n                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n                )\n            )\n            if index in wanted:\n                both = f\"{row['headline'] or ''}\\n{text}\"\n                forms = [form for found in row[\"terms\"].values() for form in found]\n                picked.append(\n                    {\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"state\": row[\"state\"],\n                        \"terms\": sorted(row[\"terms\"]),\n                        \"words\": len(text.split()),\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[:200],\n                        \"context\": window(both, first_match(both, forms), 600),\n                        \"category\": None,\n                        \"note\": None,\n                    }\n                )\n    recalled = []\n    if near or rand:\n        seen = Counter()\n        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n            for row in map(json.loads, rows):\n                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n                seen[pool] += 1\n                if index not in (near if pool == \"near_miss\" else rand):\n                    continue\n                text = row[\"text\"] or \"\"\n                low = text.lower()\n                spots = [m.start() for m in FLAGS.finditer(text)]\n                spots += [low.find(t) for t in row[\"near_miss_terms\"] for t in (t[:5],)]\n                recalled.append(\n                    {\n                        \"pool\": pool,\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[:200],\n                        \"near_miss_terms\": sorted(row[\"near_miss_terms\"]),\n                        \"words\": len(text.split()),\n                        \"opening\": \" \".join(text[:420].split()),\n                        \"contexts\": [window(text, p, 300) for p in sorted(set(spots))[:4] if p >= 0],\n                        \"ghost_report\": None,\n                        \"note\": None,\n                    }\n                )\n    return year, docs, picked, recalled\n\n\ndef quantiles(values, points=(0.1, 0.25, 0.5, 0.75, 0.9, 0.99)):\n    ordered = sorted(values)\n    return {f\"p{round(q * 100)}\": ordered[round(q * (len(ordered) - 1))] for q in points}\n\n\ndef keep_judgments(path, items, key, fields):\n    \"\"\"The freshly drawn items, with any judgment already made on them carried over.\"\"\"\n    if path.exists():\n        made = {key(old): old for old in json.loads(path.read_text())}\n        for item in items:\n            for field in fields:\n                item[field] = made.get(key(item), {}).get(field)\n    path.write_text(json.dumps(items, indent=1, ensure_ascii=False) + \"\\n\")\n    return items\n\n\ndef rate(hits, n, of):\n    low, high = wilson(hits, n)\n    return {\n        \"count\": hits,\n        \"n\": n,\n        \"share\": hits / n,\n        \"low\": low,\n        \"high\": high,\n        \"implied\": round(hits / n * of),\n        \"implied_low\": round(low * of),\n        \"implied_high\": round(high * of),\n    }\n\n\ndef main():\n    from charts import draw_all  # noqa: PLC0415 (the charts are only needed here)\n\n    counts = {\n        c[\"year\"]: c for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(counts)\n    total = {k: sum(counts[y][k] for y in years) for k in (\"pages\", \"articles\", \"candidates\", \"near_miss\")}\n    others = {y: counts[y][\"articles\"] - counts[y][\"candidates\"] for y in years}\n    total[\"non_candidates\"] = sum(others.values())\n\n    composition = defaultdict(set)\n    for year, index in uniform({y: counts[y][\"candidates\"] for y in years}, COMPOSITION, \"eval A composition\"):\n        composition[year].add(index)\n    near, rand = defaultdict(set), defaultdict(set)\n    reservoirs = {y: range(min(SAMPLE_SIZE, counts[y][\"near_miss\"])) for y in years}\n    for year, index in draw(reservoirs, {y: counts[y][\"near_miss\"] for y in years}, RECALL, \"eval A recall near-miss\"):\n        near[year].add(index)\n    reservoirs = {y: range(min(SAMPLE_SIZE, others[y])) for y in years}\n    for year, index in draw(reservoirs, others, RECALL, \"eval A recall random\"):\n        rand[year].add(index)\n\n    jobs = [(y, composition[y], near[y], rand[y]) for y in years if counts[y][\"candidates\"] or near[y] or rand[y]]\n    docs, years_of, picked, recalled = [], [], [], []\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for year, found, chosen, reread in pool.map(year_pass, sorted(jobs, key=lambda job: -counts[job[0]][\"articles\"])):\n            docs += found\n            years_of += [year] * len(found)\n            picked += chosen\n            recalled += reread\n\n    lengths = [doc[0] for doc in docs]\n    qualities = [(year, doc[1]) for year, doc in zip(years_of, docs, strict=True) if doc[1] is not None]\n    groups = clusters([doc[2] for doc in docs])\n    group_sizes = sorted((len(g) for g in groups), reverse=True)\n    cross = [g for g in groups if len({docs[d][3] for d in g}) > 1]\n    rng = random.Random(\"eval A reprint check\")\n    checks = []\n    for group in rng.sample(groups, min(REPRINT_CHECK, len(groups))):\n        a, b = rng.sample(group, 2)\n        checks.append(\n            {\n                \"size\": len(group),\n                \"papers\": len({docs[d][3] for d in group}),\n                \"years\": [min(years_of[d] for d in group), max(years_of[d] for d in group)],\n                \"members\": [docs[a][4], docs[b][4]],\n                \"openings\": [docs[a][5], docs[b][5]],\n                \"same_story\": None,\n            }\n        )\n    largest = [\n        {\n            \"size\": len(g),\n            \"papers\": len({docs[d][3] for d in g}),\n            \"years\": [min(years_of[d] for d in g), max(years_of[d] for d in g)],\n            \"example\": docs[g[0]][5][:160],\n        }\n        for g in sorted(groups, key=len, reverse=True)[:10]\n    ]\n\n    OUT.mkdir(parents=True, exist_ok=True)\n    picked = keep_judgments(OUT / \"composition.json\", sorted(picked, key=lambda p: (p[\"year\"], p[\"article_id\"])), lambda p: p[\"article_id\"], (\"category\", \"note\"))\n    recalled = keep_judgments(OUT / \"recall.json\", sorted(recalled, key=lambda r: (r[\"pool\"], r[\"year\"], r[\"article_id\"])), lambda r: (r[\"pool\"], r[\"article_id\"]), (\"ghost_report\", \"note\"))\n    checks = keep_judgments(OUT / \"reprint-check.json\", checks, lambda c: tuple(c[\"members\"]), (\"same_story\",))\n\n    by_state = defaultdict(Counter)\n    for year in years:\n        for state, row in counts[year][\"by_state\"].items():\n            by_state[state].update(row)\n    terms = {term: sum(counts[y][\"by_term\"].get(term, 0) for y in years) for term in lexicon.GHOST}\n    only = {term: sum(counts[y][\"only_by_term\"].get(term, 0) for y in years) for term in lexicon.GHOST}\n    decade_quality = defaultdict(list)\n    for year, quality in qualities:\n        decade_quality[year // 10 * 10].append(quality)\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"lexicon_version\": lexicon.VERSION,\n        \"code_version\": code_version(),\n        \"totals\": {**total, \"candidates_per_million\": total[\"candidates\"] / total[\"articles\"] * 1e6},\n        \"by_year\": [\n            {\n                \"year\": y,\n                \"pages\": counts[y][\"pages\"],\n                \"articles\": counts[y][\"articles\"],\n                \"candidates\": counts[y][\"candidates\"],\n                \"near_miss\": counts[y][\"near_miss\"],\n                \"candidates_per_million\": counts[y][\"candidates\"] / counts[y][\"articles\"] * 1e6 if counts[y][\"articles\"] else 0,\n            }\n            for y in years\n        ],\n        \"by_state\": [\n            {\n                \"state\": state,\n                **row,\n                \"candidates_per_million\": row[\"candidates\"] / row[\"articles\"] * 1e6 if row[\"articles\"] else 0,\n            }\n            for state, row in sorted(by_state.items(), key=lambda kv: -kv[1][\"candidates\"])\n        ],\n        \"no_state\": {\n            \"candidates\": by_state[\"unknown\"][\"candidates\"],\n            \"share_of_candidates\": by_state[\"unknown\"][\"candidates\"] / total[\"candidates\"],\n            \"share_of_articles\": by_state[\"unknown\"][\"articles\"] / total[\"articles\"],\n        },\n        \"terms\": {\"any\": terms, \"only\": only},\n        \"lengths\": {\"unit\": \"words of the article's text\", \"mean\": sum(lengths) / len(lengths), **quantiles(lengths), \"max\": max(lengths), \"histogram\": length_histogram(lengths)},\n        \"ocr_quality\": {\n            \"method\": \"share of words of 3+ letters in /usr/share/dict/words (Webster's 2nd), once line-break hyphens are joined and -s, -es, -ed, -ing, -ly, -ies, -ied come off\",\n            \"sample\": f\"1 candidate in {OCR_ONE_IN}, by the CRC of its id: {len(qualities):,}\",\n            **quantiles([q for _, q in qualities]),\n            \"histogram\": [sum(1 for _, q in qualities if lo <= q < lo + 0.05 or (lo == 0.95 and q == 1.0)) for lo in [i / 20 for i in range(20)]],\n            \"median_by_decade\": {d: quantiles(v, (0.5,))[\"p50\"] for d, v in sorted(decade_quality.items())},\n        },\n        \"reprints\": {\n            \"method\": \"runs of 7 words of 3+ letters from each candidate's first 120, one in 8 kept by its hash; candidates sharing a run held by at most 1,000 candidates are joined\",\n            \"clusters\": len(groups),\n            \"clustered_candidates\": sum(group_sizes),\n            \"share_clustered\": sum(group_sizes) / len(docs),\n            \"distinct_stories\": len(docs) - sum(group_sizes) + len(groups),\n            \"cross_paper_clusters\": len(cross),\n            \"cross_paper_candidates\": sum(len(g) for g in cross),\n            \"size_histogram\": size_histogram(group_sizes),\n            \"largest\": largest,\n            \"check\": summarise_checks(checks),\n        },\n        \"composition\": summarise_composition(picked, total[\"candidates\"]),\n        \"recall\": summarise_recall(recalled, total),\n    }\n    (RESULTS / \"eval_a.json\").write_text(json.dumps(report, indent=1) + \"\\n\")\n    charts = draw_all(report, OUT)\n    print(f\"wrote {(RESULTS / 'eval_a.json').relative_to(ROOT)} and {len(charts)} charts in {OUT.relative_to(ROOT)}\")\n    for line in headline_numbers(report):\n        print(line)\n\n\nLENGTH_BINS = (0, 25, 50, 100, 200, 400, 800, 1600, 3200)\nSIZE_BINS = ((2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, 10**9))\n\n\ndef length_histogram(lengths):\n    edges = list(LENGTH_BINS) + [10**9]\n    return [\n        {\"from\": lo, \"to\": hi - 1 if hi < 10**9 else None, \"candidates\": sum(1 for n in lengths if lo <= n < hi)}\n        for lo, hi in zip(edges, edges[1:], strict=False)\n    ]\n\n\ndef size_histogram(sizes):\n    return [\n        {\"from\": lo, \"to\": hi if hi < 10**9 else None, \"clusters\": sum(1 for s in sizes if lo <= s <= hi), \"candidates\": sum(s for s in sizes if lo <= s <= hi)}\n        for lo, hi in SIZE_BINS\n    ]\n\n\ndef summarise_checks(checks):\n    judged = [c for c in checks if c[\"same_story\"] is not None]\n    same = sum(bool(c[\"same_story\"]) for c in judged)\n    return {\"judged\": len(judged), \"same_story\": same, **({\"low\": wilson(same, len(judged))[0], \"high\": wilson(same, len(judged))[1]} if judged else {})}\n\n\ndef summarise_composition(picked, candidates):\n    judged = [p for p in picked if p[\"category\"]]\n    out = {\"sample\": len(picked), \"judged\": len(judged), \"seed\": \"eval A composition\"}\n    if judged:\n        out[\"categories\"] = {c: rate(sum(p[\"category\"] == c for p in judged), len(judged), candidates) for c in CATEGORIES}\n    return out\n\n\ndef summarise_recall(recalled, total):\n    out = {}\n    for pool, size, seed in ((\"near_miss\", total[\"near_miss\"], \"eval A recall near-miss\"), (\"random\", total[\"non_candidates\"], \"eval A recall random\")):\n        items = [r for r in recalled if r[\"pool\"] == pool]\n        judged = [r for r in items if r[\"ghost_report\"] is not None]\n        found = [r for r in judged if r[\"ghost_report\"]]\n        out[pool] = {\"sample\": len(items), \"judged\": len(judged), \"seed\": seed, \"pool_size\": size}\n        if judged:\n            out[pool].update(rate(len(found), len(judged), size))\n            out[pool][\"reports\"] = [{k: r[k] for k in (\"article_id\", \"year\", \"date\", \"paper\", \"headline\", \"note\")} for r in found]\n    return out\n\n\ndef headline_numbers(report):\n    t = report[\"totals\"]\n    r = report[\"reprints\"]\n    yield f\"{t['articles']:,} articles in {t['pages']:,} pages; {t['candidates']:,} candidates ({t['candidates_per_million']:.0f} per million), {t['near_miss']:,} near-miss\"\n    yield f\"no state: {report['no_state']['share_of_candidates']:.1%} of candidates; median length {report['lengths']['p50']} words; median OCR quality {report['ocr_quality']['p50']:.1%}\"\n    yield f\"reprints: {r['clusters']:,} clusters hold {r['clustered_candidates']:,} candidates ({r['share_clustered']:.1%}); {r['distinct_stories']:,} distinct stories; {r['cross_paper_clusters']:,} clusters span papers\"\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"d57ee52f-63f7-41d8-b31d-9dbd0534b8ab","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
