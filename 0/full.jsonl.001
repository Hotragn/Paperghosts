{"parentUuid":"97cbb313-0fbc-45aa-b757-7b479c145e4b","isSidechain":false,"promptId":"f40c2187-e8b4-47d5-9c53-ee1f5c6e6ab4","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ZsaxXaHduH8ySGzecyCK2","type":"tool_result","content":"76\tdef bars(\n77\t    path, title, subtitle, rows, fmt, series=None, intervals=None, label_width=170\n78\t):\n79\t    \"\"\"Horizontal bars: rows of (label, value) or (label, value, second value), with an\n80\t    optional text to print after the bar, and an optional 95% interval per row as (low, high).\"\"\"\n81\t    numbers = [[v for v in row[1:] if not isinstance(v, str)] for row in rows]\n82\t    top = max(max(values) for values in numbers)\n83\t    top, step = nice(max([top] + [high for _, high in intervals or []]))\n84\t    left, right, band = 24 + label_width, WIDTH - 80, 22 if not series else 30\n85\t    y0 = 78 if series else 68\n86\t    scale = (right - left) / top\n87\t    body = []\n88\t    if series:\n89\t        for i, (name, cls) in enumerate(series):\n90\t            body += [\n91\t                f'<rect x=\"{left + i * 150}\" y=\"58\" width=\"12\" height=\"12\" rx=\"3\" class=\"{cls}\"/>',\n92\t                text(left + i * 150 + 18, 68, name, \"muted\"),\n93\t            ]\n94\t    height = y0 + band * len(rows) + 30\n95\t    for k in range(round(top / step) + 1):\n96\t        x = left + k * step * scale\n97\t        body += [\n98\t            f'<line x1=\"{x:.1f}\" x2=\"{x:.1f}\" y1=\"{y0 - 4}\" y2=\"{height - 26}\" class=\"grid\"/>',\n99\t            text(x, height - 10, fmt(k * step), \"muted\", \"middle\"),\n100\t        ]\n101\t    for n, row in enumerate(rows):\n102\t        y = y0 + n * band\n103\t        body.append(text(left - 8, y + band / 2 + 4, row[0], \"ink\", \"end\"))\n104\t        values = numbers[n]\n105\t        said = row[-1] if isinstance(row[-1], str) else \" / \".join(map(fmt, values))\n106\t        # the whole row is a hover target, so a bar of zero has a tooltip too\n107\t        body.append(\n108\t            f'<rect class=\"hit\" x=\"{left}\" y=\"{y}\" width=\"{right - left}\" height=\"{band}\"><title>{escape(f\"{row[0]}: {said}\")}</title></rect>'\n109\t        )\n110\t        thick = min(24, (band - 6) / len(values))\n111\t        for i, value in enumerate(values):\n112\t            cls = series[i][1] if series else \"s1\"\n113\t            body.append(\n114\t                hbar(\n115\t                    left,\n116\t                    y + 3 + i * (thick + 2),\n117\t                    value * scale,\n118\t                    thick,\n119\t                    cls,\n120\t                    f\"{row[0]}: {fmt(value)}\",\n121\t                )\n122\t            )\n123\t        end = max(values) * scale\n124\t        if intervals:\n125\t            low, high = intervals[n]\n126\t            yc = y + 3 + thick / 2\n127\t            body += [\n128\t                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc:.1f}\" y2=\"{yc:.1f}\" class=\"whisker\"/>',\n129\t                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + low * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n130\t                f'<line x1=\"{left + high * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n131\t            ]\n132\t            end = high * scale\n133\t        body.append(text(left + end + 6, y + band / 2 + 4, said, \"muted\"))\n134\t    path.write_text(page(height, title, subtitle, \"\".join(body), title))\n135\t    return path\n136\t\n137\t\n138\tdef columns(path, title, subtitle, rows, fmt, marker=None):\n139\t    \"\"\"Vertical columns: rows of (label, value, tooltip). marker, if given, is (index, label)\n140\t    for a hairline at a column, such as the median.\"\"\"\n141\t    left, right, base, top_y = 70, WIDTH - 24, 300, 70"}]},"uuid":"6161cf66-ffc9-4662-9802-2b01456bff0d","timestamp":"2026-10-30T07:40:51.811Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/charts.py","content":"def bars(\n    path, title, subtitle, rows, fmt, series=None, intervals=None, label_width=170\n):\n    \"\"\"Horizontal bars: rows of (label, value) or (label, value, second value), with an\n    optional text to print after the bar, and an optional 95% interval per row as (low, high).\"\"\"\n    numbers = [[v for v in row[1:] if not isinstance(v, str)] for row in rows]\n    top = max(max(values) for values in numbers)\n    top, step = nice(max([top] + [high for _, high in intervals or []]))\n    left, right, band = 24 + label_width, WIDTH - 80, 22 if not series else 30\n    y0 = 78 if series else 68\n    scale = (right - left) / top\n    body = []\n    if series:\n        for i, (name, cls) in enumerate(series):\n            body += [\n                f'<rect x=\"{left + i * 150}\" y=\"58\" width=\"12\" height=\"12\" rx=\"3\" class=\"{cls}\"/>',\n                text(left + i * 150 + 18, 68, name, \"muted\"),\n            ]\n    height = y0 + band * len(rows) + 30\n    for k in range(round(top / step) + 1):\n        x = left + k * step * scale\n        body += [\n            f'<line x1=\"{x:.1f}\" x2=\"{x:.1f}\" y1=\"{y0 - 4}\" y2=\"{height - 26}\" class=\"grid\"/>',\n            text(x, height - 10, fmt(k * step), \"muted\", \"middle\"),\n        ]\n    for n, row in enumerate(rows):\n        y = y0 + n * band\n        body.append(text(left - 8, y + band / 2 + 4, row[0], \"ink\", \"end\"))\n        values = numbers[n]\n        said = row[-1] if isinstance(row[-1], str) else \" / \".join(map(fmt, values))\n        # the whole row is a hover target, so a bar of zero has a tooltip too\n        body.append(\n            f'<rect class=\"hit\" x=\"{left}\" y=\"{y}\" width=\"{right - left}\" height=\"{band}\"><title>{escape(f\"{row[0]}: {said}\")}</title></rect>'\n        )\n        thick = min(24, (band - 6) / len(values))\n        for i, value in enumerate(values):\n            cls = series[i][1] if series else \"s1\"\n            body.append(\n                hbar(\n                    left,\n                    y + 3 + i * (thick + 2),\n                    value * scale,\n                    thick,\n                    cls,\n                    f\"{row[0]}: {fmt(value)}\",\n                )\n            )\n        end = max(values) * scale\n        if intervals:\n            low, high = intervals[n]\n            yc = y + 3 + thick / 2\n            body += [\n                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc:.1f}\" y2=\"{yc:.1f}\" class=\"whisker\"/>',\n                f'<line x1=\"{left + low * scale:.1f}\" x2=\"{left + low * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n                f'<line x1=\"{left + high * scale:.1f}\" x2=\"{left + high * scale:.1f}\" y1=\"{yc - 5:.1f}\" y2=\"{yc + 5:.1f}\" class=\"whisker\"/>',\n            ]\n            end = high * scale\n        body.append(text(left + end + 6, y + band / 2 + 4, said, \"muted\"))\n    path.write_text(page(height, title, subtitle, \"\".join(body), title))\n    return path\n\n\ndef columns(path, title, subtitle, rows, fmt, marker=None):\n    \"\"\"Vertical columns: rows of (label, value, tooltip). marker, if given, is (index, label)\n    for a hairline at a column, such as the median.\"\"\"\n    left, right, base, top_y = 70, WIDTH - 24, 300, 70","numLines":66,"startLine":76,"totalLines":363}},"sourceToolAssistantUUID":"97cbb313-0fbc-45aa-b757-7b479c145e4b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
