 fix change? compare against the committed parser\nold = subprocess.run([\"git\", \"show\", \"HEAD:paperghosts/geo/titles.py\"], capture_output=True, text=True).stdout\nns = {}\nexec(compile(old, \"old_titles\", \"exec\"), ns)\npapers = sorted({p for e in t.values() for p in e[\"papers\"] if p and p != \"null\"})\nchanged = [p for p in papers if ns[\"parse_title\"](p) != parse_title(p)]\nprint(\"title strings the fix changes:\", len(changed))\nfor p in changed: print(\"  \", p, \"\\n     ->\", {k: v for k, v in parse_title(p).items() if ns[\"parse_title\"](p)[k] != v})\nPY","description":"Rerun the title tests and list every title the fix changes"},"caller":{"type":"direct"}}]}}
