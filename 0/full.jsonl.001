\"] == c for p in judged), len(judged), candidates)\n531\t            | {\n532\t                \"stories\": round(\n533\t                    sum(1 / p[\"printings\"] for p in judged if p[\"category\"] == c)\n534\t                    / len(judged)\n535\t                    * candidates\n536\t                )\n537\t            }\n538\t            for c in CATEGORIES\n539\t        }\n540\t    return out\n541\t\n542\t\n543\tdef summarise_recall(recalled, total):\n544\t    out = {}\n545\t    for pool, size, seed in (\n546\t        (\"near_miss\", total[\"near_miss\"], \"eval A recall near-miss\"),\n547\t        (\"random\", total[\"non_candidates\"], \"eval A recall random\"),\n548\t    ):\n549\t        items = [r for r in recalled if r[\"pool\"] == pool]\n550\t        judged = [r for r in items if r[\"ghost_report\"] is not None]\n551\t        found = [r for r in judged if r[\"ghost_report\"]]\n552\t        out[pool] = {\n553\t            \"sample\": len(items),\n554\t            \"judged\": len(judged),\n555\t            \"seed\": seed,\n556\t            \"pool_size\": size,\n557\t        }\n558\t        if judged:\n559\t            out[pool].update(rate(len(found), len(judged), size))\n560\t            out[pool][\"reports\"] = [\n561\t                {\n562\t                    k: r[k]\n563\t                    for k in (\"article_id\", \"year\", \"date\", \"paper\", \"headline\", \"note\")\n564\t                }\n565\t                for r in found\n566\t            ]\n567\t    return out\n568\t\n569\t\n570\tdef headline_numbers(report):\n571\t    t = report[\"totals\"]\n572\t    r = report[\"reprints\"]\n573\t    yield f\"{t['articles']:,} articles in {t['pages']:,} pages; {t['candidates']:,} candidates ({t['candidates_per_million']:.0f} per million), {t['near_miss']:,} near-miss\"\n574\t    yield f\"no state: {report['no_state']['share_of_candidates']:.1%} of candidates; median length {report['lengths']['p50']} words; median OCR quality {report['ocr_quality']['p