onAction\": \"error\"}\n\n# no category field (outcome, kind, place type, precision, decade, state) gets an index of its\n# own: the Search and Vector Search indexes filter on them (decision 32, rule 4)\nINDEXES = {\n    \"reports\": [\n        IndexModel([(\"location\", \"2dsphere\")], name=\"location\"),\n        IndexModel([(\"place_id\", ASCENDING), (\"date\", ASCENDING)], name=\"place_id_date\"),\n        IndexModel([(\"month_day\", ASCENDING)], name=\"month_day\"),\n        # only the 30-60 investigated stories have a case\n        IndexModel(\n            [(\"case_id\", ASCENDING)],\n            name=\"case_id\",\n            unique=True,\n            partialFilterExpression={\"case_id\": {\"$exists\": True}},\n        ),\n    ],\n    \"places\": [IndexModel([(\"location\", \"2dsphere\")], name=\"location\")],\n    \"cases\": [IndexModel([(\"report_id\", ASCENDING)], name=\"report_id\", unique=True)],\n    \"stats\": [],\n}\n\n\ndef value(kind):\n    \"\"\"A reader field, by its value alone: never its quote.\"\"\"\n    return {\"type\": \"document\", \"fields\": {\"value\": {\"type\": kind}}}\n\n\n# static mappings of what is searched or filtered, and nothing else (decision 32, rule 5);\n# three in all, M0's cap\nSEARCH = {\n    \"reports\": [\n        SearchIndexModel(\n            {\n                \"mappings\": {\n                    \"dynamic\": False,\n                    \"fields\": {\n                        \"headline\": {\"type\": \"string\"},\n                        \"display_headline\": {\"type\": \"string\"},\n                        \"text\": {\"type\": \"string\"},\n                        \"town\": {\"type\": \"string\"},\n                        \"state\": {\"type\": \"token\"},\n                        \"decade\": {\"type\": \"number\"},\n                        \"fields\": {\n                            \"type\": \"document\",\n                            \"fields\": {\n                                \"place\": value(\"string\"),\n                                \"people\": value(\"string\"),\n                                \"seen\": value(\"string\"),\n                                \"specific_place\": value(\"string\"),\n                                \"outcome\": value(\"token\"),\n                                \"place_type\": value(\"token\"),\n                                \"precision\": value(\"token\"),\n                            },\n                        },\n                    },\n                }\n            },\n            name=\"reports_search\",\n            type=\"search\",\n        ),\n        SearchIndexModel(\n            {\n                \"fields\": [\n                    {\n                        \"type\": \"vector\",\n                        \"path\": \"embedding\",\n                        \"numDimensions\": DIMENSIONS,\n                        \"similarity\": \"cosine\",\n                    },\n                    {\"type\": \"filter\", \"path\": \"state\"},\n                    {\"type\": \"filter\", \"path\": \"decade\"},\n                ]\n            },\n            name=\"reports_vector\",\n            type=\"vectorSearch\",\n        ),\n    ],\n    \"places\": [\n        SearchIndexModel(\n            {\n                \"mappings\": {\n                    \"dynamic\": False,\n                    \"fields\": {\n                        \"name\": [{\"type\": \"autocomplete\"}, {\"type\": \"string\"}],\n                        \"alternate_names\": {\"type\": \"autocomplete\"},\n                        \"state\": {\"type\": \"token\"},\n                    },\n                }\n            },\n            name=\"places_search\",\n            type=\"search\",\n        ),\n    ],\n}\n\n\ndef same_index(current, spec):\n    \"\"\"Whether an index from index_information() is the one spec describes.\"\"\"\n    options = {k: v for k, v in spec.items() if k not in (\"key\", \"name\")}\n    return list(current[\"key\"]) == list(spec[\"key\"].items()) and all(\n        current.get(k) == v for k, v in options.items()\n    )\n\n\ndef init(db):\n    \"\"\"Brings db to the plan, and returns what it changed: nothing, once it matches.\"\"\"\n    changes = []\n    existing = {c[\"name\"]: c.get(\"options\", {}) for c in db.list_collections()}\n    for name, model in COLLECTIONS.items():\n        wanted = {\"validator\": validator(model), **STRICT}\n        if name not in existing:\n            db.create_collection(name, **wanted)\n            changes.append(f\"created collection {name}\")\n        elif {k: existing[name].get(k) for k in wanted} != wanted:\n            db.command(\"collMod\", name, **wanted)\n            changes.append(f\"updated the validator of {name}\")\n        collection = db[name]\n        searches = {index[\"name\"]: index for index in collection.list_search_indexes()}\n        for search in SEARCH.get(name, []):\n            spec = search.document\n            current = searches.get(spec[\"name\"])\n            if current is None:\n                collection.create_search_index(search)\n                changes.append(f\"created search index {name}.{spec['name']}\")\n            elif current.get(\"latestDefinition\") != spec[\"definition\"]:\n                collection.update_search_index(spec[\"name\"], spec[\"definition\"])\n                changes.append(f\"updated search index {name}.{spec['name']}\")\n        have = collection.index_information()\n        for index in INDEXES[name]:\n            spec = index.document\n            current = have.get(spec[\"name\"])\n            if current is not None and same_index(current, spec):\n                continue\n            if current is not None:\n                collection.drop_index(spec[\"name\"])\n            collection.create_indexes([index])\n            done = \"rebuilt\" if current is not None else \"created\"\n            changes.append(f\"{done} index {name}.{spec['name']}\")\n    return changes\n\n\ndef main():\n    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:\n        db = client[DATABASE]\n        changes = init(db)\n        print(\"\\n\".join(changes) if changes else \"nothing to change\")\n        for name in SEARCH:\n            for index in db[name].list_search_indexes():\n                ready = \"queryable\" if index.get(\"queryable\") else \"not queryable yet\"\n                print(f\"search index {name}.{index['name']}: {index.get('status')}, {ready}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":118,"oldLines":8,"newStart":118,"newLines":9,"lines":[" "," "," def init(db):","-    \"\"\"Brings db to the plan, and returns what it changed: nothing, once it matches.\"\"\"","-    changes = []","+    \"\"\"Brings db to the plan. Returns what it changed (nothing, once it matches), and the","+    Search indexes it couldn't create because the cluster already holds M0's cap of three.\"\"\"","+    changes, blocked = [], []","     existing = {c[\"name\"]: c.get(\"options\", {}) for c in db.list_collections()}","     for name, model in COLLECTIONS.items():","         wanted = {\"validator\": validator(model), **STRICT}"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"e271364c-04f6-44f2-a1aa-0126ae77cd57","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"parentUuid":"7095da35-ae43-48a5-a2f5-e1e16b409ea8","isSidechain":false,"promptId":"cfc7125e-bacb-48e4-917e-c396bc7253de","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WvENHrvvm7cLtgD18gGqrF","type":"tool_result","content":"The file /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/paperghosts/store/db_init.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"b129b307-3c19-4419-b2e8-a5450bae22bf","timestamp":"2026-10-30T17:43:13.063Z","toolUseResult":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/paperghosts/store/db_init.py","oldString":"            if current is None:\n                collection.create_search_index(search)\n                changes.append(f\"created search index {name}.{spec['name']}\")","newString":"            if current is None:\n                try:\n                    collection.create_search_index(search)\n                except OperationFailure as exc:\n                    # the cap counts every database's Search indexes, not just ours\n                    if CAP not in str(exc):\n                        raise\n                    blocked.append(f\"{name}.{spec['name']}\")\n                    continue\n                changes.append(f\"created search index {name}.{spec['name']}\")","originalFile":"\"\"\"make db-init: the paperghosts database's collections, validators, indexes and Search indexes,\nas ARCHITECTURE section 4 and decision 32 plan them. A second run changes nothing. It touches no\nother database, and no collection outside the plan.\"\"\"\n\nfrom pymongo import ASCENDING, MongoClient\nfrom pymongo.errors import OperationFailure\nfrom pymongo.operations import IndexModel, SearchIndexModel\n\nfrom paperghosts.config import setting\nfrom paperghosts.schemas import DIMENSIONS, Case, Place, Report, Stat\nfrom paperghosts.store.validators import validator\n\nDATABASE = \"paperghosts\"\nCOLLECTIONS = {\"reports\": Report, \"places\": Place, \"cases\": Case, \"stats\": Stat}\nSTRICT = {\"validationLevel\": \"strict\", \"validationAction\": \"error\"}\n\n# no category field (outcome, kind, place type, precision, decade, state) gets an index of its\n# own: the Search and Vector Search indexes filter on them (decision 32, rule 4)\nINDEXES = {\n    \"reports\": [\n        IndexModel([(\"location\", \"2dsphere\")], name=\"location\"),\n        IndexModel([(\"place_id\", ASCENDING), (\"date\", ASCENDING)], name=\"place_id_date\"),\n        IndexModel([(\"month_day\", ASCENDING)], name=\"month_day\"),\n        # only the 30-60 investigated stories have a case\n        IndexModel(\n            [(\"case_id\", ASCENDING)],\n            name=\"case_id\",\n            unique=True,\n            partialFilterExpression={\"case_id\": {\"$exists\": True}},\n        ),\n    ],\n    \"places\": [IndexModel([(\"location\", \"2dsphere\")], name=\"location\")],\n    \"cases\": [IndexModel([(\"report_id\", ASCENDING)], name=\"report_id\", unique=True)],\n    \"stats\": [],\n}\n\n\ndef value(kind):\n    \"\"\"A reader field, by its value alone: never its quote.\"\"\"\n    return {\"type\": \"document\", \"fields\": {\"value\": {\"type\": kind}}}\n\n\n# static mappings of what is searched or filtered, and nothing else (decision 32, rule 5);\n# three in all, M0's cap\nSEARCH = {\n    \"reports\": [\n        SearchIndexModel(\n            {\n                \"mappings\": {\n                    \"dynamic\": False,\n                    \"fields\": {\n                        \"headline\": {\"type\": \"string\"},\n                        \"display_headline\": {\"type\": \"string\"},\n                        \"text\": {\"type\": \"string\"},\n                        \"town\": {\"type\": \"string\"},\n                        \"state\": {\"type\": \"token\"},\n                        \"decade\": {\"type\": \"number\"},\n                        \"fields\": {\n                            \"type\": \"document\",\n                            \"fields\": {\n                                \"place\": value(\"string\"),\n                                \"people\": value(\"string\"),\n                                \"seen\": value(\"string\"),\n                                \"specific_place\": value(\"string\"),\n                                \"outcome\": value(\"token\"),\n                                \"place_type\": value(\"token\"),\n                                \"precision\": value(\"token\"),\n                            },\n                        },\n                    },\n                }\n            },\n            name=\"reports_search\",\n            type=\"search\",\n        ),\n        SearchIndexModel(\n            {\n                \"fields\": [\n                    {\n                        \"type\": \"vector\",\n                        \"path\": \"embedding\",\n                        \"numDimensions\": DIMENSIONS,\n                        \"similarity\": \"cosine\",\n                    },\n                    {\"type\": \"filter\", \"path\": \"state\"},\n                    {\"type\": \"filter\", \"path\": \"decade\"},\n                ]\n            },\n            name=\"reports_vector\",\n            type=\"vectorSearch\",\n        ),\n    ],\n    \"places\": [\n        SearchIndexModel(\n            {\n                \"mappings\": {\n                    \"dynamic\": False,\n                    \"fields\": {\n                        \"name\": [{\"type\": \"autocomplete\"}, {\"type\": \"string\"}],\n                        \"alternate_names\": {\"type\": \"autocomplete\"},\n                        \"state\": {\"type\": \"token\"},\n                    },\n                }\n            },\n            name=\"places_search\",\n            type=\"search\",\n        ),\n    ],\n}\n\n\ndef same_index(current, spec):\n    \"\"\"Whether an index from index_information() is the one spec describes.\"\"\"\n    options = {k: v for k, v in spec.items() if k not in (\"key\", \"name\")}\n    return list(current[\"key\"]) == list(spec[\"key\"].items()) and all(\n        current.get(k) == v for k, v in options.items()\n    )\n\n\ndef init(db):\n    \"\"\"Brings db to the plan. Returns what it changed (nothing, once it matches), and the\n    Search indexes it couldn't create because the cluster already holds M0's cap of three.\"\"\"\n    changes, blocked = [], []\n    existing = {c[\"name\"]: c.get(\"options\", {}) for c in db.list_collections()}\n    for name, model in COLLECTIONS.items():\n        wanted = {\"validator\": validator(model), **STRICT}\n        if name not in existing:\n            db.create_collection(name, **wanted)\n            changes.append(f\"created collection {name}\")\n        elif {k: existing[name].get(k) for k in wanted} != wanted:\n            db.command(\"collMod\", name, **wanted)\n            changes.append(f\"updated the validator of {name}\")\n        collection = db[name]\n        searches = {index[\"name\"]: index for index in collection.list_search_indexes()}\n        for search in SEARCH.get(name, []):\n            spec = search.document\n            current = searches.get(spec[\"name\"])\n            if current is None:\n                collection.create_search_index(search)\n                changes.append(f\"created search index {name}.{spec['name']}\")\n            elif current.get(\"latestDefinition\") != spec[\"definition\"]:\n                collection.update_search_index(spec[\"name\"], spec[\"definition\"])\n                changes.append(f\"updated search index {name}.{spec['name']}\")\n        have = collection.index_information()\n        for index in INDEXES[name]:\n            spec = index.document\n            current = have.get(spec[\"name\"])\n            if current is not None and same_index(current, spec):\n                continue\n            if current is not None:\n                collection.drop_index(spec[\"name\"])\n            collection.create_indexes([index])\n            done = \"rebuilt\" if current is not None else \"created\"\n            changes.append(f\"{done} index {name}.{spec['name']}\")\n    return changes\n\n\ndef main():\n    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:\n        db = client[DATABASE]\n        changes = init(db)\n        print(\"\\n\".join(changes) if changes else \"nothing to change\")\n        for name in SEARCH:\n            for index in db[name].list_search_indexes():\n                ready = \"queryable\" if index.get(\"queryable\") else \"not queryable yet\"\n                print(f\"search index {name}.{index['name']}: {index.get('status')}, {ready}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":136,"oldLines":7,"newStart":136,"newLines":14,"lines":["             spec = search.document","             current = searches.get(spec[\"name\"])","             if current is None:","-                collection.create_search_index(search)","+                try:","+                    collection.create_search_index(search)","+                except OperationFailure as exc:","+                    # the cap counts every database's Search indexes, not just ours","+                    if CAP not in str(exc):","+                        raise","+                    blocked.append(f\"{name}.{spec['name']}\")","+                    continue","                 changes.append(f\"created search index {name}.{spec['name']}\")","             elif current.get(\"latestDefinition\") != spec[\"definition\"]:","                 collection.update_search_index(spec[\"name\"], spec[\"definition\"])"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"7095da35-ae43-48a5-a2f5-e1e16b409ea8","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
