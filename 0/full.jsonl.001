":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"parentUuid":"41f47f67-0efd-41c0-8b56-87d80a63616e","isSidechain":false,"promptId":"5cdf18f0-2d85-4e56-b04c-ea94ad2b37e1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LbB8vpuenXRucn6iFk1hwR","type":"tool_result","content":"1\t\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents for a seeded\n2\t1,000 of lexicon v2's candidates, with their real text, their reprint clusters' printings, a\n3\tBinData embedding, and reader fields whose quotes are real sentences of the article.\n4\t\n5\t1. The BSON bytes of each document, with each of rule 6's levers on and off.\n6\t2. Atlas's own data and index sizes, with the documents loaded into `reports` 500 at a time\n7\t   past its validator. Every probe document is deleted afterwards.\n8\t3. Each database's use of M0's storage, data size plus index size as Atlas counts it.\n9\t\n10\tWrites eval/results/phase2b/budget.json; Docs/BUDGET.md reads it.\"\"\"\n11\t\n12\timport json\n13\timport random\n14\timport re\n15\timport statistics\n16\timport time\n17\tfrom collections import defaultdict\n18\tfrom concurrent.futures import ProcessPoolExecutor\n19\tfrom datetime import UTC, datetime\n20\tfrom pathlib import Path\n21\t\n22\timport bson\n23\timport numpy as np\n24\timport zstandard\n25\tfrom bson.binary import Binary, BinaryVectorDtype\n26\tfrom pymongo import MongoClient\n27\t\n28\tfrom paperghosts.cluster.reprints import clusters, keys\n29\tfrom paperghosts.config import setting\n30\tfrom paperghosts.ingest.crops import crop_urls\n31\tfrom paperghosts.ingest.headline import display_headline\n32\tfrom paperghosts.schemas import DIMENSIONS, Report\n33\tfrom paperghosts.store.printings import printing\n34\t\n35\tROOT = Path(__file__).parents[1]\n36\tDATA = ROOT / \"data\"\n37\tOUT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"budget.json\"\n38\tSEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500\n39\tSETTLE = (\n40\t    75  # seconds for WiredTiger's checkpoint, once a minute, to count new index pages\n41\t)\n42\tCODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length\n43\tOUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]\n44\tPLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]\n45\t\n46\t\n47\tdef year_keys(year):\n48\t    \"\"\"Each candidate's reprint keys, in file order, as eval A takes them.\"\"\"\n49\t    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n50\t        return year, [tuple(keys(json.loads(row)[\"text\"])) for row in rows]\n51\t\n52\t\n53\tdef year_rows(job):\n54\t    year, wanted = job\n55\t    found = {}\n56\t    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n57\t        for index, row in enumerate(rows):\n58\t            if index in wanted:\n59\t                found[index] = json.loads(row)\n60\t    return year, found\n61\t\n62\t\n63\tdef sentences(text):\n64\t    flat = \" \".join((text or \"\").replace(\"-\\n\", \"\").split())\n65\t    return [s for s in re.split(r\"(?<=[.!?])\\s+\", flat) if len(s) >= 30] or [flat[:200]]\n66\t\n67\t\n68\tdef quote(sentence, most=200):\n69\t    \"\"\"A verbatim span, as the reader quotes one: a sentence, cut at a word under `most`.\"\"\"\n70\t    return sentence if len(sentence) <= most else sentence[:most].rsplit(\" \", 1)[0]\n71\t\n72\t\n73\tdef stated(rng, said, value=None):\n74\t    sentence = rng.choice(said)\n75\t    if value is None:\n76\t        words = sentence.split()\n77\t        start = rng.randrange(max(1, len(words) - 6))\n78\t        value = \" \".join(words[start : start + rng.randint(3, 6)])\n79\t    return {\n80\t        \"value\": value,\n81\t        \"quote\": quote(sentence),\n82\t        \"verified\": True,\n83\t        \"score\": round(rng.random(), 3),\n84\t    }\n85\t\n86\t\n87\tdef name(rng, said, words):\n88\t    \"\"\"A run of capitalized words from the text, as a place or a person reads.\"\"\"\n89\t    runs = re.findall(\n90\t        rf\"\\b[A-Z][a-z]{{2,}}(?: [A-Z][a-z]{{2,}}){{{words - 1}}}\\b\", \" \".join(said)\n91\t    )\n92\t    return rng.choice(runs) if runs else rng.choice(\" \".join(said).split()[:8] or [\"?\"])\n93\t\n94\t\n95\tdef story(rng, members):\n96\t    \"\"\"A full reports document for one cluster's printings, primary first: the earliest.\"\"\"\n97\t    members = sorted(members, key=lambda row: (row[\"date\"], row[\"article_id\"]))\n98\t    primary = members[0]\n99\t    said = sentences(primary[\"text\"])\n100\t    town = name(rng, said, 1)\n101\t    people = [\n102\t        stated(rng, said, name(rng, said, 2))\n103\t        for _ in range(rng.choice([0, 0, 1, 1, 2, 3]))\n104\t    ]\n105\t    vector = np.random.default_rng(rng.randrange(2**32)).normal(size=DIMENSIONS)\n106\t    year = int(primary[\"date\"][:4])\n107\t    doc = {\n108\t        \"_id\": f\"r_{primary['article_id']}\",\n109\t        \"primary_article_id\": primary[\"article_id\"],\n110\t        \"printings\": [printing(row) for row in members],\n111\t        \"headline\": primary[\"headline\"] or \"\",\n112\t        \"text\": primary[\"text\"] or \"\",\n113\t        \"display_headline\": display_headline(\n114\t            primary[\"headline\"] or \"\", primary[\"paper\"], primary[\"date\"]\n115\t        ),\n116\t        \"date\": primary[\"date\"],\n117\t        \"year\": year,\n118\t        \"month_day\": primary[\"date\"][5:],\n119\t        \"decade\": year // 10 * 10,\n120\t        \"kind\": \"report\",\n121\t        \"fields\": {\n122\t            \"place\": stated(rng, said, town),\n123\t            \"people\": people,\n124\t            \"seen\": stated(rng, said),\n125\t            \"outcome\": stated(rng, said, rng.choice(OUTCOMES)),\n126\t            \"specific_place\": stated(rng, said),\n127\t            \"place_type\": stated(rng, said, rng.choice(PLACE_TYPES)),\n128\t            \"precision\": stated(rng, said, \"town\"),\n129\t        },\n130\t        \"location\": {\n131\t            \"type\": \"Point\",\n132\t            \"coordinates\": [\n133\t                round(rng.uniform(-124, -67), 6),\n134\t                round(rng.uniform(25, 49), 6),\n135\t            ],\n136\t        },\n137\t        \"location_precision\": \"town\",\n138\t        \"location_source\": f\"geonames:{rng.randrange(4_000_000, 6_000_000)}\",\n139\t        \"place_id\": rng.randrange(4_000_000, 6_000_000),\n140\t        \"town\": town,\n141\t        \"state\": primary[\"state\"],\n142\t        \"embedding\": Binary.from_vector(vector.tolist(), BinaryVectorDtype.FLOAT32),\n143\t        \"versions\": {\n144\t            \"code\": CODE,\n145\t            \"lexicon\": \"v2\",\n146\t            \"model\": \"Qwen/Qwen3.5-4B\",\n147\t            \"adapter\": \"paperghosts-reader-lora-v1\",\n148\t            \"prompt\": \"reader-v1\",\n149\t        },\n150\t        \"lexicon_terms\": sorted(primary[\"terms\"]),\n151\t    }\n152\t    return Report.model_validate(doc).model_dump(\n153\t        by_alias=True, exclude_none=True\n154\t    ), members\n155\t\n156\t\n157\tdef levers(doc, members, vector):\n158\t    \"\"\"The document with each of rule 6's levers turned off, and with all of them off.\"\"\"\n159\t    texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}\n160\t\n161\t    def crops(p):\n162\t        service = p.get(\"service\")\n163\t        if service is None:  # its service would be looked up: one of the usual length\n164\t            where = f\"{p['lccn']}:{p['reel']}:{p['issue']}:{p['frame']}\"\n165\t            service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{where}\"\n166\t        return crop_urls(service, p[\"bbox_list\"])\n167\t\n168\t    stored_crops = [p | {\"crop_urls\": crops(p)} for p in doc[\"printings\"]]\n169\t    with_text = [p | {\"text\": texts[p[\"article_id\"]]} for p in doc[\"printings\"]]\n170\t    doubles = vector.as_vector().data\n171\t    return {\n172\t        \"all levers on (float32)\": doc,\n173\t        \"int8 embedding\": doc | {\"embedding\": int8(doubles)},\n174\t        \"embedding as an array of doubles\": doc\n175\t        | {\"embedding\": [float(x) for x in doubles]},\n176\t        \"crop URLs stored\": doc | {\"printings\": stored_crops},\n177\t        \"printings with their own text\": doc | {\"printings\": with_text},\n178\t        \"all levers off\": doc\n179\t        | {\n180\t            \"embedding\": [float(x) for x in doubles],\n181\t            \"printings\": [\n182\t                c | {\"text\": t[\"text\"]}\n183\t                for c, t in zip(stored_crops, with_text, strict=True)\n184\t            ],\n185\t        },\n186\t    }\n187\t\n188\t\n189\tdef int8(values):\n190\t    v = np.asarray(values)\n191\t    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)\n192\t    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)\n193\t\n194\t\n195\tdef summary(sizes):\n196\t    ordered = sorted(sizes)\n197\t    return {\n198\t        \"total\": sum(ordered),\n199\t        \"mean\": round(statistics.fmean(ordered), 1),\n200\t        \"median\": statistics.median(ordered),\n201\t        \"p90\": ordered[int(0.9 * (len(ordered) - 1))],\n202\t        \"max\": ordered[-1],\n203\t    }\n204\t\n205\t\n206\tdef size(value):\n207\t    return len(bson.encode({\"v\": value})) - len(bson.encode({}))\n208\t\n209\t\n210\tdef settled(collection, db):\n211\t    time.sleep(SETTLE)\n212\t    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))[\n213\t        \"storageStats\"\n214\t    ]\n215\t    whole = db.command(\"dbStats\")\n216\t    return {\n217\t        \"count\": stats[\"count\"],\n218\t        \"data_bytes\": stats[\"size\"],\n219\t        \"storage_bytes\": stats[\"storageSize\"],\n220\t        \"index_bytes\": stats[\"totalIndexSize\"],\n221\t        \"index_bytes_by_index\": stats[\"indexSizes\"],\n222\t        \"database\": {k: whole[k] for k in (\"dataSize\", \"storageSize\", \"indexSize\")},\n223\t    }\n224\t\n225\t\n226\tdef main():\n227\t    counts = {\n228\t        c[\"year\"]: c[\"candidates\"]\n229\t        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n230\t    }\n231\t    years = sorted(y for y in counts if counts[y])\n232\t    starts, total = {}, 0\n233\t    for year in years:\n234\t        starts[year], total = total, total + counts[year]\n235\t    rng = random.Random(SEED)\n236\t    picks = sorted(rng.sample(range(total), PICKS))\n237\t\n238\t    with ProcessPoolExecutor(max_workers=6) as pool:\n239\t        held = dict(pool.map(year_keys, years))\n240\t    doc_keys = [k for year in years for k in held.pop(year)]\n241\t    assert len(doc_keys) == total\n242\t    group_of = {}\n243\t    for group in clusters(doc_keys, least=2):\n244\t        for doc in group:\n245\t            group_of[doc] = group\n246\t    del doc_keys\n247\t    groups, seen = [], set()\n248\t    for pick in picks:\n249\t        group = tuple(group_of.get(pick, (pick,)))\n250\t        if group not in seen:  # two picks from one cluster are one story\n251\t            seen.add(group)\n252\t            groups.append(group)\n253\t    wanted = defaultdict(set)\n254\t    year_of = {}\n255\t    for group in groups:\n256\t        for doc in group:\n257\t            year = max(y for y in years if starts[y] <= doc)\n258\t            wanted[year].add(doc - starts[year])\n259\t            year_of[doc] = year\n260\t    with ProcessPoolExecutor(max_workers=6) as pool:\n261\t        rows = {\n262\t            starts[year] + index: row\n263\t            for year, found in pool.map(year_rows, wanted.items())\n264\t            for index, row in found.items()\n265\t        }\n266\t\n267\t    stories, variants, parts = [], defaultdict(list), defaultdict(list)\n268\t    alone, each = defaultdict(list), defaultdict(list)\n269\t    for group in groups:\n270\t        doc, members = story(rng, [rows[d] for d in group])\n271\t        stories.append(doc)\n272\t        for label, variant in levers(doc, members, doc[\"embedding\"]).items():\n273\t            variants[label].append(len(bson.encode(variant)))\n274\t            # a story's bytes, as the story itself and so much per printing\n275\t            alone[label].append(len(bson.encode(variant | {\"printings\": []})))\n276\t            each[label] += [size(p) for p in variant[\"printings\"]]\n277\t        parts[\"text, headline and display headline\"].append(\n278\t            size(doc[\"text\"]) + size(doc[\"headline\"]) + size(doc[\"display_headline\"])\n279\t        )\n280\t        parts[\"reader fields\"].append(size(doc[\"fields\"]))\n281\t        parts[\"embedding (float32)\"].append(size(doc[\"embedding\"]))\n282\t        parts[\"printings\"].append(size(doc[\"printings\"]))\n283\t        parts[\"each printing\"] += [size(p) for p in doc[\"printings\"]]\n284\t    printings = [len(doc[\"printings\"]) for doc in stories]\n285\t    report = {\n286\t        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n287\t        \"seed\": SEED,\n288\t        \"candidates_drawn\": PICKS,\n289\t        \"of_candidates\": total,\n290\t        \"stories\": len(stories),\n291\t        \"printings\": {\n292\t            \"total\": sum(printings),\n293\t            \"stories_with_more_than_one\": sum(n > 1 for n in printings),\n294\t            \"most\": max(printings),\n295\t        },\n296\t        \"bson_bytes\": {label: summary(sizes) for label, sizes in variants.items()},\n297\t        \"bson_bytes_of_parts\": {\n298\t            label: summary(sizes) for label, sizes in parts.items()\n299\t        },\n300\t        \"bson_bytes_per\": {\n301\t            label: {\n302\t                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),\n303\t                \"printing\": round(statistics.fmean(each[label]), 1),\n304\t            }\n305\t            for label in variants\n306\t        },\n307\t    }\n308\t\n309\t    with MongoClient(\n310\t        setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000\n311\t    ) as client:\n312\t        db = client[\"paperghosts\"]\n313\t        reports = db[\"reports\"]\n314\t        assert reports.estimated_document_count() == 0, (\n315\t            \"reports already holds documents\"\n316\t        )\n317\t        ids = [doc[\"_id\"] for doc in stories]\n318\t        atlas = {\"empty\": settled(reports, db)}\n319\t        try:\n320\t            for start in range(0, len(stories), BATCH):\n321\t                reports.insert_many(stories[start : start + BATCH], ordered=False)\n322\t                atlas[f\"after {min(start + BATCH, len(stories))}\"] = settled(\n323\t                    reports, db\n324\t                )\n325\t        finally:\n326\t            deleted = reports.delete_many({\"_id\": {\"$in\": ids}}).deleted_count\n327\t            report[\"cleaned_up\"] = {\n328\t                \"deleted\": deleted,\n329\t                \"left_in_reports\": reports.count_documents({}),\n330\t            }\n331\t        report[\"atlas\"] = atlas\n332\t        report[\"storage_by_database\"] = {\n333\t            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}\n334\t            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}\n335\t            for name in client.list_database_names()\n336\t            if name not in (\"admin\", \"local\")\n337\t            for s in [client[name].command(\"dbStats\")]\n338\t        }\n339\t    OUT.parent.mkdir(parents=True, exist_ok=True)\n340\t    OUT.write_text(json.dumps(report, indent=1) + \"\\n\")\n341\t    base = report[\"bson_bytes\"][\"all levers on (float32)\"]\n342\t    print(\n343\t        f\"{len(stories)} stories, {sum(printings)} printings; BSON mean {base['mean']:,} bytes, \"\n344\t        f\"median {base['median']:,}; deleted {deleted}\"\n345\t    )\n346\t    print(f\"wrote {OUT.relative_to(ROOT)}\")\n347\t\n348\t\n349\tif __name__ == \"__main__\":\n350\t    main()\n351\t"}]},"uuid":"a9f3222b-eaa3-45d9-a757-f85081105f86","timestamp":"2026-10-30T18:07:03.940Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py","content":"\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents for a seeded\n1,000 of lexicon v2's candidates, with their real text, their reprint clusters' printings, a\nBinData embedding, and reader fields whose quotes are real sentences of the article.\n\n1. The BSON bytes of each document, with each of rule 6's levers on and off.\n2. Atlas's own data and index sizes, with the documents loaded into `reports` 500 at a time\n   past its validator. Every probe document is deleted afterwards.\n3. Each database's use of M0's storage, data size plus index size as Atlas counts it.\n\nWrites eval/results/phase2b/budget.json; Docs/BUDGET.md reads it.\"\"\"\n\nimport json\nimport random\nimport re\nimport statistics\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport bson\nimport numpy as np\nimport zstandard\nfrom bson.binary import Binary, BinaryVectorDtype\nfrom pymongo import MongoClient\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.config import setting\nfrom paperghosts.ingest.crops import crop_urls\nfrom paperghosts.ingest.headline import display_headline\nfrom paperghosts.schemas import DIMENSIONS, Report\nfrom paperghosts.store.printings import printing\n\nROOT = Path(__file__).parents[1]\nDATA = ROOT / \"data\"\nOUT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"budget.json\"\nSEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500\nSETTLE = (\n    75  # seconds for WiredTiger's checkpoint, once a minute, to count new index pages\n)\nCODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length\nOUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]\nPLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]\n\n\ndef year_keys(year):\n    \"\"\"Each candidate's reprint keys, in file order, as eval A takes them.\"\"\"\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        return year, [tuple(keys(json.loads(row)[\"text\"])) for row in rows]\n\n\ndef year_rows(job):\n    year, wanted = job\n    found = {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(rows):\n            if index in wanted:\n                found[index] = json.loads(row)\n    return year, found\n\n\ndef sentences(text):\n    flat = \" \".join((text or \"\").replace(\"-\\n\", \"\").split())\n    return [s for s in re.split(r\"(?<=[.!?])\\s+\", flat) if len(s) >= 30] or [flat[:200]]\n\n\ndef quote(sentence, most=200):\n    \"\"\"A verbatim span, as the reader quotes one: a sentence, cut at a word under `most`.\"\"\"\n    return sentence if len(sentence) <= most else sentence[:most].rsplit(\" \", 1)[0]\n\n\ndef stated(rng, said, value=None):\n    sentence = rng.choice(said)\n    if value is None:\n        words = sentence.split()\n        start = rng.randrange(max(1, len(words) - 6))\n        value = \" \".join(words[start : start + rng.randint(3, 6)])\n    return {\n        \"value\": value,\n        \"quote\": quote(sentence),\n        \"verified\": True,\n        \"score\": round(rng.random(), 3),\n    }\n\n\ndef name(rng, said, words):\n    \"\"\"A run of capitalized words from the text, as a place or a person reads.\"\"\"\n    runs = re.findall(\n        rf\"\\b[A-Z][a-z]{{2,}}(?: [A-Z][a-z]{{2,}}){{{words - 1}}}\\b\", \" \".join(said)\n    )\n    return rng.choice(runs) if runs else rng.choice(\" \".join(said).split()[:8] or [\"?\"])\n\n\ndef story(rng, members):\n    \"\"\"A full reports document for one cluster's printings, primary first: the earliest.\"\"\"\n    members = sorted(members, key=lambda row: (row[\"date\"], row[\"article_id\"]))\n    primary = members[0]\n    said = sentences(primary[\"text\"])\n    town = name(rng, said, 1)\n    people = [\n        stated(rng, said, name(rng, said, 2))\n        for _ in range(rng.choice([0, 0, 1, 1, 2, 3]))\n    ]\n    vector = np.random.default_rng(rng.randrange(2**32)).normal(size=DIMENSIONS)\n    year = int(primary[\"date\"][:4])\n    doc = {\n        \"_id\": f\"r_{primary['article_id']}\",\n        \"primary_article_id\": primary[\"article_id\"],\n        \"printings\": [printing(row) for row in members],\n        \"headline\": primary[\"headline\"] or \"\",\n        \"text\": primary[\"text\"] or \"\",\n        \"display_headline\": display_headline(\n            primary[\"headline\"] or \"\", primary[\"paper\"], primary[\"date\"]\n        ),\n        \"date\": primary[\"date\"],\n        \"year\": year,\n        \"month_day\": primary[\"date\"][5:],\n        \"decade\": year // 10 * 10,\n        \"kind\": \"report\",\n        \"fields\": {\n            \"place\": stated(rng, said, town),\n            \"people\": people,\n            \"seen\": stated(rng, said),\n            \"outcome\": stated(rng, said, rng.choice(OUTCOMES)),\n            \"specific_place\": stated(rng, said),\n            \"place_type\": stated(rng, said, rng.choice(PLACE_TYPES)),\n            \"precision\": stated(rng, said, \"town\"),\n        },\n        \"location\": {\n            \"type\": \"Point\",\n            \"coordinates\": [\n                round(rng.uniform(-124, -67), 6),\n                round(rng.uniform(25, 49), 6),\n            ],\n        },\n        \"location_precision\": \"town\",\n        \"location_source\": f\"geonames:{rng.randrange(4_000_000, 6_000_000)}\",\n        \"place_id\": rng.randrange(4_000_000, 6_000_000),\n        \"town\": town,\n        \"state\": primary[\"state\"],\n        \"embedding\": Binary.from_vector(vector.tolist(), BinaryVectorDtype.FLOAT32),\n        \"versions\": {\n            \"code\": CODE,\n            \"lexicon\": \"v2\",\n            \"model\": \"Qwen/Qwen3.5-4B\",\n            \"adapter\": \"paperghosts-reader-lora-v1\",\n            \"prompt\": \"reader-v1\",\n        },\n        \"lexicon_terms\": sorted(primary[\"terms\"]),\n    }\n    return Report.model_validate(doc).model_dump(\n        by_alias=True, exclude_none=True\n    ), members\n\n\ndef levers(doc, members, vector):\n    \"\"\"The document with each of rule 6's levers turned off, and with all of them off.\"\"\"\n    texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}\n\n    def crops(p):\n        service = p.get(\"service\")\n        if service is None:  # its service would be looked up: one of the usual length\n            where = f\"{p['lccn']}:{p['reel']}:{p['issue']}:{p['frame']}\"\n            service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{where}\"\n        return crop_urls(service, p[\"bbox_list\"])\n\n    stored_crops = [p | {\"crop_urls\": crops(p)} for p in doc[\"printings\"]]\n    with_text = [p | {\"text\": texts[p[\"article_id\"]]} for p in doc[\"printings\"]]\n    doubles = vector.as_vector().data\n    return {\n        \"all levers on (float32)\": doc,\n        \"int8 embedding\": doc | {\"embedding\": int8(doubles)},\n        \"embedding as an array of doubles\": doc\n        | {\"embedding\": [float(x) for x in doubles]},\n        \"crop URLs stored\": doc | {\"printings\": stored_crops},\n        \"printings with their own text\": doc | {\"printings\": with_text},\n        \"all levers off\": doc\n        | {\n            \"embedding\": [float(x) for x in doubles],\n            \"printings\": [\n                c | {\"text\": t[\"text\"]}\n                for c, t in zip(stored_crops, with_text, strict=True)\n            ],\n        },\n    }\n\n\ndef int8(values):\n    v = np.asarray(values)\n    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)\n    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)\n\n\ndef summary(sizes):\n    ordered = sorted(sizes)\n    return {\n        \"total\": sum(ordered),\n        \"mean\": round(statistics.fmean(ordered), 1),\n        \"median\": statistics.median(ordered),\n        \"p90\": ordered[int(0.9 * (len(ordered) - 1))],\n        \"max\": ordered[-1],\n    }\n\n\ndef size(value):\n    return len(bson.encode({\"v\": value})) - len(bson.encode({}))\n\n\ndef settled(collection, db):\n    time.sleep(SETTLE)\n    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))[\n        \"storageStats\"\n    ]\n    whole = db.command(\"dbStats\")\n    return {\n        \"count\": stats[\"count\"],\n        \"data_bytes\": stats[\"size\"],\n        \"storage_bytes\": stats[\"storageSize\"],\n        \"index_bytes\": stats[\"totalIndexSize\"],\n        \"index_bytes_by_index\": stats[\"indexSizes\"],\n        \"database\": {k: whole[k] for k in (\"dataSize\", \"storageSize\", \"indexSize\")},\n    }\n\n\ndef main():\n    counts = {\n        c[\"year\"]: c[\"candidates\"]\n        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(y for y in counts if counts[y])\n    starts, total = {}, 0\n    for year in years:\n        starts[year], total = total, total + counts[year]\n    rng = random.Random(SEED)\n    picks = sorted(rng.sample(range(total), PICKS))\n\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        held = dict(pool.map(year_keys, years))\n    doc_keys = [k for year in years for k in held.pop(year)]\n    assert len(doc_keys) == total\n    group_of = {}\n    for group in clusters(doc_keys, least=2):\n        for doc in group:\n            group_of[doc] = group\n    del doc_keys\n    groups, seen = [], set()\n    for pick in picks:\n        group = tuple(group_of.get(pick, (pick,)))\n        if group not in seen:  # two picks from one cluster are one story\n            seen.add(group)\n            groups.append(group)\n    wanted = defaultdict(set)\n    year_of = {}\n    for group in groups:\n        for doc in group:\n            year = max(y for y in years if starts[y] <= doc)\n            wanted[year].add(doc - starts[year])\n            year_of[doc] = year\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        rows = {\n            starts[year] + index: row\n            for year, found in pool.map(year_rows, wanted.items())\n            for index, row in found.items()\n        }\n\n    stories, variants, parts = [], defaultdict(list), defaultdict(list)\n    alone, each = defaultdict(list), defaultdict(list)\n    for group in groups:\n        doc, members = story(rng, [rows[d] for d in group])\n        stories.append(doc)\n        for label, variant in levers(doc, members, doc[\"embedding\"]).items():\n            variants[label].append(len(bson.encode(variant)))\n            # a story's bytes, as the story itself and so much per printing\n            alone[label].append(len(bson.encode(variant | {\"printings\": []})))\n            each[label] += [size(p) for p in variant[\"printings\"]]\n        parts[\"text, headline and display headline\"].append(\n            size(doc[\"text\"]) + size(doc[\"headline\"]) + size(doc[\"display_headline\"])\n        )\n        parts[\"reader fields\"].append(size(doc[\"fields\"]))\n        parts[\"embedding (float32)\"].append(size(doc[\"embedding\"]))\n        parts[\"printings\"].append(size(doc[\"printings\"]))\n        parts[\"each printing\"] += [size(p) for p in doc[\"printings\"]]\n    printings = [len(doc[\"printings\"]) for doc in stories]\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"seed\": SEED,\n        \"candidates_drawn\": PICKS,\n        \"of_candidates\": total,\n        \"stories\": len(stories),\n        \"printings\": {\n            \"total\": sum(printings),\n            \"stories_with_more_than_one\": sum(n > 1 for n in printings),\n            \"most\": max(printings),\n        },\n        \"bson_bytes\": {label: summary(sizes) for label, sizes in variants.items()},\n        \"bson_bytes_of_parts\": {\n            label: summary(sizes) for label, sizes in parts.items()\n        },\n        \"bson_bytes_per\": {\n            label: {\n                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),\n                \"printing\": round(statistics.fmean(each[label]), 1),\n            }\n            for label in variants\n        },\n    }\n\n    with MongoClient(\n        setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000\n    ) as client:\n        db = client[\"paperghosts\"]\n        reports = db[\"reports\"]\n        assert reports.estimated_document_count() == 0, (\n            \"reports already holds documents\"\n        )\n        ids = [doc[\"_id\"] for doc in stories]\n        atlas = {\"empty\": settled(reports, db)}\n        try:\n            for start in range(0, len(stories), BATCH):\n                reports.insert_many(stories[start : start + BATCH], ordered=False)\n                atlas[f\"after {min(start + BATCH, len(stories))}\"] = settled(\n                    reports, db\n                )\n        finally:\n            deleted = reports.delete_many({\"_id\": {\"$in\": ids}}).deleted_count\n            report[\"cleaned_up\"] = {\n                \"deleted\": deleted,\n                \"left_in_reports\": reports.count_documents({}),\n            }\n        report[\"atlas\"] = atlas\n        report[\"storage_by_database\"] = {\n            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}\n            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}\n            for name in client.list_database_names()\n            if name not in (\"admin\", \"local\")\n            for s in [client[name].command(\"dbStats\")]\n        }\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    OUT.write_text(json.dumps(report, indent=1) + \"\\n\")\n    base = report[\"bson_bytes\"][\"all levers on (float32)\"]\n    print(\n        f\"{len(stories)} stories, {sum(printings)} printings; BSON mean {base['mean']:,} bytes, \"\n        f\"median {base['median']:,}; deleted {deleted}\"\n    )\n    print(f\"wrote {OUT.relative_to(ROOT)}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":351,"startLine":1,"totalLines":351}},"sourceToolAssistantUUID":"41f47f67-0efd-41c0-8b56-87d80a63616e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
