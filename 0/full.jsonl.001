{"parentUuid":"9d2b4763-12a9-4d51-9363-fdb0208c03a1","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgZUYxKGiLqEWzb1eVLLT","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"The 17 tests pass, including eval A's. I'm now moving to `scripts/clusters.py`: it will build and cache the features across the 180 year files with eight workers, check that eval A's frame reproduces 91,301 clusters, then build the stories and draw the evaluation and dev sets.\n\n","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1120,"cache_read_input_tokens":573305,"output_tokens":8655,"output_tokens_details":{"thinking_tokens":2237},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1120,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8655,"cache_read_input_tokens":573305,"cache_creation_input_tokens":1120,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1120},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":3,"thinkingDisplay":"updates","serverClassifierRequest":"ad9172f8-8376-4307-bc96-f6555f76d39d","apiBlockIndex":1,"requestId":"req_011CgZUYwfLQ4iMXMzi7zSqy","requestRef":"45979643-1104-4bd9-aa22-424357976443","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"c8bc923b-28f7-414a-93d0-d44bb9d42818","timestamp":"2026-10-31T01:50:36.921Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"parentUuid":"c8bc923b-28f7-414a-93d0-d44bb9d42818","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgZUYxKGiLqEWzb1eVLLT","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Lix4Le6XbE1FZiv6avwaN7","name":"Write","input":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/clusters.py","content":"\"\"\"Reprint clusters as stories (decision 36). Eval A's links stay, two shared runs among each\ncandidate's six smallest in its opening, but a printing joins a story only by matching the\nstory's first printing directly, so no chain of links joins stories that share nothing.\n\n  build     every candidate's runs and shingles, cached in data/clusters/features.pkl; eval A's\n            clusters, which are the frame; and the stories at THRESHOLD, reported in\n            eval/results/phase2b/clusters.json\n  draw      the evaluation set and the dev set, seeded, from the frame and the body probe, in\n            eval/clusters/eval.json and dev.json, and the reading agents' batches of texts in\n            data/clusters/batches/, which name no stratum and no score\n  tune      the stories at each threshold of GRID, scored on the labelled dev set\n  score     precision and recall of same-story links on the frozen evaluation set\n\"\"\"\n\nimport hashlib\nimport json\nimport pickle\nimport random\nimport sys\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom pathlib import Path\n\nimport numpy as np\nimport zstandard\n\nfrom paperghosts.cluster.reprints import (\n    BOILERPLATE,\n    clusters,\n    keys,\n    overlap,\n    pairs,\n    shingles,\n    stories,\n)\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\" / \"clusters\"\nFEATURES = DATA / \"features.pkl\"\nBATCHES = DATA / \"batches\"\nSETS = ROOT / \"eval\" / \"clusters\"\nREPORT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"clusters.json\"\nTHRESHOLD = 0.5  # provisional, set before any labels: tune replaces it from the dev set\nLOOSE = 0.8  # a member with less of its text in its story's first printing is read too\nGRID = [round(0.2 + 0.05 * i, 2) for i in range(13)]  # 0.2 to 0.8\nLARGE = 50  # printings in a cluster that gets its least similar pair checked by hand\nWORDS_SHOWN = 400  # of each printing, for the reading agents\nEMPTY = np.array([], dtype=np.uint64)\n\n\ndef read_year(path: Path) -> list:\n    \"\"\"One year's candidates: id, date, LCCN, paper, the opening's runs, the body's runs (from\n    word 120), and the shingles.\"\"\"\n    found = []\n    with zstandard.open(path, \"rt\") as rows:\n        for row in map(json.loads, rows):\n            text = row[\"text\"] or \"\"\n            found.append(\n                (\n                    row[\"article_id\"],\n                    row[\"date\"],\n                    row[\"lccn\"],\n                    tuple(sorted(keys(text))),\n                    tuple(sorted(keys(text, start=120))),\n                    shingles(text),\n                )\n            )\n    return found\n\n\ndef features(root: Path = ROOT) -> dict:\n    \"\"\"Every candidate's id, date, LCCN, runs and body runs; the shingles of those eval A\n    clusters; and eval A's clusters themselves. Cached, since reading takes minutes.\"\"\"\n    if FEATURES.exists():\n        return pickle.loads(FEATURES.read_bytes())\n    paths = sorted((root / \"data\" / \"candidates\").glob(\"*.jsonl.zst\"))\n    with ProcessPoolExecutor(max_workers=8) as pool:\n        rows = [row for year in pool.map(read_year, paths) for row in year]\n    groups = clusters([set(r[3]) for r in rows], least=2)\n    clustered = {d for g in groups for d in g}\n    found = {\n        \"ids\": [r[0] for r in rows],\n        \"dates\": [r[1] for r in rows],\n        \"lccns\": [r[2] for r in rows],\n        \"keys\": [r[3] for r in rows],\n        \"body\": [r[4] for r in rows],\n        \"shingles\": {d: rows[d][5] for d in clustered},\n        \"frame\": groups,\n    }\n    DATA.mkdir(parents=True, exist_ok=True)\n    FEATURES.write_bytes(pickle.dumps(found, protocol=5))\n    return found\n\n\ndef order_of(found: dict) -> list:\n    \"\"\"Every candidate, earliest first; a story's first printing names it.\"\"\"\n    return sorted(\n        range(len(found[\"ids\"])), key=lambda d: (found[\"dates\"][d], found[\"ids\"][d])\n    )\n\n\ndef stories_at(found: dict, threshold: float) -> tuple:\n    texts = [found[\"shingles\"].get(d, EMPTY) for d in range(len(found[\"ids\"]))]\n    return stories(\n        [set(k) for k in found[\"keys\"]], texts, order_of(found), threshold, BOILERPLATE\n    )\n\n\ndef similarity(found: dict, a: int, b: int) -> list:\n    shared, of_shorter, of_longer = overlap(found[\"shingles\"][a], found[\"shingles\"][b])\n    return [shared, round(of_shorter, 4), round(of_longer, 4)]\n\n\ndef least_similar(found: dict, group: list) -> tuple:\n    \"\"\"The pair of a cluster's printings that share the least of the shorter's shingles.\"\"\"\n    worst, pair = 2.0, (group[0], group[1])\n    for i, a in enumerate(group):\n        for b in group[i + 1 :]:\n            score = overlap(found[\"shingles\"][a], found[\"shingles\"][b])[1]\n            if score < worst:\n                worst, pair = score, (a, b)\n    return pair\n\n\ndef report(found: dict, story: list, match: list, threshold: float) -> dict:\n    \"\"\"What the stories at threshold make of the candidates, beside eval A's clusters.\"\"\"\n    members = defaultdict(list)\n    for doc, first in enumerate(story):\n        members[first].append(doc)\n    shared = [m for m in members.values() if len(m) > 1]\n    sizes = Counter(len(m) for m in shared)\n    loose = sum(\n        1\n        for doc, first in enumerate(story)\n        if first != doc\n        and overlap(found[\"shingles\"][doc], found[\"shingles\"][first])[0]\n        < LOOSE * len(found[\"shingles\"][doc])\n    )\n    frame = found[\"frame\"]\n    large = []\n    for group in sorted(frame, key=len, reverse=True):\n        if len(group) < LARGE:\n            break\n        parts = Counter(story[d] for d in group)\n        large.append(\n            {\n                \"printings\": len(group),\n                \"papers\": len({found[\"lccns\"][d] for d in group}),\n                \"stories\": len(parts),\n                \"largest_story\": max(parts.values()),\n                \"first\": found[\"ids\"][min(group, key=order_of_key(found))],\n            }\n        )\n    bands = [(2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, None)]\n    return {\n        \"threshold\": threshold,\n        \"loose\": LOOSE,\n        \"candidates\": len(story),\n        \"frame\": {\n            \"clusters\": len(frame),\n            \"clustered_candidates\": sum(map(len, frame)),\n            \"distinct_stories\": len(story) - sum(map(len, frame)) + len(frame),\n        },\n        \"stories\": {\n            \"with_more_than_one_printing\": len(shared),\n            \"printings_in_them\": sum(map(len, shared)),\n            \"share_of_candidates\": round(sum(map(len, shared)) / len(story), 4),\n            \"distinct_stories\": len(members),\n            \"cross_paper\": sum(len({found[\"lccns\"][d] for d in m}) > 1 for m in shared),\n            \"first_printings_that_match_their_members_directly\": \"every one, by construction\",\n            \"size_histogram\": [\n                {\n                    \"from\": low,\n                    \"to\": high,\n                    \"stories\": sum(\n                        n\n                        for size, n in sizes.items()\n                        if size >= low and (high is None or size <= high)\n                    ),\n                }\n                for low, high in bands\n            ],\n            \"lowest_match_kept\": round(min(m for m in match), 4),\n        },\n        \"reader\": {\n            \"reads\": \"each story's first printing, and every member with less than \"\n            f\"{LOOSE:.0%} of its shingles in it\",\n            \"first_printings\": len(members),\n            \"loose_members_read_too\": loose,\n            \"job\": len(members) + loose,\n            \"of_candidates\": len(story),\n        },\n        \"large_clusters\": large,\n    }\n\n\ndef order_of_key(found: dict):\n    return lambda d: (found[\"dates\"][d], found[\"ids\"][d])\n\n\ndef body_links(found: dict, rng: random.Random, count: int) -> list:\n    \"\"\"Pairs that share a pair of their body's runs, from word 120, but sit in different eval\n    A clusters, or in none: printings whose openings differ, for the recall probe.\"\"\"\n    cluster_of = {d: i for i, g in enumerate(found[\"frame\"]) for d in g}\n    holders = defaultdict(list)\n    for doc, held in enumerate(found[\"body\"]):\n        for key in pairs(set(held)):\n            holders[key].append(doc)\n    links = set()\n    for docs in holders.values():\n        if 2 <= len(docs) <= BOILERPLATE:\n            for a, b in zip(docs, docs[1:], strict=False):\n                if cluster_of.get(a, -1 - a) != cluster_of.get(b, -1 - b):\n                    links.add((a, b))\n    return rng.sample(sorted(links), min(count, len(links)))\n\n\ndef draw(found: dict) -> None:\n    \"\"\"The evaluation set and the dev set, drawn before any label or tuning. Each pair names\n    its two candidates and its stratum; the texts go to the reading agents' batches, which\n    name neither the stratum nor the similarity.\"\"\"\n    frame = [g for g in found[\"frame\"]]\n    clustered = sorted(d for g in frame for d in g)\n    group_of = {d: g for g in frame for d in g}\n\n    def partner(rng, doc):\n        return rng.choice([m for m in group_of[doc] if m != doc])\n\n    def per_candidate(rng, count, taken, band=None):\n        out = []\n        while len(out) < count:\n            doc = rng.choice(clustered)\n            other = partner(rng, doc)\n            pair = tuple(sorted((doc, other)))\n            if doc in taken or other in taken or pair in out:\n                continue\n            if band and not band[0] <= similarity(found, *pair)[1] < band[1]:\n                continue\n            out.append(pair)\n            taken.update(pair)\n        return out\n\n    taken = set()\n    rng = random.Random(\"2B.4 eval\")\n    strata = {\"per candidate\": per_candidate(rng, 200, taken)}\n    picked = []\n    while len(picked) < 100:\n        group = rng.choice(frame)\n        a, b = rng.sample(group, 2)\n        if a not in taken and b not in taken:\n            picked.append(tuple(sorted((a, b))))\n            taken.update((a, b))\n    strata[\"per cluster\"] = picked\n    strata[\"large cluster, least similar pair\"] = [\n        tuple(sorted(least_similar(found, g)))\n        for g in sorted(frame, key=len, reverse=True)\n        if len(g) >= LARGE\n    ]\n    taken.update(d for p in strata[\"large cluster, least similar pair\"] for d in p)\n    strata[\"near the threshold\"] = per_candidate(rng, 100, taken, band=(0.2, 0.6))\n    strata[\"body probe\"] = [\n        p for p in body_links(found, rng, 150) if not taken & set(p)\n    ][:100]\n    taken.update(d for p in strata[\"body probe\"] for d in p)\n    dev_rng = random.Random(\"2B.4 dev\")\n    dev = {\n        \"per candidate\": per_candidate(dev_rng, 60, taken),\n        \"near the threshold\": per_candidate(dev_rng, 140, taken, band=(0.1, 0.8)),\n    }\n    SETS.mkdir(parents=True, exist_ok=True)\n    for name, chosen in ((\"eval\", strata), (\"dev\", dev)):\n        pairs_out = [\n            {\n                \"pair\": f\"{name}-{n:04d}\",\n                \"stratum\": stratum,\n                \"a\": found[\"ids\"][a],\n                \"b\": found[\"ids\"][b],\n                \"similarity\": similarity(found, a, b)\n                if a in found[\"shingles\"] and b in found[\"shingles\"]\n                else None,\n                \"label\": None,\n                \"note\": None,\n            }\n            for n, (stratum, (a, b)) in enumerate(\n                ((s, p) for s, ps in chosen.items() for p in ps), 1\n            )\n        ]\n        (SETS / f\"{name}.json\").write_text(json.dumps(pairs_out, indent=1) + \"\\n\")\n        print(name, {s: len(ps) for s, ps in chosen.items()})\n\n\ndef texts(root: Path, wanted: set) -> dict:\n    \"\"\"The paper, date, headline and first WORDS_SHOWN words of these candidates.\"\"\"\n    found = {}\n    for path in sorted((root / \"data\" / \"candidates\").glob(\"*.jsonl.zst\")):\n        with zstandard.open(path, \"rt\") as rows:\n            for row in map(json.loads, rows):\n                if row[\"article_id\"] in wanted:\n                    words = (row[\"text\"] or \"\").split()\n                    found[row[\"article_id\"]] = {\n                        \"paper\": row[\"paper\"],\n                        \"date\": row[\"date\"],\n                        \"headline\": (row[\"headline\"] or \"\")[:200],\n                        \"text\": \" \".join(words[:WORDS_SHOWN])\n                        + (\" […]\" if len(words) > WORDS_SHOWN else \"\"),\n                    }\n    return found\n\n\ndef batches(root: Path, size: int = 50) -> None:\n    \"\"\"The reading agents' batches: every pair of both sets, shuffled together by seed, so a\n    batch mixes strata and sets, with each printing's text and nothing else.\"\"\"\n    sets = [json.loads((SETS / f\"{n}.json\").read_text()) for n in (\"eval\", \"dev\")]\n    every = [p for s in sets for p in s]\n    shown = texts(root, {p[k] for p in every for k in (\"a\", \"b\")})\n    random.Random(\"2B.4 batches\").shuffle(every)\n    BATCHES.mkdir(parents=True, exist_ok=True)\n    for i in range(0, len(every), size):\n        batch = [\n            {\"pair\": p[\"pair\"], \"first\": shown[p[\"a\"]], \"second\": shown[p[\"b\"]]}\n            for p in every[i : i + size]\n        ]\n        (BATCHES / f\"batch-{i // size + 1:02d}.json\").write_text(\n            json.dumps(batch, indent=1) + \"\\n\"\n        )\n    print(len(every), \"pairs in\", -(-len(every) // size), \"batches\")\n\n\ndef together(found: dict, story: list, pair: dict) -> bool:\n    index = {i: d for d, i in enumerate(found[\"ids\"])} if \"index\" not in found else None\n    found.setdefault(\"index\", index)\n    return story[found[\"index\"][pair[\"a\"]]] == story[found[\"index\"][pair[\"b\"]]]\n\n\ndef rate(hits: int, n: int) -> dict:\n    if not n:\n        return {\"hits\": 0, \"n\": 0}\n    low, high = wilson(hits, n)\n    return {\"hits\": hits, \"n\": n, \"share\": round(hits / n, 4), \"low\": low, \"high\": high}\n\n\ndef scored(found: dict, story: list, labelled: list) -> dict:\n    \"\"\"Precision and recall of same-story links: precision over the pairs the stories put\n    together, recall over the pairs labelled one story.\"\"\"\n    kept = [p for p in labelled if together(found, story, p)]\n    same = [p for p in labelled if p[\"label\"] == \"same\"]\n    return {\n        \"precision\": rate(sum(p[\"label\"] == \"same\" for p in kept), len(kept)),\n        \"recall\": rate(sum(together(found, story, p) for p in same), len(same)),\n        \"false_merges\": [p[\"pair\"] for p in kept if p[\"label\"] != \"same\"],\n        \"false_splits\": [p[\"pair\"] for p in same if not together(found, story, p)],\n    }\n\n\ndef tune(found: dict) -> None:\n    \"\"\"Each threshold of GRID scored on the dev set: a false merge costs five false splits,\n    since a story merged into another may never be read (decision 36).\"\"\"\n    dev = [p for p in json.loads((SETS / \"dev.json\").read_text()) if p[\"label\"]]\n    rows = []\n    for threshold in GRID:\n        story, _ = stories_at(found, threshold)\n        result = scored(found, story, dev)\n        cost = 5 * len(result[\"false_merges\"]) + len(result[\"false_splits\"])\n        rows.append({\"threshold\": threshold, \"cost\": cost} | result)\n        print(threshold, cost, len(result[\"false_merges\"]), len(result[\"false_splits\"]))\n    (SETS / \"tuning.json\").write_text(json.dumps(rows, indent=1) + \"\\n\")\n\n\ndef score(found: dict, threshold: float) -> None:\n    \"\"\"The stories at the tuned threshold, scored on the frozen evaluation set, by stratum.\"\"\"\n    path = SETS / \"eval.json\"\n    digest = hashlib.sha256(path.read_bytes()).hexdigest()\n    frozen = json.loads((SETS / \"frozen.json\").read_text())\n    assert digest == frozen[\"sha256\"], \"the evaluation set changed after it was frozen\"\n    labelled = json.loads(path.read_text())\n    story, match = stories_at(found, threshold)\n    out = report(found, story, match, threshold)\n    out[\"evaluation\"] = {\"sha256\": digest} | {\n        stratum: scored(found, story, [p for p in labelled if p[\"stratum\"] == stratum])\n        for stratum in dict.fromkeys(p[\"stratum\"] for p in labelled)\n    }\n    REPORT.write_text(json.dumps(out, indent=1) + \"\\n\")\n    print(json.dumps(out[\"evaluation\"], indent=1)[:3000])\n\n\ndef main(run: str, root: Path = ROOT):\n    found = features(root)\n    if run == \"build\":\n        story, match = stories_at(found, THRESHOLD)\n        out = report(found, story, match, THRESHOLD)\n        REPORT.parent.mkdir(parents=True, exist_ok=True)\n        REPORT.write_text(json.dumps(out, indent=1) + \"\\n\")\n        print(json.dumps({k: v for k, v in out.items() if k != \"large_clusters\"}, indent=1))\n    elif run == \"draw\":\n        draw(found)\n        batches(root)\n    elif run == \"tune\":\n        tune(found)\n    elif run == \"score\":\n        score(found, float(sys.argv[2]))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv[1])\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1120,"cache_read_input_tokens":573305,"output_tokens":8655,"output_tokens_details":{"thinking_tokens":2237},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1120,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":8655,"cache_read_input_tokens":573305,"cache_creation_input_tokens":1120,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1120},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Lix4Le6XbE1FZiv6avwaN7":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/clusters.py","content":"\"\"\"Reprint clusters as stories (decision 36). Eval A's links stay, two shared runs among each\ncandidate's six smallest in its opening, but a printing joins a story only by matching the\nstory's first printing directly, so no chain of links joins stories that share nothing.\n\n  build     every candidate's runs and shingles, cached in data/clusters/features.pkl; eval A's\n            clusters, which are the frame; and the stories at THRESHOLD, reported in\n            eval/results/phase2b/clusters.json\n  draw      the evaluation set and the dev set, seeded, from the frame and the body probe, in\n            eval/clusters/eval.json and dev.json, and the reading agents' batches of texts in\n            data/clusters/batches/, which name no stratum and no score\n  tune      the stories at each threshold of GRID, scored on the labelled dev set\n  score     precision and recall of same-story links on the frozen evaluation set\n\"\"\"\n\nimport hashlib\nimport json\nimport pickle\nimport random\nimport sys\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom pathlib import Path\n\nimport numpy as np\nimport zstandard\n\nfrom paperghosts.cluster.reprints import (\n    BOILERPLATE,\n    clusters,\n    keys,\n    overlap,\n    pairs,\n    shingles,\n    stories,\n)\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\" / \"clusters\"\nFEATURES = DATA / \"features.pkl\"\nBATCHES = DATA / \"batches\"\nSETS = ROOT / \"eval\" / \"clusters\"\nREPORT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"clusters.json\"\nTHRESHOLD = 0.5  # provisional, set before any labels: tune replaces it from the dev set\nLOOSE = 0.8  # a member with less of its text in its story's first printing is read too\nGRID = [round(0.2 + 0.05 * i, 2) for i in range(13)]  # 0.2 to 0.8\nLARGE = 50  # printings in a cluster that gets its least similar pair checked by hand\nWORDS_SHOWN = 400  # of each printing, for the reading agents\nEMPTY = np.array([], dtype=np.uint64)\n\n\ndef read_year(path: Path) -> list:\n    \"\"\"One year's candidates: id, date, LCCN, paper, the opening's runs, the body's runs (from\n    word 120), and the shingles.\"\"\"\n    found = []\n    with zstandard.open(path, \"rt\") as rows:\n        for row in map(json.loads, rows):\n            text = row[\"text\"] or \"\"\n            found.append(\n                (\n                    row[\"article_id\"],\n                    row[\"date\"],\n                    row[\"lccn\"],\n                    tuple(sorted(keys(text))),\n                    tuple(sorted(keys(text, start=120))),\n                    shingles(text),\n                )\n            )\n    return found\n\n\ndef features(root: Path = ROOT) -> dict:\n    \"\"\"Every candidate's id, date, LCCN, runs and body runs; the shingles of those eval A\n    clusters; and eval A's clusters themselves. Cached, since reading takes minutes.\"\"\"\n    if FEATURES.exists():\n        return pickle.loads(FEATURES.read_bytes())\n    paths = sorted((root / \"data\" / \"candidates\").glob(\"*.jsonl.zst\"))\n    with ProcessPoolExecutor(max_workers=8) as pool:\n        rows = [row for year in pool.map(read_year, paths) for row in year]\n    groups = clusters([set(r[3]) for r in rows], least=2)\n    clustered = {d for g in groups for d in g}\n    found = {\n        \"ids\": [r[0] for r in rows],\n        \"dates\": [r[1] for r in rows],\n        \"lccns\": [r[2] for r in rows],\n        \"keys\": [r[3] for r in rows],\n        \"body\": [r[4] for r in rows],\n        \"shingles\": {d: rows[d][5] for d in clustered},\n        \"frame\": groups,\n    }\n    DATA.mkdir(parents=True, exist_ok=True)\n    FEATURES.write_bytes(pickle.dumps(found, protocol=5))\n    return found\n\n\ndef order_of(found: dict) -> list:\n    \"\"\"Every candidate, earliest first; a story's first printing names it.\"\"\"\n    return sorted(\n        range(len(found[\"ids\"])), key=lambda d: (found[\"dates\"][d], found[\"ids\"][d])\n    )\n\n\ndef stories_at(found: dict, threshold: float) -> tuple:\n    texts = [found[\"shingles\"].get(d, EMPTY) for d in range(len(found[\"ids\"]))]\n    return stories(\n        [set(k) for k in found[\"keys\"]], texts, order_of(found), threshold, BOILERPLATE\n    )\n\n\ndef similarity(found: dict, a: int, b: int) -> list:\n    shared, of_shorter, of_longer = overlap(found[\"shingles\"][a], found[\"shingles\"][b])\n    return [shared, round(of_shorter, 4), round(of_longer, 4)]\n\n\ndef least_similar(found: dict, group: list) -> tuple:\n    \"\"\"The pair of a cluster's printings that share the least of the shorter's shingles.\"\"\"\n    worst, pair = 2.0, (group[0], group[1])\n    for i, a in enumerate(group):\n        for b in group[i + 1 :]:\n            score = overlap(found[\"shingles\"][a], found[\"shingles\"][b])[1]\n            if score < worst:\n                worst, pair = score, (a, b)\n    return pair\n\n\ndef report(found: dict, story: list, match: list, threshold: float) -> dict:\n    \"\"\"What the stories at threshold make of the candidates, beside eval A's clusters.\"\"\"\n    members = defaultdict(list)\n    for doc, first in enumerate(story):\n        members[first].append(doc)\n    shared = [m for m in members.values() if len(m) > 1]\n    sizes = Counter(len(m) for m in shared)\n    loose = sum(\n        1\n        for doc, first in enumerate(story)\n        if first != doc\n        and overlap(found[\"shingles\"][doc], found[\"shingles\"][first])[0]\n        < LOOSE * len(found[\"shingles\"][doc])\n    )\n    frame = found[\"frame\"]\n    large = []\n    for group in sorted(frame, key=len, reverse=True):\n        if len(group) < LARGE:\n            break\n        parts = Counter(story[d] for d in group)\n        large.append(\n            {\n                \"printings\": len(group),\n                \"papers\": len({found[\"lccns\"][d] for d in group}),\n                \"stories\": len(parts),\n                \"largest_story\": max(parts.values()),\n                \"first\": found[\"ids\"][min(group, key=order_of_key(found))],\n            }\n        )\n    bands = [(2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, None)]\n    return {\n        \"threshold\": threshold,\n        \"loose\": LOOSE,\n        \"candidates\": len(story),\n        \"frame\": {\n            \"clusters\": len(frame),\n            \"clustered_candidates\": sum(map(len, frame)),\n            \"distinct_stories\": len(story) - sum(map(len, frame)) + len(frame),\n        },\n        \"stories\": {\n            \"with_more_than_one_printing\": len(shared),\n            \"printings_in_them\": sum(map(len, shared)),\n            \"share_of_candidates\": round(sum(map(len, shared)) / len(story), 4),\n            \"distinct_stories\": len(members),\n            \"cross_paper\": sum(len({found[\"lccns\"][d] for d in m}) > 1 for m in shared),\n            \"first_printings_that_match_their_members_directly\": \"every one, by construction\",\n            \"size_histogram\": [\n                {\n                    \"from\": low,\n                    \"to\": high,\n                    \"stories\": sum(\n                        n\n                        for size, n in sizes.items()\n                        if size >= low and (high is None or size <= high)\n                    ),\n                }\n                for low, high in bands\n            ],\n            \"lowest_match_kept\": round(min(m for m in match), 4),\n        },\n        \"reader\": {\n            \"reads\": \"each story's first printing, and every member with less than \"\n            f\"{LOOSE:.0%} of its shingles in it\",\n            \"first_printings\": len(members),\n            \"loose_members_read_too\": loose,\n            \"job\": len(members) + loose,\n            \"of_candidates\": len(story),\n        },\n        \"large_clusters\": large,\n    }\n\n\ndef order_of_key(found: dict):\n    return lambda d: (found[\"dates\"][d], found[\"ids\"][d])\n\n\ndef body_links(found: dict, rng: random.Random, count: int) -> list:\n    \"\"\"Pairs that share a pair of their body's runs, from word 120, but sit in different eval\n    A clusters, or in none: printings whose openings differ, for the recall probe.\"\"\"\n    cluster_of = {d: i for i, g in enumerate(found[\"frame\"]) for d in g}\n    holders = defaultdict(list)\n    for doc, held in enumerate(found[\"body\"]):\n        for key in pairs(set(held)):\n            holders[key].append(doc)\n    links = set()\n    for docs in holders.values():\n        if 2 <= len(docs) <= BOILERPLATE:\n            for a, b in zip(docs, docs[1:], strict=False):\n                if cluster_of.get(a, -1 - a) != cluster_of.get(b, -1 - b):\n                    links.add((a, b))\n    return rng.sample(sorted(links), min(count, len(links)))\n\n\ndef draw(found: dict) -> None:\n    \"\"\"The evaluation set and the dev set, drawn before any label or tuning. Each pair names\n    its two candidates and its stratum; the texts go to the reading agents' batches, which\n    name neither the stratum nor the similarity.\"\"\"\n    frame = [g for g in found[\"frame\"]]\n    clustered = sorted(d for g in frame for d in g)\n    group_of = {d: g for g in frame for d in g}\n\n    def partner(rng, doc):\n        return rng.choice([m for m in group_of[doc] if m != doc])\n\n    def per_candidate(rng, count, taken, band=None):\n        out = []\n        while len(out) < count:\n            doc = rng.choice(clustered)\n            other = partner(rng, doc)\n            pair = tuple(sorted((doc, other)))\n            if doc in taken or other in taken or pair in out:\n                continue\n            if band and not band[0] <= similarity(found, *pair)[1] < band[1]:\n                continue\n            out.append(pair)\n            taken.update(pair)\n        return out\n\n    taken = set()\n    rng = random.Random(\"2B.4 eval\")\n    strata = {\"per candidate\": per_candidate(rng, 200, taken)}\n    picked = []\n    while len(picked) < 100:\n        group = rng.choice(frame)\n        a, b = rng.sample(group, 2)\n        if a not in taken and b not in taken:\n            picked.append(tuple(sorted((a, b))))\n            taken.update((a, b))\n    strata[\"per cluster\"] = picked\n    strata[\"large cluster, least similar pair\"] = [\n        tuple(sorted(least_similar(found, g)))\n        for g in sorted(frame, key=len, reverse=True)\n        if len(g) >= LARGE\n    ]\n    taken.update(d for p in strata[\"large cluster, least similar pair\"] for d in p)\n    strata[\"near the threshold\"] = per_candidate(rng, 100, taken, band=(0.2, 0.6))\n    strata[\"body probe\"] = [\n        p for p in body_links(found, rng, 150) if not taken & set(p)\n    ][:100]\n    taken.update(d for p in strata[\"body probe\"] for d in p)\n    dev_rng = random.Random(\"2B.4 dev\")\n    dev = {\n        \"per candidate\": per_candidate(dev_rng, 60, taken),\n        \"near the threshold\": per_candidate(dev_rng, 140, taken, band=(0.1, 0.8)),\n    }\n    SETS.mkdir(parents=True, exist_ok=True)\n    for name, chosen in ((\"eval\", strata), (\"dev\", dev)):\n        pairs_out = [\n            {\n                \"pair\": f\"{name}-{n:04d}\",\n                \"stratum\": stratum,\n                \"a\": found[\"ids\"][a],\n                \"b\": found[\"ids\"][b],\n                \"similarity\": similarity(found, a, b)\n                if a in found[\"shingles\"] and b in found[\"shingles\"]\n                else None,\n                \"label\": None,\n                \"note\": None,\n            }\n            for n, (stratum, (a, b)) in enumerate(\n                ((s, p) for s, ps in chosen.items() for p in ps), 1\n            )\n        ]\n        (SETS / f\"{name}.json\").write_text(json.dumps(pairs_out, indent=1) + \"\\n\")\n        print(name, {s: len(ps) for s, ps in chosen.items()})\n\n\ndef texts(root: Path, wanted: set) -> dict:\n    \"\"\"The paper, date, headline and first WORDS_SHOWN words of these candidates.\"\"\"\n    found = {}\n    for path in sorted((root / \"data\" / \"candidates\").glob(\"*.jsonl.zst\")):\n        with zstandard.open(path, \"rt\") as rows:\n            for row in map(json.loads, rows):\n                if row[\"article_id\"] in wanted:\n                    words = (row[\"text\"] or \"\").split()\n                    found[row[\"article_id\"]] = {\n                        \"paper\": row[\"paper\"],\n                        \"date\": row[\"date\"],\n                        \"headline\": (row[\"headline\"] or \"\")[:200],\n                        \"text\": \" \".join(words[:WORDS_SHOWN])\n                        + (\" […]\" if len(words) > WORDS_SHOWN else \"\"),\n                    }\n    return found\n\n\ndef batches(root: Path, size: int = 50) -> None:\n    \"\"\"The reading agents' batches: every pair of both sets, shuffled together by seed, so a\n    batch mixes strata and sets, with each printing's text and nothing else.\"\"\"\n    sets = [json.loads((SETS / f\"{n}.json\").read_text()) for n in (\"eval\", \"dev\")]\n    every = [p for s in sets for p in s]\n    shown = texts(root, {p[k] for p in every for k in (\"a\", \"b\")})\n    random.Random(\"2B.4 batches\").shuffle(every)\n    BATCHES.mkdir(parents=True, exist_ok=True)\n    for i in range(0, len(every), size):\n        batch = [\n            {\"pair\": p[\"pair\"], \"first\": shown[p[\"a\"]], \"second\": shown[p[\"b\"]]}\n            for p in every[i : i + size]\n        ]\n        (BATCHES / f\"batch-{i // size + 1:02d}.json\").write_text(\n            json.dumps(batch, indent=1) + \"\\n\"\n        )\n    print(len(every), \"pairs in\", -(-len(every) // size), \"batches\")\n\n\ndef together(found: dict, story: list, pair: dict) -> bool:\n    index = {i: d for d, i in enumerate(found[\"ids\"])} if \"index\" not in found else None\n    found.setdefault(\"index\", index)\n    return story[found[\"index\"][pair[\"a\"]]] == story[found[\"index\"][pair[\"b\"]]]\n\n\ndef rate(hits: int, n: int) -> dict:\n    if not n:\n        return {\"hits\": 0, \"n\": 0}\n    low, high = wilson(hits, n)\n    return {\"hits\": hits, \"n\": n, \"share\": round(hits / n, 4), \"low\": low, \"high\": high}\n\n\ndef scored(found: dict, story: list, labelled: list) -> dict:\n    \"\"\"Precision and recall of same-story links: precision over the pairs the stories put\n    together, recall over the pairs labelled one story.\"\"\"\n    kept = [p for p in labelled if together(found, story, p)]\n    same = [p for p in labelled if p[\"label\"] == \"same\"]\n    return {\n        \"precision\": rate(sum(p[\"label\"] == \"same\" for p in kept), len(kept)),\n        \"recall\": rate(sum(together(found, story, p) for p in same), len(same)),\n        \"false_merges\": [p[\"pair\"] for p in kept if p[\"label\"] != \"same\"],\n        \"false_splits\": [p[\"pair\"] for p in same if not together(found, story, p)],\n    }\n\n\ndef tune(found: dict) -> None:\n    \"\"\"Each threshold of GRID scored on the dev set: a false merge costs five false splits,\n    since a story merged into another may never be read (decision 36).\"\"\"\n    dev = [p for p in json.loads((SETS / \"dev.json\").read_text()) if p[\"label\"]]\n    rows = []\n    for threshold in GRID:\n        story, _ = stories_at(found, threshold)\n        result = scored(found, story, dev)\n        cost = 5 * len(result[\"false_merges\"]) + len(result[\"false_splits\"])\n        rows.append({\"threshold\": threshold, \"cost\": cost} | result)\n        print(threshold, cost, len(result[\"false_merges\"]), len(result[\"false_splits\"]))\n    (SETS / \"tuning.json\").write_text(json.dumps(rows, indent=1) + \"\\n\")\n\n\ndef score(found: dict, threshold: float) -> None:\n    \"\"\"The stories at the tuned threshold, scored on the frozen evaluation set, by stratum.\"\"\"\n    path = SETS / \"eval.json\"\n    digest = hashlib.sha256(path.read_bytes()).hexdigest()\n    frozen = json.loads((SETS / \"frozen.json\").read_text())\n    assert digest == frozen[\"sha256\"], \"the evaluation set changed after it was frozen\"\n    labelled = json.loads(path.read_text())\n    story, match = stories_at(found, threshold)\n    out = report(found, story, match, threshold)\n    out[\"evaluation\"] = {\"sha256\": digest} | {\n        stratum: scored(found, story, [p for p in labelled if p[\"stratum\"] == stratum])\n        for stratum in dict.fromkeys(p[\"stratum\"] for p in labelled)\n    }\n    REPORT.write_text(json.dumps(out, indent=1) + \"\\n\")\n    print(json.dumps(out[\"evaluation\"], indent=1)[:3000])\n\n\ndef main(run: str, root: Path = ROOT):\n    found = features(root)\n    if run == \"build\":\n        story, match = stories_at(found, THRESHOLD)\n        out = report(found, story, match, THRESHOLD)\n        REPORT.parent.mkdir(parents=True, exist_ok=True)\n        REPORT.write_text(json.dumps(out, indent=1) + \"\\n\")\n        print(json.dumps({k: v for k, v in out.items() if k != \"large_clusters\"}, indent=1))\n    elif run == \"draw\":\n        draw(found)\n        batches(root)\n    elif run == \"tune\":\n        tune(found)\n    elif run == \"score\":\n        score(found, float(sys.argv[2]))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv[1])\n"}},"serverClassifierRequest":"ad9172f8-8376-4307-bc96-f6555f76d39d","apiBlockIndex":2,"requestId":"req_011CgZUYwfLQ4iMXMzi7zSqy","requestRef":"45979643-1104-4bd9-aa22-424357976443","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"38bd63b3-08aa-403d-9dda-cc79868ad32e","timestamp":"2026-10-31T01:51:22.822Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"type":"file-history-delta","messageId":"38bd63b3-08aa-403d-9dda-cc79868ad32e","snapshotMessageId":"fa9e06ba-ee0e-47ae-b821-eb76f7248503","trackingPath":"scripts/clusters.py","backup":{"backupFileName":null,"version":1,"backupTime":"2026-10-31T01:51:22.850Z","realParentDir":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts"},"timestamp":"2026-10-31T01:51:22.850Z"}
{"parentUuid":"38bd63b3-08aa-403d-9dda-cc79868ad32e","isSidechain":false,"promptId":"e9ec6031-6d70-425a-a94b-94b6c6cc5b96","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lix4Le6XbE1FZiv6avwaN7","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/clusters.py (file state is current in your context — no need to Read it back)"}]},"uuid":"363eb46d-4769-49d5-adab-d689cf114ba4","timestamp":"2026-10-31T01:51:22.852Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/clusters.py","content":"\"\"\"Reprint clusters as stories (decision 36). Eval A's links stay, two shared runs among each\ncandidate's six smallest in its opening, but a printing joins a story only by matching the\nstory's first printing directly, so no chain of links joins stories that share nothing.\n\n  build     every candidate's runs and shingles, cached in data/clusters/features.pkl; eval A's\n            clusters, which are the frame; and the stories at THRESHOLD, reported in\n            eval/results/phase2b/clusters.json\n  draw      the evaluation set and the dev set, seeded, from the frame and the body probe, in\n            eval/clusters/eval.json and dev.json, and the reading agents' batches of texts in\n            data/clusters/batches/, which name no stratum and no score\n  tune      the stories at each threshold of GRID, scored on the labelled dev set\n  score     precision and recall of same-story links on the frozen evaluation set\n\"\"\"\n\nimport hashlib\nimport json\nimport pickle\nimport random\nimport sys\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom pathlib import Path\n\nimport numpy as np\nimport zstandard\n\nfrom paperghosts.cluster.reprints import (\n    BOILERPLATE,\n    clusters,\n    keys,\n    overlap,\n    pairs,\n    shingles,\n    stories,\n)\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\" / \"clusters\"\nFEATURES = DATA / \"features.pkl\"\nBATCHES = DATA / \"batches\"\nSETS = ROOT / \"eval\" / \"clusters\"\nREPORT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"clusters.json\"\nTHRESHOLD = 0.5  # provisional, set before any labels: tune replaces it from the dev set\nLOOSE = 0.8  # a member with less of its text in its story's first printing is read too\nGRID = [round(0.2 + 0.05 * i, 2) for i in range(13)]  # 0.2 to 0.8\nLARGE = 50  # printings in a cluster that gets its least similar pair checked by hand\nWORDS_SHOWN = 400  # of each printing, for the reading agents\nEMPTY = np.array([], dtype=np.uint64)\n\n\ndef read_year(path: Path) -> list:\n    \"\"\"One year's candidates: id, date, LCCN, paper, the opening's runs, the body's runs (from\n    word 120), and the shingles.\"\"\"\n    found = []\n    with zstandard.open(path, \"rt\") as rows:\n        for row in map(json.loads, rows):\n            text = row[\"text\"] or \"\"\n            found.append(\n                (\n                    row[\"article_id\"],\n                    row[\"date\"],\n                    row[\"lccn\"],\n                    tuple(sorted(keys(text))),\n                    tuple(sorted(keys(text, start=120))),\n                    shingles(text),\n                )\n            )\n    return found\n\n\ndef features(root: Path = ROOT) -> dict:\n    \"\"\"Every candidate's id, date, LCCN, runs and body runs; the shingles of those eval A\n    clusters; and eval A's clusters themselves. Cached, since reading takes minutes.\"\"\"\n    if FEATURES.exists():\n        return pickle.loads(FEATURES.read_bytes())\n    paths = sorted((root / \"data\" / \"candidates\").glob(\"*.jsonl.zst\"))\n    with ProcessPoolExecutor(max_workers=8) as pool:\n        rows = [row for year in pool.map(read_year, paths) for row in year]\n    groups = clusters([set(r[3]) for r in rows], least=2)\n    clustered = {d for g in groups for d in g}\n    found = {\n        \"ids\": [r[0] for r in rows],\n        \"dates\": [r[1] for r in rows],\n        \"lccns\": [r[2] for r in rows],\n        \"keys\": [r[3] for r in rows],\n        \"body\": [r[4] for r in rows],\n        \"shingles\": {d: rows[d][5] for d in clustered},\n        \"frame\": groups,\n    }\n    DATA.mkdir(parents=True, exist_ok=True)\n    FEATURES.write_bytes(pickle.dumps(found, protocol=5))\n    return found\n\n\ndef order_of(found: dict) -> list:\n    \"\"\"Every candidate, earliest first; a story's first printing names it.\"\"\"\n    return sorted(\n        range(len(found[\"ids\"])), key=lambda d: (found[\"dates\"][d], found[\"ids\"][d])\n    )\n\n\ndef stories_at(found: dict, threshold: float) -> tuple:\n    texts = [found[\"shingles\"].get(d, EMPTY) for d in range(len(found[\"ids\"]))]\n    return stories(\n        [set(k) for k in found[\"keys\"]], texts, order_of(found), threshold, BOILERPLATE\n    )\n\n\ndef similarity(found: dict, a: int, b: int) -> list:\n    shared, of_shorter, of_longer = overlap(found[\"shingles\"][a], found[\"shingles\"][b])\n    return [shared, round(of_shorter, 4), round(of_longer, 4)]\n\n\ndef least_similar(found: dict, group: list) -> tuple:\n    \"\"\"The pair of a cluster's printings that share the least of the shorter's shingles.\"\"\"\n    worst, pair = 2.0, (group[0], group[1])\n    for i, a in enumerate(group):\n        for b in group[i + 1 :]:\n            score = overlap(found[\"shingles\"][a], found[\"shingles\"][b])[1]\n            if score < worst:\n                worst, pair = score, (a, b)\n    return pair\n\n\ndef report(found: dict, story: list, match: list, threshold: float) -> dict:\n    \"\"\"What the stories at threshold make of the candidates, beside eval A's clusters.\"\"\"\n    members = defaultdict(list)\n    for doc, first in enumerate(story):\n        members[first].append(doc)\n    shared = [m for m in members.values() if len(m) > 1]\n    sizes = Counter(len(m) for m in shared)\n    loose = sum(\n        1\n        for doc, first in enumerate(story)\n        if first != doc\n        and overlap(found[\"shingles\"][doc], found[\"shingles\"][first])[0]\n        < LOOSE * len(found[\"shingles\"][doc])\n    )\n    frame = found[\"frame\"]\n    large = []\n    for group in sorted(frame, key=len, reverse=True):\n        if len(group) < LARGE:\n            break\n        parts = Counter(story[d] for d in group)\n        large.append(\n            {\n                \"printings\": len(group),\n                \"papers\": len({found[\"lccns\"][d] for d in group}),\n                \"stories\": len(parts),\n                \"largest_story\": max(parts.values()),\n                \"first\": found[\"ids\"][min(group, key=order_of_key(found))],\n            }\n        )\n    bands = [(2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, None)]\n    return {\n        \"threshold\": threshold,\n        \"loose\": LOOSE,\n        \"candidates\": len(story),\n        \"frame\": {\n            \"clusters\": len(frame),\n            \"clustered_candidates\": sum(map(len, frame)),\n            \"distinct_stories\": len(story) - sum(map(len, frame)) + len(frame),\n        },\n        \"stories\": {\n            \"with_more_than_one_printing\": len(shared),\n            \"printings_in_them\": sum(map(len, shared)),\n            \"share_of_candidates\": round(sum(map(len, shared)) / len(story), 4),\n            \"distinct_stories\": len(members),\n            \"cross_paper\": sum(len({found[\"lccns\"][d] for d in m}) > 1 for m in shared),\n            \"first_printings_that_match_their_members_directly\": \"every one, by construction\",\n            \"size_histogram\": [\n                {\n                    \"from\": low,\n                    \"to\": high,\n                    \"stories\": sum(\n                        n\n                        for size, n in sizes.items()\n                        if size >= low and (high is None or size <= high)\n                    ),\n                }\n                for low, high in bands\n            ],\n            \"lowest_match_kept\": round(min(m for m in match), 4),\n        },\n        \"reader\": {\n            \"reads\": \"each story's first printing, and every member with less than \"\n            f\"{LOOSE:.0%} of its shingles in it\",\n            \"first_printings\": len(members),\n            \"loose_members_read_too\": loose,\n            \"job\": len(members) + loose,\n            \"of_candidates\": len(story),\n        },\n        \"large_clusters\": large,\n    }\n\n\ndef order_of_key(found: dict):\n    return lambda d: (found[\"dates\"][d], found[\"ids\"][d])\n\n\ndef body_links(found: dict, rng: random.Random, count: int) -> list:\n    \"\"\"Pairs that share a pair of their body's runs, from word 120, but sit in different eval\n    A clusters, or in none: printings whose openings differ, for the recall probe.\"\"\"\n    cluster_of = {d: i for i, g in enumerate(found[\"frame\"]) for d in g}\n    holders = defaultdict(list)\n    for doc, held in enumerate(found[\"body\"]):\n        for key in pairs(set(held)):\n            holders[key].append(doc)\n    links = set()\n    for docs in holders.values():\n        if 2 <= len(docs) <= BOILERPLATE:\n            for a, b in zip(docs, docs[1:], strict=False):\n                if cluster_of.get(a, -1 - a) != cluster_of.get(b, -1 - b):\n                    links.add((a, b))\n    return rng.sample(sorted(links), min(count, len(links)))\n\n\ndef draw(found: dict) -> None:\n    \"\"\"The evaluation set and the dev set, drawn before any label or tuning. Each pair names\n    its two candidates and its stratum; the texts go to the reading agents' batches, which\n    name neither the stratum nor the similarity.\"\"\"\n    frame = [g for g in found[\"frame\"]]\n    clustered = sorted(d for g in frame for d in g)\n    group_of = {d: g for g in frame for d in g}\n\n    def partner(rng, doc):\n        return rng.choice([m for m in group_of[doc] if m != doc])\n\n    def per_candidate(rng, count, taken, band=None):\n        out = []\n        while len(out) < count:\n            doc = rng.choice(clustered)\n            other = partner(rng, doc)\n            pair = tuple(sorted((doc, other)))\n            if doc in taken or other in taken or pair in out:\n                continue\n            if band and not band[0] <= similarity(found, *pair)[1] < band[1]:\n                continue\n            out.append(pair)\n            taken.update(pair)\n        return out\n\n    taken = set()\n    rng = random.Random(\"2B.4 eval\")\n    strata = {\"per candidate\": per_candidate(rng, 200, taken)}\n    picked = []\n    while len(picked) < 100:\n        group = rng.choice(frame)\n        a, b = rng.sample(group, 2)\n        if a not in taken and b not in taken:\n            picked.append(tuple(sorted((a, b))))\n            taken.update((a, b))\n    strata[\"per cluster\"] = picked\n    strata[\"large cluster, least similar pair\"] = [\n        tuple(sorted(least_similar(found, g)))\n        for g in sorted(frame, key=len, reverse=True)\n        if len(g) >= LARGE\n    ]\n    taken.update(d for p in strata[\"large cluster, least similar pair\"] for d in p)\n    strata[\"near the threshold\"] = per_candidate(rng, 100, taken, band=(0.2, 0.6))\n    strata[\"body probe\"] = [\n        p for p in body_links(found, rng, 150) if not taken & set(p)\n    ][:100]\n    taken.update(d for p in strata[\"body probe\"] for d in p)\n    dev_rng = random.Random(\"2B.4 dev\")\n    dev = {\n        \"per candidate\": per_candidate(dev_rng, 60, taken),\n        \"near the threshold\": per_candidate(dev_rng, 140, taken, band=(0.1, 0.8)),\n    }\n    SETS.mkdir(parents=True, exist_ok=True)\n    for name, chosen in ((\"eval\", strata), (\"dev\", dev)):\n        pairs_out = [\n            {\n                \"pair\": f\"{name}-{n:04d}\",\n                \"stratum\": stratum,\n                \"a\": found[\"ids\"][a],\n                \"b\": found[\"ids\"][b],\n                \"similarity\": similarity(found, a, b)\n                if a in found[\"shingles\"] and b in found[\"shingles\"]\n                else None,\n                \"label\": None,\n                \"note\": None,\n            }\n            for n, (stratum, (a, b)) in enumerate(\n                ((s, p) for s, ps in chosen.items() for p in ps), 1\n            )\n        ]\n        (SETS / f\"{name}.json\").write_text(json.dumps(pairs_out, indent=1) + \"\\n\")\n        print(name, {s: len(ps) for s, ps in chosen.items()})\n\n\ndef texts(root: Path, wanted: set) -> dict:\n    \"\"\"The paper, date, headline and first WORDS_SHOWN words of these candidates.\"\"\"\n    found = {}\n    for path in sorted((root / \"data\" / \"candidates\").glob(\"*.jsonl.zst\")):\n        with zstandard.open(path, \"rt\") as rows:\n            for row in map(json.loads, rows):\n                if row[\"article_id\"] in wanted:\n                    words = (row[\"text\"] or \"\").split()\n                    found[row[\"article_id\"]] = {\n                        \"paper\": row[\"paper\"],\n                        \"date\": row[\"date\"],\n                        \"headline\": (row[\"headline\"] or \"\")[:200],\n                        \"text\": \" \".join(words[:WORDS_SHOWN])\n                        + (\" […]\" if len(words) > WORDS_SHOWN else \"\"),\n                    }\n    return found\n\n\ndef batches(root: Path, size: int = 50) -> None:\n    \"\"\"The reading agents' batches: every pair of both sets, shuffled together by seed, so a\n    batch mixes strata and sets, with each printing's text and nothing else.\"\"\"\n    sets = [json.loads((SETS / f\"{n}.json\").read_text()) for n in (\"eval\", \"dev\")]\n    every = [p for s in sets for p in s]\n    shown = texts(root, {p[k] for p in every for k in (\"a\", \"b\")})\n    random.Random(\"2B.4 batches\").shuffle(every)\n    BATCHES.mkdir(parents=True, exist_ok=True)\n    for i in range(0, len(every), size):\n        batch = [\n            {\"pair\": p[\"pair\"], \"first\": shown[p[\"a\"]], \"second\": shown[p[\"b\"]]}\n            for p in every[i : i + size]\n        ]\n        (BATCHES / f\"batch-{i // size + 1:02d}.json\").write_text(\n            json.dumps(batch, indent=1) + \"\\n\"\n        )\n    print(len(every), \"pairs in\", -(-len(every) // size), \"batches\")\n\n\ndef together(found: dict, story: list, pair: dict) -> bool:\n    index = {i: d for d, i in enumerate(found[\"ids\"])} if \"index\" not in found else None\n    found.setdefault(\"index\", index)\n    return story[found[\"index\"][pair[\"a\"]]] == story[found[\"index\"][pair[\"b\"]]]\n\n\ndef rate(hits: int, n: int) -> dict:\n    if not n:\n        return {\"hits\": 0, \"n\": 0}\n    low, high = wilson(hits, n)\n    return {\"hits\": hits, \"n\": n, \"share\": round(hits / n, 4), \"low\": low, \"high\": high}\n\n\ndef scored(found: dict, story: list, labelled: list) -> dict:\n    \"\"\"Precision and recall of same-story links: precision over the pairs the stories put\n    together, recall over the pairs labelled one story.\"\"\"\n    kept = [p for p in labelled if together(found, story, p)]\n    same = [p for p in labelled if p[\"label\"] == \"same\"]\n    return {\n        \"precision\": rate(sum(p[\"label\"] == \"same\" for p in kept), len(kept)),\n        \"recall\": rate(sum(together(found, story, p) for p in same), len(same)),\n        \"false_merges\": [p[\"pair\"] for p in kept if p[\"label\"] != \"same\"],\n        \"false_splits\": [p[\"pair\"] for p in same if not together(found, story, p)],\n    }\n\n\ndef tune(found: dict) -> None:\n    \"\"\"Each threshold of GRID scored on the dev set: a false merge costs five false splits,\n    since a story merged into another may never be read (decision 36).\"\"\"\n    dev = [p for p in json.loads((SETS / \"dev.json\").read_text()) if p[\"label\"]]\n    rows = []\n    for threshold in GRID:\n        story, _ = stories_at(found, threshold)\n        result = scored(found, story, dev)\n        cost = 5 * len(result[\"false_merges\"]) + len(result[\"false_splits\"])\n        rows.append({\"threshold\": threshold, \"cost\": cost} | result)\n        print(threshold, cost, len(result[\"false_merges\"]), len(result[\"false_splits\"]))\n    (SETS / \"tuning.json\").write_text(json.dumps(rows, indent=1) + \"\\n\")\n\n\ndef score(found: dict, threshold: float) -> None:\n    \"\"\"The stories at the tuned threshold, scored on the frozen evaluation set, by stratum.\"\"\"\n    path = SETS / \"eval.json\"\n    digest = hashlib.sha256(path.read_bytes()).hexdigest()\n    frozen = json.loads((SETS / \"frozen.json\").read_text())\n    assert digest == frozen[\"sha256\"], \"the evaluation set changed after it was frozen\"\n    labelled = json.loads(path.read_text())\n    story, match = stories_at(found, threshold)\n    out = report(found, story, match, threshold)\n    out[\"evaluation\"] = {\"sha256\": digest} | {\n        stratum: scored(found, story, [p for p in labelled if p[\"stratum\"] == stratum])\n        for stratum in dict.fromkeys(p[\"stratum\"] for p in labelled)\n    }\n    REPORT.write_text(json.dumps(out, indent=1) + \"\\n\")\n    print(json.dumps(out[\"evaluation\"], indent=1)[:3000])\n\n\ndef main(run: str, root: Path = ROOT):\n    found = features(root)\n    if run == \"build\":\n        story, match = stories_at(found, THRESHOLD)\n        out = report(found, story, match, THRESHOLD)\n        REPORT.parent.mkdir(parents=True, exist_ok=True)\n        REPORT.write_text(json.dumps(out, indent=1) + \"\\n\")\n        print(json.dumps({k: v for k, v in out.items() if k != \"large_clusters\"}, indent=1))\n    elif run == \"draw\":\n        draw(found)\n        batches(root)\n    elif run == \"tune\":\n        tune(found)\n    elif run == \"score\":\n        score(found, float(sys.argv[2]))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv[1])\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"38bd63b3-08aa-403d-9dda-cc79868ad32e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
