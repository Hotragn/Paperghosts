{"parentUuid":"a559377a-2884-4b2c-b9ae-67c1ee6fc53b","isSidechain":false,"promptId":"78e5ea90-09d8-43a3-94af-ec107a2e4714","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bi6NiTVgaqBQ93XrpYK6JY","type":"tool_result","content":"1\t\"\"\"The display headline drops the masthead lines that an article's first box often takes in:\n2\tthe paper's title, its own place and date, and its volume, number and page. Every case is a\n3\treal headline from the 2A read, beside the paper's title as LoC records it.\"\"\"\n4\t\n5\timport pytest\n6\t\n7\tfrom paperghosts.ingest.headline import display_headline\n8\t\n9\tDROPS = [\n10\t    pytest.param(\n11\t        \"Lewistown gazette. [volume] (Lewistown, Pa.) 1843-1944\",\n12\t        \"New Series-VOl. 4-NO. 40.\\n\\nTHE MYSTERIOUS KNOCKIyGs.\",\n13\t        \"THE MYSTERIOUS KNOCKIyGs.\",\n14\t        id=\"volume and number, 1850-07-26\",\n15\t    ),\n16\t    pytest.param(\n17\t        \"The Cecil Whig. [volume] (Elkton, Md.) 1841-current\",\n18\t        \"WHOLE No 467\\n\\nWaIer..Water.\",\n19\t        \"WaIer..Water.\",\n20\t        id=\"whole number, 1850-07-13\",\n21\t    ),\n22\t    pytest.param(\n23\t        \"The daily crescent. [volume] ([New Orleans, La.]) 1848-1851\",\n24\t        \"DAILY CRESCENT.\\n\\nIMT NATfVRLAND.\",\n25\t        \"IMT NATfVRLAND.\",\n26\t        id=\"title, 1850-03-22\",\n27\t    ),\n28\t    pytest.param(\n29\t        \"Anti-slavery bugle. [volume] (New-Lisbon, Ohio) 1845-1861\",\n30\t        \"THE ANTI-SLAVERY BUGLE.\\n\\nwhere dcst thou seek EnioYments\",\n31\t        \"where dcst thou seek EnioYments\",\n32\t        id=\"title with The, 1850-09-07\",\n33\t    ),\n34\t    pytest.param(\n35\t        \"The national era. [volume] (Washington [D.C.]) 1847-1860\",\n36\t        \"THE NATIONAL ERA.\\n\\nWASHINGTON. JANUARY il, 1880.\\n\\nLoWEbb'S POEMS.\",\n37\t        \"LoWEbb'S POEMS.\",\n38\t        id=\"title and its own dateline, 1850-01-17\",\n39\t    ),\n40\t    pytest.param(\n41\t        \"The republic. [volume] (Washington [D.C.]) 1849-1853\",\n42\t        \"WASHINGTON: SATURDAY MORNING. JULY 90 1850\\n\\nHARPER & BROTHERS.\",\n43\t        \"HARPER & BROTHERS.\",\n44\t        id=\"its own dateline with the time of day, 1850-07-20\",\n45\t    ),\n46\t    pytest.param(\n47\t        \"Morning journal and courier. [volume] (New Haven [Conn.]) 1848-1894\",\n48\t        \"NEW HAVEN, CONN\\n\\nThursday Morning, june 1e. 1881.\\n\\nNEW ADVRRTLsERENTs To-DA r\",\n49\t        \"NEW ADVRRTLsERENTs To-DA r\",\n50\t        id=\"its own place and state, then the date, 1881-06-16\",\n51\t    ),\n52\t    pytest.param(\n53\t        \"The Dallas daily herald. [volume] (Dallas, Tex.) 1873-1887\",\n54\t        \"DALLAS TEXAS, WEDNESDAY MORNING, MARCH 26 1873\",\n55\t        \"\",\n56\t        id=\"its own state spelled out, 1873-03-26\",\n57\t    ),\n58\t    pytest.param(\n59\t        \"Public ledger. [volume] (Memphis, Tenn.) 1865-1893\",\n60\t        \"NMEMPHIs, TENN: TUESDAY EVENING NOVEMBER 26 1872\",\n61\t        \"\",\n62\t        id=\"a stray letter on its own place, 1872-11-26\",\n63\t    ),\n64\t    pytest.param(\n65\t        \"The sun. [volume] (New York [N.Y.]) 1833-1916\",\n66\t        \"THE SUN, SUNDAY. DECEMBER 9. 1891.\",\n67\t        \"\",\n68\t        id=\"a short title standing alone, 1891-12-06\",\n69\t    ),\n70\t    pytest.param(\n71\t        \"The Portland gazette. [volume] (Portland, Me.) 1818-1824\",\n72\t        \"PORTL AND:\\n\\nSaturday, February I2. 1870\",\n73\t        \"\",\n74\t        id=\"its own place and date and nothing else, 1820-02-15\",\n75\t    ),\n76\t    pytest.param(\n77\t        \"The evening herald. [volume] (Albuquerque, New Mexico) 1914-1922\",\n78\t        \"Tuesday Evening,\\n\\n\\nJuly 2, 1918.\",\n79\t        \"\",\n80\t        id=\"a weekday and time, then the date, 1918-07-02\",\n81\t    ),\n82\t    pytest.param(\n83\t        \"The Somerset herald. [volume] (Somerset, Pa.) 1870-1936\",\n84\t        'g. SOMERSET PA, \"WEDNESDAY',\n85\t        \"\",\n86\t        id=\"its own place beside a lone weekday, 1890-07-30\",\n87\t    ),\n88\t    pytest.param(\n89\t        \"Bloomington herald. [volume] (Bloomington, I. T. [Iowa]) 1840-1849\",\n90\t        \"WHOLE NO. ls3.\",\n91\t        \"\",\n92\t        id=\"a whole number as OCR reads it, 1843-05-19\",\n93\t    ),\n94\t]\n95\t\n96\tKEEPS = [\n97\t    pytest.param(\n98\t        \"Elizabeth-Town gazette. [volume] (Elizabeth-Town, N.J.) 1818-1821\",\n99\t        \"From the London Literary Gazette.\\nTHE FOG SPECTRE.\",\n100\t        \"From the London Literary Gazette.\\nTHE FOG SPECTRE.\",\n101\t        id=\"another paper's name, 1820-03-14\",\n102\t    ),\n103\t    pytest.param(\n104\t        \"The daily Cairo bulletin. (Cairo, Ill.) 1878-1???\",\n105\t        \"For the Cairo Bulletin:\\n\\n\\nLEONOR.\",\n106\t        \"For the Cairo Bulletin:\\nLEONOR.\",\n107\t        id=\"its own place within a line, 1880-04-11\",\n108\t    ),\n109\t    pytest.param(\n110\t        \"Alexandria gazette &amp; daily advertiser. [volume] (Alexandria [Va.]) 1817-1822\",\n111\t        \".Nezg- York, AAgust /.\\n\\nSITUATION OF FRANCE\",\n112\t        \".Nezg- York, AAgust /.\\nSITUATION OF FRANCE\",\n113\t        id=\"another city's dateline, 1820-08-07\",\n114\t    ),\n115\t    pytest.param(\n116\t        \"The Saline County journal. [volume] (Salina, Kan.) 1871-1893\",\n117\t        \"The weather still delightful.\\n\\n\\nOlof Bull called last Tuesday.\",\n118\t        \"The weather still delightful.\\nOlof Bull called last Tuesday.\",\n119\t        id=\"a weekday in a sentence, 1880-01-15\",\n120\t    ),\n121\t    pytest.param(\n122\t        \"The Superior times. [volume] (Superior, Wis.) 1870-1912\",\n123\t        \"From Sunday Afternoon\\nMRS. WILKINS DUTY.\",\n124\t        \"From Sunday Afternoon\\nMRS. WILKINS DUTY.\",\n125\t        id=\"a magazine named for a day, 1880-02-07\",\n126\t    ),\n127\t    pytest.param(\n128\t        \"North Branch democrat. [volume] (Tunkhannock, Pa.) 1854-1867\",\n129\t        \"SHORT PATE MT SER MON\\n\\n\\nON\\nThe Paym ent Of Debts\",\n130\t        \"SHORT PATE MT SER MON\\nON\\nThe Paym ent Of Debts\",\n131\t        id=\"a short word on a line of its own, 1865-08-02\",\n132\t    ),\n133\t    pytest.param(\n134\t        \"True American. [volume] (New Orleans [La.]) 1835-18??\",\n135\t        \"IN Ak, IA,\\n\\n\\ntTRTR itTTTH l5>q,W\\nII\",\n136\t        \"IN Ak, IA,\\ntTRTR itTTTH l5>q,W\\nII\",\n137\t        id=\"a numeral on a line of its own, 1839-08-22\",\n138\t    ),\n139\t    # mis-drops in the 200-line sample: dated lines and issue words that belong to the article\n140\t    pytest.param(\n141\t        \"The Parisian. (Paris, Tenn.) 1907-1962\",\n142\t        \"Police To Seek\\n\\n\\nOut Ghosts Next\\n\\n\\nMonday Evening\",\n143\t        \"Police To Seek\\nOut Ghosts Next\\nMonday Evening\",\n144\t        id=\"a weekday and time ending the headline, 1921-10-28\",\n145\t    ),\n146\t    pytest.param(\n147\t        \"The daily union. [volume] (Washington [D.C.]) 1845-1857\",\n148\t        \"IN CONGRESS- OF THE U. STATES.\\n\\nThirty s,r, corgrsss--Firs' Session.\"\n149\t        \"\\n\\n- -\\nWEDNESDAY, JANUARY 8, 1850.\\n\\n\",\n150\t        \"IN CONGRESS- OF THE U. STATES.\\nThirty s,r, corgrsss--Firs' Session.\"\n151\t        \"\\nWEDNESDAY, JANUARY 8, 1850.\",\n152\t        id=\"the session's date under the headline, and a rule, 1850-01-10\",\n153\t    ),\n154\t    pytest.param(\n155\t        \"The Paducah evening sun. [volume] (Paducah, Ky.) 1906-1929\",\n156\t        \"MARCH.\",\n157\t        \"MARCH.\",\n158\t        id=\"a poem named for a month, 1907-03-02\",\n159\t    ),\n160\t    pytest.param(\n161\t        \"The Washington herald.\",\n162\t        \"EVENING.\",\n163\t        \"EVENING.\",\n164\t        id=\"a poem named for a time of day, 1909-03-28\",\n165\t    ),\n166\t    pytest.param(\n167\t        \"New Britain herald.\",\n168\t        \"MAY\\n\\n GET Sc|NSkrS TEAM\\n\\n(Continucd From Eighth PageD\",\n169\t        \"MAY\\nGET Sc|NSkrS TEAM\\n(Continucd From Eighth PageD\",\n170\t        id=\"May as a verb, 1915-01-19\",\n171\t    ),\n172\t    pytest.param(\n173\t        \"The Charleston daily news. (Charleston, S.C.) 1865-1873\",\n174\t        'Tbe Maflesto,t News.\\n\\nFRIDAY, DECEMBER \"a, 1859.\\n\\nTIE CONTENTS OF OUR CHRIsTMAS s\\n\\n\\nNUMBER.',\n175\t        'Tbe Maflesto,t News.\\nFRIDAY, DECEMBER \"a, 1859.\\nTIE CONTENTS OF OUR CHRIsTMAS s\\nNUMBER.',\n176\t        id=\"an issue word that belongs to the headline, 1869-12-24\",\n177\t    ),\n178\t    pytest.param(\n179\t        \"The Jersey City news. (Jersey City [N.J.]) 1889-1906\",\n180\t        \"NEW\\n\\nThe Forum for May.\",\n181\t        \"NEW\\nThe Forum for May.\",\n182\t        id=\"an issue word with no number, leading, 1893-05-02\",\n183\t    ),\n184\t    pytest.param(\n185\t        \"The Big Stone Gap post. [volume] (Big Stone Gap, Wise County, Va.) 1892-1928\",\n186\t        \"Coal Operators Should Live\\n\\n\\nin Big Stone Gap.\",\n187\t        \"Coal Operators Should Live\\nin Big Stone Gap.\",\n188\t        id=\"its own place inside a sentence, 1911-05-03\",\n189\t    ),\n190\t    pytest.param(\n191\t        \"The Toledo chronicle. [volume] (Toledo, Tama County, Iowa) 1873-1924\",\n192\t        \"Hls,sso.oo rs, sso.co\\n\\n100000\\n\\n100000\\n2, COCO\",\n193\t        \"Hls,sso.oo rs, sso.co\\n100000\\n100000\\n2, COCO\",\n194\t        id=\"figures in a table, 1876-01-06\",\n195\t    ),\n196\t    # a short title or place inside a word: these were dropped while names had no boundaries\n197\t    pytest.param(\n198\t        \"The post. [volume] (Middleburg, Snyder County, Pa.) 1864-1883\",\n199\t        \"PoStry\\n\\ncA1RItY.\",\n200\t        \"PoStry\\ncA1RItY.\",\n201\t        id=\"Post inside Poetry, 1876-09-07\",\n202\t    ),\n203\t    pytest.param(\n204\t        \"The Iola register. [volume] (Iola, Allen County, Kansas) 1875-1902\",\n205\t        \"tCopuri0hted.l\\nVIOLA\\n\\nThrice Lost IN a Struggle for a Name,\",\n206\t        \"tCopuri0hted.l\\nVIOLA\\nThrice Lost IN a Struggle for a Name,\",\n207\t        id=\"Iola inside Viola, 1882-09-22\",\n208\t    ),\n209\t    pytest.param(\n210\t        \"The sun. [volume] (New York [N.Y.]) 1833-1916\",\n211\t        \"EAkSUNs AMERICAN MUSEUM\",\n212\t        \"EAkSUNs AMERICAN MUSEUM\",\n213\t        id=\"Sun inside a name, 1863-09-29\",\n214\t    ),\n215\t    # real headline lines from other papers, set beside a short title\n216\t    pytest.param(\n217\t        \"The star. (Cincinnati [Ohio]) 1874-1875\",\n218\t        \"Stars.\",\n219\t        \"Stars.\",\n220\t        id=\"Star inside Stars, from the Lexington weekly intelligencer, 1882-08-26\",\n221\t    ),\n222\t    pytest.param(\n223\t        \"The bee.\",\n224\t        \"BEER.\",\n225\t        \"BEER.\",\n226\t        id=\"Bee inside Beer, from the Weekly Kansas chief, 1881-07-21\",\n227\t    ),\n228\t    pytest.param(\n229\t        None,\n230\t        \"Junc 10 tho Probable Date for\\nHolding the Democratic\\n\\n\\nConvention.\",\n231\t        \"Junc 10 tho Probable Date for\\nHolding the Democratic\\nConvention.\",\n232\t        id=\"no title on record, 1880-02-23\",\n233\t    ),\n234\t]\n235\t\n236\t\n237\t@pytest.mark.parametrize(\"paper, headline, shown\", DROPS + KEEPS)\n238\tdef test_the_display_headline_drops_only_masthead_lines(paper, headline, shown):\n239\t    assert display_headline(headline, paper) == shown\n240\t"}]},"uuid":"594b1c91-ee0d-43a5-9c8c-3a6e05ceda69","timestamp":"2026-10-30T07:50:43.239Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_headline.py","content":"\"\"\"The display headline drops the masthead lines that an article's first box often takes in:\nthe paper's title, its own place and date, and its volume, number and page. Every case is a\nreal headline from the 2A read, beside the paper's title as LoC records it.\"\"\"\n\nimport pytest\n\nfrom paperghosts.ingest.headline import display_headline\n\nDROPS = [\n    pytest.param(\n        \"Lewistown gazette. [volume] (Lewistown, Pa.) 1843-1944\",\n        \"New Series-VOl. 4-NO. 40.\\n\\nTHE MYSTERIOUS KNOCKIyGs.\",\n        \"THE MYSTERIOUS KNOCKIyGs.\",\n        id=\"volume and number, 1850-07-26\",\n    ),\n    pytest.param(\n        \"The Cecil Whig. [volume] (Elkton, Md.) 1841-current\",\n        \"WHOLE No 467\\n\\nWaIer..Water.\",\n        \"WaIer..Water.\",\n        id=\"whole number, 1850-07-13\",\n    ),\n    pytest.param(\n        \"The daily crescent. [volume] ([New Orleans, La.]) 1848-1851\",\n        \"DAILY CRESCENT.\\n\\nIMT NATfVRLAND.\",\n        \"IMT NATfVRLAND.\",\n        id=\"title, 1850-03-22\",\n    ),\n    pytest.param(\n        \"Anti-slavery bugle. [volume] (New-Lisbon, Ohio) 1845-1861\",\n        \"THE ANTI-SLAVERY BUGLE.\\n\\nwhere dcst thou seek EnioYments\",\n        \"where dcst thou seek EnioYments\",\n        id=\"title with The, 1850-09-07\",\n    ),\n    pytest.param(\n        \"The national era. [volume] (Washington [D.C.]) 1847-1860\",\n        \"THE NATIONAL ERA.\\n\\nWASHINGTON. JANUARY il, 1880.\\n\\nLoWEbb'S POEMS.\",\n        \"LoWEbb'S POEMS.\",\n        id=\"title and its own dateline, 1850-01-17\",\n    ),\n    pytest.param(\n        \"The republic. [volume] (Washington [D.C.]) 1849-1853\",\n        \"WASHINGTON: SATURDAY MORNING. JULY 90 1850\\n\\nHARPER & BROTHERS.\",\n        \"HARPER & BROTHERS.\",\n        id=\"its own dateline with the time of day, 1850-07-20\",\n    ),\n    pytest.param(\n        \"Morning journal and courier. [volume] (New Haven [Conn.]) 1848-1894\",\n        \"NEW HAVEN, CONN\\n\\nThursday Morning, june 1e. 1881.\\n\\nNEW ADVRRTLsERENTs To-DA r\",\n        \"NEW ADVRRTLsERENTs To-DA r\",\n        id=\"its own place and state, then the date, 1881-06-16\",\n    ),\n    pytest.param(\n        \"The Dallas daily herald. [volume] (Dallas, Tex.) 1873-1887\",\n        \"DALLAS TEXAS, WEDNESDAY MORNING, MARCH 26 1873\",\n        \"\",\n        id=\"its own state spelled out, 1873-03-26\",\n    ),\n    pytest.param(\n        \"Public ledger. [volume] (Memphis, Tenn.) 1865-1893\",\n        \"NMEMPHIs, TENN: TUESDAY EVENING NOVEMBER 26 1872\",\n        \"\",\n        id=\"a stray letter on its own place, 1872-11-26\",\n    ),\n    pytest.param(\n        \"The sun. [volume] (New York [N.Y.]) 1833-1916\",\n        \"THE SUN, SUNDAY. DECEMBER 9. 1891.\",\n        \"\",\n        id=\"a short title standing alone, 1891-12-06\",\n    ),\n    pytest.param(\n        \"The Portland gazette. [volume] (Portland, Me.) 1818-1824\",\n        \"PORTL AND:\\n\\nSaturday, February I2. 1870\",\n        \"\",\n        id=\"its own place and date and nothing else, 1820-02-15\",\n    ),\n    pytest.param(\n        \"The evening herald. [volume] (Albuquerque, New Mexico) 1914-1922\",\n        \"Tuesday Evening,\\n\\n\\nJuly 2, 1918.\",\n        \"\",\n        id=\"a weekday and time, then the date, 1918-07-02\",\n    ),\n    pytest.param(\n        \"The Somerset herald. [volume] (Somerset, Pa.) 1870-1936\",\n        'g. SOMERSET PA, \"WEDNESDAY',\n        \"\",\n        id=\"its own place beside a lone weekday, 1890-07-30\",\n    ),\n    pytest.param(\n        \"Bloomington herald. [volume] (Bloomington, I. T. [Iowa]) 1840-1849\",\n        \"WHOLE NO. ls3.\",\n        \"\",\n        id=\"a whole number as OCR reads it, 1843-05-19\",\n    ),\n]\n\nKEEPS = [\n    pytest.param(\n        \"Elizabeth-Town gazette. [volume] (Elizabeth-Town, N.J.) 1818-1821\",\n        \"From the London Literary Gazette.\\nTHE FOG SPECTRE.\",\n        \"From the London Literary Gazette.\\nTHE FOG SPECTRE.\",\n        id=\"another paper's name, 1820-03-14\",\n    ),\n    pytest.param(\n        \"The daily Cairo bulletin. (Cairo, Ill.) 1878-1???\",\n        \"For the Cairo Bulletin:\\n\\n\\nLEONOR.\",\n        \"For the Cairo Bulletin:\\nLEONOR.\",\n        id=\"its own place within a line, 1880-04-11\",\n    ),\n    pytest.param(\n        \"Alexandria gazette &amp; daily advertiser. [volume] (Alexandria [Va.]) 1817-1822\",\n        \".Nezg- York, AAgust /.\\n\\nSITUATION OF FRANCE\",\n        \".Nezg- York, AAgust /.\\nSITUATION OF FRANCE\",\n        id=\"another city's dateline, 1820-08-07\",\n    ),\n    pytest.param(\n        \"The Saline County journal. [volume] (Salina, Kan.) 1871-1893\",\n        \"The weather still delightful.\\n\\n\\nOlof Bull called last Tuesday.\",\n        \"The weather still delightful.\\nOlof Bull called last Tuesday.\",\n        id=\"a weekday in a sentence, 1880-01-15\",\n    ),\n    pytest.param(\n        \"The Superior times. [volume] (Superior, Wis.) 1870-1912\",\n        \"From Sunday Afternoon\\nMRS. WILKINS DUTY.\",\n        \"From Sunday Afternoon\\nMRS. WILKINS DUTY.\",\n        id=\"a magazine named for a day, 1880-02-07\",\n    ),\n    pytest.param(\n        \"North Branch democrat. [volume] (Tunkhannock, Pa.) 1854-1867\",\n        \"SHORT PATE MT SER MON\\n\\n\\nON\\nThe Paym ent Of Debts\",\n        \"SHORT PATE MT SER MON\\nON\\nThe Paym ent Of Debts\",\n        id=\"a short word on a line of its own, 1865-08-02\",\n    ),\n    pytest.param(\n        \"True American. [volume] (New Orleans [La.]) 1835-18??\",\n        \"IN Ak, IA,\\n\\n\\ntTRTR itTTTH l5>q,W\\nII\",\n        \"IN Ak, IA,\\ntTRTR itTTTH l5>q,W\\nII\",\n        id=\"a numeral on a line of its own, 1839-08-22\",\n    ),\n    # mis-drops in the 200-line sample: dated lines and issue words that belong to the article\n    pytest.param(\n        \"The Parisian. (Paris, Tenn.) 1907-1962\",\n        \"Police To Seek\\n\\n\\nOut Ghosts Next\\n\\n\\nMonday Evening\",\n        \"Police To Seek\\nOut Ghosts Next\\nMonday Evening\",\n        id=\"a weekday and time ending the headline, 1921-10-28\",\n    ),\n    pytest.param(\n        \"The daily union. [volume] (Washington [D.C.]) 1845-1857\",\n        \"IN CONGRESS- OF THE U. STATES.\\n\\nThirty s,r, corgrsss--Firs' Session.\"\n        \"\\n\\n- -\\nWEDNESDAY, JANUARY 8, 1850.\\n\\n\",\n        \"IN CONGRESS- OF THE U. STATES.\\nThirty s,r, corgrsss--Firs' Session.\"\n        \"\\nWEDNESDAY, JANUARY 8, 1850.\",\n        id=\"the session's date under the headline, and a rule, 1850-01-10\",\n    ),\n    pytest.param(\n        \"The Paducah evening sun. [volume] (Paducah, Ky.) 1906-1929\",\n        \"MARCH.\",\n        \"MARCH.\",\n        id=\"a poem named for a month, 1907-03-02\",\n    ),\n    pytest.param(\n        \"The Washington herald.\",\n        \"EVENING.\",\n        \"EVENING.\",\n        id=\"a poem named for a time of day, 1909-03-28\",\n    ),\n    pytest.param(\n        \"New Britain herald.\",\n        \"MAY\\n\\n GET Sc|NSkrS TEAM\\n\\n(Continucd From Eighth PageD\",\n        \"MAY\\nGET Sc|NSkrS TEAM\\n(Continucd From Eighth PageD\",\n        id=\"May as a verb, 1915-01-19\",\n    ),\n    pytest.param(\n        \"The Charleston daily news. (Charleston, S.C.) 1865-1873\",\n        'Tbe Maflesto,t News.\\n\\nFRIDAY, DECEMBER \"a, 1859.\\n\\nTIE CONTENTS OF OUR CHRIsTMAS s\\n\\n\\nNUMBER.',\n        'Tbe Maflesto,t News.\\nFRIDAY, DECEMBER \"a, 1859.\\nTIE CONTENTS OF OUR CHRIsTMAS s\\nNUMBER.',\n        id=\"an issue word that belongs to the headline, 1869-12-24\",\n    ),\n    pytest.param(\n        \"The Jersey City news. (Jersey City [N.J.]) 1889-1906\",\n        \"NEW\\n\\nThe Forum for May.\",\n        \"NEW\\nThe Forum for May.\",\n        id=\"an issue word with no number, leading, 1893-05-02\",\n    ),\n    pytest.param(\n        \"The Big Stone Gap post. [volume] (Big Stone Gap, Wise County, Va.) 1892-1928\",\n        \"Coal Operators Should Live\\n\\n\\nin Big Stone Gap.\",\n        \"Coal Operators Should Live\\nin Big Stone Gap.\",\n        id=\"its own place inside a sentence, 1911-05-03\",\n    ),\n    pytest.param(\n        \"The Toledo chronicle. [volume] (Toledo, Tama County, Iowa) 1873-1924\",\n        \"Hls,sso.oo rs, sso.co\\n\\n100000\\n\\n100000\\n2, COCO\",\n        \"Hls,sso.oo rs, sso.co\\n100000\\n100000\\n2, COCO\",\n        id=\"figures in a table, 1876-01-06\",\n    ),\n    # a short title or place inside a word: these were dropped while names had no boundaries\n    pytest.param(\n        \"The post. [volume] (Middleburg, Snyder County, Pa.) 1864-1883\",\n        \"PoStry\\n\\ncA1RItY.\",\n        \"PoStry\\ncA1RItY.\",\n        id=\"Post inside Poetry, 1876-09-07\",\n    ),\n    pytest.param(\n        \"The Iola register. [volume] (Iola, Allen County, Kansas) 1875-1902\",\n        \"tCopuri0hted.l\\nVIOLA\\n\\nThrice Lost IN a Struggle for a Name,\",\n        \"tCopuri0hted.l\\nVIOLA\\nThrice Lost IN a Struggle for a Name,\",\n        id=\"Iola inside Viola, 1882-09-22\",\n    ),\n    pytest.param(\n        \"The sun. [volume] (New York [N.Y.]) 1833-1916\",\n        \"EAkSUNs AMERICAN MUSEUM\",\n        \"EAkSUNs AMERICAN MUSEUM\",\n        id=\"Sun inside a name, 1863-09-29\",\n    ),\n    # real headline lines from other papers, set beside a short title\n    pytest.param(\n        \"The star. (Cincinnati [Ohio]) 1874-1875\",\n        \"Stars.\",\n        \"Stars.\",\n        id=\"Star inside Stars, from the Lexington weekly intelligencer, 1882-08-26\",\n    ),\n    pytest.param(\n        \"The bee.\",\n        \"BEER.\",\n        \"BEER.\",\n        id=\"Bee inside Beer, from the Weekly Kansas chief, 1881-07-21\",\n    ),\n    pytest.param(\n        None,\n        \"Junc 10 tho Probable Date for\\nHolding the Democratic\\n\\n\\nConvention.\",\n        \"Junc 10 tho Probable Date for\\nHolding the Democratic\\nConvention.\",\n        id=\"no title on record, 1880-02-23\",\n    ),\n]\n\n\n@pytest.mark.parametrize(\"paper, headline, shown\", DROPS + KEEPS)\ndef test_the_display_headline_drops_only_masthead_lines(paper, headline, shown):\n    assert display_headline(headline, paper) == shown\n","numLines":240,"startLine"