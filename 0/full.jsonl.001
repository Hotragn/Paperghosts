{"parentUuid":"e1cea9cb-1ee6-4a98-bc23-8b1eac3e7b5c","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgYxT9d1YRwwBXa3QhoD4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017oz2v6ToQmz6ri5M8r99mG","name":"Bash","input":{"command":"cd \"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts\" && cat scripts/geocode_check.py","description":"Read the geocoder accuracy script"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":822,"cache_read_input_tokens":136068,"output_tokens":341,"output_tokens_details":{"thinking_tokens":121},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":822,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":341,"cache_read_input_tokens":136068,"cache_creation_input_tokens":822,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":822},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_017oz2v6ToQmz6ri5M8r99mG":{"command":"cd \"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts\" && cat scripts/geocode_check.py","description":"Read the geocoder accuracy script"}},"serverClassifierRequest":"e2e4609b-c48b-47c7-bb30-d2cd2fb31c67","apiBlockIndex":3,"requestId":"req_011CgYxT8hSTFm5Tp9n3XAJi","requestRef":"e99db0f2-d452-4bd9-bae2-8d7de0689cb6","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"72a3e603-0459-4bb0-a4a7-326ce51b22cb","timestamp":"2026-10-30T19:15:32.090Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"parentUuid":"72a3e603-0459-4bb0-a4a7-326ce51b22cb","isSidechain":false,"promptId":"3c21d421-8439-4ef3-a792-2ee8b64888f0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017oz2v6ToQmz6ri5M8r99mG","type":"tool_result","content":"\"\"\"The geocoder's accuracy (decision 34), against answers checked by hand in\neval/results/phase2b/geocoder_expected.json:\n1. a seeded 200 of the papers' distinct (place, state) pairs, from the title lookup\n2. the 24 judged reports' story places, as their text gives them, as an early look at the\n   places the reader will extract\n\nA result is right when it is the expected GeoNames ID, or no point where no GeoNames place is\nright. Writes eval/results/phase2b/geocoder.json, with Wilson intervals and each failure's\nkind. `--review` prints the draw with each result's runners-up instead, for checking by hand.\"\"\"\n\nimport json\nimport random\nimport sys\nfrom collections import Counter\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nfrom paperghosts.geo.geonames import Gazetteer, flat, name_key\nfrom paperghosts.geo.titles import state_name\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).parents[1]\nLOOKUP = ROOT / \"data\" / \"titles\" / \"titles.json\"\nRESULTS = ROOT / \"eval\" / \"results\" / \"phase2b\"\nEXPECTED = RESULTS / \"geocoder_expected.json\"\nOUT = RESULTS / \"geocoder.json\"\nSEED, PAIRS = \"2B geocoder\", 200\n\n\ndef query(title):\n    \"\"\"The towns to try for a paper, the cataloguer's first, its modern state, its county.\"\"\"\n    towns = [t for t in (title.get(\"supplied_place\"), title.get(\"place\")) if t]\n    state = title.get(\"modern_state\") or state_name(\n        title.get(\"supplied_state\") or title.get(\"state\")\n    )\n    return list(dict.fromkeys(towns)), state, title.get(\"county\")\n\n\ndef geocode(gazetteer, towns, state, county):\n    found = gazetteer.geocode(None, state)\n    for town in towns:\n        found = gazetteer.geocode(town, state, county)\n        if found[\"place_id\"] is not None:\n            break\n    return found\n\n\ndef order(lccns):\n    \"\"\"The papers in the seeded order the draw walks them.\"\"\"\n    lccns = sorted(lccns)\n    random.Random(SEED).shuffle(lccns)\n    return lccns\n\n\ndef draw():\n    \"\"\"The first 200 distinct (place, state) pairs of the papers, walked in seeded order.\"\"\"\n    titles = json.loads(LOOKUP.read_text())\n    sample, seen = [], set()\n    for lccn in order(titles):\n        towns, state, county = query(titles[lccn])\n        pair = (towns[0] if towns else None, state)\n        if pair not in seen:\n            seen.add(pair)\n            sample.append(\n                {\n                    \"town\": pair[0],\n                    \"state\": state,\n                    \"towns\": towns,\n                    \"county\": county,\n                    \"lccn\": lccn,\n                }\n            )\n        if len(sample) == PAIRS:\n            return sample\n    raise ValueError(\"fewer distinct pairs than the draw needs\")\n\n\ndef rate(right, n):\n    low, high = wilson(right, n)\n    return {\n        \"right\": right,\n        \"n\": n,\n        \"share\": right / n if n else None,\n        \"low\": low,\n        \"high\": high,\n    }\n\n\ndef review(gazetteer, sample):\n    for n, pair in enumerate(sample, 1):\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        code = gazetteer.states.get(pair[\"state\"] or \"\")\n        others = []\n        for town in pair[\"towns\"]:\n            key = flat(name_key(town))\n            for kind, index in (\n                (\"name\", gazetteer.names),\n                (\"alt\", gazetteer.alternates),\n            ):\n                for p in index.get((key, code), []):\n                    county = gazetteer.county_names.get((code, p[\"county\"]))\n                    others.append(\n                        f\"{p['id']} {p['name']} ({county}, {p['code']}, {p['population']}, {kind})\"\n                    )\n        print(\n            f\"{n:3} {pair['towns']} | {pair['state']} | county {pair['county']} | {pair['lccn']}\"\n        )\n        print(\n            f\"    -> {found.get('place_id')} {found.get('name')} ({found.get('county')}, {found.get('feature_code')}, {found.get('population')}) {found.get('reason', '')}\"\n        )\n        for other in dict.fromkeys(others):\n            if not other.startswith(str(found.get(\"place_id\"))):\n                print(f\"       also {other}\")\n\n\ndef main():\n    gazetteer = Gazetteer()\n    sample = draw()\n    if sys.argv[1:] == [\"--review\"]:\n        review(gazetteer, sample)\n        return\n    expected = json.loads(EXPECTED.read_text())\n    papers, kinds = [], Counter()\n    for pair in sample:\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        want = expected[\"papers\"][f\"{pair['town']}|{pair['state']}\"]\n        right = found[\"place_id\"] == want[\"place_id\"] and want[\"failure\"] is None\n        if not right:\n            kinds[want[\"failure\"]] += 1\n        papers.append(\n            pair\n            | {\n                \"found\": found.get(\"place_id\"),\n                \"reason\": found.get(\"reason\"),\n                \"expected\": want[\"place_id\"],\n                \"right\": right,\n                \"failure\": None if right else want[\"failure\"],\n            }\n        )\n    resolved = [p for p in papers if p[\"found\"] is not None]\n    stories, hinted = [], Counter()\n    for story in expected[\"stories\"]:\n        found = gazetteer.geocode(story[\"town\"], story[\"state\"], story.get(\"county\"))\n        row = story | {\n            \"found\": found.get(\"place_id\"),\n            \"reason\": found.get(\"reason\"),\n            \"right\": found.get(\"place_id\") == story[\"place_id\"],\n        }\n        if story[\"given\"] == \"town only\":\n            # what the paper's own state would give, against where the story happened\n            guess = gazetteer.geocode(\n                story[\"town\"], story[\"paper_state\"], story.get(\"county\")\n            )\n            row[\"with_the_papers_state\"] = guess.get(\"place_id\")\n            hinted[\n                \"nothing\"\n                if guess.get(\"place_id\") is None\n                else \"right\"\n                if guess[\"place_id\"] == story[\"true_place_id\"]\n                else \"a wrong place\"\n            ] += 1\n        stories.append(row)\n    named = [s for s in stories if s[\"town\"] and s[\"state\"]]\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"gazetteer\": gazetteer.source,\n        \"papers\": {\n            \"seed\": SEED,\n            \"pairs\": len(papers),\n            \"right\": rate(sum(p[\"right\"] for p in papers), len(papers)),\n            \"resolved\": len(resolved),\n            \"right_when_resolved\": rate(\n                sum(p[\"right\"] for p in resolved), len(resolved)\n            ),\n            \"failures\": dict(kinds),\n            \"results\": papers,\n        },\n        \"stories\": {\n            \"reports\": len(stories),\n            \"as_the_text_gives_them\": dict(Counter(s[\"given\"] for s in stories)),\n            \"right_with_town_and_state\": rate(\n                sum(s[\"right\"] for s in named), len(named)\n            ),\n            \"town_only_with_the_papers_state\": dict(hinted),\n            \"results\": stories,\n        },\n    }\n    OUT.write_text(json.dumps(report, indent=1, ensure_ascii=False) + \"\\n\")\n    print(\n        json.dumps(\n            {k: v for k, v in report[\"papers\"].items() if k != \"results\"}, indent=1\n        )\n    )\n    print(\n        json.dumps(\n            {k: v for k, v in report[\"stories\"].items() if k != \"results\"}, indent=1\n        )\n    )\n\n\nif __name__ == \"__main__\":\n    main()","is_error":false}]},"uuid":"60ebc553-3887-4b07-97ad-06ef2fdff694","timestamp":"2026-10-30T19:15:32.840Z","toolUseResult":{"stdout":"\"\"\"The geocoder's accuracy (decision 34), against answers checked by hand in\neval/results/phase2b/geocoder_expected.json:\n1. a seeded 200 of the papers' distinct (place, state) pairs, from the title lookup\n2. the 24 judged reports' story places, as their text gives them, as an early look at the\n   places the reader will extract\n\nA result is right when it is the expected GeoNames ID, or no point where no GeoNames place is\nright. Writes eval/results/phase2b/geocoder.json, with Wilson intervals and each failure's\nkind. `--review` prints the draw with each result's runners-up instead, for checking by hand.\"\"\"\n\nimport json\nimport random\nimport sys\nfrom collections import Counter\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nfrom paperghosts.geo.geonames import Gazetteer, flat, name_key\nfrom paperghosts.geo.titles import state_name\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).parents[1]\nLOOKUP = ROOT / \"data\" / \"titles\" / \"titles.json\"\nRESULTS = ROOT / \"eval\" / \"results\" / \"phase2b\"\nEXPECTED = RESULTS / \"geocoder_expected.json\"\nOUT = RESULTS / \"geocoder.json\"\nSEED, PAIRS = \"2B geocoder\", 200\n\n\ndef query(title):\n    \"\"\"The towns to try for a paper, the cataloguer's first, its modern state, its county.\"\"\"\n    towns = [t for t in (title.get(\"supplied_place\"), title.get(\"place\")) if t]\n    state = title.get(\"modern_state\") or state_name(\n        title.get(\"supplied_state\") or title.get(\"state\")\n    )\n    return list(dict.fromkeys(towns)), state, title.get(\"county\")\n\n\ndef geocode(gazetteer, towns, state, county):\n    found = gazetteer.geocode(None, state)\n    for town in towns:\n        found = gazetteer.geocode(town, state, county)\n        if found[\"place_id\"] is not None:\n            break\n    return found\n\n\ndef order(lccns):\n    \"\"\"The papers in the seeded order the draw walks them.\"\"\"\n    lccns = sorted(lccns)\n    random.Random(SEED).shuffle(lccns)\n    return lccns\n\n\ndef draw():\n    \"\"\"The first 200 distinct (place, state) pairs of the papers, walked in seeded order.\"\"\"\n    titles = json.loads(LOOKUP.read_text())\n    sample, seen = [], set()\n    for lccn in order(titles):\n        towns, state, county = query(titles[lccn])\n        pair = (towns[0] if towns else None, state)\n        if pair not in seen:\n            seen.add(pair)\n            sample.append(\n                {\n                    \"town\": pair[0],\n                    \"state\": state,\n                    \"towns\": towns,\n                    \"county\": county,\n                    \"lccn\": lccn,\n                }\n            )\n        if len(sample) == PAIRS:\n            return sample\n    raise ValueError(\"fewer distinct pairs than the draw needs\")\n\n\ndef rate(right, n):\n    low, high = wilson(right, n)\n    return {\n        \"right\": right,\n        \"n\": n,\n        \"share\": right / n if n else None,\n        \"low\": low,\n        \"high\": high,\n    }\n\n\ndef review(gazetteer, sample):\n    for n, pair in enumerate(sample, 1):\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        code = gazetteer.states.get(pair[\"state\"] or \"\")\n        others = []\n        for town in pair[\"towns\"]:\n            key = flat(name_key(town))\n            for kind, index in (\n                (\"name\", gazetteer.names),\n                (\"alt\", gazetteer.alternates),\n            ):\n                for p in index.get((key, code), []):\n                    county = gazetteer.county_names.get((code, p[\"county\"]))\n                    others.append(\n                        f\"{p['id']} {p['name']} ({county}, {p['code']}, {p['population']}, {kind})\"\n                    )\n        print(\n            f\"{n:3} {pair['towns']} | {pair['state']} | county {pair['county']} | {pair['lccn']}\"\n        )\n        print(\n            f\"    -> {found.get('place_id')} {found.get('name')} ({found.get('county')}, {found.get('feature_code')}, {found.get('population')}) {found.get('reason', '')}\"\n        )\n        for other in dict.fromkeys(others):\n            if not other.startswith(str(found.get(\"place_id\"))):\n                print(f\"       also {other}\")\n\n\ndef main():\n    gazetteer = Gazetteer()\n    sample = draw()\n    if sys.argv[1:] == [\"--review\"]:\n        review(gazetteer, sample)\n        return\n    expected = json.loads(EXPECTED.read_text())\n    papers, kinds = [], Counter()\n    for pair in sample:\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        want = expected[\"papers\"][f\"{pair['town']}|{pair['state']}\"]\n        right = found[\"place_id\"] == want[\"place_id\"] and want[\"failure\"] is None\n        if not right:\n            kinds[want[\"failure\"]] += 1\n        papers.append(\n            pair\n            | {\n                \"found\": found.get(\"place_id\"),\n                \"reason\": found.get(\"reason\"),\n                \"expected\": want[\"place_id\"],\n                \"right\": right,\n                \"failure\": None if right else want[\"failure\"],\n            }\n        )\n    resolved = [p for p in papers if p[\"found\"] is not None]\n    stories, hinted = [], Counter()\n    for story in expected[\"stories\"]:\n        found = gazetteer.geocode(story[\"town\"], story[\"state\"], story.get(\"county\"))\n        row = story | {\n            \"found\": found.get(\"place_id\"),\n            \"reason\": found.get(\"reason\"),\n            \"right\": found.get(\"place_id\") == story[\"place_id\"],\n        }\n        if story[\"given\"] == \"town only\":\n            # what the paper's own state would give, against where the story happened\n            guess = gazetteer.geocode(\n                story[\"town\"], story[\"paper_state\"], story.get(\"county\")\n            )\n            row[\"with_the_papers_state\"] = guess.get(\"place_id\")\n            hinted[\n                \"nothing\"\n                if guess.get(\"place_id\") is None\n                else \"right\"\n                if guess[\"place_id\"] == story[\"true_place_id\"]\n                else \"a wrong place\"\n            ] += 1\n        stories.append(row)\n    named = [s for s in stories if s[\"town\"] and s[\"state\"]]\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"gazetteer\": gazetteer.source,\n        \"papers\": {\n            \"seed\": SEED,\n            \"pairs\": len(papers),\n            \"right\": rate(sum(p[\"right\"] for p in papers), len(papers)),\n            \"resolved\": len(resolved),\n            \"right_when_resolved\": rate(\n                sum(p[\"right\"] for p in resolved), len(resolved)\n            ),\n            \"failures\": dict(kinds),\n            \"results\": papers,\n        },\n        \"stories\": {\n            \"reports\": len(stories),\n            \"as_the_text_gives_them\": dict(Counter(s[\"given\"] for s in stories)),\n            \"right_with_town_and_state\": rate(\n                sum(s[\"right\"] for s in named), len(named)\n            ),\n            \"town_only_with_the_papers_state\": dict(hinted),\n            \"results\": stories,\n        },\n    }\n    OUT.write_text(json.dumps(report, indent=1, ensure_ascii=False) + \"\\n\")\n    print(\n        json.dumps(\n            {k: v for k, v in report[\"papers\"].items() if k != \"results\"}, indent=1\n        )\n    )\n    print(\n        json.dumps(\n            {k: v for k, v in report[\"stories\"].items() if k != \"results\"}, indent=1\n        )\n    )\n\n\nif __name__ == \"__main__\":\n    main()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"e2e4609b-c48b-47c7-bb30-d2cd2fb31c67","context":{"git_state":{"cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","root":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","branch":"phase-2b-data-layer","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":13,"untracked":null,"untracked_normal":4},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}]}},"live_cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"72a3e603-0459-4bb0-a4a7-326ce51b22cb","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"type":"api-request-blob","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","hash":"4e1b80862771666d75e887d9d4c77249fe143225c2d843b034dd819aeac186c8","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"text","text":"Red then green confirmed. Next, the accuracy script: it should report results with and without the record check."},{"type":"tool_use","id":"toolu_01F5GNd5DhyEmTkpd26ZsHmW","name":"mcp__ccd_turn__update_plan","input":{"advance":true},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_017oz2v6ToQmz6ri5M8r99mG","name":"Bash","input":{"command":"cd \"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts\" && cat scripts/geocode_check.py","description":"Read the geocoder accuracy script"},"caller":{"type":"direct"}}]}}
{"type":"api-request-blob","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","hash":"68aa6180e9216b7e789035e1fe5b938f76060ba4c96a4cd8172c1bc259aa80b1","message":{"role":"user","content":[{"tool_use_id":"toolu_01F5GNd5DhyEmTkpd26ZsHmW","type":"tool_result","content":[{"type":"text","text":"Plan updated: step 2 of 7 is in progress."}]},{"tool_use_id":"toolu_017oz2v6ToQmz6ri5M8r99mG","type":"tool_result","content":"\"\"\"The geocoder's accuracy (decision 34), against answers checked by hand in\neval/results/phase2b/geocoder_expected.json:\n1. a seeded 200 of the papers' distinct (place, state) pairs, from the title lookup\n2. the 24 judged reports' story places, as their text gives them, as an early look at the\n   places the reader will extract\n\nA result is right when it is the expected GeoNames ID, or no point where no GeoNames place is\nright. Writes eval/results/phase2b/geocoder.json, with Wilson intervals and each failure's\nkind. `--review` prints the draw with each result's runners-up instead, for checking by hand.\"\"\"\n\nimport json\nimport random\nimport sys\nfrom collections import Counter\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nfrom paperghosts.geo.geonames import Gazetteer, flat, name_key\nfrom paperghosts.geo.titles import state_name\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).parents[1]\nLOOKUP = ROOT / \"data\" / \"titles\" / \"titles.json\"\nRESULTS = ROOT / \"eval\" / \"results\" / \"phase2b\"\nEXPECTED = RESULTS / \"geocoder_expected.json\"\nOUT = RESULTS / \"geocoder.json\"\nSEED, PAIRS = \"2B geocoder\", 200\n\n\ndef query(title):\n    \"\"\"The towns to try for a paper, the cataloguer's first, its modern state, its county.\"\"\"\n    towns = [t for t in (title.get(\"supplied_place\"), title.get(\"place\")) if t]\n    state = title.get(\"modern_state\") or state_name(\n        title.get(\"supplied_state\") or title.get(\"state\")\n    )\n    return list(dict.fromkeys(towns)), state, title.get(\"county\")\n\n\ndef geocode(gazetteer, towns, state, county):\n    found = gazetteer.geocode(None, state)\n    for town in towns:\n        found = gazetteer.geocode(town, state, county)\n        if found[\"place_id\"] is not None:\n            break\n    return found\n\n\ndef order(lccns):\n    \"\"\"The papers in the seeded order the draw walks them.\"\"\"\n    lccns = sorted(lccns)\n    random.Random(SEED).shuffle(lccns)\n    return lccns\n\n\ndef draw():\n    \"\"\"The first 200 distinct (place, state) pairs of the papers, walked in seeded order.\"\"\"\n    titles = json.loads(LOOKUP.read_text())\n    sample, seen = [], set()\n    for lccn in order(titles):\n        towns, state, county = query(titles[lccn])\n        pair = (towns[0] if towns else None, state)\n        if pair not in seen:\n            seen.add(pair)\n            sample.append(\n                {\n                    \"town\": pair[0],\n                    \"state\": state,\n                    \"towns\": towns,\n                    \"county\": county,\n                    \"lccn\": lccn,\n                }\n            )\n        if len(sample) == PAIRS:\n            return sample\n    raise ValueError(\"fewer distinct pairs than the draw needs\")\n\n\ndef rate(right, n):\n    low, high = wilson(right, n)\n    return {\n        \"right\": right,\n        \"n\": n,\n        \"share\": right / n if n else None,\n        \"low\": low,\n        \"high\": high,\n    }\n\n\ndef review(gazetteer, sample):\n    for n, pair in enumerate(sample, 1):\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        code = gazetteer.states.get(pair[\"state\"] or \"\")\n        others = []\n        for town in pair[\"towns\"]:\n            key = flat(name_key(town))\n            for kind, index in (\n                (\"name\", gazetteer.names),\n                (\"alt\", gazetteer.alternates),\n            ):\n                for p in index.get((key, code), []):\n                    county = gazetteer.county_names.get((code, p[\"county\"]))\n                    others.append(\n                        f\"{p['id']} {p['name']} ({county}, {p['code']}, {p['population']}, {kind})\"\n                    )\n        print(\n            f\"{n:3} {pair['towns']} | {pair['state']} | county {pair['county']} | {pair['lccn']}\"\n        )\n        print(\n            f\"    -> {found.get('place_id')} {found.get('name')} ({found.get('county')}, {found.get('feature_code')}, {found.get('population')}) {found.get('reason', '')}\"\n        )\n        for other in dict.fromkeys(others):\n            if not other.startswith(str(found.get(\"place_id\"))):\n                print(f\"       also {other}\")\n\n\ndef main():\n    gazetteer = Gazetteer()\n    sample = draw()\n    if sys.argv[1:] == [\"--review\"]:\n        review(gazetteer, sample)\n        return\n    expected = json.loads(EXPECTED.read_text())\n    papers, kinds = [], Counter()\n    for pair in sample:\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        want = expected[\"papers\"][f\"{pair['town']}|{pair['state']}\"]\n        right = found[\"place_id\"] == want[\"place_id\"] and want[\"failure\"] is None\n        if not right:\n            kinds[want[\"failure\"]] += 1\n        papers.append(\n            pair\n            | {\n                \"found\": found.get(\"place_id\"),\n                \"reason\": found.get(\"reason\"),\n                \"expected\": want[\"place_id\"],\n                \"right\": right,\n                \"failure\": None if right else want[\"failure\"],\n            }\n        )\n    resolved = [p for p in papers if p[\"found\"] is not None]\n    stories, hinted = [], Counter()\n    for story in expected[\"stories\"]:\n        found = gazetteer.geocode(story[\"town\"], story[\"state\"], story.get(\"county\"))\n        row = story | {\n            \"found\": found.get(\"place_id\"),\n            \"reason\": found.get(\"reason\"),\n            \"right\": found.get(\"place_id\") == story[\"place_id\"],\n        }\n        if story[\"given\"] == \"town only\":\n            # what the paper's own state would give, against where the story happened\n            guess = gazetteer.geocode(\n                story[\"town\"], story[\"paper_state\"], story.get(\"county\")\n            )\n            row[\"with_the_papers_state\"] = guess.get(\"place_id\")\n            hinted[\n                \"nothing\"\n                if guess.get(\"place_id\") is None\n                else \"right\"\n                if guess[\"place_id\"] == story[\"true_place_id\"]\n                else \"a wrong place\"\n            ] += 1\n        stories.append(row)\n    named = [s for s in stories if s[\"town\"] and s[\"state\"]]\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"gazetteer\": gazetteer.source,\n        \"papers\": {\n            \"seed\": SEED,\n            \"pairs\": len(papers),\n            \"right\": rate(sum(p[\"right\"] for p in papers), len(papers)),\n            \"resolved\": len(resolved),\n            \"right_when_resolved\": rate(\n                sum(p[\"right\"] for p in resolved), len(resolved)\n            ),\n            \"failures\": dict(kinds),\n            \"results\": papers,\n        },\n        \"stories\": {\n            \"reports\": len(stories),\n            \"as_the_text_gives_them\": dict(Counter(s[\"given\"] for s in stories)),\n            \"right_with_town_and_state\": rate(\n                sum(s[\"right\"] for s in named), len(named)\n            ),\n            \"town_only_with_the_papers_state\": dict(hinted),\n            \"results\": stories,\n        },\n    }\n    OUT.write_text(json.dumps(report, indent=1, ensure_ascii=False) + \"\\n\")\n    print(\n        json.dumps(\n            {k: v for k, v in report[\"papers\"].items() if k != \"results\"}, indent=1\n        )\n    )\n    print(\n        json.dumps(\n            {k: v for k, v in report[\"stories\"].items() if k != \"results\"}, indent=1\n        )\n    )\n\n\nif __name__ == \"__main__\":\n    main()","is_error":false}]}}
