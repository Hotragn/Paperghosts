en or not given.get(\"place\"):\n46\t        return printed | {\"record\": \"none\"}\n47\t    counties, states = (\n48\t        given.get(\"counties\") or [],\n49\t        given.get(\"states\") or [given[\"state\"]],\n50\t    )\n51\t    agrees = gazetteer.same_county(printed, counties, states)\n52\t    if agrees is None:\n53\t        why = (\n54\t            \"can't be checked against GeoNames' counties\"\n55\t            if counties\n56\t            else \"has no county to check\"\n57\t        )\n58\t        if printed[\"place_id\"] is not None:\n59\t            return printed | {\"record\": why}\n...\n65\t    how = (\n66\t        \"replaced the printed place\"\n67\t        if printed[\"place_id\"] is not None\n68\t        else \"found what the printed place didn't\"\n69\t    )\n70\t    for county in counties:\n71\t        catalogued = gazetteer.geocode(given[\"place\"], given[\"state\"], county)\n72\t        if catalogued[\"place_id\"] is not None and gazetteer.same_county(\n73\t            catalogued, counties, states\n74\t        ):\n75\t            return catalogued | {\"record\": how}\n76\t    ghost = gazetteer.ghost(given[\"place\"], given[\"state\"], counties)\n77\t    if ghost:\n78\t        return ghost | {\"record\": \"a ghost town in the record's county\"}\n79\t    return gazetteer.base() | {\n80\t        \"reason\": \"outside the record's county, whose own place isn't in GeoNames\",\n81\t        \"record\": \"disagrees, and its own place isn't in GeoNames\","}]}}
