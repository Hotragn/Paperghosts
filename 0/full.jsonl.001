{"parentUuid":"29557097-3aca-4b81-8904-0b5739a61f70","isSidechain":false,"promptId":"10e32944-f26c-4e52-a7ee-6e5ea350bb2b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Ga5sGxnwhjkFuJUXVgKoa","type":"tool_result","content":"1\t\"\"\"Lexicon v1 finds ghost terms and their OCR misreadings, leaves ordinary words alone, and\n2\tsorts knocking-and-spirits articles without a ghost term into the near-miss pool.\"\"\"\n3\t\n4\timport pytest\n5\t\n6\tfrom paperghosts.ingest.lexicon import (\n7\t    GHOST,\n8\t    GHOST_STEMS,\n9\t    NEAR_MISS,\n10\t    NEAR_MISS_STEMS,\n11\t    ghost_terms,\n12\t    near_miss_terms,\n13\t)\n14\t\n15\t\n16\tdef test_every_term_has_precheck_stems():\n17\t    # a term with no stems would be skipped by the pre-check and lose its recall silently\n18\t    assert GHOST_STEMS.keys() == GHOST.keys()\n19\t    assert NEAR_MISS_STEMS.keys() == NEAR_MISS.keys()\n20\t\n21\t\n22\t@pytest.mark.parametrize(\n23\t    (\"text\", \"term\"),\n24\t    [\n25\t        (\"A GHOST was seen on the stairs\", \"ghost\"),\n26\t        (\"ghostly figures\", \"ghost\"),\n27\t        (\"a ghost-like form\", \"ghost\"),\n28\t        (\"the haunted house\", \"haunt\"),\n29\t        (\"an apparition in white\", \"apparition\"),\n30\t        (\"a spectre at the window\", \"spectre\"),\n31\t        (\"the specter\", \"spectre\"),\n32\t        (\"a spectral light\", \"spectre\"),\n33\t        (\"the phantom ship\", \"phantom\"),\n34\t        (\"a phantasm\", \"phantom\"),\n35\t        (\"spooks in the attic\", \"spook\"),\n36\t        (\"a wraith\", \"wraith\"),\n37\t        (\"a poltergeist\", \"poltergeist\"),\n38\t        (\"the banshee wailed\", \"banshee\"),\n39\t        (\"hobgoblins\", \"goblin\"),\n40\t        (\"the mysterious knockings\", \"knocking\"),\n41\t        (\"spirit rappings\", \"rapping\"),\n42\t        (\"the Rochester Rappers\", \"rapping\"),\n43\t    ],\n44\t)\n45\tdef test_ghost_terms(text, term):\n46\t    assert term in ghost_terms(text)\n47\t\n48\t\n49\t@pytest.mark.parametrize(\n50\t    (\"scanned\", \"term\"),\n51\t    [\n52\t        (\"ghoft\", \"ghost\"),  # long s\n53\t        (\"gbost\", \"ghost\"),\n54\t        (\"gliost\", \"ghost\"),\n55\t        (\"gh0st\", \"ghost\"),\n56\t        (\"ghosl\", \"ghost\"),\n57\t        (\"appariiion\", \"apparition\"),\n58\t        (\"apparitlon\", \"apparition\"),\n59\t        (\"aparition\", \"apparition\"),\n60\t        (\"hannted\", \"haunt\"),\n61\t        (\"baunted\", \"haunt\"),\n62\t        (\"fpectre\", \"spectre\"),\n63\t        (\"spcctre\", \"spectre\"),\n64\t        (\"pbantom\", \"phantom\"),\n65\t        (\"phautom\", \"phantom\"),\n66\t        (\"knockiygs\", \"knocking\"),\n67\t        (\"knockiugs\", \"knocking\"),\n68\t        (\"knockngs\", \"knocking\"),\n69\t        (\"rapplngs\", \"rapping\"),\n70\t        (\"rappngs\", \"rapping\"),\n71\t    ],\n72\t)\n73\tdef test_ocr_misreadings_keep_their_spelling(scanned, term):\n74\t    assert ghost_terms(f\"there was an {scanned} here\") == {term: [scanned]}\n75\t\n76\t\n77\t@pytest.mark.parametrize(\n78\t    \"text\",\n79\t    [\n80\t        \"the host and his guests\",\n81\t        \"a ghastly murder\",\n82\t        \"hunted down\",\n83\t        \"a spectacle of respect\",\n84\t        \"a knock at the door\",\n85\t        \"knocking at the door\",\n86\t        \"a brass rapper\",\n87\t        \"spirits of turpentine\",\n88\t        \"a silver goblet\",\n89\t        \"a spcck of dust\",  # speck misread, the most common false spook in 1850\n90\t    ],\n91\t)\n92\tdef test_ordinary_words_are_not_ghost_terms(text):\n93\t    assert ghost_terms(text) == {}\n94\t\n95\t\n96\t@pytest.mark.parametrize(\n97\t    (\"text\", \"term\"),\n98\t    [\n99\t        (\"a knock at the door\", \"knock\"),\n100\t        (\"strange noises were heard\", \"noise\"),\n101\t        (\"mysterious\\nsounds\", \"noise\"),\n102\t        (\"evil spirits\", \"spirit\"),\n103\t        (\"the spiritualists met\", \"spiritualism\"),\n104\t        (\"a séance\", \"seance\"),\n105\t        (\"supernatural agency\", \"supernatural\"),\n106\t    ],\n107\t)\n108\tdef test_near_miss_terms(text, term):\n109\t    assert term in near_miss_terms(text)\n110\t\n111\t\n112\tdef test_words_hyphenated_across_lines_are_joined():\n113\t    assert set(ghost_terms(\"a strange appa-\\nrition, ghost-\\nly pale\")) == {\n114\t        \"apparition\",\n115\t        \"ghost\",\n116\t    }\n117\t\n118\t\n119\tdef test_noises_split_across_lines_without_a_hyphen():\n120\t    # as the New York herald of 1850-04-30 printed them\n121\t    assert set(ghost_terms(\"the Rochester knock\\nings and the rapp\\nings\")) == {\n122\t        \"knocking\",\n123\t        \"rapping\",\n124\t    }\n125\t\n126\t\n127\tdef test_the_walking_skeleton_article_is_a_candidate():\n128\t    # its OCR, from the Lewistown gazette of 1850-07-26: no ghost word, only the noises\n129\t    headline = \"New Series-VOl. 4-NO. 40.\\n\\nTHE MYSTERIOUS KNOCKIyGs.\"\n130\t    line = \"in Stratford, Conn, mysterious rapplngs,\"\n131\t    assert set(ghost_terms(f\"{headline}\\n{line}\")) == {\"knocking\", \"rapping\"}\n132\t"}]},"uuid":"1a77797e-cbe4-4ccb-94b8-dd93c5ce88b4","timestamp":"2026-10-30T14:43:30.241Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_lexicon.py","content":"\"\"\"Lexicon v1 finds ghost terms and their OCR misreadings, leaves ordinary words alone, and\nsorts knocking-and-spirits articles without a ghost term into the near-miss pool.\"\"\"\n\nimport pytest\n\nfrom paperghosts.ingest.lexicon import (\n    GHOST,\n    GHOST_STEMS,\n    NEAR_MISS,\n    NEAR_MISS_STEMS,\n    ghost_terms,\n    near_miss_terms,\n)\n\n\ndef test_every_term_has_precheck_stems():\n    # a term with no stems would be skipped by the pre-check and lose its recall silently\n    assert GHOST_STEMS.keys() == GHOST.keys()\n    assert NEAR_MISS_STEMS.keys() == NEAR_MISS.keys()\n\n\n@pytest.mark.parametrize(\n    (\"text\", \"term\"),\n    [\n        (\"A GHOST was seen on the stairs\", \"ghost\"),\n        (\"ghostly figures\", \"ghost\"),\n        (\"a ghost-like form\", \"ghost\"),\n        (\"the haunted house\", \"haunt\"),\n        (\"an apparition in white\", \"apparition\"),\n        (\"a spectre at the window\", \"spectre\"),\n        (\"the specter\", \"spectre\"),\n        (\"a spectral light\", \"spectre\"),\n        (\"the phantom ship\", \"phantom\"),\n        (\"a phantasm\", \"phantom\"),\n        (\"spooks in the attic\", \"spook\"),\n        (\"a wraith\", \"wraith\"),\n        (\"a poltergeist\", \"poltergeist\"),\n        (\"the banshee wailed\", \"banshee\"),\n        (\"hobgoblins\", \"goblin\"),\n        (\"the mysterious knockings\", \"knocking\"),\n        (\"spirit rappings\", \"rapping\"),\n        (\"the Rochester Rappers\", \"rapping\"),\n    ],\n)\ndef test_ghost_terms(text, term):\n    assert term in ghost_terms(text)\n\n\n@pytest.mark.parametrize(\n    (\"scanned\", \"term\"),\n    [\n        (\"ghoft\", \"ghost\"),  # long s\n        (\"gbost\", \"ghost\"),\n        (\"gliost\", \"ghost\"),\n        (\"gh0st\", \"ghost\"),\n        (\"ghosl\", \"ghost\"),\n        (\"appariiion\", \"apparition\"),\n        (\"apparitlon\", \"apparition\"),\n        (\"aparition\", \"apparition\"),\n        (\"hannted\", \"haunt\"),\n        (\"baunted\", \"haunt\"),\n        (\"fpectre\", \"spectre\"),\n        (\"spcctre\", \"spectre\"),\n        (\"pbantom\", \"phantom\"),\n        (\"phautom\", \"phantom\"),\n        (\"knockiygs\", \"knocking\"),\n        (\"knockiugs\", \"knocking\"),\n        (\"knockngs\", \"knocking\"),\n        (\"rapplngs\", \"rapping\"),\n        (\"rappngs\", \"rapping\"),\n    ],\n)\ndef test_ocr_misreadings_keep_their_spelling(scanned, term):\n    assert ghost_terms(f\"there was an {scanned} here\") == {term: [scanned]}\n\n\n@pytest.mark.parametrize(\n    \"text\",\n    [\n        \"the host and his guests\",\n        \"a ghastly murder\",\n        \"hunted down\",\n        \"a spectacle of respect\",\n        \"a knock at the door\",\n        \"knocking at the door\",\n        \"a brass rapper\",\n        \"spirits of turpentine\",\n        \"a silver goblet\",\n        \"a spcck of dust\",  # speck misread, the most common false spook in 1850\n    ],\n)\ndef test_ordinary_words_are_not_ghost_terms(text):\n    assert ghost_terms(text) == {}\n\n\n@pytest.mark.parametrize(\n    (\"text\", \"term\"),\n    [\n        (\"a knock at the door\", \"knock\"),\n        (\"strange noises were heard\", \"noise\"),\n        (\"mysterious\\nsounds\", \"noise\"),\n        (\"evil spirits\", \"spirit\"),\n        (\"the spiritualists met\", \"spiritualism\"),\n        (\"a séance\", \"seance\"),\n        (\"supernatural agency\", \"supernatural\"),\n    ],\n)\ndef test_near_miss_terms(text, term):\n    assert term in near_miss_terms(text)\n\n\ndef test_words_hyphenated_across_lines_are_joined():\n    assert set(ghost_terms(\"a strange appa-\\nrition, ghost-\\nly pale\")) == {\n        \"apparition\",\n        \"ghost\",\n    }\n\n\ndef test_noises_split_across_lines_without_a_hyphen():\n    # as the New York herald of 1850-04-30 printed them\n    assert set(ghost_terms(\"the Rochester knock\\nings and the rapp\\nings\")) == {\n        \"knocking\",\n        \"rapping\",\n    }\n\n\ndef test_the_walking_skeleton_article_is_a_candidate():\n    # its OCR, from the Lewistown gazette of 1850-07-26: no ghost word, only the noises\n    headline = \"New Series-VOl. 4-NO. 40.\\n\\nTHE MYSTERIOUS KNOCKIyGs.\"\n    line = \"in Stratford, Conn, mysterious rapplngs,\"\n    assert set(ghost_terms(f\"{headline}\\n{line}\")) == {\"knocking\", \"rapping\"}\n","numLines":132,"startLine":1,"totalLines":132}},"sourceToolAssistantUUID":"29557097-3aca-4b81-8904-0b5739a61f70","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entr