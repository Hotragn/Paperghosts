precheck):","+def _find(matcher, stems, text, precheck, together=None):","     text = text.replace(\"-\\n\", \"\")  # rejoin words hyphenated at a line end","     if precheck:","         folded = text.lower().translate(FOLD)"]},{"oldStart":93,"oldLines":12,"newStart":118,"newLines":18,"lines":["     for match in matcher.finditer(text):","         form = \" \".join(match.group().lower().split())","         found.setdefault(match.lastgroup, set()).add(form)","+    for term, words in (together or {}).items():","+        forms = [","+            {match.group().lower() for match in word.finditer(text)} for word in words","+        ]","+        if all(forms):","+            found[term] = set().union(*forms)","     return {term: sorted(forms) for term, forms in found.items()}"," "," "," def ghost_terms(text, precheck=True):","     \"\"\"Each ghost term in the text, with the spellings it was scanned as.\"\"\"","-    return _find(GHOST_MATCHER, _GHOST_STEMS, text, precheck)","+    return _find(GHOST_MATCHER, _GHOST_STEMS, text, precheck, _TOGETHER)"," "," "," def near_miss_terms(text, precheck=True):"]}]}],"moreFiles":0,"changedFiles":["/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/paperghosts/ingest/lexicon.py"]}},"serverClassifierContext":{"request":"d8551946-f45f-4d2b-aede-f659c10f0344","context":{"git_state":{"cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","root":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","branch":"phase-2a-lexicon-v2","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":1,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/Paperghosts","visibility"