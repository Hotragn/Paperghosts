{"parentUuid":"f0a8e268-412e-4e31-85ea-e549416b6eac","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgYYzQZzPNJ3BfmsReoQU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01X5cZPwzUvcsJDdcVTcRDmh","name":"Read","input":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","limit":480},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6165,"cache_read_input_tokens":102724,"output_tokens":116,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":6165,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":116,"cache_read_input_tokens":102724,"cache_creation_input_tokens":6165,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6165},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01X5cZPwzUvcsJDdcVTcRDmh":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","limit":480}},"serverClassifierRequest":"42c57f72-4872-4269-852a-910de298ff2a","apiBlockIndex":0,"requestId":"req_011CgYYzPeBWZbQ8nLb92zXG","requestRef":"bc06bd1f-917c-45a8-9eff-707f4375e320","requestedModel":"claude-opus-5-5","attributionMcpServer":"ccd_turn","attributionMcpTool":"update_plan","type":"assistant","uuid":"7315eeb7-aa6b-49c4-aed3-cd003b0a043d","timestamp":"2026-10-30T14:07:50.020Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
{"parentUuid":"7315eeb7-aa6b-49c4-aed3-cd003b0a043d","isSidechain":false,"promptId":"efbe7dae-4a3a-47ef-9f27-91c90fdaed9c","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X5cZPwzUvcsJDdcVTcRDmh","type":"tool_result","content":"1\t\"\"\"make eval: eval A over the archive read in Phase 2A. It writes eval/results/eval_a.json,\n2\tand its charts and hand-judged samples to eval/results/eval_a/.\n3\t\n4\t1. EDA: by year, by state and by term; candidate lengths; OCR quality, as the share of words\n5\t   /usr/share/dict/words knows; reprint clusters among the candidates; and the candidates\n6\t   whose scan has no batch path, which can show a clipping only if loc.gov lists the page.\n7\t2. Composition: 200 candidates at random, each put in a category by hand in\n8\t   composition.json. The categories are defined in decision 27.\n9\t3. Recall: 300 articles from the near-miss reservoirs and 300 from the random ones, each\n10\t   weighted by its year's share of the pool, marked by hand in recall.json.\n11\t\n12\tEvery sample is seeded, so a rerun draws the same articles and keeps the judgments made.\n13\t\"\"\"\n14\t\n15\timport itertools\n16\timport json\n17\timport random\n18\timport re\n19\timport zlib\n20\tfrom collections import Counter, defaultdict\n21\tfrom concurrent.futures import ProcessPoolExecutor\n22\tfrom datetime import UTC, datetime\n23\tfrom pathlib import Path\n24\t\n25\timport zstandard\n26\tfrom charts import draw_all\n27\t\n28\tfrom paperghosts.cluster.reprints import clusters, keys\n29\tfrom paperghosts.ingest import lexicon\n30\tfrom paperghosts.ingest.crops import BATCH_PATH\n31\tfrom paperghosts.ingest.prefilter import SAMPLE_SIZE\n32\tfrom paperghosts.ingest.year import code_version\n33\tfrom paperghosts.stats import wilson\n34\t\n35\tROOT = Path(__file__).resolve().parents[1]\n36\tDATA = ROOT / \"data\"\n37\tRESULTS = ROOT / \"eval\" / \"results\"\n38\tOUT = RESULTS / \"eval_a\"\n39\tDICTIONARY = Path(\"/usr/share/dict/words\")\n40\tOCR_ONE_IN = 20  # OCR quality is measured on one candidate in twenty, chosen by its id\n41\tCOMPOSITION, RECALL, REPRINT_CHECK = 200, 300, 20\n42\tCATEGORIES = (\n43\t    \"ghost_report\",\n44\t    \"fiction\",\n45\t    \"religious\",\n46\t    \"figurative\",\n47\t    \"name_or_title\",\n48\t    \"social_event\",\n49\t    \"other\",\n50\t)\n51\tWORD = re.compile(r\"[a-z]{3,}\")\n52\t# common endings, tried in turn when a word isn't in the list as it stands\n53\tENDINGS = (\n54\t    (\"ies\", \"y\"),\n55\t    (\"ied\", \"y\"),\n56\t    (\"ing\", \"e\"),\n57\t    (\"ing\", \"\"),\n58\t    (\"ed\", \"e\"),\n59\t    (\"ed\", \"\"),\n60\t    (\"es\", \"\"),\n61\t    (\"s\", \"\"),\n62\t    (\"ly\", \"\"),\n63\t)\n64\t# words to look around in a random-pool article, besides its opening; a guide to reading\n65\tFLAGS = re.compile(\n66\t    r\"\\b(?:spirit|spectral|unearthly|uncanny|weird|supernatural|seance|apparit|phantasm\"\n67\t    r\"|spook|wraith|goblin|banshee|witch|hoodoo|voodoo|superstiti|haint|bogey|boogey\"\n68\t    r\"|corpse|graveyard|midnight|in white|strange (?:noise|light|sound)|mysterious|knock\"\n69\t    r\"|rapp|haunt|spectre|specter|phantom|[gq][hbk]?[o0ae][a-z]?sts?\\b)\\w*\",\n70\t    re.IGNORECASE,\n71\t)\n72\t_words = None\n73\t\n74\t\n75\tdef dictionary():\n76\t    global _words\n77\t    if _words is None:\n78\t        _words = frozenset(\n79\t            w.strip().lower() for w in DICTIONARY.read_text().splitlines()\n80\t        )\n81\t    return _words\n82\t\n83\t\n84\tdef known(word, words):\n85\t    if word in words:\n86\t        return True\n87\t    return any(\n88\t        len(word) > len(end) + 2\n89\t        and word.endswith(end)\n90\t        and word[: -len(end)] + back in words\n91\t        for end, back in ENDINGS\n92\t    )\n93\t\n94\t\n95\tdef ocr_quality(text, words, least=20):\n96\t    \"\"\"The share of the article's words of three letters or more that the dictionary knows,\n97\t    once line-break hyphens are joined and common endings come off; None under `least`.\"\"\"\n98\t    found = WORD.findall((text or \"\").replace(\"-\\n\", \"\").lower())\n99\t    if len(found) < least:\n100\t        return None\n101\t    return sum(known(word, words) for word in found) / len(found)\n102\t\n103\t\n104\tdef draw(pools, sizes, n, seed):\n105\t    \"\"\"n (year, item) pairs, each year drawn in proportion to its share of the pool across the\n106\t    archive, so the sample stands for every article in the pool rather than for each year\n107\t    equally. pools maps a year to its reservoir, and sizes to the pool's full size.\"\"\"\n108\t    rng = random.Random(seed)\n109\t    years = sorted(year for year in pools if sizes.get(year) and pools[year])\n110\t    wanted = Counter(rng.choices(years, weights=[sizes[year] for year in years], k=n))\n111\t    return [\n112\t        (year, item)\n113\t        for year in years\n114\t        for item in rng.sample(list(pools[year]), min(wanted[year], len(pools[year])))\n115\t    ]\n116\t\n117\t\n118\tdef uniform(counts, n, seed):\n119\t    \"\"\"n (year, index) pairs without replacement, every candidate equally likely.\"\"\"\n120\t    rng = random.Random(seed)\n121\t    years = sorted(counts)\n122\t    picks = []\n123\t    for left in sorted(rng.sample(range(sum(counts.values())), n)):\n124\t        for year in years:\n125\t            if left < counts[year]:\n126\t                picks.append((year, left))\n127\t                break\n128\t            left -= counts[year]\n129\t    return picks\n130\t\n131\t\n132\tdef window(text, position, width=320):\n133\t    start = max(0, position - width // 2)\n134\t    return \" \".join(text[start : start + width].split())\n135\t\n136\t\n137\tdef first_match(text, forms):\n138\t    low = text.lower()\n139\t    found = [low.find(form.lower()) for form in forms]\n140\t    return min([p for p in found if p >= 0], default=0)\n141\t\n142\t\n143\tdef year_pass(job):\n144\t    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n145\t    paper and opening; plus the composition picks and recall picks that fall in this year.\"\"\"\n146\t    year, wanted, near, rand = job\n147\t    words, docs, picked, no_batch_path = dictionary(), [], [], 0\n148\t    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n149\t        for index, row in enumerate(map(json.loads, rows)):\n150\t            text = row[\"text\"] or \"\"\n151\t            no_batch_path += not BATCH_PATH.search(\n152\t                (row.get(\"scan\") or {}).get(\"raw_data_loc\") or \"\"\n153\t            )\n154\t            quality = None\n155\t            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n156\t                quality = ocr_quality(text, words)\n157\t            docs.append(\n158\t                (\n159\t                    len(text.split()),\n160\t                    quality,\n161\t                    tuple(keys(text)),\n162\t                    row[\"lccn\"],\n163\t                    row[\"article_id\"],\n164\t                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n165\t                )\n166\t            )\n167\t            if index in wanted:\n168\t                both = f\"{row['headline'] or ''}\\n{text}\"\n169\t                forms = [form for found in row[\"terms\"].values() for form in found]\n170\t                picked.append(\n171\t                    {\n172\t                        \"article_id\": row[\"article_id\"],\n173\t                        \"year\": year,\n174\t                        \"date\": row[\"date\"],\n175\t                        \"paper\": row[\"paper\"],\n176\t                        \"state\": row[\"state\"],\n177\t                        \"terms\": sorted(row[\"terms\"]),\n178\t                        \"words\": len(text.split()),\n179\t                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[\n180\t                            :200\n181\t                        ],\n182\t                        \"context\": window(both, first_match(both, forms), 600),\n183\t                        \"category\": None,\n184\t                        \"note\": None,\n185\t                    }\n186\t                )\n187\t    recalled = []\n188\t    if near or rand:\n189\t        seen = Counter()\n190\t        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n191\t            for row in map(json.loads, rows):\n192\t                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n193\t                seen[pool] += 1\n194\t                if index not in (near if pool == \"near_miss\" else rand):\n195\t                    continue\n196\t                text = row[\"text\"] or \"\"\n197\t                low = text.lower()\n198\t                spots = [m.start() for m in FLAGS.finditer(text)]\n199\t                spots += [\n200\t                    low.find(form.lower())\n201\t                    for forms in row[\"near_miss_terms\"].values()\n202\t                    for form in forms\n203\t                ]\n204\t                recalled.append(\n205\t                    {\n206\t                        \"pool\": pool,\n207\t                        \"article_id\": row[\"article_id\"],\n208\t                        \"year\": year,\n209\t                        \"date\": row[\"date\"],\n210\t                        \"paper\": row[\"paper\"],\n211\t                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[\n212\t                            :200\n213\t                        ],\n214\t                        \"near_miss_terms\": sorted(row[\"near_miss_terms\"]),\n215\t                        \"words\": len(text.split()),\n216\t                        \"opening\": \" \".join(text[:420].split()),\n217\t                        \"contexts\": [\n218\t                            window(text, p, 300)\n219\t                            for p in sorted(set(spots))[:4]\n220\t                            if p >= 0\n221\t                        ],\n222\t                        \"ghost_report\": None,\n223\t                        \"note\": None,\n224\t                    }\n225\t                )\n226\t    return year, docs, picked, recalled, no_batch_path\n227\t\n228\t\n229\tdef quantiles(values, points=(0.1, 0.25, 0.5, 0.75, 0.9, 0.99)):\n230\t    ordered = sorted(values)\n231\t    return {\n232\t        f\"p{round(q * 100)}\": ordered[round(q * (len(ordered) - 1))] for q in points\n233\t    }\n234\t\n235\t\n236\tdef keep_judgments(path, items, key, fields):\n237\t    \"\"\"The freshly drawn items, with any judgment already made on them carried over.\"\"\"\n238\t    if path.exists():\n239\t        made = {key(old): old for old in json.loads(path.read_text())}\n240\t        for item in items:\n241\t            for field in fields:\n242\t                item[field] = made.get(key(item), {}).get(field)\n243\t    path.write_text(json.dumps(items, indent=1, ensure_ascii=False) + \"\\n\")\n244\t    return items\n245\t\n246\t\n247\tdef rate(hits, n, of):\n248\t    low, high = wilson(hits, n)\n249\t    return {\n250\t        \"count\": hits,\n251\t        \"n\": n,\n252\t        \"share\": hits / n,\n253\t        \"low\": low,\n254\t        \"high\": high,\n255\t        \"implied\": round(hits / n * of),\n256\t        \"implied_low\": round(low * of),\n257\t        \"implied_high\": round(high * of),\n258\t    }\n259\t\n260\t\n261\tdef main():\n262\t    counts = {\n263\t        c[\"year\"]: c\n264\t        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n265\t    }\n266\t    years = sorted(counts)\n267\t    total = {\n268\t        k: sum(counts[y][k] for y in years)\n269\t        for k in (\"pages\", \"articles\", \"candidates\", \"near_miss\")\n270\t    }\n271\t    others = {y: counts[y][\"articles\"] - counts[y][\"candidates\"] for y in years}\n272\t    total[\"non_candidates\"] = sum(others.values())\n273\t\n274\t    composition = defaultdict(set)\n275\t    for year, index in uniform(\n276\t        {y: counts[y][\"candidates\"] for y in years}, COMPOSITION, \"eval A composition\"\n277\t    ):\n278\t        composition[year].add(index)\n279\t    near, rand = defaultdict(set), defaultdict(set)\n280\t    reservoirs = {y: range(min(SAMPLE_SIZE, counts[y][\"near_miss\"])) for y in years}\n281\t    for year, index in draw(\n282\t        reservoirs,\n283\t        {y: counts[y][\"near_miss\"] for y in years},\n284\t        RECALL,\n285\t        \"eval A recall near-miss\",\n286\t    ):\n287\t        near[year].add(index)\n288\t    reservoirs = {y: range(min(SAMPLE_SIZE, others[y])) for y in years}\n289\t    for year, index in draw(reservoirs, others, RECALL, \"eval A recall random\"):\n290\t        rand[year].add(index)\n291\t\n292\t    jobs = [\n293\t        (y, composition[y], near[y], rand[y])\n294\t        for y in years\n295\t        if counts[y][\"candidates\"] or near[y] or rand[y]\n296\t    ]\n297\t    docs, years_of, picked, recalled = [], [], [], []\n298\t    no_batch_path = Counter()\n299\t    with ProcessPoolExecutor(max_workers=6) as pool:\n300\t        for year, found, chosen, reread, missing in pool.map(\n301\t            year_pass, sorted(jobs, key=lambda job: -counts[job[0]][\"articles\"])\n302\t        ):\n303\t            no_batch_path[year] = missing\n304\t            docs += found\n305\t            years_of += [year] * len(found)\n306\t            picked += chosen\n307\t            recalled += reread\n308\t\n309\t    lengths = [doc[0] for doc in docs]\n310\t    qualities = [\n311\t        (year, doc[1])\n312\t        for year, doc in zip(years_of, docs, strict=True)\n313\t        if doc[1] is not None\n314\t    ]\n315\t    groups = clusters([doc[2] for doc in docs], least=2)\n316\t    group_sizes = sorted((len(g) for g in groups), reverse=True)\n317\t    cross = [g for g in groups if len({docs[d][3] for d in g}) > 1]\n318\t    rng = random.Random(\"eval A reprint check\")\n319\t    checks = []\n320\t    for group in rng.sample(groups, min(REPRINT_CHECK, len(groups))):\n321\t        a, b = rng.sample(group, 2)\n322\t        checks.append(\n323\t            {\n324\t                \"size\": len(group),\n325\t                \"papers\": len({docs[d][3] for d in group}),\n326\t                \"years\": [\n327\t                    min(years_of[d] for d in group),\n328\t                    max(years_of[d] for d in group),\n329\t                ],\n330\t                \"members\": [docs[a][4], docs[b][4]],\n331\t                \"openings\": [docs[a][5], docs[b][5]],\n332\t                \"same_story\": None,\n333\t            }\n334\t        )\n335\t    largest = [\n336\t        {\n337\t            \"size\": len(g),\n338\t            \"papers\": len({docs[d][3] for d in g}),\n339\t            \"years\": [min(years_of[d] for d in g), max(years_of[d] for d in g)],\n340\t            \"example\": docs[g[0]][5][:160],\n341\t        }\n342\t        for g in sorted(groups, key=len, reverse=True)[:10]\n343\t    ]\n344\t\n345\t    printings = {docs[d][4]: len(g) for g in groups for d in g}\n346\t    for p in picked:\n347\t        p[\"printings\"] = printings.get(p[\"article_id\"], 1)\n348\t\n349\t    OUT.mkdir(parents=True, exist_ok=True)\n350\t    picked = keep_judgments(\n351\t        OUT / \"composition.json\",\n352\t        sorted(picked, key=lambda p: (p[\"year\"], p[\"article_id\"])),\n353\t        lambda p: p[\"article_id\"],\n354\t        (\"category\", \"note\"),\n355\t    )\n356\t    recalled = keep_judgments(\n357\t        OUT / \"recall.json\",\n358\t        sorted(recalled, key=lambda r: (r[\"pool\"], r[\"year\"], r[\"article_id\"])),\n359\t        lambda r: (r[\"pool\"], r[\"article_id\"]),\n360\t        (\"ghost_report\", \"note\"),\n361\t    )\n362\t    checks = keep_judgments(\n363\t        OUT / \"reprint-check.json\",\n364\t        checks,\n365\t        lambda c: tuple(c[\"members\"]),\n366\t        (\"same_story\",),\n367\t    )\n368\t\n369\t    by_state = defaultdict(Counter)\n370\t    for year in years:\n371\t        for state, row in counts[year][\"by_state\"].items():\n372\t            by_state[state].update(row)\n373\t    terms = {\n374\t        term: sum(counts[y][\"by_term\"].get(term, 0) for y in years)\n375\t        for term in lexicon.GHOST\n376\t    }\n377\t    only = {\n378\t        term: sum(counts[y][\"only_by_term\"].get(term, 0) for y in years)\n379\t        for term in lexicon.GHOST\n380\t    }\n381\t    decade_quality = defaultdict(list)\n382\t    for year, quality in qualities:\n383\t        decade_quality[year // 10 * 10].append(quality)\n384\t\n385\t    report = {\n386\t        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n387\t        \"lexicon_version\": lexicon.VERSION,\n388\t        \"code_version\": code_version(),\n389\t        \"totals\": {\n390\t            **total,\n391\t            \"candidates_per_million\": total[\"candidates\"] / total[\"articles\"] * 1e6,\n392\t            \"no_batch_path\": no_batch_path.total(),\n393\t            \"share_no_batch_path\": no_batch_path.total() / total[\"candidates\"],\n394\t        },\n395\t        \"by_year\": [\n396\t            {\n397\t                \"year\": y,\n398\t                \"pages\": counts[y][\"pages\"],\n399\t                \"articles\": counts[y][\"articles\"],\n400\t                \"candidates\": counts[y][\"candidates\"],\n401\t                \"near_miss\": counts[y][\"near_miss\"],\n402\t                \"no_batch_path\": no_batch_path[y],\n403\t                \"candidates_per_million\": counts[y][\"candidates\"]\n404\t                / counts[y][\"articles\"]\n405\t                * 1e6\n406\t                if counts[y][\"articles\"]\n407\t                else 0,\n408\t            }\n409\t            for y in years\n410\t        ],\n411\t        \"by_state\": [\n412\t            {\n413\t                \"state\": state,\n414\t                **row,\n415\t                \"candidates_per_million\": row[\"candidates\"] / row[\"articles\"] * 1e6\n416\t                if row[\"articles\"]\n417\t                else 0,\n418\t            }\n419\t            for state, row in sorted(\n420\t                by_state.items(), key=lambda kv: -kv[1][\"candidates\"]\n421\t            )\n422\t        ],\n423\t        \"no_state\": {\n424\t            \"candidates\": by_state[\"unknown\"][\"candidates\"],\n425\t            \"share_of_candidates\": by_state[\"unknown\"][\"candidates\"]\n426\t            / total[\"candidates\"],\n427\t            \"share_of_articles\": by_state[\"unknown\"][\"articles\"] / total[\"articles\"],\n428\t        },\n429\t        \"terms\": {\"any\": terms, \"only\": only},\n430\t        \"lengths\": {\n431\t            \"unit\": \"words of the article's text\",\n432\t            \"mean\": sum(lengths) / len(lengths),\n433\t            **quantiles(lengths),\n434\t            \"max\": max(lengths),\n435\t            \"histogram\": length_histogram(lengths),\n436\t        },\n437\t        \"ocr_quality\": {\n438\t            \"method\": \"share of words of 3+ letters in /usr/share/dict/words (Webster's 2nd), once line-break hyphens are joined and -s, -es, -ed, -ing, -ly, -ies, -ied come off\",\n439\t            \"sample\": f\"1 candidate in {OCR_ONE_IN}, by the CRC of its id: {len(qualities):,}\",\n440\t            **quantiles([q for _, q in qualities]),\n441\t            \"histogram\": [\n442\t                sum(\n443\t                    1\n444\t                    for _, q in qualities\n445\t                    if lo <= q < lo + 0.05 or (lo == 0.95 and q == 1.0)\n446\t                )\n447\t                for lo in [i / 20 for i in range(20)]\n448\t            ],\n449\t            \"median_by_decade\": {\n450\t                d: quantiles(v, (0.5,))[\"p50\"]\n451\t                for d, v in sorted(decade_quality.items())\n452\t            },\n453\t        },\n454\t        \"reprints\": {\n455\t            \"method\": \"runs of 7 words of 3+ letters from each candidate's first 120, one in 8 kept by its hash; candidates sharing two of their six smallest runs, in a pair held by at most 1,000 candidates, are joined\",\n456\t            \"clusters\": len(groups),\n457\t            \"clustered_candidates\": sum(group_sizes),\n458\t            \"share_clustered\": sum(group_sizes) / len(docs),\n459\t            \"distinct_stories\": len(docs) - sum(group_sizes) + len(groups),\n460\t            \"cross_paper_clusters\": len(cross),\n461\t            \"cross_paper_candidates\": sum(len(g) for g in cross),\n462\t            \"size_histogram\": size_histogram(group_sizes),\n463\t            \"largest\": largest,\n464\t            \"check\": summarise_checks(checks),\n465\t        },\n466\t        \"composition\": summarise_composition(picked, total[\"candidates\"]),\n467\t        \"recall\": summarise_recall(recalled, total),\n468\t    }\n469\t    (RESULTS / \"eval_a.json\").write_text(json.dumps(report, indent=1) + \"\\n\")\n470\t    charts = draw_all(report, OUT)\n471\t    print(\n472\t        f\"wrote {(RESULTS / 'eval_a.json').relative_to(ROOT)} and {len(charts)} charts in {OUT.relative_to(ROOT)}\"\n473\t    )\n474\t    for line in headline_numbers(report):\n475\t        print(line)\n476\t\n477\t\n478\tLENGTH_BINS = (0, 25, 50, 100, 200, 400, 800, 1600, 3200)\n479\tSIZE_BINS = ((2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, 10**9))\n480\t"}]},"uuid":"c7bc99d4-32f7-459d-b648-1c5bb797d133","timestamp":"2026-10-30T14:07:50.051Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/eval_a.py","content":"\"\"\"make eval: eval A over the archive read in Phase 2A. It writes eval/results/eval_a.json,\nand its charts and hand-judged samples to eval/results/eval_a/.\n\n1. EDA: by year, by state and by term; candidate lengths; OCR quality, as the share of words\n   /usr/share/dict/words knows; reprint clusters among the candidates; and the candidates\n   whose scan has no batch path, which can show a clipping only if loc.gov lists the page.\n2. Composition: 200 candidates at random, each put in a category by hand in\n   composition.json. The categories are defined in decision 27.\n3. Recall: 300 articles from the near-miss reservoirs and 300 from the random ones, each\n   weighted by its year's share of the pool, marked by hand in recall.json.\n\nEvery sample is seeded, so a rerun draws the same articles and keeps the judgments made.\n\"\"\"\n\nimport itertools\nimport json\nimport random\nimport re\nimport zlib\nfrom collections import Counter, defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport zstandard\nfrom charts import draw_all\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.ingest import lexicon\nfrom paperghosts.ingest.crops import BATCH_PATH\nfrom paperghosts.ingest.prefilter import SAMPLE_SIZE\nfrom paperghosts.ingest.year import code_version\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).resolve().parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"eval_a\"\nDICTIONARY = Path(\"/usr/share/dict/words\")\nOCR_ONE_IN = 20  # OCR quality is measured on one candidate in twenty, chosen by its id\nCOMPOSITION, RECALL, REPRINT_CHECK = 200, 300, 20\nCATEGORIES = (\n    \"ghost_report\",\n    \"fiction\",\n    \"religious\",\n    \"figurative\",\n    \"name_or_title\",\n    \"social_event\",\n    \"other\",\n)\nWORD = re.compile(r\"[a-z]{3,}\")\n# common endings, tried in turn when a word isn't in the list as it stands\nENDINGS = (\n    (\"ies\", \"y\"),\n    (\"ied\", \"y\"),\n    (\"ing\", \"e\"),\n    (\"ing\", \"\"),\n    (\"ed\", \"e\"),\n    (\"ed\", \"\"),\n    (\"es\", \"\"),\n    (\"s\", \"\"),\n    (\"ly\", \"\"),\n)\n# words to look around in a random-pool article, besides its opening; a guide to reading\nFLAGS = re.compile(\n    r\"\\b(?:spirit|spectral|unearthly|uncanny|weird|supernatural|seance|apparit|phantasm\"\n    r\"|spook|wraith|goblin|banshee|witch|hoodoo|voodoo|superstiti|haint|bogey|boogey\"\n    r\"|corpse|graveyard|midnight|in white|strange (?:noise|light|sound)|mysterious|knock\"\n    r\"|rapp|haunt|spectre|specter|phantom|[gq][hbk]?[o0ae][a-z]?sts?\\b)\\w*\",\n    re.IGNORECASE,\n)\n_words = None\n\n\ndef dictionary():\n    global _words\n    if _words is None:\n        _words = frozenset(\n            w.strip().lower() for w in DICTIONARY.read_text().splitlines()\n        )\n    return _words\n\n\ndef known(word, words):\n    if word in words:\n        return True\n    return any(\n        len(word) > len(end) + 2\n        and word.endswith(end)\n        and word[: -len(end)] + back in words\n        for end, back in ENDINGS\n    )\n\n\ndef ocr_quality(text, words, least=20):\n    \"\"\"The share of the article's words of three letters or more that the dictionary knows,\n    once line-break hyphens are joined and common endings come off; None under `least`.\"\"\"\n    found = WORD.findall((text or \"\").replace(\"-\\n\", \"\").lower())\n    if len(found) < least:\n        return None\n    return sum(known(word, words) for word in found) / len(found)\n\n\ndef draw(pools, sizes, n, seed):\n    \"\"\"n (year, item) pairs, each year drawn in proportion to its share of the pool across the\n    archive, so the sample stands for every article in the pool rather than for each year\n    equally. pools maps a year to its reservoir, and sizes to the pool's full size.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(year for year in pools if sizes.get(year) and pools[year])\n    wanted = Counter(rng.choices(years, weights=[sizes[year] for year in years], k=n))\n    return [\n        (year, item)\n        for year in years\n        for item in rng.sample(list(pools[year]), min(wanted[year], len(pools[year])))\n    ]\n\n\ndef uniform(counts, n, seed):\n    \"\"\"n (year, index) pairs without replacement, every candidate equally likely.\"\"\"\n    rng = random.Random(seed)\n    years = sorted(counts)\n    picks = []\n    for left in sorted(rng.sample(range(sum(counts.values())), n)):\n        for year in years:\n            if left < counts[year]:\n                picks.append((year, left))\n                break\n            left -= counts[year]\n    return picks\n\n\ndef window(text, position, width=320):\n    start = max(0, position - width // 2)\n    return \" \".join(text[start : start + width].split())\n\n\ndef first_match(text, forms):\n    low = text.lower()\n    found = [low.find(form.lower()) for form in forms]\n    return min([p for p in found if p >= 0], default=0)\n\n\ndef year_pass(job):\n    \"\"\"One year's candidates: per-article length, OCR quality for a fixed sample, reprint keys,\n    paper and opening; plus the composition picks and recall picks that fall in this year.\"\"\"\n    year, wanted, near, rand = job\n    words, docs, picked, no_batch_path = dictionary(), [], [], 0\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(map(json.loads, rows)):\n            text = row[\"text\"] or \"\"\n            no_batch_path += not BATCH_PATH.search(\n                (row.get(\"scan\") or {}).get(\"raw_data_loc\") or \"\"\n            )\n            quality = None\n            if zlib.crc32(row[\"article_id\"].encode()) % OCR_ONE_IN == 0:\n                quality = ocr_quality(text, words)\n            docs.append(\n                (\n                    len(text.split()),\n                    quality,\n                    tuple(keys(text)),\n                    row[\"lccn\"],\n                    row[\"article_id\"],\n                    f\"{row['paper'] or '?'} {row['date']}: {' '.join(text[:200].split())}\",\n                )\n            )\n            if index in wanted:\n                both = f\"{row['headline'] or ''}\\n{text}\"\n                forms = [form for found in row[\"terms\"].values() for form in found]\n                picked.append(\n                    {\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"state\": row[\"state\"],\n                        \"terms\": sorted(row[\"terms\"]),\n                        \"words\": len(text.split()),\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[\n                            :200\n                        ],\n                        \"context\": window(both, first_match(both, forms), 600),\n                        \"category\": None,\n                        \"note\": None,\n                    }\n                )\n    recalled = []\n    if near or rand:\n        seen = Counter()\n        with zstandard.open(DATA / \"samples\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n            for row in map(json.loads, rows):\n                pool, index = row[\"sample\"], seen[row[\"sample\"]]\n                seen[pool] += 1\n                if index not in (near if pool == \"near_miss\" else rand):\n                    continue\n                text = row[\"text\"] or \"\"\n                low = text.lower()\n                spots = [m.start() for m in FLAGS.finditer(text)]\n                spots += [\n                    low.find(form.lower())\n                    for forms in row[\"near_miss_terms\"].values()\n                    for form in forms\n                ]\n                recalled.append(\n                    {\n                        \"pool\": pool,\n                        \"article_id\": row[\"article_id\"],\n                        \"year\": year,\n                        \"date\": row[\"date\"],\n                        \"paper\": row[\"paper\"],\n                        \"headline\": \" / \".join((row[\"headline\"] or \"\").split(\"\\n\"))[\n                            :200\n                        ],\n                        \"near_miss_terms\": sorted(row[\"near_miss_terms\"]),\n                        \"words\": len(text.split()),\n                        \"opening\": \" \".join(text[:420].split()),\n                        \"contexts\": [\n                            window(text, p, 300)\n                            for p in sorted(set(spots))[:4]\n                            if p >= 0\n                        ],\n                        \"ghost_report\": None,\n                        \"note\": None,\n                    }\n                )\n    return year, docs, picked, recalled, no_batch_path\n\n\ndef quantiles(values, points=(0.1, 0.25, 0.5, 0.75, 0.9, 0.99)):\n    ordered = sorted(values)\n    return {\n        f\"p{round(q * 100)}\": ordered[round(q * (len(ordered) - 1))] for q in points\n    }\n\n\ndef keep_judgments(path, items, key, fields):\n    \"\"\"The freshly drawn items, with any judgment already made on them carried over.\"\"\"\n    if path.exists():\n        made = {key(old): old for old in json.loads(path.read_text())}\n        for item in items:\n            for field in fields:\n                item[field] = made.get(key(item), {}).get(field)\n    path.write_text(json.dumps(items, indent=1, ensure_ascii=False) + \"\\n\")\n    return items\n\n\ndef rate(hits, n, of):\n    low, high = wilson(hits, n)\n    return {\n        \"count\": hits,\n        \"n\": n,\n        \"share\": hits / n,\n        \"low\": low,\n        \"high\": high,\n        \"implied\": round(hits / n * of),\n        \"implied_low\": round(low * of),\n        \"implied_high\": round(high * of),\n    }\n\n\ndef main():\n    counts = {\n        c[\"year\"]: c\n        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(counts)\n    total = {\n        k: sum(counts[y][k] for y in years)\n        for k in (\"pages\", \"articles\", \"candidates\", \"near_miss\")\n    }\n    others = {y: counts[y][\"articles\"] - counts[y][\"candidates\"] for y in years}\n    total[\"non_candidates\"] = sum(others.values())\n\n    composition = defaultdict(set)\n    for year, index in uniform(\n        {y: counts[y][\"candidates\"] for y in years}, COMPOSITION, \"eval A composition\"\n    ):\n        composition[year].add(index)\n    near, rand = defaultdict(set), defaultdict(set)\n    reservoirs = {y: range(min(SAMPLE_SIZE, counts[y][\"near_miss\"])) for y in years}\n    for year, index in draw(\n        reservoirs,\n        {y: counts[y][\"near_miss\"] for y in years},\n        RECALL,\n        \"eval A recall near-miss\",\n    ):\n        near[year].add(index)\n    reservoirs = {y: range(min(SAMPLE_SIZE, others[y])) for y in years}\n    for year, index in draw(reservoirs, others, RECALL, \"eval A recall random\"):\n        rand[year].add(index)\n\n    jobs = [\n        (y, composition[y], near[y], rand[y])\n        for y in years\n        if counts[y][\"candidates\"] or near[y] or rand[y]\n    ]\n    docs, years_of, picked, recalled = [], [], [], []\n    no_batch_path = Counter()\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for year, found, chosen, reread, missing in pool.map(\n            year_pass, sorted(jobs, key=lambda job: -counts[job[0]][\"articles\"])\n        ):\n            no_batch_path[year] = missing\n            docs += found\n            years_of += [year] * len(found)\n            picked += chosen\n            recalled += reread\n\n    lengths = [doc[0] for doc in docs]\n    qualities = [\n        (year, doc[1])\n        for year, doc in zip(years_of, docs, strict=True)\n        if doc[1] is not None\n    ]\n    groups = clusters([doc[2] for doc in docs], least=2)\n    group_sizes = sorted((len(g) for g in groups), reverse=True)\n    cross = [g for g in groups if len({docs[d][3] for d in g}) > 1]\n    rng = random.Random(\"eval A reprint check\")\n    checks = []\n    for group in rng.sample(groups, min(REPRINT_CHECK, len(groups))):\n        a, b = rng.sample(group, 2)\n        checks.append(\n            {\n                \"size\": len(group),\n                \"papers\": len({docs[d][3] for d in group}),\n                \"years\": [\n                    min(years_of[d] for d in group),\n                    max(years_of[d] for d in group),\n                ],\n                \"members\": [docs[a][4], docs[b][4]],\n                \"openings\": [docs[a][5], docs[b][5]],\n                \"same_story\": None,\n            }\n        )\n    largest = [\n        {\n            \"size\": len(g),\n            \"papers\": len({docs[d][3] for d in g}),\n            \"years\": [min(years_of[d] for d in g), max(years_of[d] for d in g)],\n            \"example\": docs[g[0]][5][:160],\n        }\n        for g in sorted(groups, key=len, reverse=True)[:10]\n    ]\n\n    printings = {docs[d][4]: len(g) for g in groups for d in g}\n    for p in picked:\n        p[\"printings\"] = printings.get(p[\"article_id\"], 1)\n\n    OUT.mkdir(parents=True, exist_ok=True)\n    picked = keep_judgments(\n        OUT / \"composition.json\",\n        sorted(picked, key=lambda p: (p[\"year\"], p[\"article_id\"])),\n        lambda p: p[\"article_id\"],\n        (\"category\", \"note\"),\n    )\n    recalled = keep_judgments(\n        OUT / \"recall.json\",\n        sorted(recalled, key=lambda r: (r[\"pool\"], r[\"year\"], r[\"article_id\"])),\n        lambda r: (r[\"pool\"], r[\"article_id\"]),\n        (\"ghost_report\", \"note\"),\n    )\n    checks = keep_judgments(\n        OUT / \"reprint-check.json\",\n        checks,\n        lambda c: tuple(c[\"members\"]),\n        (\"same_story\",),\n    )\n\n    by_state = defaultdict(Counter)\n    for year in years:\n        for state, row in counts[year][\"by_state\"].items():\n            by_state[state].update(row)\n    terms = {\n        term: sum(counts[y][\"by_term\"].get(term, 0) for y in years)\n        for term in lexicon.GHOST\n    }\n    only = {\n        term: sum(counts[y][\"only_by_term\"].get(term, 0) for y in years)\n        for term in lexicon.GHOST\n    }\n    decade_quality = defaultdict(list)\n    for year, quality in qualities:\n        decade_quality[year // 10 * 10].append(quality)\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"lexicon_version\": lexicon.VERSION,\n        \"code_version\": code_version(),\n        \"totals\": {\n            **total,\n            \"candidates_per_million\": total[\"candidates\"] / total[\"articles\"] * 1e6,\n            \"no_batch_path\": no_batch_path.total(),\n            \"share_no_batch_path\": no_batch_path.total() / total[\"candidates\"],\n        },\n        \"by_year\": [\n            {\n                \"year\": y,\n                \"pages\": counts[y][\"pages\"],\n                \"articles\": counts[y][\"articles\"],\n                \"candidates\": counts[y][\"candidates\"],\n                \"near_miss\": counts[y][\"near_miss\"],\n                \"no_batch_path\": no_batch_path[y],\n                \"candidates_per_million\": counts[y][\"candidates\"]\n                / counts[y][\"articles\"]\n                * 1e6\n                if counts[y][\"articles\"]\n                else 0,\n            }\n            for y in years\n        ],\n        \"by_state\": [\n            {\n                \"state\": state,\n                **row,\n                \"candidates_per_million\": row[\"candidates\"] / row[\"articles\"] * 1e6\n                if row[\"articles\"]\n                else 0,\n            }\n            for state, row in sorted(\n                by_state.items(), key=lambda kv: -kv[1][\"candidates\"]\n            )\n        ],\n        \"no_state\": {\n            \"candidates\": by_state[\"unknown\"][\"candidates\"],\n            \"share_of_candidates\": by_state[\"unknown\"][\"candidates\"]\n            / total[\"candidates\"],\n            \"share_of_articles\": by_state[\"unknown\"][\"articles\"] / total[\"articles\"],\n        },\n        \"terms\": {\"any\": terms, \"only\": only},\n        \"lengths\": {\n            \"unit\": \"words of the article's text\",\n            \"mean\": sum(lengths) / len(lengths),\n            **quantiles(lengths),\n            \"max\": max(lengths),\n            \"histogram\": length_histogram(lengths),\n        },\n        \"ocr_quality\": {\n            \"method\": \"share of words of 3+ letters in /usr/share/dict/words (Webster's 2nd), once line-break hyphens are joined and -s, -es, -ed, -ing, -ly, -ies, -ied come off\",\n            \"sample\": f\"1 candidate in {OCR_ONE_IN}, by the CRC of its id: {len(qualities):,}\",\n            **quantiles([q for _, q in qualities]),\n            \"histogram\": [\n                sum(\n                    1\n                    for _, q in qualities\n                    if lo <= q < lo + 0.05 or (lo == 0.95 and q == 1.0)\n                )\n                for lo in [i / 20 for i in range(20)]\n            ],\n            \"median_by_decade\": {\n                d: quantiles(v, (0.5,))[\"p50\"]\n                for d, v in sorted(decade_quality.items())\n            },\n        },\n        \"reprints\": {\n            \"method\": \"runs of 7 words of 3+ letters from each candidate's first 120, one in 8 kept by its hash; candidates sharing two of their six smallest runs, in a pair held by at most 1,000 candidates, are joined\",\n            \"clusters\": len(groups),\n            \"clustered_candidates\": sum(group_sizes),\n            \"share_clustered\": sum(group_sizes) / len(docs),\n            \"distinct_stories\": len(docs) - sum(group_sizes) + len(groups),\n            \"cross_paper_clusters\": len(cross),\n            \"cross_paper_candidates\": sum(len(g) for g in cross),\n            \"size_histogram\": size_histogram(group_sizes),\n            \"largest\": largest,\n            \"check\": summarise_checks(checks),\n        },\n        \"composition\": summarise_composition(picked, total[\"candidates\"]),\n        \"recall\": summarise_recall(recalled, total),\n    }\n    (RESULTS / \"eval_a.json\").write_text(json.dumps(report, indent=1) + \"\\n\")\n    charts = draw_all(report, OUT)\n    print(\n        f\"wrote {(RESULTS / 'eval_a.json').relative_to(ROOT)} and {len(charts)} charts in {OUT.relative_to(ROOT)}\"\n    )\n    for line in headline_numbers(report):\n        print(line)\n\n\nLENGTH_BINS = (0, 25, 50, 100, 200, 400, 800, 1600, 3200)\nSIZE_BINS = ((2, 2), (3, 3), (4, 4), (5, 9), (10, 19), (20, 49), (50, 10**9))\n","numLines":480,"startLine":1,"totalLines":581}},"sourceToolAssistantUUID":"7315eeb7-aa6b-49c4-aed3-cd003b0a043d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunny-popping-comet"}
