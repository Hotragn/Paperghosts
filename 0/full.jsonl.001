{"parentUuid":"4994d680-7337-47c2-82f5-067beaef6f7e","isSidechain":false,"promptId":"fdb4383a-0e1d-45d1-a3f9-1b2691993af6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UvfQnjtWaXoKEmVuh3SYdW","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/geocode_check.py (file state is current in your context — no need to Read it back)"}]},"uuid":"f6b0c7d9-8018-4a24-9e3b-9c558e11b4b4","timestamp":"2026-10-30T18:50:14.002Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/geocode_check.py","content":"\"\"\"The geocoder's accuracy (decision 34), against answers checked by hand in\neval/results/phase2b/geocoder_expected.json:\n1. a seeded 200 of the papers' distinct (place, state) pairs, from the title lookup\n2. the 24 judged reports' story places, as their text gives them, as an early look at the\n   places the reader will extract\n\nA result is right when it is the expected GeoNames ID, or no point where no GeoNames place is\nright. Writes eval/results/phase2b/geocoder.json, with Wilson intervals and each failure's\nkind. `--review` prints the draw with each result's runners-up instead, for checking by hand.\"\"\"\n\nimport json\nimport random\nimport sys\nfrom collections import Counter\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nfrom paperghosts.geo.geonames import Gazetteer, flat, name_key\nfrom paperghosts.geo.titles import state_name\nfrom paperghosts.stats import wilson\n\nROOT = Path(__file__).parents[1]\nLOOKUP = ROOT / \"data\" / \"titles\" / \"titles.json\"\nRESULTS = ROOT / \"eval\" / \"results\" / \"phase2b\"\nEXPECTED = RESULTS / \"geocoder_expected.json\"\nOUT = RESULTS / \"geocoder.json\"\nSEED, PAIRS = \"2B geocoder\", 200\n\n\ndef query(title):\n    \"\"\"The towns to try for a paper, the cataloguer's first, its modern state, its county.\"\"\"\n    towns = [t for t in (title.get(\"supplied_place\"), title.get(\"place\")) if t]\n    state = title.get(\"modern_state\") or state_name(\n        title.get(\"supplied_state\") or title.get(\"state\")\n    )\n    return list(dict.fromkeys(towns)), state, title.get(\"county\")\n\n\ndef geocode(gazetteer, towns, state, county):\n    found = gazetteer.geocode(None, state)\n    for town in towns:\n        found = gazetteer.geocode(town, state, county)\n        if found[\"place_id\"] is not None:\n            break\n    return found\n\n\ndef draw():\n    titles = json.loads(LOOKUP.read_text())\n    pairs = {}\n    for lccn, title in sorted(titles.items()):\n        towns, state, county = query(title)\n        pairs.setdefault((towns[0] if towns else None, state), (towns, county, lccn))\n    keys = sorted(pairs, key=lambda k: (str(k[0]), str(k[1])))\n    return [\n        {\"town\": k[0], \"state\": k[1], \"towns\": pairs[k][0], \"county\": pairs[k][1], \"lccn\": pairs[k][2]}\n        for k in random.Random(SEED).sample(keys, PAIRS)\n    ]\n\n\ndef rate(right, n):\n    low, high = wilson(right, n)\n    return {\"right\": right, \"n\": n, \"share\": right / n if n else None, \"low\": low, \"high\": high}\n\n\ndef review(gazetteer, sample):\n    for n, pair in enumerate(sample, 1):\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        code = gazetteer.states.get(pair[\"state\"] or \"\")\n        others = []\n        for town in pair[\"towns\"]:\n            key = flat(name_key(town))\n            for kind, index in ((\"name\", gazetteer.names), (\"alt\", gazetteer.alternates)):\n                for p in index.get((key, code), []):\n                    county = gazetteer.county_names.get((code, p[\"county\"]))\n                    others.append(f\"{p['id']} {p['name']} ({county}, {p['code']}, {p['population']}, {kind})\")\n        print(f\"{n:3} {pair['towns']} | {pair['state']} | county {pair['county']} | {pair['lccn']}\")\n        print(f\"    -> {found.get('place_id')} {found.get('name')} ({found.get('county')}, {found.get('feature_code')}, {found.get('population')}) {found.get('reason', '')}\")\n        for other in dict.fromkeys(others):\n            if not other.startswith(str(found.get(\"place_id\"))):\n                print(f\"       also {other}\")\n\n\ndef main():\n    gazetteer = Gazetteer()\n    sample = draw()\n    if sys.argv[1:] == [\"--review\"]:\n        review(gazetteer, sample)\n        return\n    expected = json.loads(EXPECTED.read_text())\n    papers, kinds = [], Counter()\n    for pair in sample:\n        found = geocode(gazetteer, pair[\"towns\"], pair[\"state\"], pair[\"county\"])\n        want = expected[\"papers\"][f\"{pair['town']}|{pair['state']}\"]\n        right = found[\"place_id\"] == want[\"place_id\"]\n        if not right:\n            kinds[want[\"failure\"]] += 1\n        papers.append(pair | {\"found\": found.get(\"place_id\"), \"reason\": found.get(\"reason\"), \"expected\": want[\"place_id\"], \"right\": right, \"failure\": None if right else want[\"failure\"]})\n    resolved = [p for p in papers if p[\"found\"] is not None]\n    stories = []\n    for story in expected[\"stories\"]:\n        found = gazetteer.geocode(story[\"town\"], story[\"state\"], story.get(\"county\"))\n        stories.append(story | {\"found\": found.get(\"place_id\"), \"reason\": found.get(\"reason\"), \"right\": found.get(\"place_id\") == story[\"place_id\"]})\n    named = [s for s in stories if s[\"town\"] and s[\"state\"]]\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"gazetteer\": gazetteer.source,\n        \"papers\": {\n            \"seed\": SEED,\n            \"pairs\": len(papers),\n            \"right\": rate(sum(p[\"right\"] for p in papers), len(papers)),\n            \"resolved\": len(resolved),\n            \"right_when_resolved\": rate(sum(p[\"right\"] for p in resolved), len(resolved)),\n            \"failures\": dict(kinds),\n            \"results\": papers,\n        },\n        \"stories\": {\n            \"reports\": len(stories),\n            \"as_the_text_gives_them\": dict(Counter(s[\"given\"] for s in stories)),\n            \"right_with_town_and_state\": rate(sum(s[\"right\"] for s in named), len(named)),\n            \"results\": stories,\n        },\n    }\n    OUT.write_text(json.dumps(report, indent=1, ensure_ascii=False) + \"\\n\")\n    print(json.dumps({k: v for k, v in report[\"papers\"].items() if k != \"results\"}, indent=1))\n    print(json.dumps({k: v for k, v in report[\"stories\"].items() if k != \"results\"}, indent=1))\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"4994d680-7337-47c2-82f5-067beaef6f7e","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
