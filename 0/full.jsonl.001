test_a_draw_bigger_than_a_years_reservoir_fails_rather_than_shrinking():\n    pools = {1800: list(range(5)), 1900: list(range(100))}\n    sizes = {1800: 99_000, 1900: 1_000}\n\n    with pytest.raises(AssertionError, match=\"1800\"):\n        draw(pools, sizes, 50, seed=\"test\")\n\n\ndef test_a_uniform_pick_gives_every_candidate_the_same_chance():\n    counts = {1800: 3, 1801: 0, 1802: 5}\n    assert sorted(uniform(counts, 8, seed=\"x\")) == [\n        (1800, 0),\n        (1800, 1),\n        (1800, 2),\n        (1802, 0),\n        (1802, 1),\n        (1802, 2),\n        (1802, 3),\n        (1802, 4),\n    ]\n\n\ndef test_a_story_printed_in_several_papers_counts_once():\n    picked = [\n        {\"category\": \"ghost_report\", \"printings\": 2},\n        {\"category\": \"ghost_report\", \"printings\": 1},\n        {\"category\": \"other\", \"printings\": 1},\n        {\"category\": \"other\", \"printings\": 4},\n    ]\n    ghosts = summarise_composition(picked, 400)[\"categories\"][\"ghost_report\"]\n    # each candidate is 1/k of a story when its cluster holds k printings\n    assert (ghosts[\"implied\"], ghosts[\"stories\"]) == (200, 150)\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":7,"lines":[" \"\"\"Eval A's helpers: OCR quality as the share of words a dictionary knows, and samples that"," stand for every article in the archive, not for each year equally.\"\"\""," ","+import pytest"," from eval_a import draw, ocr_quality, summarise_composition, uniform"," "," WORDS = frozenset("]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"009866f4-6911-4322-9409-167383a09197","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2a-archive","slug":"sunn