{"parentUuid":"a9f3222b-eaa3-45d9-a757-f85081105f86","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgYsEefJyJKmccm9L4mM1","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8448,"cache_read_input_tokens":620464,"output_tokens":10992,"output_tokens_details":{"thinking_tokens":3007},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8448,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":10992,"cache_read_input_tokens":620464,"cache_creation_input_tokens":8448,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8448},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"thinkingDurationMs":26811,"thinkingDisplay":"updates","serverClassifierRequest":"07dd8f81-9884-423f-9cba-534ddcee5dc5","apiBlockIndex":0,"requestId":"req_011CgYsEdhWZkeFMCA5eU8qF","requestRef":"35640c81-03c2-4449-a92f-9f73dea3c7d1","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"d725ece9-72c4-4bd2-ab9f-e2f9dab6b80b","timestamp":"2026-10-30T18:07:33.069Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"parentUuid":"d725ece9-72c4-4bd2-ab9f-e2f9dab6b80b","isSidechain":false,"message":{"model":"claude-opus-5-5","id":"msg_011CgYsEefJyJKmccm9L4mM1","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Mm3LEJZaiZUP5VbLoW6b4M","name":"Write","input":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py","content":"\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents, with their\nreal text, their reprint clusters' printings, a BinData embedding, and reader fields whose quotes\nare real sentences of the article. They are built for a seeded 1,000 of lexicon v2's candidates,\nand for the judged reports that v2 makes candidates.\n\n1. Offline, with bson.encode: the bytes of each document by part, with each of rule 6's levers\n   turned off, and with each further lever on: bbox_list packed as BinData, paper, place and\n   state in a title lookup by LCCN, display_headline derived at read time, and an int8 embedding.\n2. Atlas's own data and index sizes, for the 1,000 loaded 500 at a time into a scratch\n   collection with the reports validator and indexes. The collection is dropped afterwards.\n3. Each database's use of M0's storage: data size plus index size, as Atlas counts it.\n4. How many stories fit at the top of decisions 30 and 31's intervals.\n\nWrites eval/results/phase2b/budget.json, which Docs/BUDGET.md reads.\"\"\"\n\nimport json\nimport random\nimport re\nimport statistics\nimport time\nimport uuid\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport bson\nimport numpy as np\nimport zstandard\nfrom bson.binary import Binary, BinaryVectorDtype\nfrom pymongo import MongoClient\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.config import setting\nfrom paperghosts.ingest.crops import MEMBER, crop_urls\nfrom paperghosts.ingest.headline import display_headline\nfrom paperghosts.schemas import DIMENSIONS, Report\nfrom paperghosts.store.db_init import INDEXES\nfrom paperghosts.store.printings import printing\nfrom paperghosts.store.validators import validator\n\nROOT = Path(__file__).parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"phase2b\" / \"budget.json\"\nSEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500\nSETTLE = 75  # seconds: WiredTiger's checkpoint, once a minute, updates the index sizes\nCODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length\nOUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]\nPLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]\nBOX = (\"x0\", \"y0\", \"x1\", \"y1\")\nBASE = \"as stored: rule 6's levers on, float32\"\nLIMIT = 500_000_000  # M0's \"0.5 GB\"; read as 512 MiB it would be 536,870,912\nPRINTINGS = 74_027 + 21_176  # the tops of decision 27's and decision 31's intervals\nSTORIES_PER_PRINTING = 22_300 / 36_766  # lexicon v1's (decision 27)\n\n\ndef year_keys(year):\n    \"\"\"Each candidate's reprint keys and article ID in file order, and each LCCN's title.\"\"\"\n    found, ids, titles = [], [], {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for row in map(json.loads, rows):\n            found.append(tuple(keys(row[\"text\"])))\n            ids.append(row[\"article_id\"])\n            lccn = row[\"lccn\"] or MEMBER.search(row[\"member\"])[\"lccn\"]\n            titles.setdefault(lccn, {\"paper\": row[\"paper\"], \"state\": row[\"state\"]})\n    return year, found, ids, titles\n\n\ndef year_rows(job):\n    year, wanted = job\n    found = {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(rows):\n            if index in wanted:\n                found[index] = json.loads(row)\n    return year, found\n\n\ndef sentences(text):\n    flat = \" \".join((text or \"\").replace(\"-\\n\", \"\").split())\n    return [s for s in re.split(r\"(?<=[.!?])\\s+\", flat) if len(s) >= 30] or [flat[:200]]\n\n\ndef quote(sentence, most=200):\n    \"\"\"A verbatim span, as the reader quotes one: a sentence, cut at a word under `most`.\"\"\"\n    return sentence if len(sentence) <= most else sentence[:most].rsplit(\" \", 1)[0]\n\n\ndef stated(rng, said, value=None):\n    sentence = rng.choice(said)\n    if value is None:\n        words = sentence.split()\n        start = rng.randrange(max(1, len(words) - 6))\n        value = \" \".join(words[start : start + rng.randint(3, 6)])\n    return {\n        \"value\": value,\n        \"quote\": quote(sentence),\n        \"verified\": True,\n        \"score\": round(rng.random(), 3),\n    }\n\n\ndef name(rng, said, words):\n    \"\"\"A run of capitalized words from the text, as a place or a person reads.\"\"\"\n    runs = re.findall(\n        rf\"\\b[A-Z][a-z]{{2,}}(?: [A-Z][a-z]{{2,}}){{{words - 1}}}\\b\", \" \".join(said)\n    )\n    return rng.choice(runs) if runs else rng.choice(\" \".join(said).split()[:8] or [\"?\"])\n\n\ndef story(rng, members):\n    \"\"\"A full reports document for one cluster's printings, primary first: the earliest.\"\"\"\n    members = sorted(members, key=lambda row: (row[\"date\"], row[\"article_id\"]))\n    primary = members[0]\n    said = sentences(primary[\"text\"])\n    town = name(rng, said, 1)\n    people = [\n        stated(rng, said, name(rng, said, 2))\n        for _ in range(rng.choice([0, 0, 1, 1, 2, 3]))\n    ]\n    vector = np.random.default_rng(rng.randrange(2**32)).normal(size=DIMENSIONS)\n    year = int(primary[\"date\"][:4])\n    doc = {\n        \"_id\": f\"r_{primary['article_id']}\",\n        \"primary_article_id\": primary[\"article_id\"],\n        \"printings\": [printing(row) for row in members],\n        \"headline\": primary[\"headline\"] or \"\",\n        \"text\": primary[\"text\"] or \"\",\n        \"display_headline\": display_headline(\n            primary[\"headline\"] or \"\", primary[\"paper\"], primary[\"date\"]\n        ),\n        \"date\": primary[\"date\"],\n        \"year\": year,\n        \"month_day\": primary[\"date\"][5:],\n        \"decade\": year // 10 * 10,\n        \"kind\": \"report\",\n        \"fields\": {\n            \"place\": stated(rng, said, town),\n            \"people\": people,\n            \"seen\": stated(rng, said),\n            \"outcome\": stated(rng, said, rng.choice(OUTCOMES)),\n            \"specific_place\": stated(rng, said),\n            \"place_type\": stated(rng, said, rng.choice(PLACE_TYPES)),\n            \"precision\": stated(rng, said, \"town\"),\n        },\n        \"location\": {\n            \"type\": \"Point\",\n            \"coordinates\": [\n                round(rng.uniform(-124, -67), 6),\n                round(rng.uniform(25, 49), 6),\n            ],\n        },\n        \"location_precision\": \"town\",\n        \"location_source\": f\"geonames:{rng.randrange(4_000_000, 6_000_000)}\",\n        \"place_id\": rng.randrange(4_000_000, 6_000_000),\n        \"town\": town,\n        \"state\": primary[\"state\"],\n        \"embedding\": Binary.from_vector(vector.tolist(), BinaryVectorDtype.FLOAT32),\n        \"versions\": {\n            \"code\": CODE,\n            \"lexicon\": \"v2\",\n            \"model\": \"Qwen/Qwen3.5-4B\",\n            \"adapter\": \"paperghosts-reader-lora-v1\",\n            \"prompt\": \"reader-v1\",\n        },\n        \"lexicon_terms\": sorted(primary[\"terms\"]),\n    }\n    stored = Report.model_validate(doc).model_dump(by_alias=True, exclude_none=True)\n    return stored, members\n\n\ndef int8(values):\n    v = np.asarray(values)\n    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)\n    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)\n\n\ndef packed(boxes, dtype):\n    \"\"\"bbox_list as BinData: each box's x0, y0, x1, y1, little-endian, unpacked when read.\"\"\"\n    return Binary(np.array([[box[k] for k in BOX] for box in boxes], dtype=dtype).tobytes())\n\n\ndef variants(doc, members):\n    \"\"\"The document as stored, with each of rule 6's levers turned off, and with each further\n    lever on, alone and together.\"\"\"\n    texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}\n    floats = doc[\"embedding\"].as_vector().data\n\n    def crops(p):\n        service = p.get(\"service\")\n        if service is None:  # its service would be looked up: one of the usual length\n            where = f\"{p['lccn']}:{p['reel']}:{p['issue']}:{p['frame']}\"\n            service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{where}\"\n        return crop_urls(service, p[\"bbox_list\"])\n\n    def each(change):\n        return [change(dict(p)) for p in doc[\"printings\"]]\n\n    untitled = each(lambda p: {k: v for k, v in p.items() if k not in (\"paper\", \"place\", \"state\")})\n    bare = {k: v for k, v in doc.items() if k != \"display_headline\"}\n    three = bare | {\n        \"printings\": [p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")} for p in untitled]\n    }\n    return {\n        BASE: doc,\n        \"rule 6 off: embedding as an array of doubles\": doc | {\"embedding\": list(floats)},\n        \"rule 6 off: crop URLs stored\": doc\n        | {\"printings\": each(lambda p: p | {\"crop_urls\": crops(p)})},\n        \"rule 6 off: printings with their own text\": doc\n        | {\"printings\": each(lambda p: p | {\"text\": texts[p[\"article_id\"]]})},\n        \"bbox_list as int16 BinData\": doc\n        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")})},\n        \"bbox_list as int32 BinData\": doc\n        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i4\")})},\n        \"paper, place and state in a title lookup\": doc | {\"printings\": untitled},\n        \"display_headline derived at read time\": bare,\n        \"int8 embedding\": doc | {\"embedding\": int8(floats)},\n        \"the three, float32\": three,\n        \"the three, int8\": three | {\"embedding\": int8(floats)},\n    }\n\n\ndef parts(doc):\n    \"\"\"The document's bytes by part; the rest is its ids, dates, place, versions and terms.\"\"\"\n\n    def element(key, value):\n        return len(bson.encode({key: value})) - len(bson.encode({}))\n\n    boxes = sum(element(\"bbox_list\", p[\"bbox_list\"]) for p in doc[\"printings\"])\n    found = {\n        \"text\": element(\"text\", doc[\"text\"]),\n        \"headline and display headline\": element(\"headline\", doc[\"headline\"])\n        + element(\"display_headline\", doc[\"display_headline\"]),\n        \"printings, apart from their boxes\": element(\"printings\", doc[\"printings\"]) - boxes,\n        \"printings' bbox_list\": boxes,\n        \"reader fields\": element(\"fields\", doc[\"fields\"]),\n        \"embedding\": element(\"embedding\", doc[\"embedding\"]),\n    }\n    found[\"the rest\"] = len(bson.encode(doc)) - sum(found.values())\n    return found\n\n\ndef summary(sizes):\n    ordered = sorted(sizes)\n    return {\n        \"total\": sum(ordered),\n        \"mean\": round(statistics.fmean(ordered), 1),\n        \"median\": statistics.median(ordered),\n        \"p90\": ordered[int(0.9 * (len(ordered) - 1))],\n        \"max\": ordered[-1],\n    }\n\n\ndef measure(built):\n    \"\"\"Bytes by part and by variant for a list of (doc, members), and a story's bytes as the\n    story itself and so much per printing.\"\"\"\n    by_part, by_variant = defaultdict(list), defaultdict(list)\n    alone, extra, printings = defaultdict(list), defaultdict(int), []\n    for doc, members in built:\n        printings.append(len(doc[\"printings\"]))\n        for label, value in parts(doc).items():\n            by_part[label].append(value)\n        for label, variant in variants(doc, members).items():\n            whole = len(bson.encode(variant))\n            bare = len(bson.encode(variant | {\"printings\": []}))\n            by_variant[label].append(whole)\n            alone[label].append(bare)\n            extra[label] += whole - bare\n    return {\n        \"stories\": len(built),\n        \"printings\": {\n            \"total\": sum(printings),\n            \"per_story\": round(sum(printings) / len(printings), 2),\n            \"stories_with_more_than_one\": sum(n > 1 for n in printings),\n            \"most\": max(printings),\n        },\n        \"bytes_by_part\": {label: summary(v) for label, v in by_part.items()},\n        \"bytes\": {label: summary(v) for label, v in by_variant.items()},\n        \"bytes_per\": {\n            label: {\n                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),\n                \"printing\": round(extra[label] / sum(printings), 1),\n            }\n            for label in by_variant\n        },\n    }\n\n\ndef settled(collection):\n    time.sleep(SETTLE)\n    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))\n    stats = stats[\"storageStats\"]\n    return {\n        \"count\": stats[\"count\"],\n        \"data_bytes\": stats[\"size\"],\n        \"storage_bytes\": stats[\"storageSize\"],\n        \"index_bytes\": stats[\"totalIndexSize\"],\n        \"index_bytes_by_index\": stats[\"indexSizes\"],\n    }\n\n\ndef atlas(docs):\n    \"\"\"The 1,000 in a scratch collection with the reports validator and its indexes (no\n    Search indexes: M0's cap), 500 at a time, then the collection dropped.\"\"\"\n    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:\n        db = client[\"paperghosts\"]\n        scratch = db.create_collection(\n            f\"scratch_budget_{uuid.uuid4().hex[:8]}\", validator=validator(Report)\n        )\n        try:\n            scratch.create_indexes(INDEXES[\"reports\"])\n            steps = {\"empty\": settled(scratch)}\n            for start in range(0, len(docs), BATCH):\n                scratch.insert_many(docs[start : start + BATCH], ordered=False)\n                steps[f\"after {min(start + BATCH, len(docs))}\"] = settled(scratch)\n        finally:\n            scratch.drop()\n        left = scratch.name in db.list_collection_names()\n        storage = {\n            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}\n            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}\n            for name in client.list_database_names()\n            if name not in (\"admin\", \"local\")\n            for s in [client[name].command(\"dbStats\")]\n        }\n    return steps, left, storage\n\n\ndef capacity(samples, index_per_story, titles_bytes, storage):\n    \"\"\"Whether the top of the range fits, and how many stories would, per variant: a story's\n    bytes from whichever sample has more, its index bytes from Atlas, and the title lookup\n    where a variant uses it.\"\"\"\n    counted = {name: s[\"counted\"] for name, s in storage.items()}\n    free = {\n        \"with sample_mflix\": LIMIT - sum(counted.values()),\n        \"without sample_mflix\": LIMIT\n        - sum(v for k, v in counted.items() if k != \"sample_mflix\"),\n    }\n    scenarios = {\n        \"v1's ratio of stories to printings\": round(PRINTINGS * STORIES_PER_PRINTING),\n        \"one story per printing\": PRINTINGS,\n    }\n    out = {\"limit\": LIMIT, \"printings\": PRINTINGS, \"free\": free, \"variants\": {}}\n    for label in samples[0][\"bytes_per\"]:\n        story_bytes = max(s[\"bytes_per\"][label][\"story_without_its_printings\"] for s in samples)\n        printing_bytes = max(s[\"bytes_per\"][label][\"printing\"] for s in samples)\n        fixed = titles_bytes if \"title lookup\" in label or label.startswith(\"the three\") else 0\n        rows = {}\n        for scenario, stories in scenarios.items():\n            need = stories * (story_bytes + index_per_story) + PRINTINGS * printing_bytes + fixed\n            per = story_bytes + index_per_story + PRINTINGS / stories * printing_bytes\n            rows[scenario] = {\n                \"stories\": stories,\n                \"bytes\": round(need),\n                \"fits\": {k: need <= v for k, v in free.items()},\n                \"stories_that_fit\": {k: int((v - fixed) // per) for k, v in free.items()},\n            }\n        out[\"variants\"][label] = {\n            \"story_bytes\": story_bytes,\n            \"printing_bytes\": printing_bytes,\n            \"fixed_bytes\": fixed,\n            \"scenarios\": rows,\n        }\n    return out\n\n\ndef judged_reports():\n    \"\"\"The 25 reports judged so far: eval A's 7, the screen's 4 and 2A.8's 14.\"\"\"\n    composition = json.loads((RESULTS / \"eval_a\" / \"composition.json\").read_text())\n    screen = json.loads((RESULTS / \"eval_a\" / \"screen.json\").read_text())\n    added = json.loads((RESULTS / \"eval_a_v2\" / \"added.json\").read_text())\n    return {\n        \"eval A\": [i[\"article_id\"] for i in composition if i[\"category\"] == \"ghost_report\"],\n        \"screen\": [i[\"article_id\"] for i in screen if i[\"ghost_report\"]],\n        \"2A.8\": [i[\"article_id\"] for i in added if i[\"ghost_report\"]],\n    }\n\n\ndef main():\n    counts = {\n        c[\"year\"]: c[\"candidates\"]\n        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(y for y in counts if counts[y])\n    starts, total = {}, 0\n    for year in years:\n        starts[year], total = total, total + counts[year]\n    rng = random.Random(SEED)\n    picks = sorted(rng.sample(range(total), PICKS))\n\n    doc_keys, ids, titles = [], [], {}\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for _, found, named, held in pool.map(year_keys, years):\n            doc_keys += found\n            ids += named\n            for lccn, title in held.items():\n                titles.setdefault(lccn, title)\n    assert len(doc_keys) == total\n    group_of = {}\n    for group in clusters(doc_keys, least=2):\n        for doc in group:\n            group_of[doc] = group\n    del doc_keys\n    index_of = {article: i for i, article in enumerate(ids)}\n    judged = judged_reports()\n    not_candidates = sorted(a for found in judged.values() for a in found if a not in index_of)\n\n    def groups_of(docs):\n        found, seen = [], set()\n        for doc in docs:\n            group = tuple(group_of.get(doc, (doc,)))\n            if group not in seen:  # two picks from one cluster are one story\n                seen.add(group)\n                found.append(group)\n        return found\n\n    sampled = groups_of(picks)\n    reports = groups_of(\n        sorted({index_of[a] for found in judged.values() for a in found if a in index_of})\n    )\n    wanted = defaultdict(set)\n    for group in sampled + reports:\n        for doc in group:\n            year = max(y for y in years if starts[y] <= doc)\n            wanted[year].add(doc - starts[year])\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        rows = {\n            starts[year] + index: row\n            for year, found in pool.map(year_rows, wanted.items())\n            for index, row in found.items()\n        }\n    built = [story(rng, [rows[d] for d in group]) for group in sampled]\n    judged_built = [story(rng, [rows[d] for d in group]) for group in reports]\n    boxes = [v for doc, _ in built + judged_built for p in doc[\"printings\"] for b in p[\"bbox_list\"] for v in b.values()]\n    title_entries = [\n        len(bson.encode({\"_id\": lccn} | {k: v for k, v in t.items() if v}))\n        for lccn, t in titles.items()\n    ]\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"seed\": SEED,\n        \"candidates_drawn\": PICKS,\n        \"of_candidates\": total,\n        \"sample\": measure(built),\n        \"judged_reports\": {\n            \"counts\": {k: len(v) for k, v in judged.items()},\n            \"not_v2_candidates\": not_candidates,\n            **measure(judged_built),\n        },\n        \"largest_box_coordinate\": max(boxes),\n        \"title_lookup\": {\n            \"lccns\": len(titles),\n            \"bytes\": sum(title_entries),\n            \"mean_entry_bytes\": round(statistics.fmean(title_entries), 1),\n        },\n    }\n    steps, left, storage = atlas([doc for doc, _ in built])\n    first, last = steps[f\"after {BATCH}\"], steps[f\"after {len(built)}\"]\n    index_per_story = max(\n        last[\"index_bytes\"] / last[\"count\"],\n        (last[\"index_bytes\"] - first[\"index_bytes\"]) / (last[\"count\"] - first[\"count\"]),\n    )\n    report[\"atlas\"] = {\n        \"steps\": steps,\n        \"data_bytes_per_story\": last[\"data_bytes\"] / last[\"count\"],\n        \"index_bytes_per_story\": round(index_per_story, 1),\n        \"scratch_collection_left\": left,\n    }\n    report[\"storage_by_database\"] = storage\n    report[\"capacity\"] = capacity(\n        [report[\"sample\"], report[\"judged_reports\"]],\n        index_per_story,\n        report[\"title_lookup\"][\"bytes\"],\n        storage,\n    )\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    OUT.write_text(json.dumps(report, indent=1) + \"\\n\")\n    for name in (\"sample\", \"judged_reports\"):\n        s = report[name]\n        print(\n            f\"{name}: {s['stories']} stories, {s['printings']['total']} printings; \"\n            f\"BSON mean {s['bytes'][BASE]['mean']:,} bytes\"\n        )\n    print(f\"wrote {OUT.relative_to(ROOT)}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8448,"cache_read_input_tokens":620464,"output_tokens":10992,"output_tokens_details":{"thinking_tokens":3007},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8448,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":10992,"cache_read_input_tokens":620464,"cache_creation_input_tokens":8448,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8448},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"wireToolInputs":{"toolu_01Mm3LEJZaiZUP5VbLoW6b4M":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py","content":"\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents, with their\nreal text, their reprint clusters' printings, a BinData embedding, and reader fields whose quotes\nare real sentences of the article. They are built for a seeded 1,000 of lexicon v2's candidates,\nand for the judged reports that v2 makes candidates.\n\n1. Offline, with bson.encode: the bytes of each document by part, with each of rule 6's levers\n   turned off, and with each further lever on: bbox_list packed as BinData, paper, place and\n   state in a title lookup by LCCN, display_headline derived at read time, and an int8 embedding.\n2. Atlas's own data and index sizes, for the 1,000 loaded 500 at a time into a scratch\n   collection with the reports validator and indexes. The collection is dropped afterwards.\n3. Each database's use of M0's storage: data size plus index size, as Atlas counts it.\n4. How many stories fit at the top of decisions 30 and 31's intervals.\n\nWrites eval/results/phase2b/budget.json, which Docs/BUDGET.md reads.\"\"\"\n\nimport json\nimport random\nimport re\nimport statistics\nimport time\nimport uuid\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport bson\nimport numpy as np\nimport zstandard\nfrom bson.binary import Binary, BinaryVectorDtype\nfrom pymongo import MongoClient\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.config import setting\nfrom paperghosts.ingest.crops import MEMBER, crop_urls\nfrom paperghosts.ingest.headline import display_headline\nfrom paperghosts.schemas import DIMENSIONS, Report\nfrom paperghosts.store.db_init import INDEXES\nfrom paperghosts.store.printings import printing\nfrom paperghosts.store.validators import validator\n\nROOT = Path(__file__).parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"phase2b\" / \"budget.json\"\nSEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500\nSETTLE = 75  # seconds: WiredTiger's checkpoint, once a minute, updates the index sizes\nCODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length\nOUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]\nPLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]\nBOX = (\"x0\", \"y0\", \"x1\", \"y1\")\nBASE = \"as stored: rule 6's levers on, float32\"\nLIMIT = 500_000_000  # M0's \"0.5 GB\"; read as 512 MiB it would be 536,870,912\nPRINTINGS = 74_027 + 21_176  # the tops of decision 27's and decision 31's intervals\nSTORIES_PER_PRINTING = 22_300 / 36_766  # lexicon v1's (decision 27)\n\n\ndef year_keys(year):\n    \"\"\"Each candidate's reprint keys and article ID in file order, and each LCCN's title.\"\"\"\n    found, ids, titles = [], [], {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for row in map(json.loads, rows):\n            found.append(tuple(keys(row[\"text\"])))\n            ids.append(row[\"article_id\"])\n            lccn = row[\"lccn\"] or MEMBER.search(row[\"member\"])[\"lccn\"]\n            titles.setdefault(lccn, {\"paper\": row[\"paper\"], \"state\": row[\"state\"]})\n    return year, found, ids, titles\n\n\ndef year_rows(job):\n    year, wanted = job\n    found = {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(rows):\n            if index in wanted:\n                found[index] = json.loads(row)\n    return year, found\n\n\ndef sentences(text):\n    flat = \" \".join((text or \"\").replace(\"-\\n\", \"\").split())\n    return [s for s in re.split(r\"(?<=[.!?])\\s+\", flat) if len(s) >= 30] or [flat[:200]]\n\n\ndef quote(sentence, most=200):\n    \"\"\"A verbatim span, as the reader quotes one: a sentence, cut at a word under `most`.\"\"\"\n    return sentence if len(sentence) <= most else sentence[:most].rsplit(\" \", 1)[0]\n\n\ndef stated(rng, said, value=None):\n    sentence = rng.choice(said)\n    if value is None:\n        words = sentence.split()\n        start = rng.randrange(max(1, len(words) - 6))\n        value = \" \".join(words[start : start + rng.randint(3, 6)])\n    return {\n        \"value\": value,\n        \"quote\": quote(sentence),\n        \"verified\": True,\n        \"score\": round(rng.random(), 3),\n    }\n\n\ndef name(rng, said, words):\n    \"\"\"A run of capitalized words from the text, as a place or a person reads.\"\"\"\n    runs = re.findall(\n        rf\"\\b[A-Z][a-z]{{2,}}(?: [A-Z][a-z]{{2,}}){{{words - 1}}}\\b\", \" \".join(said)\n    )\n    return rng.choice(runs) if runs else rng.choice(\" \".join(said).split()[:8] or [\"?\"])\n\n\ndef story(rng, members):\n    \"\"\"A full reports document for one cluster's printings, primary first: the earliest.\"\"\"\n    members = sorted(members, key=lambda row: (row[\"date\"], row[\"article_id\"]))\n    primary = members[0]\n    said = sentences(primary[\"text\"])\n    town = name(rng, said, 1)\n    people = [\n        stated(rng, said, name(rng, said, 2))\n        for _ in range(rng.choice([0, 0, 1, 1, 2, 3]))\n    ]\n    vector = np.random.default_rng(rng.randrange(2**32)).normal(size=DIMENSIONS)\n    year = int(primary[\"date\"][:4])\n    doc = {\n        \"_id\": f\"r_{primary['article_id']}\",\n        \"primary_article_id\": primary[\"article_id\"],\n        \"printings\": [printing(row) for row in members],\n        \"headline\": primary[\"headline\"] or \"\",\n        \"text\": primary[\"text\"] or \"\",\n        \"display_headline\": display_headline(\n            primary[\"headline\"] or \"\", primary[\"paper\"], primary[\"date\"]\n        ),\n        \"date\": primary[\"date\"],\n        \"year\": year,\n        \"month_day\": primary[\"date\"][5:],\n        \"decade\": year // 10 * 10,\n        \"kind\": \"report\",\n        \"fields\": {\n            \"place\": stated(rng, said, town),\n            \"people\": people,\n            \"seen\": stated(rng, said),\n            \"outcome\": stated(rng, said, rng.choice(OUTCOMES)),\n            \"specific_place\": stated(rng, said),\n            \"place_type\": stated(rng, said, rng.choice(PLACE_TYPES)),\n            \"precision\": stated(rng, said, \"town\"),\n        },\n        \"location\": {\n            \"type\": \"Point\",\n            \"coordinates\": [\n                round(rng.uniform(-124, -67), 6),\n                round(rng.uniform(25, 49), 6),\n            ],\n        },\n        \"location_precision\": \"town\",\n        \"location_source\": f\"geonames:{rng.randrange(4_000_000, 6_000_000)}\",\n        \"place_id\": rng.randrange(4_000_000, 6_000_000),\n        \"town\": town,\n        \"state\": primary[\"state\"],\n        \"embedding\": Binary.from_vector(vector.tolist(), BinaryVectorDtype.FLOAT32),\n        \"versions\": {\n            \"code\": CODE,\n            \"lexicon\": \"v2\",\n            \"model\": \"Qwen/Qwen3.5-4B\",\n            \"adapter\": \"paperghosts-reader-lora-v1\",\n            \"prompt\": \"reader-v1\",\n        },\n        \"lexicon_terms\": sorted(primary[\"terms\"]),\n    }\n    stored = Report.model_validate(doc).model_dump(by_alias=True, exclude_none=True)\n    return stored, members\n\n\ndef int8(values):\n    v = np.asarray(values)\n    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)\n    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)\n\n\ndef packed(boxes, dtype):\n    \"\"\"bbox_list as BinData: each box's x0, y0, x1, y1, little-endian, unpacked when read.\"\"\"\n    return Binary(np.array([[box[k] for k in BOX] for box in boxes], dtype=dtype).tobytes())\n\n\ndef variants(doc, members):\n    \"\"\"The document as stored, with each of rule 6's levers turned off, and with each further\n    lever on, alone and together.\"\"\"\n    texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}\n    floats = doc[\"embedding\"].as_vector().data\n\n    def crops(p):\n        service = p.get(\"service\")\n        if service is None:  # its service would be looked up: one of the usual length\n            where = f\"{p['lccn']}:{p['reel']}:{p['issue']}:{p['frame']}\"\n            service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{where}\"\n        return crop_urls(service, p[\"bbox_list\"])\n\n    def each(change):\n        return [change(dict(p)) for p in doc[\"printings\"]]\n\n    untitled = each(lambda p: {k: v for k, v in p.items() if k not in (\"paper\", \"place\", \"state\")})\n    bare = {k: v for k, v in doc.items() if k != \"display_headline\"}\n    three = bare | {\n        \"printings\": [p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")} for p in untitled]\n    }\n    return {\n        BASE: doc,\n        \"rule 6 off: embedding as an array of doubles\": doc | {\"embedding\": list(floats)},\n        \"rule 6 off: crop URLs stored\": doc\n        | {\"printings\": each(lambda p: p | {\"crop_urls\": crops(p)})},\n        \"rule 6 off: printings with their own text\": doc\n        | {\"printings\": each(lambda p: p | {\"text\": texts[p[\"article_id\"]]})},\n        \"bbox_list as int16 BinData\": doc\n        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")})},\n        \"bbox_list as int32 BinData\": doc\n        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i4\")})},\n        \"paper, place and state in a title lookup\": doc | {\"printings\": untitled},\n        \"display_headline derived at read time\": bare,\n        \"int8 embedding\": doc | {\"embedding\": int8(floats)},\n        \"the three, float32\": three,\n        \"the three, int8\": three | {\"embedding\": int8(floats)},\n    }\n\n\ndef parts(doc):\n    \"\"\"The document's bytes by part; the rest is its ids, dates, place, versions and terms.\"\"\"\n\n    def element(key, value):\n        return len(bson.encode({key: value})) - len(bson.encode({}))\n\n    boxes = sum(element(\"bbox_list\", p[\"bbox_list\"]) for p in doc[\"printings\"])\n    found = {\n        \"text\": element(\"text\", doc[\"text\"]),\n        \"headline and display headline\": element(\"headline\", doc[\"headline\"])\n        + element(\"display_headline\", doc[\"display_headline\"]),\n        \"printings, apart from their boxes\": element(\"printings\", doc[\"printings\"]) - boxes,\n        \"printings' bbox_list\": boxes,\n        \"reader fields\": element(\"fields\", doc[\"fields\"]),\n        \"embedding\": element(\"embedding\", doc[\"embedding\"]),\n    }\n    found[\"the rest\"] = len(bson.encode(doc)) - sum(found.values())\n    return found\n\n\ndef summary(sizes):\n    ordered = sorted(sizes)\n    return {\n        \"total\": sum(ordered),\n        \"mean\": round(statistics.fmean(ordered), 1),\n        \"median\": statistics.median(ordered),\n        \"p90\": ordered[int(0.9 * (len(ordered) - 1))],\n        \"max\": ordered[-1],\n    }\n\n\ndef measure(built):\n    \"\"\"Bytes by part and by variant for a list of (doc, members), and a story's bytes as the\n    story itself and so much per printing.\"\"\"\n    by_part, by_variant = defaultdict(list), defaultdict(list)\n    alone, extra, printings = defaultdict(list), defaultdict(int), []\n    for doc, members in built:\n        printings.append(len(doc[\"printings\"]))\n        for label, value in parts(doc).items():\n            by_part[label].append(value)\n        for label, variant in variants(doc, members).items():\n            whole = len(bson.encode(variant))\n            bare = len(bson.encode(variant | {\"printings\": []}))\n            by_variant[label].append(whole)\n            alone[label].append(bare)\n            extra[label] += whole - bare\n    return {\n        \"stories\": len(built),\n        \"printings\": {\n            \"total\": sum(printings),\n            \"per_story\": round(sum(printings) / len(printings), 2),\n            \"stories_with_more_than_one\": sum(n > 1 for n in printings),\n            \"most\": max(printings),\n        },\n        \"bytes_by_part\": {label: summary(v) for label, v in by_part.items()},\n        \"bytes\": {label: summary(v) for label, v in by_variant.items()},\n        \"bytes_per\": {\n            label: {\n                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),\n                \"printing\": round(extra[label] / sum(printings), 1),\n            }\n            for label in by_variant\n        },\n    }\n\n\ndef settled(collection):\n    time.sleep(SETTLE)\n    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))\n    stats = stats[\"storageStats\"]\n    return {\n        \"count\": stats[\"count\"],\n        \"data_bytes\": stats[\"size\"],\n        \"storage_bytes\": stats[\"storageSize\"],\n        \"index_bytes\": stats[\"totalIndexSize\"],\n        \"index_bytes_by_index\": stats[\"indexSizes\"],\n    }\n\n\ndef atlas(docs):\n    \"\"\"The 1,000 in a scratch collection with the reports validator and its indexes (no\n    Search indexes: M0's cap), 500 at a time, then the collection dropped.\"\"\"\n    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:\n        db = client[\"paperghosts\"]\n        scratch = db.create_collection(\n            f\"scratch_budget_{uuid.uuid4().hex[:8]}\", validator=validator(Report)\n        )\n        try:\n            scratch.create_indexes(INDEXES[\"reports\"])\n            steps = {\"empty\": settled(scratch)}\n            for start in range(0, len(docs), BATCH):\n                scratch.insert_many(docs[start : start + BATCH], ordered=False)\n                steps[f\"after {min(start + BATCH, len(docs))}\"] = settled(scratch)\n        finally:\n            scratch.drop()\n        left = scratch.name in db.list_collection_names()\n        storage = {\n            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}\n            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}\n            for name in client.list_database_names()\n            if name not in (\"admin\", \"local\")\n            for s in [client[name].command(\"dbStats\")]\n        }\n    return steps, left, storage\n\n\ndef capacity(samples, index_per_story, titles_bytes, storage):\n    \"\"\"Whether the top of the range fits, and how many stories would, per variant: a story's\n    bytes from whichever sample has more, its index bytes from Atlas, and the title lookup\n    where a variant uses it.\"\"\"\n    counted = {name: s[\"counted\"] for name, s in storage.items()}\n    free = {\n        \"with sample_mflix\": LIMIT - sum(counted.values()),\n        \"without sample_mflix\": LIMIT\n        - sum(v for k, v in counted.items() if k != \"sample_mflix\"),\n    }\n    scenarios = {\n        \"v1's ratio of stories to printings\": round(PRINTINGS * STORIES_PER_PRINTING),\n        \"one story per printing\": PRINTINGS,\n    }\n    out = {\"limit\": LIMIT, \"printings\": PRINTINGS, \"free\": free, \"variants\": {}}\n    for label in samples[0][\"bytes_per\"]:\n        story_bytes = max(s[\"bytes_per\"][label][\"story_without_its_printings\"] for s in samples)\n        printing_bytes = max(s[\"bytes_per\"][label][\"printing\"] for s in samples)\n        fixed = titles_bytes if \"title lookup\" in label or label.startswith(\"the three\") else 0\n        rows = {}\n        for scenario, stories in scenarios.items():\n            need = stories * (story_bytes + index_per_story) + PRINTINGS * printing_bytes + fixed\n            per = story_bytes + index_per_story + PRINTINGS / stories * printing_bytes\n            rows[scenario] = {\n                \"stories\": stories,\n                \"bytes\": round(need),\n                \"fits\": {k: need <= v for k, v in free.items()},\n                \"stories_that_fit\": {k: int((v - fixed) // per) for k, v in free.items()},\n            }\n        out[\"variants\"][label] = {\n            \"story_bytes\": story_bytes,\n            \"printing_bytes\": printing_bytes,\n            \"fixed_bytes\": fixed,\n            \"scenarios\": rows,\n        }\n    return out\n\n\ndef judged_reports():\n    \"\"\"The 25 reports judged so far: eval A's 7, the screen's 4 and 2A.8's 14.\"\"\"\n    composition = json.loads((RESULTS / \"eval_a\" / \"composition.json\").read_text())\n    screen = json.loads((RESULTS / \"eval_a\" / \"screen.json\").read_text())\n    added = json.loads((RESULTS / \"eval_a_v2\" / \"added.json\").read_text())\n    return {\n        \"eval A\": [i[\"article_id\"] for i in composition if i[\"category\"] == \"ghost_report\"],\n        \"screen\": [i[\"article_id\"] for i in screen if i[\"ghost_report\"]],\n        \"2A.8\": [i[\"article_id\"] for i in added if i[\"ghost_report\"]],\n    }\n\n\ndef main():\n    counts = {\n        c[\"year\"]: c[\"candidates\"]\n        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(y for y in counts if counts[y])\n    starts, total = {}, 0\n    for year in years:\n        starts[year], total = total, total + counts[year]\n    rng = random.Random(SEED)\n    picks = sorted(rng.sample(range(total), PICKS))\n\n    doc_keys, ids, titles = [], [], {}\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for _, found, named, held in pool.map(year_keys, years):\n            doc_keys += found\n            ids += named\n            for lccn, title in held.items():\n                titles.setdefault(lccn, title)\n    assert len(doc_keys) == total\n    group_of = {}\n    for group in clusters(doc_keys, least=2):\n        for doc in group:\n            group_of[doc] = group\n    del doc_keys\n    index_of = {article: i for i, article in enumerate(ids)}\n    judged = judged_reports()\n    not_candidates = sorted(a for found in judged.values() for a in found if a not in index_of)\n\n    def groups_of(docs):\n        found, seen = [], set()\n        for doc in docs:\n            group = tuple(group_of.get(doc, (doc,)))\n            if group not in seen:  # two picks from one cluster are one story\n                seen.add(group)\n                found.append(group)\n        return found\n\n    sampled = groups_of(picks)\n    reports = groups_of(\n        sorted({index_of[a] for found in judged.values() for a in found if a in index_of})\n    )\n    wanted = defaultdict(set)\n    for group in sampled + reports:\n        for doc in group:\n            year = max(y for y in years if starts[y] <= doc)\n            wanted[year].add(doc - starts[year])\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        rows = {\n            starts[year] + index: row\n            for year, found in pool.map(year_rows, wanted.items())\n            for index, row in found.items()\n        }\n    built = [story(rng, [rows[d] for d in group]) for group in sampled]\n    judged_built = [story(rng, [rows[d] for d in group]) for group in reports]\n    boxes = [v for doc, _ in built + judged_built for p in doc[\"printings\"] for b in p[\"bbox_list\"] for v in b.values()]\n    title_entries = [\n        len(bson.encode({\"_id\": lccn} | {k: v for k, v in t.items() if v}))\n        for lccn, t in titles.items()\n    ]\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"seed\": SEED,\n        \"candidates_drawn\": PICKS,\n        \"of_candidates\": total,\n        \"sample\": measure(built),\n        \"judged_reports\": {\n            \"counts\": {k: len(v) for k, v in judged.items()},\n            \"not_v2_candidates\": not_candidates,\n            **measure(judged_built),\n        },\n        \"largest_box_coordinate\": max(boxes),\n        \"title_lookup\": {\n            \"lccns\": len(titles),\n            \"bytes\": sum(title_entries),\n            \"mean_entry_bytes\": round(statistics.fmean(title_entries), 1),\n        },\n    }\n    steps, left, storage = atlas([doc for doc, _ in built])\n    first, last = steps[f\"after {BATCH}\"], steps[f\"after {len(built)}\"]\n    index_per_story = max(\n        last[\"index_bytes\"] / last[\"count\"],\n        (last[\"index_bytes\"] - first[\"index_bytes\"]) / (last[\"count\"] - first[\"count\"]),\n    )\n    report[\"atlas\"] = {\n        \"steps\": steps,\n        \"data_bytes_per_story\": last[\"data_bytes\"] / last[\"count\"],\n        \"index_bytes_per_story\": round(index_per_story, 1),\n        \"scratch_collection_left\": left,\n    }\n    report[\"storage_by_database\"] = storage\n    report[\"capacity\"] = capacity(\n        [report[\"sample\"], report[\"judged_reports\"]],\n        index_per_story,\n        report[\"title_lookup\"][\"bytes\"],\n        storage,\n    )\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    OUT.write_text(json.dumps(report, indent=1) + \"\\n\")\n    for name in (\"sample\", \"judged_reports\"):\n        s = report[name]\n        print(\n            f\"{name}: {s['stories']} stories, {s['printings']['total']} printings; \"\n            f\"BSON mean {s['bytes'][BASE]['mean']:,} bytes\"\n        )\n    print(f\"wrote {OUT.relative_to(ROOT)}\")\n\n\nif __name__ == \"__main__\":\n    main()\n"}},"serverClassifierRequest":"07dd8f81-9884-423f-9cba-534ddcee5dc5","apiBlockIndex":1,"requestId":"req_011CgYsEdhWZkeFMCA5eU8qF","requestRef":"35640c81-03c2-4449-a92f-9f73dea3c7d1","requestedModel":"claude-opus-5-5","type":"assistant","uuid":"3e452fe4-a936-484d-a9c3-db0e634549f9","timestamp":"2026-10-30T18:08:26.658Z","advisorModel":"claude-opus-5-5","effort":"max","perTurnEffort":"max","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2b-data-layer","slug":"sunny-popping-comet"}
{"parentUuid":"3e452fe4-a936-484d-a9c3-db0e634549f9","isSidechain":false,"promptId":"5cdf18f0-2d85-4e56-b04c-ea94ad2b37e1","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mm3LEJZaiZUP5VbLoW6b4M","type":"tool_result","content":"The file /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"7357c33d-c15d-4d67-bf35-1f35e7c7804b","timestamp":"2026-10-30T18:08:26.713Z","toolUseResult":{"type":"update","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/budget_probe.py","content":"\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents, with their\nreal text, their reprint clusters' printings, a BinData embedding, and reader fields whose quotes\nare real sentences of the article. They are built for a seeded 1,000 of lexicon v2's candidates,\nand for the judged reports that v2 makes candidates.\n\n1. Offline, with bson.encode: the bytes of each document by part, with each of rule 6's levers\n   turned off, and with each further lever on: bbox_list packed as BinData, paper, place and\n   state in a title lookup by LCCN, display_headline derived at read time, and an int8 embedding.\n2. Atlas's own data and index sizes, for the 1,000 loaded 500 at a time into a scratch\n   collection with the reports validator and indexes. The collection is dropped afterwards.\n3. Each database's use of M0's storage: data size plus index size, as Atlas counts it.\n4. How many stories fit at the top of decisions 30 and 31's intervals.\n\nWrites eval/results/phase2b/budget.json, which Docs/BUDGET.md reads.\"\"\"\n\nimport json\nimport random\nimport re\nimport statistics\nimport time\nimport uuid\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import UTC, datetime\nfrom pathlib import Path\n\nimport bson\nimport numpy as np\nimport zstandard\nfrom bson.binary import Binary, BinaryVectorDtype\nfrom pymongo import MongoClient\n\nfrom paperghosts.cluster.reprints import clusters, keys\nfrom paperghosts.config import setting\nfrom paperghosts.ingest.crops import MEMBER, crop_urls\nfrom paperghosts.ingest.headline import display_headline\nfrom paperghosts.schemas import DIMENSIONS, Report\nfrom paperghosts.store.db_init import INDEXES\nfrom paperghosts.store.printings import printing\nfrom paperghosts.store.validators import validator\n\nROOT = Path(__file__).parents[1]\nDATA = ROOT / \"data\"\nRESULTS = ROOT / \"eval\" / \"results\"\nOUT = RESULTS / \"phase2b\" / \"budget.json\"\nSEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500\nSETTLE = 75  # seconds: WiredTiger's checkpoint, once a minute, updates the index sizes\nCODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length\nOUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]\nPLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]\nBOX = (\"x0\", \"y0\", \"x1\", \"y1\")\nBASE = \"as stored: rule 6's levers on, float32\"\nLIMIT = 500_000_000  # M0's \"0.5 GB\"; read as 512 MiB it would be 536,870,912\nPRINTINGS = 74_027 + 21_176  # the tops of decision 27's and decision 31's intervals\nSTORIES_PER_PRINTING = 22_300 / 36_766  # lexicon v1's (decision 27)\n\n\ndef year_keys(year):\n    \"\"\"Each candidate's reprint keys and article ID in file order, and each LCCN's title.\"\"\"\n    found, ids, titles = [], [], {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for row in map(json.loads, rows):\n            found.append(tuple(keys(row[\"text\"])))\n            ids.append(row[\"article_id\"])\n            lccn = row[\"lccn\"] or MEMBER.search(row[\"member\"])[\"lccn\"]\n            titles.setdefault(lccn, {\"paper\": row[\"paper\"], \"state\": row[\"state\"]})\n    return year, found, ids, titles\n\n\ndef year_rows(job):\n    year, wanted = job\n    found = {}\n    with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:\n        for index, row in enumerate(rows):\n            if index in wanted:\n                found[index] = json.loads(row)\n    return year, found\n\n\ndef sentences(text):\n    flat = \" \".join((text or \"\").replace(\"-\\n\", \"\").split())\n    return [s for s in re.split(r\"(?<=[.!?])\\s+\", flat) if len(s) >= 30] or [flat[:200]]\n\n\ndef quote(sentence, most=200):\n    \"\"\"A verbatim span, as the reader quotes one: a sentence, cut at a word under `most`.\"\"\"\n    return sentence if len(sentence) <= most else sentence[:most].rsplit(\" \", 1)[0]\n\n\ndef stated(rng, said, value=None):\n    sentence = rng.choice(said)\n    if value is None:\n        words = sentence.split()\n        start = rng.randrange(max(1, len(words) - 6))\n        value = \" \".join(words[start : start + rng.randint(3, 6)])\n    return {\n        \"value\": value,\n        \"quote\": quote(sentence),\n        \"verified\": True,\n        \"score\": round(rng.random(), 3),\n    }\n\n\ndef name(rng, said, words):\n    \"\"\"A run of capitalized words from the text, as a place or a person reads.\"\"\"\n    runs = re.findall(\n        rf\"\\b[A-Z][a-z]{{2,}}(?: [A-Z][a-z]{{2,}}){{{words - 1}}}\\b\", \" \".join(said)\n    )\n    return rng.choice(runs) if runs else rng.choice(\" \".join(said).split()[:8] or [\"?\"])\n\n\ndef story(rng, members):\n    \"\"\"A full reports document for one cluster's printings, primary first: the earliest.\"\"\"\n    members = sorted(members, key=lambda row: (row[\"date\"], row[\"article_id\"]))\n    primary = members[0]\n    said = sentences(primary[\"text\"])\n    town = name(rng, said, 1)\n    people = [\n        stated(rng, said, name(rng, said, 2))\n        for _ in range(rng.choice([0, 0, 1, 1, 2, 3]))\n    ]\n    vector = np.random.default_rng(rng.randrange(2**32)).normal(size=DIMENSIONS)\n    year = int(primary[\"date\"][:4])\n    doc = {\n        \"_id\": f\"r_{primary['article_id']}\",\n        \"primary_article_id\": primary[\"article_id\"],\n        \"printings\": [printing(row) for row in members],\n        \"headline\": primary[\"headline\"] or \"\",\n        \"text\": primary[\"text\"] or \"\",\n        \"display_headline\": display_headline(\n            primary[\"headline\"] or \"\", primary[\"paper\"], primary[\"date\"]\n        ),\n        \"date\": primary[\"date\"],\n        \"year\": year,\n        \"month_day\": primary[\"date\"][5:],\n        \"decade\": year // 10 * 10,\n        \"kind\": \"report\",\n        \"fields\": {\n            \"place\": stated(rng, said, town),\n            \"people\": people,\n            \"seen\": stated(rng, said),\n            \"outcome\": stated(rng, said, rng.choice(OUTCOMES)),\n            \"specific_place\": stated(rng, said),\n            \"place_type\": stated(rng, said, rng.choice(PLACE_TYPES)),\n            \"precision\": stated(rng, said, \"town\"),\n        },\n        \"location\": {\n            \"type\": \"Point\",\n            \"coordinates\": [\n                round(rng.uniform(-124, -67), 6),\n                round(rng.uniform(25, 49), 6),\n            ],\n        },\n        \"location_precision\": \"town\",\n        \"location_source\": f\"geonames:{rng.randrange(4_000_000, 6_000_000)}\",\n        \"place_id\": rng.randrange(4_000_000, 6_000_000),\n        \"town\": town,\n        \"state\": primary[\"state\"],\n        \"embedding\": Binary.from_vector(vector.tolist(), BinaryVectorDtype.FLOAT32),\n        \"versions\": {\n            \"code\": CODE,\n            \"lexicon\": \"v2\",\n            \"model\": \"Qwen/Qwen3.5-4B\",\n            \"adapter\": \"paperghosts-reader-lora-v1\",\n            \"prompt\": \"reader-v1\",\n        },\n        \"lexicon_terms\": sorted(primary[\"terms\"]),\n    }\n    stored = Report.model_validate(doc).model_dump(by_alias=True, exclude_none=True)\n    return stored, members\n\n\ndef int8(values):\n    v = np.asarray(values)\n    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)\n    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)\n\n\ndef packed(boxes, dtype):\n    \"\"\"bbox_list as BinData: each box's x0, y0, x1, y1, little-endian, unpacked when read.\"\"\"\n    return Binary(np.array([[box[k] for k in BOX] for box in boxes], dtype=dtype).tobytes())\n\n\ndef variants(doc, members):\n    \"\"\"The document as stored, with each of rule 6's levers turned off, and with each further\n    lever on, alone and together.\"\"\"\n    texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}\n    floats = doc[\"embedding\"].as_vector().data\n\n    def crops(p):\n        service = p.get(\"service\")\n        if service is None:  # its service would be looked up: one of the usual length\n            where = f\"{p['lccn']}:{p['reel']}:{p['issue']}:{p['frame']}\"\n            service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{where}\"\n        return crop_urls(service, p[\"bbox_list\"])\n\n    def each(change):\n        return [change(dict(p)) for p in doc[\"printings\"]]\n\n    untitled = each(lambda p: {k: v for k, v in p.items() if k not in (\"paper\", \"place\", \"state\")})\n    bare = {k: v for k, v in doc.items() if k != \"display_headline\"}\n    three = bare | {\n        \"printings\": [p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")} for p in untitled]\n    }\n    return {\n        BASE: doc,\n        \"rule 6 off: embedding as an array of doubles\": doc | {\"embedding\": list(floats)},\n        \"rule 6 off: crop URLs stored\": doc\n        | {\"printings\": each(lambda p: p | {\"crop_urls\": crops(p)})},\n        \"rule 6 off: printings with their own text\": doc\n        | {\"printings\": each(lambda p: p | {\"text\": texts[p[\"article_id\"]]})},\n        \"bbox_list as int16 BinData\": doc\n        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")})},\n        \"bbox_list as int32 BinData\": doc\n        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i4\")})},\n        \"paper, place and state in a title lookup\": doc | {\"printings\": untitled},\n        \"display_headline derived at read time\": bare,\n        \"int8 embedding\": doc | {\"embedding\": int8(floats)},\n        \"the three, float32\": three,\n        \"the three, int8\": three | {\"embedding\": int8(floats)},\n    }\n\n\ndef parts(doc):\n    \"\"\"The document's bytes by part; the rest is its ids, dates, place, versions and terms.\"\"\"\n\n    def element(key, value):\n        return len(bson.encode({key: value})) - len(bson.encode({}))\n\n    boxes = sum(element(\"bbox_list\", p[\"bbox_list\"]) for p in doc[\"printings\"])\n    found = {\n        \"text\": element(\"text\", doc[\"text\"]),\n        \"headline and display headline\": element(\"headline\", doc[\"headline\"])\n        + element(\"display_headline\", doc[\"display_headline\"]),\n        \"printings, apart from their boxes\": element(\"printings\", doc[\"printings\"]) - boxes,\n        \"printings' bbox_list\": boxes,\n        \"reader fields\": element(\"fields\", doc[\"fields\"]),\n        \"embedding\": element(\"embedding\", doc[\"embedding\"]),\n    }\n    found[\"the rest\"] = len(bson.encode(doc)) - sum(found.values())\n    return found\n\n\ndef summary(sizes):\n    ordered = sorted(sizes)\n    return {\n        \"total\": sum(ordered),\n        \"mean\": round(statistics.fmean(ordered), 1),\n        \"median\": statistics.median(ordered),\n        \"p90\": ordered[int(0.9 * (len(ordered) - 1))],\n        \"max\": ordered[-1],\n    }\n\n\ndef measure(built):\n    \"\"\"Bytes by part and by variant for a list of (doc, members), and a story's bytes as the\n    story itself and so much per printing.\"\"\"\n    by_part, by_variant = defaultdict(list), defaultdict(list)\n    alone, extra, printings = defaultdict(list), defaultdict(int), []\n    for doc, members in built:\n        printings.append(len(doc[\"printings\"]))\n        for label, value in parts(doc).items():\n            by_part[label].append(value)\n        for label, variant in variants(doc, members).items():\n            whole = len(bson.encode(variant))\n            bare = len(bson.encode(variant | {\"printings\": []}))\n            by_variant[label].append(whole)\n            alone[label].append(bare)\n            extra[label] += whole - bare\n    return {\n        \"stories\": len(built),\n        \"printings\": {\n            \"total\": sum(printings),\n            \"per_story\": round(sum(printings) / len(printings), 2),\n            \"stories_with_more_than_one\": sum(n > 1 for n in printings),\n            \"most\": max(printings),\n        },\n        \"bytes_by_part\": {label: summary(v) for label, v in by_part.items()},\n        \"bytes\": {label: summary(v) for label, v in by_variant.items()},\n        \"bytes_per\": {\n            label: {\n                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),\n                \"printing\": round(extra[label] / sum(printings), 1),\n            }\n            for label in by_variant\n        },\n    }\n\n\ndef settled(collection):\n    time.sleep(SETTLE)\n    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))\n    stats = stats[\"storageStats\"]\n    return {\n        \"count\": stats[\"count\"],\n        \"data_bytes\": stats[\"size\"],\n        \"storage_bytes\": stats[\"storageSize\"],\n        \"index_bytes\": stats[\"totalIndexSize\"],\n        \"index_bytes_by_index\": stats[\"indexSizes\"],\n    }\n\n\ndef atlas(docs):\n    \"\"\"The 1,000 in a scratch collection with the reports validator and its indexes (no\n    Search indexes: M0's cap), 500 at a time, then the collection dropped.\"\"\"\n    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:\n        db = client[\"paperghosts\"]\n        scratch = db.create_collection(\n            f\"scratch_budget_{uuid.uuid4().hex[:8]}\", validator=validator(Report)\n        )\n        try:\n            scratch.create_indexes(INDEXES[\"reports\"])\n            steps = {\"empty\": settled(scratch)}\n            for start in range(0, len(docs), BATCH):\n                scratch.insert_many(docs[start : start + BATCH], ordered=False)\n                steps[f\"after {min(start + BATCH, len(docs))}\"] = settled(scratch)\n        finally:\n            scratch.drop()\n        left = scratch.name in db.list_collection_names()\n        storage = {\n            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}\n            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}\n            for name in client.list_database_names()\n            if name not in (\"admin\", \"local\")\n            for s in [client[name].command(\"dbStats\")]\n        }\n    return steps, left, storage\n\n\ndef capacity(samples, index_per_story, titles_bytes, storage):\n    \"\"\"Whether the top of the range fits, and how many stories would, per variant: a story's\n    bytes from whichever sample has more, its index bytes from Atlas, and the title lookup\n    where a variant uses it.\"\"\"\n    counted = {name: s[\"counted\"] for name, s in storage.items()}\n    free = {\n        \"with sample_mflix\": LIMIT - sum(counted.values()),\n        \"without sample_mflix\": LIMIT\n        - sum(v for k, v in counted.items() if k != \"sample_mflix\"),\n    }\n    scenarios = {\n        \"v1's ratio of stories to printings\": round(PRINTINGS * STORIES_PER_PRINTING),\n        \"one story per printing\": PRINTINGS,\n    }\n    out = {\"limit\": LIMIT, \"printings\": PRINTINGS, \"free\": free, \"variants\": {}}\n    for label in samples[0][\"bytes_per\"]:\n        story_bytes = max(s[\"bytes_per\"][label][\"story_without_its_printings\"] for s in samples)\n        printing_bytes = max(s[\"bytes_per\"][label][\"printing\"] for s in samples)\n        fixed = titles_bytes if \"title lookup\" in label or label.startswith(\"the three\") else 0\n        rows = {}\n        for scenario, stories in scenarios.items():\n            need = stories * (story_bytes + index_per_story) + PRINTINGS * printing_bytes + fixed\n            per = story_bytes + index_per_story + PRINTINGS / stories * printing_bytes\n            rows[scenario] = {\n                \"stories\": stories,\n                \"bytes\": round(need),\n                \"fits\": {k: need <= v for k, v in free.items()},\n                \"stories_that_fit\": {k: int((v - fixed) // per) for k, v in free.items()},\n            }\n        out[\"variants\"][label] = {\n            \"story_bytes\": story_bytes,\n            \"printing_bytes\": printing_bytes,\n            \"fixed_bytes\": fixed,\n            \"scenarios\": rows,\n        }\n    return out\n\n\ndef judged_reports():\n    \"\"\"The 25 reports judged so far: eval A's 7, the screen's 4 and 2A.8's 14.\"\"\"\n    composition = json.loads((RESULTS / \"eval_a\" / \"composition.json\").read_text())\n    screen = json.loads((RESULTS / \"eval_a\" / \"screen.json\").read_text())\n    added = json.loads((RESULTS / \"eval_a_v2\" / \"added.json\").read_text())\n    return {\n        \"eval A\": [i[\"article_id\"] for i in composition if i[\"category\"] == \"ghost_report\"],\n        \"screen\": [i[\"article_id\"] for i in screen if i[\"ghost_report\"]],\n        \"2A.8\": [i[\"article_id\"] for i in added if i[\"ghost_report\"]],\n    }\n\n\ndef main():\n    counts = {\n        c[\"year\"]: c[\"candidates\"]\n        for c in (json.loads(p.read_text()) for p in (DATA / \"counts\").glob(\"*.json\"))\n    }\n    years = sorted(y for y in counts if counts[y])\n    starts, total = {}, 0\n    for year in years:\n        starts[year], total = total, total + counts[year]\n    rng = random.Random(SEED)\n    picks = sorted(rng.sample(range(total), PICKS))\n\n    doc_keys, ids, titles = [], [], {}\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        for _, found, named, held in pool.map(year_keys, years):\n            doc_keys += found\n            ids += named\n            for lccn, title in held.items():\n                titles.setdefault(lccn, title)\n    assert len(doc_keys) == total\n    group_of = {}\n    for group in clusters(doc_keys, least=2):\n        for doc in group:\n            group_of[doc] = group\n    del doc_keys\n    index_of = {article: i for i, article in enumerate(ids)}\n    judged = judged_reports()\n    not_candidates = sorted(a for found in judged.values() for a in found if a not in index_of)\n\n    def groups_of(docs):\n        found, seen = [], set()\n        for doc in docs:\n            group = tuple(group_of.get(doc, (doc,)))\n            if group not in seen:  # two picks from one cluster are one story\n                seen.add(group)\n                found.append(group)\n        return found\n\n    sampled = groups_of(picks)\n    reports = groups_of(\n        sorted({index_of[a] for found in judged.values() for a in found if a in index_of})\n    )\n    wanted = defaultdict(set)\n    for group in sampled + reports:\n        for doc in group:\n            year = max(y for y in years if starts[y] <= doc)\n            wanted[year].add(doc - starts[year])\n    with ProcessPoolExecutor(max_workers=6) as pool:\n        rows = {\n            starts[year] + index: row\n            for year, found in pool.map(year_rows, wanted.items())\n            for index, row in found.items()\n        }\n    built = [story(rng, [rows[d] for d in group]) for group in sampled]\n    judged_built = [story(rng, [rows[d] for d in group]) for group in reports]\n    boxes = [v for doc, _ in built + judged_built for p in doc[\"printings\"] for b in p[\"bbox_list\"] for v in b.values()]\n    title_entries = [\n        len(bson.encode({\"_id\": lccn} | {k: v for k, v in t.items() if v}))\n        for lccn, t in titles.items()\n    ]\n\n    report = {\n        \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),\n        \"seed\": SEED,\n        \"candidates_drawn\": PICKS,\n        \"of_candidates\": total,\n        \"sample\": measure(built),\n        \"judged_reports\": {\n            \"counts\": {k: len(v) for k, v in judged.items()},\n            \"not_v2_candidates\": not_candidates,\n            **measure(judged_built),\n        },\n        \"largest_box_coordinate\": max(boxes),\n        \"title_lookup\": {\n            \"lccns\": len(titles),\n            \"bytes\": sum(title_entries),\n            \"mean_entry_bytes\": round(statistics.fmean(title_entries), 1),\n        },\n    }\n    steps, left, storage = atlas([doc for doc, _ in built])\n    first, last = steps[f\"after {BATCH}\"], steps[f\"after {len(built)}\"]\n    index_per_story = max(\n        last[\"index_bytes\"] / last[\"count\"],\n        (last[\"index_bytes\"] - first[\"index_bytes\"]) / (last[\"count\"] - first[\"count\"]),\n    )\n    report[\"atlas\"] = {\n        \"steps\": steps,\n        \"data_bytes_per_story\": last[\"data_bytes\"] / last[\"count\"],\n        \"index_bytes_per_story\": round(index_per_story, 1),\n        \"scratch_collection_left\": left,\n    }\n    report[\"storage_by_database\"] = storage\n    report[\"capacity\"] = capacity(\n        [report[\"sample\"], report[\"judged_reports\"]],\n        index_per_story,\n        report[\"title_lookup\"][\"bytes\"],\n        storage,\n    )\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    OUT.write_text(json.dumps(report, indent=1) + \"\\n\")\n    for name in (\"sample\", \"judged_reports\"):\n        s = report[name]\n        print(\n            f\"{name}: {s['stories']} stories, {s['printings']['total']} printings; \"\n            f\"BSON mean {s['bytes'][BASE]['mean']:,} bytes\"\n        )\n    print(f\"wrote {OUT.relative_to(ROOT)}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":1,"oldLines":19,"newStart":1,"newLines":24,"lines":["-\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents for a seeded","-1,000 of lexicon v2's candidates, with their real text, their reprint clusters' printings, a","-BinData embedding, and reader fields whose quotes are real sentences of the article.","+\"\"\"The storage budget's measurements (decision 32, rule 8): full `reports` documents, with their","+real text, their reprint clusters' printings, a BinData embedding, and reader fields whose quotes","+are real sentences of the article. They are built for a seeded 1,000 of lexicon v2's candidates,","+and for the judged reports that v2 makes candidates."," ","-1. The BSON bytes of each document, with each of rule 6's levers on and off.","-2. Atlas's own data and index sizes, with the documents loaded into `reports` 500 at a time","-   past its validator. Every probe document is deleted afterwards.","-3. Each database's use of M0's storage, data size plus index size as Atlas counts it.","+1. Offline, with bson.encode: the bytes of each document by part, with each of rule 6's levers","+   turned off, and with each further lever on: bbox_list packed as BinData, paper, place and","+   state in a title lookup by LCCN, display_headline derived at read time, and an int8 embedding.","+2. Atlas's own data and index sizes, for the 1,000 loaded 500 at a time into a scratch","+   collection with the reports validator and indexes. The collection is dropped afterwards.","+3. Each database's use of M0's storage: data size plus index size, as Atlas counts it.","+4. How many stories fit at the top of decisions 30 and 31's intervals."," ","-Writes eval/results/phase2b/budget.json; Docs/BUDGET.md reads it.\"\"\"","+Writes eval/results/phase2b/budget.json, which Docs/BUDGET.md reads.\"\"\""," "," import json"," import random"," import re"," import statistics"," import time","+import uuid"," from collections import defaultdict"," from concurrent.futures import ProcessPoolExecutor"," from datetime import UTC, datetime"]},{"oldStart":27,"oldLines":27,"newStart":32,"newLines":39,"lines":[" "," from paperghosts.cluster.reprints import clusters, keys"," from paperghosts.config import setting","-from paperghosts.ingest.crops import crop_urls","+from paperghosts.ingest.crops import MEMBER, crop_urls"," from paperghosts.ingest.headline import display_headline"," from paperghosts.schemas import DIMENSIONS, Report","+from paperghosts.store.db_init import INDEXES"," from paperghosts.store.printings import printing","+from paperghosts.store.validators import validator"," "," ROOT = Path(__file__).parents[1]"," DATA = ROOT / \"data\"","-OUT = ROOT / \"eval\" / \"results\" / \"phase2b\" / \"budget.json\"","+RESULTS = ROOT / \"eval\" / \"results\"","+OUT = RESULTS / \"phase2b\" / \"budget.json\""," SEED, PICKS, BATCH = \"2B budget probe\", 1_000, 500","-SETTLE = (","-    75  # seconds for WiredTiger's checkpoint, once a minute, to count new index pages","-)","+SETTLE = 75  # seconds: WiredTiger's checkpoint, once a minute, updates the index sizes"," CODE = \"0123456789abcdef0123456789abcdef01234567\"  # a git SHA's length"," OUTCOMES = [\"unexplained\", \"explained\", \"hoax\", \"unknown\"]"," PLACE_TYPES = [\"house\", \"church\", \"cemetery\", \"road_or_bridge\", \"other\"]","+BOX = (\"x0\", \"y0\", \"x1\", \"y1\")","+BASE = \"as stored: rule 6's levers on, float32\"","+LIMIT = 500_000_000  # M0's \"0.5 GB\"; read as 512 MiB it would be 536,870,912","+PRINTINGS = 74_027 + 21_176  # the tops of decision 27's and decision 31's intervals","+STORIES_PER_PRINTING = 22_300 / 36_766  # lexicon v1's (decision 27)"," "," "," def year_keys(year):","-    \"\"\"Each candidate's reprint keys, in file order, as eval A takes them.\"\"\"","+    \"\"\"Each candidate's reprint keys and article ID in file order, and each LCCN's title.\"\"\"","+    found, ids, titles = [], [], {}","     with zstandard.open(DATA / \"candidates\" / f\"{year}.jsonl.zst\", \"rt\") as rows:","-        return year, [tuple(keys(json.loads(row)[\"text\"])) for row in rows]","+        for row in map(json.loads, rows):","+            found.append(tuple(keys(row[\"text\"])))","+            ids.append(row[\"article_id\"])","+            lccn = row[\"lccn\"] or MEMBER.search(row[\"member\"])[\"lccn\"]","+            titles.setdefault(lccn, {\"paper\": row[\"paper\"], \"state\": row[\"state\"]})","+    return year, found, ids, titles"," "," "," def year_rows(job):"]},{"oldStart":149,"oldLines":14,"newStart":166,"newLines":26,"lines":["         },","         \"lexicon_terms\": sorted(primary[\"terms\"]),","     }","-    return Report.model_validate(doc).model_dump(","-        by_alias=True, exclude_none=True","-    ), members","+    stored = Report.model_validate(doc).model_dump(by_alias=True, exclude_none=True)","+    return stored, members"," "," ","-def levers(doc, members, vector):","-    \"\"\"The document with each of rule 6's levers turned off, and with all of them off.\"\"\"","+def int8(values):","+    v = np.asarray(values)","+    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)","+    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)","+","+","+def packed(boxes, dtype):","+    \"\"\"bbox_list as BinData: each box's x0, y0, x1, y1, little-endian, unpacked when read.\"\"\"","+    return Binary(np.array([[box[k] for k in BOX] for box in boxes], dtype=dtype).tobytes())","+","+","+def variants(doc, members):","+    \"\"\"The document as stored, with each of rule 6's levers turned off, and with each further","+    lever on, alone and together.\"\"\"","     texts = {row[\"article_id\"]: row[\"text\"] or \"\" for row in members}","+    floats = doc[\"embedding\"].as_vector().data"," ","     def crops(p):","         service = p.get(\"service\")"]},{"oldStart":165,"oldLines":33,"newStart":194,"newLines":53,"lines":["             service = f\"service:ndnp:xx:batch_xx_unknown_ver01:data:{where}\"","         return crop_urls(service, p[\"bbox_list\"])"," ","-    stored_crops = [p | {\"crop_urls\": crops(p)} for p in doc[\"printings\"]]","-    with_text = [p | {\"text\": texts[p[\"article_id\"]]} for p in doc[\"printings\"]]","-    doubles = vector.as_vector().data","+    def each(change):","+        return [change(dict(p)) for p in doc[\"printings\"]]","+","+    untitled = each(lambda p: {k: v for k, v in p.items() if k not in (\"paper\", \"place\", \"state\")})","+    bare = {k: v for k, v in doc.items() if k != \"display_headline\"}","+    three = bare | {","+        \"printings\": [p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")} for p in untitled]","+    }","     return {","-        \"all levers on (float32)\": doc,","-        \"int8 embedding\": doc | {\"embedding\": int8(doubles)},","-        \"embedding as an array of doubles\": doc","-        | {\"embedding\": [float(x) for x in doubles]},","-        \"crop URLs stored\": doc | {\"printings\": stored_crops},","-        \"printings with their own text\": doc | {\"printings\": with_text},","-        \"all levers off\": doc","-        | {","-            \"embedding\": [float(x) for x in doubles],","-            \"printings\": [","-                c | {\"text\": t[\"text\"]}","-                for c, t in zip(stored_crops, with_text, strict=True)","-            ],","-        },","+        BASE: doc,","+        \"rule 6 off: embedding as an array of doubles\": doc | {\"embedding\": list(floats)},","+        \"rule 6 off: crop URLs stored\": doc","+        | {\"printings\": each(lambda p: p | {\"crop_urls\": crops(p)})},","+        \"rule 6 off: printings with their own text\": doc","+        | {\"printings\": each(lambda p: p | {\"text\": texts[p[\"article_id\"]]})},","+        \"bbox_list as int16 BinData\": doc","+        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i2\")})},","+        \"bbox_list as int32 BinData\": doc","+        | {\"printings\": each(lambda p: p | {\"bbox_list\": packed(p[\"bbox_list\"], \"<i4\")})},","+        \"paper, place and state in a title lookup\": doc | {\"printings\": untitled},","+        \"display_headline derived at read time\": bare,","+        \"int8 embedding\": doc | {\"embedding\": int8(floats)},","+        \"the three, float32\": three,","+        \"the three, int8\": three | {\"embedding\": int8(floats)},","     }"," "," ","-def int8(values):","-    v = np.asarray(values)","-    scaled = np.round(v * (127 / np.abs(v).max())).astype(np.int8)","-    return Binary.from_vector(scaled.tolist(), BinaryVectorDtype.INT8)","+def parts(doc):","+    \"\"\"The document's bytes by part; the rest is its ids, dates, place, versions and terms.\"\"\""," ","+    def element(key, value):","+        return len(bson.encode({key: value})) - len(bson.encode({}))"," ","+    boxes = sum(element(\"bbox_list\", p[\"bbox_list\"]) for p in doc[\"printings\"])","+    found = {","+        \"text\": element(\"text\", doc[\"text\"]),","+        \"headline and display headline\": element(\"headline\", doc[\"headline\"])","+        + element(\"display_headline\", doc[\"display_headline\"]),","+        \"printings, apart from their boxes\": element(\"printings\", doc[\"printings\"]) - boxes,","+        \"printings' bbox_list\": boxes,","+        \"reader fields\": element(\"fields\", doc[\"fields\"]),","+        \"embedding\": element(\"embedding\", doc[\"embedding\"]),","+    }","+    found[\"the rest\"] = len(bson.encode(doc)) - sum(found.values())","+    return found","+","+"," def summary(sizes):","     ordered = sorted(sizes)","     return {"]},{"oldStart":203,"oldLines":26,"newStart":252,"newLines":131,"lines":["     }"," "," ","-def size(value):","-    return len(bson.encode({\"v\": value})) - len(bson.encode({}))","+def measure(built):","+    \"\"\"Bytes by part and by variant for a list of (doc, members), and a story's bytes as the","+    story itself and so much per printing.\"\"\"","+    by_part, by_variant = defaultdict(list), defaultdict(list)","+    alone, extra, printings = defaultdict(list), defaultdict(int), []","+    for doc, members in built:","+        printings.append(len(doc[\"printings\"]))","+        for label, value in parts(doc).items():","+            by_part[label].append(value)","+        for label, variant in variants(doc, members).items():","+            whole = len(bson.encode(variant))","+            bare = len(bson.encode(variant | {\"printings\": []}))","+            by_variant[label].append(whole)","+            alone[label].append(bare)","+            extra[label] += whole - bare","+    return {","+        \"stories\": len(built),","+        \"printings\": {","+            \"total\": sum(printings),","+            \"per_story\": round(sum(printings) / len(printings), 2),","+            \"stories_with_more_than_one\": sum(n > 1 for n in printings),","+            \"most\": max(printings),","+        },","+        \"bytes_by_part\": {label: summary(v) for label, v in by_part.items()},","+        \"bytes\": {label: summary(v) for label, v in by_variant.items()},","+        \"bytes_per\": {","+            label: {","+                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),","+                \"printing\": round(extra[label] / sum(printings), 1),","+            }","+            for label in by_variant","+        },","+    }"," "," ","-def settled(collection, db):","+def settled(collection):","     time.sleep(SETTLE)","-    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))[","-        \"storageStats\"","-    ]","-    whole = db.command(\"dbStats\")","+    stats = next(collection.aggregate([{\"$collStats\": {\"storageStats\": {}}}]))","+    stats = stats[\"storageStats\"]","     return {","         \"count\": stats[\"count\"],","         \"data_bytes\": stats[\"size\"],","         \"storage_bytes\": stats[\"storageSize\"],","         \"index_bytes\": stats[\"totalIndexSize\"],","         \"index_bytes_by_index\": stats[\"indexSizes\"],","-        \"database\": {k: whole[k] for k in (\"dataSize\", \"storageSize\", \"indexSize\")},","     }"," "," ","+def atlas(docs):","+    \"\"\"The 1,000 in a scratch collection with the reports validator and its indexes (no","+    Search indexes: M0's cap), 500 at a time, then the collection dropped.\"\"\"","+    with MongoClient(setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000) as client:","+        db = client[\"paperghosts\"]","+        scratch = db.create_collection(","+            f\"scratch_budget_{uuid.uuid4().hex[:8]}\", validator=validator(Report)","+        )","+        try:","+            scratch.create_indexes(INDEXES[\"reports\"])","+            steps = {\"empty\": settled(scratch)}","+            for start in range(0, len(docs), BATCH):","+                scratch.insert_many(docs[start : start + BATCH], ordered=False)","+                steps[f\"after {min(start + BATCH, len(docs))}\"] = settled(scratch)","+        finally:","+            scratch.drop()","+        left = scratch.name in db.list_collection_names()","+        storage = {","+            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}","+            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}","+            for name in client.list_database_names()","+            if name not in (\"admin\", \"local\")","+            for s in [client[name].command(\"dbStats\")]","+        }","+    return steps, left, storage","+","+","+def capacity(samples, index_per_story, titles_bytes, storage):","+    \"\"\"Whether the top of the range fits, and how many stories would, per variant: a story's","+    bytes from whichever sample has more, its index bytes from Atlas, and the title lookup","+    where a variant uses it.\"\"\"","+    counted = {name: s[\"counted\"] for name, s in storage.items()}","+    free = {","+        \"with sample_mflix\": LIMIT - sum(counted.values()),","+        \"without sample_mflix\": LIMIT","+        - sum(v for k, v in counted.items() if k != \"sample_mflix\"),","+    }","+    scenarios = {","+        \"v1's ratio of stories to printings\": round(PRINTINGS * STORIES_PER_PRINTING),","+        \"one story per printing\": PRINTINGS,","+    }","+    out = {\"limit\": LIMIT, \"printings\": PRINTINGS, \"free\": free, \"variants\": {}}","+    for label in samples[0][\"bytes_per\"]:","+        story_bytes = max(s[\"bytes_per\"][label][\"story_without_its_printings\"] for s in samples)","+        printing_bytes = max(s[\"bytes_per\"][label][\"printing\"] for s in samples)","+        fixed = titles_bytes if \"title lookup\" in label or label.startswith(\"the three\") else 0","+        rows = {}","+        for scenario, stories in scenarios.items():","+            need = stories * (story_bytes + index_per_story) + PRINTINGS * printing_bytes + fixed","+            per = story_bytes + index_per_story + PRINTINGS / stories * printing_bytes","+            rows[scenario] = {","+                \"stories\": stories,","+                \"bytes\": round(need),","+                \"fits\": {k: need <= v for k, v in free.items()},","+                \"stories_that_fit\": {k: int((v - fixed) // per) for k, v in free.items()},","+            }","+        out[\"variants\"][label] = {","+            \"story_bytes\": story_bytes,","+            \"printing_bytes\": printing_bytes,","+            \"fixed_bytes\": fixed,","+            \"scenarios\": rows,","+        }","+    return out","+","+","+def judged_reports():","+    \"\"\"The 25 reports judged so far: eval A's 7, the screen's 4 and 2A.8's 14.\"\"\"","+    composition = json.loads((RESULTS / \"eval_a\" / \"composition.json\").read_text())","+    screen = json.loads((RESULTS / \"eval_a\" / \"screen.json\").read_text())","+    added = json.loads((RESULTS / \"eval_a_v2\" / \"added.json\").read_text())","+    return {","+        \"eval A\": [i[\"article_id\"] for i in composition if i[\"category\"] == \"ghost_report\"],","+        \"screen\": [i[\"article_id\"] for i in screen if i[\"ghost_report\"]],","+        \"2A.8\": [i[\"article_id\"] for i in added if i[\"ghost_report\"]],","+    }","+","+"," def main():","     counts = {","         c[\"year\"]: c[\"candidates\"]"]},{"oldStart":235,"oldLines":114,"newStart":389,"newLines":100,"lines":["     rng = random.Random(SEED)","     picks = sorted(rng.sample(range(total), PICKS))"," ","+    doc_keys, ids, titles = [], [], {}","     with ProcessPoolExecutor(max_workers=6) as pool:","-        held = dict(pool.map(year_keys, years))","-    doc_keys = [k for year in years for k in held.pop(year)]","+        for _, found, named, held in pool.map(year_keys, years):","+            doc_keys += found","+            ids += named","+            for lccn, title in held.items():","+                titles.setdefault(lccn, title)","     assert len(doc_keys) == total","     group_of = {}","     for group in clusters(doc_keys, least=2):","         for doc in group:","             group_of[doc] = group","     del doc_keys","-    groups, seen = [], set()","-    for pick in picks:","-        group = tuple(group_of.get(pick, (pick,)))","-        if group not in seen:  # two picks from one cluster are one story","-            seen.add(group)","-            groups.append(group)","+    index_of = {article: i for i, article in enumerate(ids)}","+    judged = judged_reports()","+    not_candidates = sorted(a for found in judged.values() for a in found if a not in index_of)","+","+    def groups_of(docs):","+        found, seen = [], set()","+        for doc in docs:","+            group = tuple(group_of.get(doc, (doc,)))","+            if group not in seen:  # two picks from one cluster are one story","+                seen.add(group)","+                found.append(group)","+        return found","+","+    sampled = groups_of(picks)","+    reports = groups_of(","+        sorted({index_of[a] for found in judged.values() for a in found if a in index_of})","+    )","     wanted = defaultdict(set)","-    year_of = {}","-    for group in groups:","+    for group in sampled + reports:","         for doc in group:","             year = max(y for y in years if starts[y] <= doc)","             wanted[year].add(doc - starts[year])","-            year_of[doc] = year","     with ProcessPoolExecutor(max_workers=6) as pool:","         rows = {","             starts[year] + index: row","             for year, found in pool.map(year_rows, wanted.items())","             for index, row in found.items()","         }","+    built = [story(rng, [rows[d] for d in group]) for group in sampled]","+    judged_built = [story(rng, [rows[d] for d in group]) for group in reports]","+    boxes = [v for doc, _ in built + judged_built for p in doc[\"printings\"] for b in p[\"bbox_list\"] for v in b.values()]","+    title_entries = [","+        len(bson.encode({\"_id\": lccn} | {k: v for k, v in t.items() if v}))","+        for lccn, t in titles.items()","+    ]"," ","-    stories, variants, parts = [], defaultdict(list), defaultdict(list)","-    alone, each = defaultdict(list), defaultdict(list)","-    for group in groups:","-        doc, members = story(rng, [rows[d] for d in group])","-        stories.append(doc)","-        for label, variant in levers(doc, members, doc[\"embedding\"]).items():","-            variants[label].append(len(bson.encode(variant)))","-            # a story's bytes, as the story itself and so much per printing","-            alone[label].append(len(bson.encode(variant | {\"printings\": []})))","-            each[label] += [size(p) for p in variant[\"printings\"]]","-        parts[\"text, headline and display headline\"].append(","-            size(doc[\"text\"]) + size(doc[\"headline\"]) + size(doc[\"display_headline\"])","-        )","-        parts[\"reader fields\"].append(size(doc[\"fields\"]))","-        parts[\"embedding (float32)\"].append(size(doc[\"embedding\"]))","-        parts[\"printings\"].append(size(doc[\"printings\"]))","-        parts[\"each printing\"] += [size(p) for p in doc[\"printings\"]]","-    printings = [len(doc[\"printings\"]) for doc in stories]","     report = {","         \"generated_at\": datetime.now(UTC).isoformat(timespec=\"seconds\"),","         \"seed\": SEED,","         \"candidates_drawn\": PICKS,","         \"of_candidates\": total,","-        \"stories\": len(stories),","-        \"printings\": {","-            \"total\": sum(printings),","-            \"stories_with_more_than_one\": sum(n > 1 for n in printings),","-            \"most\": max(printings),","+        \"sample\": measure(built),","+        \"judged_reports\": {","+            \"counts\": {k: len(v) for k, v in judged.items()},","+            \"not_v2_candidates\": not_candidates,","+            **measure(judged_built),","         },","-        \"bson_bytes\": {label: summary(sizes) for label, sizes in variants.items()},","-        \"bson_bytes_of_parts\": {","-            label: summary(sizes) for label, sizes in parts.items()","+        \"largest_box_coordinate\": max(boxes),","+        \"title_lookup\": {","+            \"lccns\": len(titles),","+            \"bytes\": sum(title_entries),","+            \"mean_entry_bytes\": round(statistics.fmean(title_entries), 1),","         },","-        \"bson_bytes_per\": {","-            label: {","-                \"story_without_its_printings\": round(statistics.fmean(alone[label]), 1),","-                \"printing\": round(statistics.fmean(each[label]), 1),","-            }","-            for label in variants","-        },","     }","-","-    with MongoClient(","-        setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000","-    ) as client:","-        db = client[\"paperghosts\"]","-        reports = db[\"reports\"]","-        assert reports.estimated_document_count() == 0, (","-            \"reports already holds documents\"","-        )","-        ids = [doc[\"_id\"] for doc in stories]","-        atlas = {\"empty\": settled(reports, db)}","-        try:","-            for start in range(0, len(stories), BATCH):","-                reports.insert_many(stories[start : start + BATCH], ordered=False)","-                atlas[f\"after {min(start + BATCH, len(stories))}\"] = settled(","-                    reports, db","-                )","-        finally:","-            deleted = reports.delete_many({\"_id\": {\"$in\": ids}}).deleted_count","-            report[\"cleaned_up\"] = {","-                \"deleted\": deleted,","-                \"left_in_reports\": reports.count_documents({}),","-            }","-        report[\"atlas\"] = atlas","-        report[\"storage_by_database\"] = {","-            name: {k: s[k] for k in (\"dataSize\", \"indexSize\", \"storageSize\")}","-            | {\"counted\": s[\"dataSize\"] + s[\"indexSize\"]}","-            for name in client.list_database_names()","-            if name not in (\"admin\", \"local\")","-            for s in [client[name].command(\"dbStats\")]","-        }","+    steps, left, storage = atlas([doc for doc, _ in built])","+    first, last = steps[f\"after {BATCH}\"], steps[f\"after {len(built)}\"]","+    index_per_story = max(","+        last[\"index_bytes\"] / last[\"count\"],","+        (last[\"index_bytes\"] - first[\"index_bytes\"]) / (last[\"count\"] - first[\"count\"]),","+    )","+    report[\"atlas\"] = {","+        \"steps\": steps,","+        \"data_bytes_per_story\": last[\"data_bytes\"] / last[\"count\"],","+        \"index_bytes_per_story\": round(index_per_story, 1),","+        \"scratch_collection_left\": left,","+    }","+    report[\"storage_by_database\"] = storage","+    report[\"capacity\"] = capacity(","+        [report[\"sample\"], report[\"judged_reports\"]],","+        index_per_story,","+        report[\"title_lookup\"][\"bytes\"],","+        storage,","+    )","     OUT.parent.mkdir(parents=True, exist_ok=True)","     OUT.write_text(json.dumps(report, indent=1) + \"\\n\")","-    base = report[\"bson_bytes\"][\"all levers on (float32)\"]","-  