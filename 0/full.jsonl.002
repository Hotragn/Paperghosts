 in one chunk of their own (see Reveal.tsx)","+export { default as FadeContent } from './FadeContent.tsx'","+export { default as SplitText } from './SplitText.tsx'"]}],"created":true},{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/index.css","hunks":[{"oldStart":148,"oldLines":6,"newStart":148,"newLines":17,"lines":["   max-width: 40rem;"," }"," ","+/* waiting for the motion chunk; shown anyway after a moment, so a slow or failed fetch never hides it */","+.tagline.waiting {","+  animation: appear 0.3s 1.2s both;","+}","+","+@keyframes appear {","+  from {","+    opacity: 0;","+  }","+}","+"," .chain {","   position: absolute;","   top: 0;"]}]}],"moreFiles":0,"changedFiles":["/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/App.tsx","/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/Reveal.tsx","/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/bits/gsap.ts","/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/index.css"]}},"serverClassifierContext":{"request":"7762de99-e931-4e5a-b735-f15ee44e9485","context":{"git_state":{"cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web","root":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","branch":"onboarding-motion","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":6,"untracked":null,"untracked_normal":2},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}]}},"live_cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web","platform":"macos"}},"sandboxed":false,"sourceToolAssistan