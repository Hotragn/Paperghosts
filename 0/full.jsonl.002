{"parentUuid":"94111bf2-5f28-4260-bf12-91d29c5ccb02","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_label_gold.py","snippet":"33\t    \"outcome\": {\n34\t        \"value\": \"unexplained\",\n35\t        \"quote\": \"which no search has\\n been able to explain\",\n36\t    },\n37\t    \"people\": [\n38\t        {\"value\": \"the family of Mr. John Hale\", \"quote\": \"The family of Mr. John Hale\"}\n39\t    ],\n40\t    \"rules\": [1],\n41\t    \"slices\": [\"E5\"],\n42\t}\n43\t\n44\t\n45\tdef client(tmp_path, asked):\n46\t    (tmp_path / CROP).write_bytes(b\"\\xff\\xd8 a jpeg\")\n47\t\n48\t    def crops_for(member, scan, boxes, text=None):\n49\t        asked.append((member, len(boxes), text))\n...\n59\t    page = web.get(\"/article/a1\")\n60\t\n61\t    assert page.status_code == 200\n62\t    assert (\n63\t        \"knockings upon the walls\" in page.text and f'src=\"/crop/{CROP}\"' in page.text\n64\t    )\n65\t    assert asked == [(\"m\", 1, TEXT)]  # through crops_for, which checks the page first\n66\t    assert 'data-name=\"outcome\"' in page.text and \"inn or hotel\" in page.text\n67\t    assert 'name=\"slice\" value=\"E12\"' in page.text and 'value=\"E9\"' not in page.text\n68\t    # POLICY.md's rule 14, at hand\n69\t    assert \"Phantom ships, trains and lights\" in page.text\n70\t    assert web.get(f\"/crop/{CROP}\").content == b\"\\xff\\xd8 a jpeg\"\n71\t    assert web.get(\"/crop/..%2Flabels.jsonl\").status_code == 404\n72\t\n73\t\n74\tdef test_it_saves_a_label_whose_quotes_are_in_the_text_and_refuses_one_that_isnt(\n75\t    tmp_path,\n...\n89\t    )\n90\t\n91\t    (saved,) = [json.loads(line) for line in out[\"gold\"].read_text().splitlines()]\n92\t    assert saved[\"kind\"] == \"report\" and saved[\"labeller\"] == \"tester\"\n93\t    assert (\n94\t        saved[\"outcome\"][\"value\"] == \"unexplained\" and saved[\"note\"] == \"checked twice\"\n95\t    )\n96\t    assert saved[\"people\"] == REPORT[\"people\"] and saved[\"specific_place\"] is None\n97\t    assert saved[\"slices\"] == [\"E5\"]\n98\t    assert list(saved)[:3] == [\"article_id\", \"kind\", \"kind_quote\"]\n99\t\n100\t\n101\tdef test_fields_are_for_reports_only_and_choices_come_from_the_schema(tmp_path):\n102\t    web, _ = client(tmp_path, [])\n103\t\n104\t    idiom = {**REPORT, \"kind\": \"idiom\"}\n105\t    assert (\n106\t        web.post(\"/label\", json=idiom).json()[\"detail\"] == \"fields are for reports only\"\n107\t    )\n108\t    odd = {**REPORT, \"outcome\": {\"value\": \"spooky\", \"quote\": \"the old farmhouse\"}}\n109\t    assert \"not one of\" in web.post(\"/label\", json=odd).json()[\"detail\"]\n110\t    # E9 comes from the grouping, so a label can't claim it\n111\t    reprinted = {**REPORT, \"slices\": [\"E9\"]}\n112\t    assert \"slices\" in web.post(\"/label\", json=reprinted).json()[\"detail\"]"},"type":"attachment","uuid":"863512e8-33c6-4e43-903c-fabb53505351","timestamp":"2026-10-31T07:30:30.905Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_label_gold.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n33\t    \"outcome\": {\n34\t        \"value\": \"unexplained\",\n35\t        \"quote\": \"which no search has\\n been able to explain\",\n36\t    },\n37\t    \"people\": [\n38\t        {\"value\": \"the family of Mr. John Hale\", \"quote\": \"The family of Mr. John Hale\"}\n39\t    ],\n40\t    \"rules\": [1],\n41\t    \"slices\": [\"E5\"],\n42\t}\n43\t\n44\t\n45\tdef client(tmp_path, asked):\n46\t    (tmp_path / CROP).write_bytes(b\"\\xff\\xd8 a jpeg\")\n47\t\n48\t    def crops_for(member, scan, boxes, text=None):\n49\t 