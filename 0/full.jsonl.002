ook.to, duration: seconds * look.share, ease, ...staggerVars },\n            position\n          )\n        );\n      };\n\n      const conceal = (timeline: gsap.core.Timeline, vars: gsap.TweenVars) => {\n        if (noisy) {\n          timeline.to(proxies, { progress: 0, ...vars, onUpdate: draw }, 0);\n          return;\n        }\n        looks.forEach(look => timeline.to(targets, { ...look.from, ...vars }, 0));\n      };\n\n      const settle = () => {\n        if (noisy) {\n          masks.forEach(mask => mask.remove());\n          masks = [];\n          return;\n        }\n        gsap.set(targets, { clearProps: 'filter,transform' });\n      };\n\n      const scrubbing = scrub && trigger !== 'mount';\n      const replaying = !once || exit;\n      const disappearing = disappearAfter > 0 && !replaying && !scrubbing;\n\n      const tl = gsap.timeline({\n        paused: true,\n        onStart: () => callbacksRef.current.onStart?.(),\n        onComplete: () => {\n          callbacksRef.current.onComplete?.();\n          if (scrubbing) return;\n          if (disappearing) {\n            const out = gsap.timeline({\n              delay: toSeconds(disappearAfter),\n              onComplete: () => callbacksRef.current.onDisappearanceComplete?.()\n            });\n            conceal(out, {\n              duration: Math.max(toSeconds(disappearDuration) || 0, 0.01),\n              ease: disappearEase,\n              ...staggerVars\n            });\n            return;\n          }\n          if (!replaying || !noisy) settle();\n        }\n      });\n      reveal(tl, scrubbing ? 0 : Math.max(toSeconds(delay) || 0, 0));\n\n      if (trigger === 'mount') {\n        tl.play();\n        return;\n      }\n\n      const measure = () => {\n        const view = scroller ? scroller.getBoundingClientRect() : { top: 0, height: window.innerHeight };\n        const scrolled = scroller ? scroller.scrollTop : window.scrollY;\n        const box = el.getBoundingClientRect();\n        return {\n          height: view.height,\n          scrolled,\n          limit: scroller\n            ? scroller.scrollHeight - scroller.clientHeight\n            : document.documentElement.scrollHeight - window.innerHeight,\n          top: box.top - view.top + scrolled,\n          bottom: box.bottom - view.top + scrolled\n        };\n      };\n\n      if (scrubbing) {\n        const smoothing = scrub === true ? 0 : Math.max(Number(scrub) || 0, 0);\n        const update = () => {\n          const { height, scrolled, limit, top, bottom } = measure();\n          const zone = height * Math.min(Math.max((1 - 2 * threshold) * 0.4, 0.05), 0.4);\n          const revealed = Math.min(top - height * (1 - threshold) + zone, limit);\n          let visible = clamp01((scrolled - revealed) / zone + 1);\n          if (exit) {\n            const outStart = Math.max(bottom - height * threshold - zone, 0);\n            const outEnd = Math.max(bottom - height * threshold, outStart + zone / 2);\n            visible = Math.min(visible, 1 - clamp01((scrolled - outStart) / (outEnd - outStart)));\n          }\n          visible = Math.round(visible * 1000) / 1000;\n          if (smoothing > 0) {\n            follow = gsap.to(tl, { progress: visible, duration: smoothing, ease: 'power3.out', overwrite: true });\n          } else {\n            tl.progress(visible);\n          }\n        };\n        ScrollTrigger.create({\n          trigger: el,\n          scroller,\n          start: 'top bottom',\n          end: 'bottom top',\n          onUpdate: update,\n          onRefresh: update\n        });\n        update();\n        return;\n      }\n\n      ScrollTrigger.create({\n        trigger: el,\n        scroller,\n        start: () => {\n          const { height, limit, top } = measure();\n          const start = top - height * (1 - threshold);\n          return start > limit ? limit - 1 : start;\n        },\n        end: exit ? `bottom ${threshold * 100}%` : undefined,\n        once: !replaying,\n        onEnter: () => tl.play(),\n        onLeave: exit ? () => tl.reverse() : undefined,\n        onEnterBack: exit ? () => tl.play() : undefined,\n        onLeaveBack: once ? undefined : () => tl.reverse()\n      });\n    }, el);\n\n    return () => {\n      follow?.kill();\n      ctx.revert();\n      masks.forEach(mask => mask.remove());\n    };\n  }, [\n    container,\n    effect,\n    blur,\n    duration,\n    ease,\n    delay,\n    threshold,\n    initialOpacity,\n    stagger,\n    staggerFrom,\n    trigger,\n    once,\n    exit,\n    scrub,\n    disappearAfter,\n    disappearDuration,\n    disappearEase\n  ]);\n\n  return (\n    <div ref={ref} className={className} style={{ visibility: 'hidden', ...style }} {...props}>\n      {children}\n    </div>\n  );\n};\n\nexport default FadeContent;","stderr":"\nShell cwd was reset to /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"42651d75-3367-41b3-ab61-0f0a48a701a8","context":{"git_state":{"cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","root":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","branch":"onboarding-motion","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"Hotragn/Paperghosts","visibility":"private"}]}},"live_cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","platform":"macos"}},"sandboxed":false,"sourceToolAssistantUUID":"5035dfb9-7dbb-4a59-924e-cbaa2e8a405c","permissionDecision":{"decision":"accept","source":"config","reasonType":"cl