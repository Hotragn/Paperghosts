{"parentUuid":"5811520e-e0fa-4780-b2fd-43349114202b","isSidechain":false,"promptId":"775e54ef-6487-4f79-8598-643421b87718","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014WVDbHN1egH5RYvmiDznBV","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/second_pass.py (file state is current in your context — no need to Read it back)"}]},"uuid":"b878c292-cf32-495d-9510-51c0599e4344","timestamp":"2026-10-31T08:37:34.085Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/second_pass.py","content":"\"\"\"The blind second pass over the gold and dev labels (2C.2).\n\nEvery gold article and a seeded fifth of dev are labelled again by readers who see only the\ntext, its crops and POLICY.md: no first label, stratum or weight. Their labels are saved as\nlabeller \"second pass\", and the two passes' agreement is measured before any ruling.\n\n  packets K DIR      the pass's articles in K packets of text, each with its texts for check\n  check FILE TEXTS   a packet's labels through checked(), against its texts alone\n  agreement          the agreement, with 95% intervals, into eval/results/phase2c/agreement.json\n  disputes           every article the passes disagree on, as JSON lines, for a ruling\n\nA field agrees when both passes leave it empty, or:\n  outcome, place_type, precision, place_state   they give the same value\n  place, seen, specific_place                   their quotes overlap in the text, or their\n                                                values are the same, ignoring case\n  people                                        each person's quote overlaps one of the\n                                                other pass's, both ways\n\"\"\"\n\nimport json\nimport random\nimport sys\nfrom pathlib import Path\n\nfrom label_gold import FIELDS, OUT, ROOT, SEEN, articles, checked, saved, shown, squeezed\n\nfrom paperghosts.stats import wilson\n\nDEV_SHARE = 0.2\nFIRST, SECOND = \"Claude\", \"second pass\"\nRESULT = ROOT / \"eval\" / \"results\" / \"phase2c\" / \"agreement.json\"\nVALUES = {\"outcome\", \"place_type\", \"precision\", \"place_state\"}\n\n\ndef sampled(dev: list, share: float = DEV_SHARE) -> list:\n    \"\"\"The seeded share of dev that the second pass labels again.\"\"\"\n    ids = sorted(dev)\n    return sorted(random.Random(\"2C.2 second pass dev sample\").sample(ids, round(len(ids) * share)))\n\n\ndef passed(rows: dict) -> list:\n    \"\"\"Every gold article and the dev sample, in one seeded shuffle, so a packet doesn't show\n    which split an article is from.\"\"\"\n    gold = sorted(aid for aid, row in rows.items() if row[\"split\"] == \"gold\")\n    dev = [aid for aid, row in rows.items() if row[\"split\"] == \"dev\"]\n    order = gold + sampled(dev)\n    random.Random(\"2C.2 second pass order\").shuffle(order)\n    return order\n\n\ndef packets(rows: dict, ids: list, k: int, cropped: dict) -> list:\n    \"\"\"The ids in k packets of near-equal size: each packet's text to read, and the headline\n    and text of its articles, all that checked() needs.\"\"\"\n    size, extra = divmod(len(ids), k)\n    made, start = [], 0\n    for i in range(k):\n        part = ids[start : start + size + (i < extra)]\n        start += len(part)\n        texts = {aid: {\"headline\": rows[aid].get(\"headline\"), \"text\": rows[aid].get(\"text\")} for aid in part}\n        made.append((\"\\n\\n\".join(shown(aid, rows[aid], cropped) for aid in part), texts))\n    return made\n\n\ndef kappa(a: list, b: list) -> float | None:\n    \"\"\"Cohen's kappa for two raters' categories; None when chance agreement is certain.\"\"\"\n    n = len(a)\n    observed = sum(x == y for x, y in zip(a, b, strict=True)) / n\n    chance = sum((a.count(c) / n) * (b.count(c) / n) for c in set(a) | set(b))\n    return None if chance == 1 else (observed - chance) / (1 - chance)\n\n\ndef interval(a: list, b: list, draws: int = 2000) -> list | None:\n    \"\"\"A 95% percentile bootstrap interval for kappa, resampling articles.\"\"\"\n    rng, n, found = random.Random(\"2C.2 kappa bootstrap\"), len(a), []\n    for _ in range(draws):\n        picks = [rng.randrange(n) for _ in range(n)]\n        value = kappa([a[i] for i in picks], [b[i] for i in picks])\n        if value is not None:\n            found.append(value)\n    if not found:\n        return None\n    found.sort()\n    return [found[int(0.025 * len(found))], found[min(len(found) - 1, int(0.975 * len(found)))]]\n\n\ndef spans(quote: str, text: str) -> list:\n    needle, found, at = squeezed(quote), [], text.find(squeezed(quote))\n    while needle and at >= 0:\n        found.append((at, at + len(needle)))\n        at = text.find(needle, at + 1)\n    return found\n\n\ndef overlap(a: dict, b: dict, text: str) -> bool:\n    if a[\"value\"].casefold() == b[\"value\"].casefold():\n        return True\n    return any(s < f and t < e for s, e in spans(a[\"quote\"], text) for t, f in spans(b[\"quote\"], text))\n\n\ndef same(name: str, a: dict, b: dict, text: str) -> bool:\n    \"\"\"Whether the two passes agree on one field of a report; the module's docstring says how.\"\"\"\n    if name == \"people\":\n        first, second = a.get(\"people\") or [], b.get(\"people\") or []\n        return all(any(overlap(p, q, text) for q in second) for p in first) and all(\n            any(overlap(q, p, text) for p in first) for q in second\n        )\n    x, y = a.get(name), b.get(name)\n    if not x or not y:\n        return not x and not y\n    return x[\"value\"] == y[\"value\"] if name in VALUES else overlap(x, y, text)\n\n\ndef rate(agree: int, n: int) -> dict:\n    return {\"agree\": agree, \"n\": n, \"rate\": agree / n, \"interval\": wilson(agree, n)}\n\n\ndef agreed(pairs: list, texts: dict) -> dict:\n    \"\"\"Kind, report-or-not and each field, on the pairs both passes call reports.\"\"\"\n    kinds = [(a[\"kind\"], b[\"kind\"]) for a, b in pairs]\n    reports = [(a[\"kind\"] == \"report\", b[\"kind\"] == \"report\") for a, b in pairs]\n    both = [(a, b) for a, b in pairs if a[\"kind\"] == b[\"kind\"] == \"report\"]\n    found = {\"n\": len(pairs)}\n    for name, values in ((\"kind\", kinds), (\"report\", reports)):\n        first, second = [x for x, _ in values], [y for _, y in values]\n        found[name] = rate(sum(x == y for x, y in values), len(values)) | {\n            \"kappa\": kappa(first, second),\n            \"kappa_interval\": interval(first, second),\n        }\n    found[\"fields\"] = {\n        name: rate(sum(same(name, a, b, texts[a[\"article_id\"]]) for a, b in both), len(both))\n        for name in (*FIELDS, \"people\")\n        if both\n    }\n    return found\n\n\ndef disputes(pairs: list, texts: dict) -> list:\n    \"\"\"Each article the passes disagree on: its kinds, and the fields of a report both call one.\"\"\"\n    found = []\n    for a, b in pairs:\n        fields = (\n            [name for name in (*FIELDS, \"people\") if not same(name, a, b, texts[a[\"article_id\"]])]\n            if a[\"kind\"] == b[\"kind\"] == \"report\"\n            else []\n        )\n        if a[\"kind\"] != b[\"kind\"] or fields:\n            found.append({\"article_id\": a[\"article_id\"], \"kinds\": [a[\"kind\"], b[\"kind\"]], \"fields\": fields})\n    return found\n\n\ndef paired(split: str) -> list:\n    \"\"\"The first and second passes' labels of each article both labelled, in article order.\"\"\"\n    by = {}\n    for record in saved(OUT[split]):\n        by.setdefault(record[\"article_id\"], {})[record[\"labeller\"]] = record\n    return [(two[FIRST], two[SECOND]) for _, two in sorted(by.items()) if FIRST in two and SECOND in two]\n\n\ndef main() -> None:\n    run, *rest = sys.argv[1:]\n    if run == \"check\":\n        path, given = map(Path, rest)\n        texts = json.loads(given.read_text())\n        errors = []\n        for line in filter(str.strip, path.read_text().splitlines()):\n            label = json.loads(line)\n            row = texts.get(label.get(\"article_id\"))\n            try:\n                if row is None:\n                    raise ValueError(\"not an article in this packet\")\n                checked(label, {\"article_id\": label[\"article_id\"], **row}, SECOND)\n            except ValueError as error:\n                errors.append(f\"{label.get('article_id')}: {error}\")\n        print(\"\\n\".join(errors) or \"every label passes checked()\")\n        sys.exit(1 if errors else 0)\n    rows = articles()\n    if run == \"packets\":\n        k, out = int(rest[0]), Path(rest[1])\n        cropped = json.loads(SEEN.read_text())\n        out.mkdir(parents=True, exist_ok=True)\n        for i, (text, texts) in enumerate(packets(rows, passed(rows), k, cropped), 1):\n            (out / f\"packet{i:02}.txt\").write_text(text + \"\\n\")\n            (out / f\"texts{i:02}.json\").write_text(json.dumps(texts) + \"\\n\")\n        return\n    texts = {aid: squeezed(f\"{row.get('headline') or ''}\\n{row.get('text') or ''}\") for aid, row in rows.items()}\n    gold, dev = paired(\"gold\"), paired(\"dev\")\n    if run == \"agreement\":\n        found = {name: agreed(pairs, texts) for name, pairs in ((\"gold\", gold), (\"dev\", dev), (\"all\", gold + dev))}\n        RESULT.write_text(json.dumps(found, indent=1) + \"\\n\")\n        print(json.dumps({name: {k: v for k, v in part.items() if k != \"fields\"} for name, part in found.items()}, indent=1))\n    elif run == \"disputes\":\n        for item in disputes(gold + dev, texts):\n            print(json.dumps(item))\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"5811520e-e0fa-4780-b2fd-43349114202b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2c-reader","slug":"sunny-popping-comet"}
{"type":"api-request-blob","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","hash":"257cbaa608698a4b8cb2620bfd325ffa5a36a965d695c7aecbf1cd656c86150a","message":{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":""},{"type":"tool_use","id":"toolu_01MnrwsYW1r1QYRubmVQYeoD","name":"Edit","input":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/label_gold.py","old_string":"    done = {r[\"article_id\"] for r in saved(out[split]) if r[\"labeller\"] == labeller}\n    cropped = json.loads(seen.read_text()) if seen.exists() else {}\n    picked = [a for a in order_of(rows) if rows[a][\"split\"] == split and a not in done]\n    return \"\\n\\n\".join(\n        f\"=== {aid}\\n{rows[aid].get('paper')} · {rows[aid].get('date')}\\n\"\n        f\"crops: {cropped.get(aid, {}).get('crops') or cropped.get(aid, {}).get('none')}\\n\"\n        f\"headline: {rows[aid].get('headline') or ''}\\n---\\n{rows[aid].get('text') or ''}\"\n        for aid in picked[:count]\n    )","new_string":"    done = {r[\"article_id\"] for r in saved(out[split]) if r[\"labeller\"] == labeller}\n    cropped = json.loads(seen.read_text()) if seen.exists() else {}\n    picked = [a for a in order_of(rows) if rows[a][\"split\"] == split and a not in done]\n    return \"\\n\\n\".join(shown(aid, rows[aid], cropped) for aid in picked[:count])\n\n\ndef shown(aid: str, row: dict, cropped: dict) -> str:\n    \"\"\"One article as text to read: its paper, date, crops, headline and OCR text.\"\"\"\n    crop = cropped.get(aid, {})\n    return (\n        f\"=== {aid}\\n{row.get('paper')} · {row.get('date')}\\n\"\n        f\"crops: {crop.get('crops') or crop.get('none')}\\n\"\n        f\"headline: {row.get('headline') or ''}\\n---\\n{row.get('text') or ''}\"\n    )"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_014WVDbHN1egH5RYvmiDznBV","name":"Write","input":{"file_path":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/second_pass.py","content":"\"\"\"The blind second pass over the gold and dev labels (2C.2).\n\nEvery gold article and a seeded fifth of dev are labelled again by readers who see only the\ntext, its crops and POLICY.md: no first label, stratum or weight. Their labels are saved as\nlabeller \"second pass\", and the two passes' agreement is measured before any ruling.\n\n  packets K DIR      the pass's articles in K packets of text, each with its texts for check\n  check FILE TEXTS   a packet's labels through checked(), against its texts alone\n  agreement          the agreement, with 95% intervals, into eval/results/phase2c/agreement.json\n  disputes           every article the passes disagree on, as JSON lines, for a ruling\n\nA field agrees when both passes leave it empty, or:\n  outcome, place_type, precision, place_state   they give the same value\n  place, seen, specific_place                   their quotes overlap in the text, or their\n                                                values are the same, ignoring case\n  people                                        each person's quote overlaps one of the\n                                                other pass's, both ways\n\"\"\"\n\nimport json\nimport random\nimport sys\nfrom pathlib import Path\n\nfrom label_gold import FIELDS, OUT, ROOT, SEEN, articles, checked, saved, shown, squeezed\n\nfrom paperghosts.stats import wilson\n\nDEV_SHARE = 0.2\nFIRST, SECOND = \"Claude\", \"second pass\"\nRESULT = ROOT / \"eval\" / \"results\" / \"phase2c\" / \"agreement.json\"\nVALUES = {\"outcome\", \"place_type\", \"precision\", \"place_state\"}\n\n\ndef sampled(dev: list, share: float = DEV_SHARE) -> list:\n    \"\"\"The seeded share of dev that the second pass labels again.\"\"\"\n    ids = sorted(dev)\n    return sorted(random.Random(\"2C.2 second pass dev sample\").sample(ids, round(len(ids) * share)))\n\n\ndef passed(rows: dict) -> list:\n    \"\"\"Every gold article and the dev sample, in one seeded shuffle, so a packet doesn't show\n    which split an article is from.\"\"\"\n    gold = sorted(aid for aid, row in rows.items() if row[\"split\"] == \"gold\")\n    dev = [aid for aid, row in rows.items() if row[\"split\"] == \"dev\"]\n    order = gold + sampled(dev)\n    random.Random(\"2C.2 second pass order\").shuffle(order)\n    return order\n\n\ndef packets(rows: dict, ids: list, k: int, cropped: dict) -> list:\n    \"\"\"The ids in k packets of near-equal size: each packet's text to read, and the headline\n    and text of its articles, all that checked() needs.\"\"\"\n    size, extra = divmod(len(ids), k)\n    made, start = [], 0\n    for i in range(k):\n        part = ids[start : start + size + (i < extra)]\n        start += len(part)\n        texts = {aid: {\"headline\": rows[aid].get(\"headline\"), \"text\": rows[aid].get(\"text\")} for aid in part}\n        made.append((\"\\n\\n\".join(shown(aid, rows[aid], cropped) for aid in part), texts))\n    return made\n\n\ndef kappa(a: list, b: list) -> float | None:\n    \"\"\"Cohen's kappa for two raters' categories; None when chance agreement is certain.\"\"\"\n    n = len(a)\n    observed = sum(x == y for x, y in zip(a, b, strict=True)) / n\n    chance = sum((a.count(c) / n) * (b.count(c) / n) for c in set(a) | set(b))\n    return None if chance == 1 else (observed - chance) / (1 - chance)\n\n\ndef interval(a: list, b: list, draws: int = 2000) -> list | None:\n    \"\"\"A 95% percentile bootstrap interval for kappa, resampling articles.\"\"\"\n    rng, n, found = random.Random(\"2C.2 kappa bootstrap\"), len(a), []\n    for _ in range(draws):\n        picks = [rng.randrange(n) for _ in range(n)]\n        value = kappa([a[i] for i in picks], [b[i] for i in picks])\n        if value is not None:\n            found.append(value)\n    if not found:\n        return None\n    found.sort()\n    return [found[int(0.025 * len(found))], found[min(len(found) - 1, int(0.975 * len(found)))]]\n\n\ndef spans(quote: str, text: str) -> list:\n    needle, found, at = squeezed(quote), [], text.find(squeezed(quote))\n    while needle and at >= 0:\n        found.append((at, at + len(needle)))\n        at = text.find(needle, at + 1)\n    return found\n\n\ndef overlap(a: dict, b: dict, text: str) -> bool:\n    if a[\"value\"].casefold() == b[\"value\"].casefold():\n        return True\n    return any(s < f and t < e for s, e in spans(a[\"quote\"], text) for t, f in spans(b[\"quote\"], text))\n\n\ndef same(name: str, a: dict, b: dict, text: str) -> bool:\n    \"\"\"Whether the two passes agree on one field of a report; the module's docstring says how.\"\"\"\n    if name == \"people\":\n        first, second = a.get(\"people\") or [], b.get(\"people\") or []\n        return all(any(overlap(p, q, text) for q in second) for p in first) and all(\n            any(overlap(q, p, text) for p in first) for q in second\n        )\n    x, y = a.get(name), b.get(name)\n    if not x or not y:\n        return not x and not y\n    return x[\"value\"] == y[\"value\"] if name in VALUES else overlap(x, y, text)\n\n\ndef rate(agree: int, n: int) -> dict:\n    return {\"agree\": agree, \"n\": n, \"rate\": agree / n, \"interval\": wilson(agree, n)}\n\n\ndef agreed(pairs: list, texts: dict) -> dict:\n    \"\"\"Kind, report-or-not and each field, on the pairs both passes call reports.\"\"\"\n    kinds = [(a[\"kind\"], b[\"kind\"]) for a, b in pairs]\n    reports = [(a[\"kind\"] == \"report\", b[\"kind\"] == \"report\") for a, b in pairs]\n    both = [(a, b) for a, b in pairs if a[\"kind\"] == b[\"kind\"] == \"report\"]\n    found = {\"n\": len(pairs)}\n    for name, values in ((\"kind\", kinds), (\"report\", reports)):\n        first, second = [x for x, _ in values], [y for _, y in values]\n        found[name] = rate(sum(x == y for x, y in values), len(values)) | {\n            \"kappa\": kappa(first, second),\n            \"kappa_interval\": interval(first, second),\n        }\n    found[\"fields\"] = {\n        name: rate(sum(same(name, a, b, texts[a[\"article_id\"]]) for a, b in both), len(both))\n        for name in (*FIELDS, \"people\")\n        if both\n    }\n    return found\n\n\ndef disputes(pairs: list, texts: dict) -> list:\n    \"\"\"Each article the passes disagree on: its kinds, and the fields of a report both call one.\"\"\"\n    found = []\n    for a, b in pairs:\n        fields = (\n            [name for name in (*FIELDS, \"people\") if not same(name, a, b, texts[a[\"article_id\"]])]\n            if a[\"kind\"] == b[\"kind\"] == \"report\"\n            else []\n        )\n        if a[\"kind\"] != b[\"kind\"] or fields:\n            found.append({\"article_id\": a[\"article_id\"], \"kinds\": [a[\"kind\"], b[\"kind\"]], \"fields\": fields})\n    return found\n\n\ndef paired(split: str) -> list:\n    \"\"\"The first and second passes' labels of each article both labelled, in article order.\"\"\"\n    by = {}\n    for record in saved(OUT[split]):\n        by.setdefault(record[\"article_id\"], {})[record[\"labeller\"]] = record\n    return [(two[FIRST], two[SECOND]) for _, two in sorted(by.items()) if FIRST in two and SECOND in two]\n\n\ndef main() -> None:\n    run, *rest = sys.argv[1:]\n    if run == \"check\":\n        path, given = map(Path, rest)\n        texts = json.loads(given.read_text())\n        errors = []\n        for line in filter(str.strip, path.read_text().splitlines()):\n            label = json.loads(line)\n            row = texts.get(label.get(\"article_id\"))\n            try:\n                if row is None:\n                    raise ValueError(\"not an article in this packet\")\n                checked(label, {\"article_id\": label[\"article_id\"], **row}, SECOND)\n            except ValueError as error:\n                errors.append(f\"{label.get('article_id')}: {error}\")\n        print(\"\\n\".join(errors) or \"every label passes checked()\")\n        sys.exit(1 if errors else 0)\n    rows = articles()\n    if run == \"packets\":\n        k, out = int(rest[0]), Path(rest[1])\n        cropped = json.loads(SEEN.read_text())\n        out.mkdir(parents=True, exist_ok=True)\n        for i, (text, texts) in enumerate(packets(rows, passed(rows), k, cropped), 1):\n            (out / f\"packet{i:02}.txt\").write_text(text + \"\\n\")\n            (out / f\"texts{i:02}.json\").write_text(json.dumps(texts) + \"\\n\")\n        return\n    texts = {aid: squeezed(f\"{row.get('headline') or ''}\\n{row.get('text') or ''}\") for aid, row in rows.items()}\n    gold, dev = paired(\"gold\"), paired(\"dev\")\n    if run == \"agreement\":\n        found = {name: agreed(pairs, texts) for name, pairs in ((\"gold\", gold), (\"dev\", dev), (\"all\", gold + dev))}\n        RESULT.write_text(json.dumps(found, indent=1) + \"\\n\")\n        print(json.dumps({name: {k: v for k, v in part.items() if k != \"fields\"} for name, part in found.items()}, indent=1))\n    elif run == \"disputes\":\n        for item in disputes(gold + dev, texts):\n            print(json.dumps(item))\n\n\nif __name__ == \"__main__\":\n    main()\n"},"caller":{"type":"direct"}}]}}
