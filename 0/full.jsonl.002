"+                  </li>","+                ))}","+              </ul>","+            )}","+          </dd>","+        </div>","+      </dl>","+      <p className=\"sources\">","+        {r.issue_page && (","+          <a href={r.issue_page} rel=\"noreferrer\">","+            The issue at the Library of Congress","+          </a>","+        )}","+        {r.clippings","+          .filter((c) => c.loc)","+          .map((c, i) => (","+            <a key={c.src} href={c.loc ?? undefined} rel=\"noreferrer\">","+              Clipping {r.clippings.length > 1 ? i + 1 : ''} at full size","+            </a>","+          ))}","+        <span className=\"filing\">Filed as {r.article_id.replace(/\\.json$/, '')}</span>","+      </p>","+      <p className=\"thirty\" aria-label=\"End of the report\">","+        -30-","+      </p>","+    </div>","+  )","+}","+","+function Envelope({ r }: { r: Report }) {","+  const first = r.headline.split(/(?<=[.!?])\\s+/)[0] || 'Untitled'","+  const where = [r.place?.value, r.place_state?.value].filter(Boolean).join(', ')","+  return (","+    <li>","+      <details className=\"envelope\">","+        <summary>","+          <span className=\"label\">","+            <span className=\"date\">{r.date}</span>","+            <span className=\"paper\">{paperName(r.paper)}</span>","+          </span>","+          <span className=\"headline\">{first}</span>","+          <span className=\"where\">{where || 'Place not stated'}</span>","+          <Stamp outcome={r.outcome} />","+        </summary>","+        <Case r={r} />","+      </details>","+    </li>","+  )","+}","+","+function useLights(): ['on' | 'off', () => void] {","+  const [lights, setLights] = useState<'on' | 'off'>(() => {","+    try {","+      const kept = localStorage.getItem('lights')","+      if (kept === 'on' || kept === 'off') return kept","+    } catch {","+      // storage can be blocked; the device's setting decides then","+    }","+    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'off' : 'on'","+  })","+  useEffect(() => {","+    document.documentElement.dataset.lights = lights","+    try {","+      localStorage.setItem('lights', lights)","+    } catch {","+      // nothing to keep","+    }","+  }, [lights])","+  return [lights, () => setLights((l) => (l === 'on' ? 'off' : 'on'))]","+}","+","+// the reading lamp follows the pointer and keyboard focus; with reduced motion it stays put","+function useLamp() {","+  useEffect(() => {","+    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return","+    const root = document.documentElement","+    let frame = 0","+    const move = (x: number, y: number) => {","+      cancelAnimationFrame(frame)","+      frame = requestAnimationFrame(() => {","+        root.style.setProperty('--lamp-x', `${x}px`)","+        root.style.setProperty('--lamp-y', `${y}px`)","+      })","+    }","+    const onPointer = (e: PointerEvent) => move(e.clientX, e.clientY)","+    const onFocus = (e: FocusEvent) => {","+      const box = (e.target as Element).getBoundingClientRect?.()","+      if (box) move(box.left + box.width / 2, box.top + box.height / 2)","+    }","+    window.addEventListener('pointermove', onPointer, { passive: true })","+    window.addEventListener('focusin', onFocus)","+    return () => {","+      window.removeEventListener('pointermove', onPointer)","+      window.removeEventListener('focusin', onFocus)","+    }","+  }, [])","+}","+"," function App() {","-  const [article, setArticle] = useState<Article>()","+  const [reports, setReports] = useState<Report[]>()","   const [error, setError] = useState<string>()","+  const [query, setQuery] = useState('')","+  const [era, setEra] = useState('')","+  const [outcome, setOutcome] = useState('')","+  const [lights, toggle] = useLights()","+  useLamp()"," ","   useEffect(() => {","-    fetch(`/api/skeleton/${encodeURIComponent(ARTICLE)}`)","-      .then((response) =>","-        response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`)),","-      )","-      .then(setArticle, (failure: Error) => setError(failure.message))","+    fetch('reports.json')","+      .then((response) => (response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`))))","+      .then(setReports, (failure: Error) => setError(failure.message))","   }, [])"," ","-  if (error) return <main><p>The article could not be loaded ({error}).</p></main>","-  if (!article) return <main><p>Loading the article…</p></main>","+  const decades = useMemo(() => [...new Set((reports ?? []).map(decade))].sort(), [reports])","+  const shown = useMemo(() => {","+    const words = query.toLowerCase().split(/\\s+/).filter(Boolean)","+    return (reports ?? []).filter((r) => {","+      if (era && decade(r) !== era) return false","+      if (outcome && (r.outcome?.value ?? 'unknown') !== outcome) return false","+      const hay = [r.place?.value, r.place_state?.value, r.specific_place?.value, r.headline, r.text, r.paper]","+        .join(' ')","+        .toLowerCase()","+      return words.every((w) => hay.includes(w))","+    })","+  }, [reports, query, era, outcome])","+","   return (","-    <main","-      style={{","-        display: 'grid',","-        gridTemplateColumns: 'repeat(auto-fit, minmax(18rem, 1fr))',","-        gap: '2rem',","-        padding: '1rem',","-      }}","-    >","-      <div>","-        {article.crop_urls.map((url, part) => (","-          <img","-            key={url}","-            src={url}","-            alt={`The clipping, part ${part + 1} of ${article.crop_urls.length}`}","-            style={{ width: '100%', display: 'block' }}","-          />","-        ))}","-      </div>","-      <article>","-        <h1 style={{ whiteSpace: 'pre-line' }}>{article.display_headline}</h1>","+    <>","+      <a className=\"skip\" href=\"#drawer\">","+        Skip to the reports","+      </a>","+      <header className=\"masthead\">","+        <button type=\"button\" className=\"chain\" onClick={toggle} aria-pressed={lights === 'on'}>","+          <span className=\"chain-pull\" aria-hidden=\"true\" />","+          {lights === 'on' ? 'Lights off' : 'Lights on'}","+        </button>","+        <p className=\"ear\">","+          {reports ? `${reports.length} ghost reports the papers printed, ${year(reports[0])}–${year(reports[reports.length - 1])}` : 'The morgue'}","+        </p>","+        <h1 className=\"nameplate\">Paper Ghosts</h1>","+        <p className=\"tagline\">A morgue of ghost reports from American newspapers, each one filed with the words it rests on.</p>","+      </header>","+","+      <main>","+        <form className=\"slip\" role=\"search\" onSubmit={(e) => e.preventDefault()}>","+          <p className=\"slip-head\">Request slip</p>","+          <label>","+            Town, state or word","+            <input type=\"search\" value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Georgetown, Ohio, knocking…\" />","+          </label>","+          <label>","+            Decade","+            <select value={era} onChange={(e) => setEra(e.target.value)}>","+              <option value=\"\">Any</option>","+              {decades.map((d) => (","+                <option key={d}>{d}</option>","+              ))}","+            </select>","+          </label>","+          <label>","+            Outcome","+            <select value={outcome} onChange={(e) => setOutcome(e.target.value)}>","+              <option value=\"\">Any</option>","+              {OUTCOMES.map((o) => (","+                <option key={o} value={o}>","+                  {STAMPS[o]}","+                </option>","+              ))}","+            </select>","+          </label>","+        </form>","+","+        <section id=\"drawer\" aria-live=\"polite\" aria-busy={!reports && !error}>","+          {error && <p className=\"count\">The drawer could not be opened ({error}).</p>}","+          {!reports && !error && <p className=\"count\">Opening the drawer…</p>}","+          {reports && (","+            <p className=\"count\">","+              {shown.length === 0","+                ? 'Nothing filed under that.'","+                : `${shown.length} report${shown.length === 1 ? '' : 's'}, ${year(shown[0])}–${year(shown[shown.length - 1])}.`}","+            </p>","+          )}","+          <ol className=\"envelopes\">","+            {shown.map((r) => (","+              <Envelope key={r.article_id} r={r} />","+            ))}","+          </ol>","+        </section>","+      </main>","+","+      <footer className=\"colophon\">","+        <h2>How this was made</h2>","         <p>","-          {article.paper}, {article.date}","+          These are the reports among 450 articles drawn from the archive and labelled one at a time under the project’s","+          labelling policy (POLICY.md) by an AI labeller, Claude, working article by article in a labelling page. A blind second pass relabelled every gold","+          article and a seeded fifth of the rest, and fresh judges ruled every disagreement blind. Each value carries the","+          exact words of the scan that state it, and a quote verifier checks that those words are in the text.","         </p>","-        <p style={{ whiteSpace: 'pre-wrap' }}>{article.text}</p>","-      </article>","-    </main>","+        <p>","+          The automatic reader that will label the rest of the archive is still being trained, on labels from an open-weight model run","+          locally. Nothing on this page was written by it.","+        </p>","+        <p>","+          Text: the AmericanStories dataset’s OCR of Chronicling America. Scans: the Library of Congress, Chronicling","+          America.","+        </p>","+      </footer>","+    </>","   )"," }"," "]}],"originalFile":"import { useEffect, useState } from 'react'\n\n// the 1850 Lewistown gazette article that scripts/load_skeleton.py loads\nconst ARTICLE = '9_1850-07-26_p1_sn83032276_00296028587_1850072601_0265.json'\n\ntype Article = {\n  paper: string\n  date: string\n  display_headline: string\n  text: string\n  crop_urls: string[]\n}\n\nfunction App() {\n  const [article, setArticle] = useState<Article>()\n  const [error, setError] = useState<string>()\n\n  useEffect(() => {\n    fetch(`/api/skeleton/${encodeURIComponent(ARTICLE)}`)\n      .then((response) =>\n        response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`)),\n      )\n      .then(setArticle, (failure: Error) => setError(failure.message))\n  }, [])\n\n  if (error) return <main><p>The article could not be loaded ({error}).</p></main>\n  if (!article) return <main><p>Loading the article…</p></main>\n  return (\n    <main\n      style={{\n        display: 'grid',\n        gridTemplateColumns: 'repeat(auto-fit, minmax(18rem, 1fr))',\n        gap: '2rem',\n        padding: '1rem',\n      }}\n    >\n      <div>\n        {article.crop_urls.map((url, part) => (\n          <img\n            key={url}\n            src={url}\n            alt={`The clipping, part ${part + 1} of ${article.crop_urls.length}`}\n            style={{ width: '100%', display: 'block' }}\n          />\n        ))}\n      </div>\n      <article>\n        <h1 style={{ whiteSpace: 'pre-line' }}>{article.display_headline}</h1>\n        <p>\n          {article.paper}, {article.date}\n        </p>\n        <p style={{ whiteSpace: 'pre-wrap' }}>{article.text}</p>\n      </article>\n    </main>\n  )\n}\n\nexport default App\n","userModified":false},"sourceToolAssistantUUID":"df6d72a5-af7a-4fbe-8f34-093ee76a1416","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"submission","slug":"sunny-popping-comet"}
