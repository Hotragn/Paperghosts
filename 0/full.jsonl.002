{"parentUuid":"8ee95efc-09b3-4fa4-8d0b-6f69b5dd8745","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/local_lora_timing.py","snippet":"16\timport tempfile\n17\timport time\n18\t\n19\tfrom label_gold import ROOT\n20\t\n21\tMODEL = \"Qwen/Qwen3.5-4B\"\n22\tRESULT = ROOT / \"eval\" / \"results\" / \"phase2c\" / \"local_lora_timing.json\"\n23\tEXAMPLES = 3000\n24\tLINE = re.compile(\n25\t    r\"Iter (\\d+): Train loss [\\d.]+.*?It/sec ([\\d.]+).*?Tokens/sec ([\\d.]+).*?Peak mem ([\\d.]+) GB\"\n26\t)\n27\t\n28\t\n29\tdef main(data: str, iters: int = 40, batch: int = 4) -> None:\n30\t    with tempfile.TemporaryDirectory() as adapters:\n31\t        started = time.time()\n32\t        log = subprocess.run(\n33\t            [\n34\t                sys.executable,\n35\t                \"-m\",\n36\t                \"mlx_lm\",\n37\t                \"lora\",\n38\t                \"--model\",\n39\t                MODEL,\n40\t                \"--train\",\n41\t                \"--data\",\n42\t                data,\n43\t                \"--iters\",\n44\t                str(iters),\n45\t                \"--batch-size\",\n46\t                str(batch),\n47\t                \"--num-layers\",\n48\t                \"16\",\n49\t                \"--max-seq-length\",\n50\t                \"2048\",\n51\t                \"--steps-per-report\",\n52\t                \"10\",\n53\t                \"--steps-per-eval\",\n54\t                \"100000\",\n55\t                \"--adapter-path\",\n56\t                adapters,\n57\t            ],\n58\t            capture_output=True,\n59\t            text=True,\n60\t            check=False,\n61\t        )\n62\t        wall = time.time() - started\n63\t    reports = [\n64\t        tuple(map(float, m.groups())) for m in LINE.finditer(log.stdout + log.stderr)\n65\t    ]\n66\t    if not reports:\n67\t        sys.exit(\n68\t            \"no training report in mlx-lm's log:\\n\" + (log.stdout + log.stderr)[-2000:]\n69\t        )\n70\t    steady = reports[1:] or reports  # the first report includes the warm-up\n71\t    it_per_sec = sum(r[1] for r in steady) / len(steady)\n72\t    epoch = EXAMPLES / batch / it_per_sec\n73\t    found = {\n74\t        \"model\": MODEL,\n75\t        \"iterations\": iters,\n76\t        \"batch\": batch,\n77\t        \"lora_layers\": 16,"},"type":"attachment","uuid":"3468ab32-1d03-44bd-a7fa-accd9c32c5e4","timestamp":"2026-10-31T20:03:56.451Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/local_lora_timing.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n16\timport tempfile\n17\timport time\n18\t\n19\tfrom label_gold import ROOT\n20\t\n21\tMODEL = \"Qwen/Qwen3.5-4B\"\n22\tRESULT = ROOT / \"eval\" / \"results\" / \"phase2c\" / \"local_lora_timing.json\"\n23\tEXAMPLES = 3000\n24\tLINE = re.compile(\n25\t    r\"Iter (\\d+): Train loss [\\d.]+.*?It/sec ([\\d.]+).*?Tokens/sec ([\\d.]+).*?Peak mem ([\\d.]+) GB\"\n26\t)\n27\t\n28\t\n29\tdef main(data: str, iters: int = 40, batch: int = 4) -> None:\n30\t    with tempfile.TemporaryDirectory() as adapters:\n31\t        started = time.time()\n32\t        log = subprocess.run(\n33\t            [\n34\t                sys.executable,\n35\t                \"-m\",\n36\t                \"mlx_lm\",\n37\t                \"lora\",\n38\t                \"--model\",\n39\t                MODEL,\n40\t                \"--train\",\n41\t                \"--data\",\n42\t                data,\n43\t                \"--iters\",\n44\t                str(iters),\n45\t                \"--batch-size\",\n46\t                str(batch),\n47\t                \"--num-layers\",\n48\t                \"16\",\n49\t                \"--max-seq-length\",\n50\t                \"2048\",\n51\t                \"--steps-per-report\",\n52\t                \"10\",\n53\t                \"--steps-per-eval\",\n54\t                \"100000\",\n55\t                \"--adapter-path\",\n56\t                adapters,\n57\t            ],\n58\t            capture_output=True,\n59\t            text=True,\n60\t            check=False,\n61\t        )\n62\t        wall = time.time() - started\n63\t    reports = [\n64\t        tuple(map(float, m.groups())) for m in LINE.finditer(log.stdout + log.stderr)\n65\t    ]\n66\t    if not reports:\n67\t        sys.exit(\n68\t            \"no training report in mlx-lm's log:\\n\" + (log.stdout + log.stderr)[-2000:]\n69\t        )\n70\t    steady = reports[1:] or reports  # the first report includes the warm-up\n71\t    it_per_sec = sum(r[1] for r in steady) / len(steady)\n72\t    epoch = EXAMPLES / batch / it_per_sec\n73\t    found = {\n74\t        \"model\": MODEL,\n75\t        \"iterations\": iters,\n76\t        \"batch\": batch,\n77\t        \"lora_layers\": 16,\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2c-reader","slug":"sunny-popping-comet"}
