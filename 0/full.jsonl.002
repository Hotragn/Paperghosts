{"parentUuid":"6157ab22-a473-4c7f-a566-5c4ca78489e6","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_teacher.py","snippet":"3\t\n4\tfrom teacher import parsed, prompt_sha256, rendered, score, verified\n5\t\n6\tTEXT = \"A HAUNTED FARMHOUSE MILFORD, Conn., June 3.-The family of Mr. John Hale have been disturbed every night by knockings upon the walls of the old farmhouse.\"\n7\t\n8\t\n9\tdef test_the_prompt_is_chatml_without_thinking_and_hashed():\n10\t    text = rendered(\"the system\", \"the article\")\n11\t    assert text.startswith(\n12\t        \"<|im_start|>system\\nthe system<|im_end|>\\n<|im_start|>user\\nthe article\"\n13\t    )\n14\t    assert text.endswith(\"<|im_start|>assistant\\n<think>\\n\\n</think>\\n\\n\")\n15\t    assert prompt_sha256(\"a\") != prompt_sha256(\"b\") and len(prompt_sha256(\"a\")) == 64\n16\t\n17\t\n18\tdef test_an_answer_is_parsed_from_its_json_even_with_text_around_it():\n19\t    answer = 'Here it is: {\"kind\": \"report\", \"kind_quote\": \"knockings\", \"seen\": {\"value\": \"knockings\", \"quote\": \"knockings upon the walls\"}, \"people\": []} done'\n20\t    found = parsed(answer)\n21\t    assert (\n22\t        found[\"kind\"] == \"report\"\n23\t        and found[\"seen\"][\"quote\"] == \"knockings upon the walls\"\n24\t    )\n25\t    assert parsed(\"no json here\") is None\n26\t    assert parsed('{\"kind\": \"spooky\"}') is None  # not one of POLICY.md's kinds\n27\t\n28\t\n29\tdef test_a_quote_scores_one_when_it_is_in_the_text_and_low_when_it_is_not():\n30\t    assert score(\"knockings upon the walls\", TEXT) == 1.0\n31\t    assert (\n32\t        score(\"Knockings  upon the WALLS.\", TEXT) == 1.0\n33\t    )  # case, spacing and punctuation\n34\t    assert 0.8 < score(\"knockings upon tho walls\", TEXT) < 1.0  # an OCR letter mended\n35\t    assert score(\"a pale woman in white on the stairs\", TEXT) < 0.6\n36\t\n37\t\n38\tdef test_a_value_whose_quote_fails_is_dropped_never_kept():\n39\t    label = {\n40\t        \"kind\": \"report\",\n41\t        \"kind_quote\": \"knockings\",\n42\t        \"seen\": {\"value\": \"knockings\", \"quote\": \"knockings upon the walls\"},\n43\t        \"place\": {\"value\": \"Boston\", \"quote\": \"in the city of Boston\"},\n44\t        \"outcome\": {\"value\": \"spooky\", \"quote\": \"knockings\"},\n45\t        \"people\": [\n46\t            {\"value\": \"the Hale family\", \"quote\": \"The family of Mr. John Hale\"},\n47\t            {\"value\": \"a ghost\", \"quote\": \"a pale ghost\"},\n48\t        ],\n49\t    }\n50\t    kept, dropped = verified(label, TEXT, 0.9)\n51\t    assert kept[\"seen\"][\"quote\"] == \"knockings upon the walls\" and kept[\"place\"] is None\n52\t    assert kept[\"outcome\"] is None  # not one of the schema's outcomes\n53\t    assert [p[\"value\"] for p in kept[\"people\"]] == [\"the Hale family\"]\n54\t    assert sorted(dropped) == [\"outcome\", \"people\", \"place\"]"},"type":"attachment","uuid":"a22a09e9-498e-4f4a-ba69-64136dcffb84","timestamp":"2026-10-31T19:23:20.658Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_teacher.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n3\t\n4\tfrom teacher import parsed, prompt_sha256, rendered, score, verified\n5\t\n6\tTEXT = \"A HAUNTED FARMHOUSE MILFORD, Conn., June 3.-The family of Mr. John Hale have been disturbed every night by knockings upon the walls of the old farmhouse.\"\n7\t\n8\t\n9\tdef test_the_prompt_is_chatml_without_thinking_and_hashed():\n10\t    text = rendered(\"the system\", \"the article\")\n11\t    assert text.startswith(\n12\t        \"<|im_start|>system\\nthe system<|im_end|>\\n<|im_start|>user\\nthe article\"\n13\t    )\n14\t    assert text.endswith(\"<|im_start|>assistant\\n<think>\\n\\n</think>\\n\\n\")\n15\t    assert prompt_sha256(\"a\") != prompt_sha256(\"b\") and len(prompt_sha256(\"a\")) == 64\n16\t\n17\t\n18\tdef test_an_answer_is_parsed_from_its_json_even_with_text_around_it():\n19\t    answer = 'Here it is: {\"kind\": \"report\", \"kind_quote\": \"knockings\", \"seen\": {\"value\": \"knockings\", \"quote\": \"knockings upon the walls\"}, \"people\": []} done'\n20\t    found = parsed(answer)\n21\t    assert (\n22\t        found[\"kind\"] == \"report\"\n23\t        and found[\"seen\"][\"quote\"] == \"knockings upon the walls\"\n24\t    )\n25\t    assert parsed(\"no json here\") is None\n26\t    assert parsed('{\"kind\": \"spooky\"}') is None  # not one of POLICY.md's kinds\n27\t\n28\t\n29\tdef test_a_quote_scores_one_when_it_is_in_the_text_and_low_when_it_is_not():\n30\t    assert score(\"knockings upon the walls\", TEXT) == 1.0\n31\t    assert (\n32\t        score(\"Knockings  upon the WALLS.\", TEXT) == 1.0\n33\t    )  # case, spacing and punctuation\n34\t    assert 0.8 < score(\"knockings upon tho walls\", TEXT) < 1.0  # an OCR letter mended\n35\t    assert score(\"a pale woman in white on the stairs\", TEXT) < 0.6\n36\t\n37\t\n38\tdef test_a_value_whose_quote_fails_is_dropped_never_kept():\n39\t    label = {\n40\t        \"kind\": \"report\",\n41\t        \"kind_quote\": \"knockings\",\n42\t        \"seen\": {\"value\": \"knockings\", \"quote\": \"knockings upon the walls\"},\n43\t        \"place\": {\"value\": \"Boston\", \"quote\": \"in the city of Boston\"},\n44\t        \"outcome\": {\"value\": \"spooky\", \"quote\": \"knockings\"},\n45\t        \"people\": [\n46\t            {\"value\": \"the Hale family\", \"quote\": \"The family of Mr. John Hale\"},\n47\t            {\"value\": \"a ghost\", \"quote\": \"a pale ghost\"},\n48\t        ],\n49\t    }\n50\t    kept, dropped = verified(label, TEXT, 0.9