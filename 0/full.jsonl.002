{"type":"api-request-blob","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","hash":"58d47fecfc402b65600ae783690532347ca04df370743c8f23f9f088dcaa4ef7","message":{"role":"system","content":[{"type":"text","text":"Note: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/query_demo_atlas.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n11\timport sys\n12\timport time\n13\t\n14\tfrom pymongo import MongoClient\n15\t\n16\tfrom paperghosts.config import setting\n17\tfrom paperghosts.store.db_init import DATABASE\n18\t\n19\tPATHS = [\n20\t    \"headline\",\n21\t    \"text\",\n22\t    \"fields.place.value\",\n23\t    \"fields.seen.value\",\n24\t    \"fields.specific_place.value\",\n25\t]\n26\tSHOWN = {\n27\t    \"_id\": 1,\n28\t    \"date\": 1,\n29\t    \"display_headline\": 1,\n30\t    \"paper\": {\"$first\": \"$printings.paper\"},\n31\t    \"place\": \"$fields.place.value\",\n32\t    \"score\": {\"$meta\": \"searchScore\"},\n33\t    \"highlights\": {\"$meta\": \"searchHighlights\"},\n34\t}\n35\t\n36\t\n37\tdef fuzzy(words: str) -> list:\n38\t    return [\n39\t        {\n40\t            \"$search\": {\n41\t                \"index\": \"reports_search\",\n42\t                \"text\": {\n43\t                    \"query\": words,\n44\t                    \"path\": PATHS,\n45\t                    \"fuzzy\": {\"maxEdits\": 2, \"prefixLength\": 1},\n46\t                },\n47\t                \"highlight\": {\"path\": [\"headline\", \"text\"]},\n48\t            }\n49\t        },\n50\t        {\"$limit\": 5},\n51\t        {\"$project\": SHOWN},\n52\t    ]\n53\t\n54\t\n55\tdef like(doc: dict) -> list:\n56\t    return [\n57\t        {\n58\t            \"$search\": {\n59\t                \"index\": \"reports_search\",\n60\t                \"moreLikeThis\": {\n61\t                    \"like\": {\"headline\": doc[\"headline\"], \"text\": doc[\"text\"][:2000]}\n62\t                },\n63\t            }\n64\t        },\n65\t        {\"$match\": {\"_id\": {\"$ne\": doc[\"_id\"]}}},\n66\t        {\"$limit\": 5},\n67\t        {\"$project\": {k: v for k, v in SHOWN.items() if k != \"highlights\"}},\n68\t    ]\n69\t\n70\t\n71\tdef matched(found: dict) -> str:\n72\t    words = {\n73\t        t[\"value\"]\n74\t        for h in found.get(\"highlights\") or []\n75\t        for t in h[\"texts\"]\n76\t        if t[\"type\"] == \"hit\"\n77\t    }\n78\t    return \", \".join(sorted(words)[:6])\n79\t\n80\t\n81\tdef main(args: list) -> None:\n82\t    with MongoClient(\n83\t        setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000\n84\t    ) as client:\n85\t        reports = client[DATABASE][\"reports\"]\n86\t        if args[0] == \"--like\":\n87\t            doc = reports.find_one({\"_id\": f\"r_{args[1]}\"}, {\"headline\": 1, \"text\": 1})\n88\t            if doc is None:\n89\t                sys.exit(f\"{args[1]} is not in the Morgue\")\n90\t            print(\n91\t                f\"ghosts like {doc['headline'].splitlines()[0] if doc['headline'] else args[1]}:\"\n92\t            )\n93\t            pipeline = like(doc)\n94\t        else:\n95\t            print(f\"search: {args[0]!r}, fuzzy up to 2 edits\")\n96\t            pipeline = fuzzy(args[0])\n97\t        started = time.perf_counter()\n98\t        results = list(reports.aggregate(pipeline))\n99\t        ms = (time.perf_counter() - started) * 1000\n100\t    for r in results:\n101\t        title = (r.get(\"display_headline\") or \"\").splitlines()[0][:70]\n102\t        print(f\"  {r['date']}  {title}\\n    {r.get('paper') or ''}\")\n103\t        print(\n104\t            f\"    story place: {r.get('place') or 'not stated'}   score {r['score']:.2f}\"\n105\t        )\n106\t        if r.get(\"highlights\"):\n107\t            print(f\"    matched: {matched(r)}\")\n108\t    print(f\"{len(results)} found in {ms:.0f} ms\")\n109\t\n110\t\n111\tif __name__ == \"__main__\":\n112\t    main(sys.argv[1:])"}]}}
