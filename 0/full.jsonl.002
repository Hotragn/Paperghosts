79\t\n80\t\n81\tdef test_the_final_label_is_the_ruling_where_there_is_one():\n82\t    records = [\n83\t        {\"article_id\": \"a\", \"labeller\": \"Claude\", \"kind\": \"idiom\"},\n84\t        {\"article_id\": \"a\", \"labeller\": \"second pass\", \"kind\": \"other\"},\n85\t        {\"article_id\": \"a\", \"labeller\": \"ruling\", \"kind\": \"other\"},\n86\t        {\"article_id\": \"b\", \"labeller\": \"Claude\", \"kind\": \"report\"},\n87\t        {\"article_id\": \"b\", \"labeller\": \"second pass\", \"kind\": \"report\"},\n88\t    ]\n89\t    assert {aid: r[\"kind\"] for aid, r in final(records).items()} == {\n90\t        \"a\": \"other\",\n91\t        \"b\": \"report\",\n92\t    }\n93\t\n94\t\n95\tdef test_reports_are_counted_by_stratum_beside_the_expectation_and_weighted():\n96\t    items = [\n97\t        {\"article_id\": \"a\", \"stratum\": \"s1\", \"weight\": 10.0},\n98\t        {\"article_id\": \"b\", \"stratum\": \"s1\", \"weight\": 10.0},\n99\t        {\"article_id\": \"c\", \"stratum\": \"s2\", \"weight\": 1000.0},\n100\t    ]\n101\t    kinds = {\"a\": \"report\", \"b\": \"fiction\", \"c\": \"idiom\"}\n102\t    expected = {\n103\t        \"strata\": {\"s1\": {\"reports\": [0.8, 0.2, 1.5]}, \"s2\": {\"reports\": None}},\n104\t        \"total\": [1.0, 0.3, 2.0],\n105\t    }\n106\t\n107\t    rows = by_stratum(items, kinds, expected)\n108\t    assert rows[\"strata\"][\"s1\"] == {\n109\t        \"gold\": 2,\n110\t        \"reports\": 1,\n111\t        \"expected\": [0.8, 0.2, 1.5],\n112\t    }\n113\t    assert rows[\"strata\"][\"s2\"] == {\"gold\": 1, \"reports\": 0, \"expected\": None}\n114\t    assert rows[\"total\"] == {\"gold\": 3, \"reports\": 1, \"expected\": [1.0, 0.3, 2.0]}\n115\t\n116\t    rate = weighted(items, kinds)\n117\t    assert rate[\"rate\"] == pytest.approx(10 / 1020)\n118\t    low, high = rate[\"interval\"]\n119\t    assert 0 <= low <= rate[\"rate\"] <= high\n120\t\n</system-reminder>"}],"renderedRole":"system","userType":"external","entr