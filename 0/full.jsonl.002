{"parentUuid":"c209a71f-f27f-426b-a97e-c479911982ca","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/local_throughput.py","snippet":"15\tfrom credit_check import RESULT as CREDIT\n16\tfrom credit_check import rows_of\n17\tfrom label_gold import ROOT\n18\tfrom teacher import INSTRUCTIONS, article_text, rendered\n19\t\n20\tMODEL = \"qwen3.5:4b\"\n21\tURL = \"http://127.0.0.1:11434/api/generate\"\n22\tRESULT = ROOT / \"eval\" / \"results\" / \"phase2c\" / \"local_throughput.json\"\n23\tSHORT = \"Label this newspaper article for the ghost-report archive. Answer with the label's JSON.\"\n24\tCANDIDATES = 1_236_122\n25\t\n26\t\n27\tdef one(row: dict, system: str = INSTRUCTIONS) -> dict:\n28\t    body = {\n29\t        \"model\": MODEL,\n30\t        \"prompt\": rendered(system, article_text(row)),\n31\t        \"raw\": True,\n32\t        \"stream\": False,\n33\t        \"options\": {\n34\t            \"temperature\": 0,\n35\t            \"num_predict\": 700,\n36\t            \"num_ctx\": 8192,\n37\t            \"stop\": [\"<|im_end|>\"],\n38\t        },\n39\t    }\n40\t    answer = httpx.post(URL, json=body, timeout=600).json()\n41\t    return {\n42\t        \"article_id\": row[\"article_id\"],\n43\t        \"prompt_tokens\": answer.get(\"prompt_eval_count\", 0),\n44\t        \"output_tokens\": answer.get(\"eval_count\", 0),\n45\t        \"seconds\": answer.get(\"total_duration\", 0) / 1e9,\n46\t        \"prompt_seconds\": answer.get(\"prompt_eval_duration\", 0) / 1e9,\n47\t    }\n48\t\n49\t\n50\tdef timed(rows: list, workers: int, system: str = INSTRUCTIONS) -> tuple[dict, list]:\n51\t    started = time.time()\n52\t    with ThreadPoolExecutor(workers) as pool:\n53\t        out = list(pool.map(lambda row: one(row, system), rows))\n54\t    wall = time.time() - started\n55\t    per_hour = len(rows) / wall * 3600\n56\t    return {\n57\t        \"concurrent\": workers,\n58\t        \"wall_seconds\": round(wall, 1),\n59\t        \"articles_per_hour\": round(per_hour),\n60\t        \"prompt_tokens\": sum(o[\"prompt_tokens\"] for o in out),\n61\t        \"output_tokens\": sum(o[\"output_tokens\"] for o in out),\n62\t        \"full_pass_days\": round(CANDIDATES / per_hour / 24, 1),\n63\t    }, out\n64\t\n65\t\n66\tdef main(run: str = \"long\") -> None:\n67\t    picked = json.loads(CREDIT.read_text())[\"sample\"]\n68\t    rows = rows_of(set(picked))\n69\t    rows = [rows[aid] for aid in picked]\n70\t    found = (\n71\t        json.loads(RESULT.read_text())\n72\t        if RESULT.exists()\n73\t        else {\"model\": MODEL, \"articles\": len(rows)}\n74\t    )\n75\t    if run == \"long\":\n76\t        one(rows[0])  # load the model before timing\n77\t        found[\"runs\"] = [timed(rows, workers)[0] for workers in (1, 4, 8)]\n78\t    elif run == \"short\":\n79\t        one(rows[0], SHORT)\n80\t        found[\"short\"] = timed(rows, 4, SHORT)[0] | {\"instruction\": SHORT}\n81\t    elif run == \"prefix\":\n82\t        one(rows[0])\n83\t        _, out = timed(rows, 1)\n84\t        short_run = [one(row, SHORT) for row in rows]\n85\t        found[\"prefix\"] = {\n86\t            \"long_prompt_tokens_evaluated\": sum(o[\"prompt_tokens\"] for o in out)\n87\t            / len(out),\n88\t            \"long_prompt_seconds\": sum(o[\"prompt_seconds\"] for o in out) / len(out),\n89\t            \"short_prompt_tokens_evaluated\": sum(o[\"prompt_tokens\"] for o in short_run)\n90\t            / len(out),\n91\t            \"short_prompt_seconds\": sum(o[\"prompt_seconds\"] for o in short_run)\n92\t            / len(out),\n93\t        }\n94\t    RESULT.write_text(json.dumps(found, indent=1) + \"\\n\")\n95\t    print(\n96\t        json.dumps(\n97\t            {k: v for k, v in found.items() if k in (\"runs\", \"short\", \"prefix\")},\n98\t            indent=1,\n99\t        )\n100\t    )\n101\t\n102\t\n103\tif __name__ == \"__main__\":\n104\t    import sys\n105\t\n106\t    main(sys.argv[1] if len(sys.argv) > 1 else \"long\")"},"type":"attachment","uuid":"64b36c52-f058-4439-b1dd-5a56a7597b87","timestamp":"2026-10-31T19:53:45.603Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/scripts/local_throughput.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n15\tfrom credit_check import RESULT as CREDIT\n16\tfrom credit_check import rows_of\n17\tfrom label_gold import ROOT\n18\tfrom teacher import INSTRUCTIONS, article_text, rendered\n19\t\n20\tMODEL = \"qwen3.5:4b\"\n21\tURL = \"http://127.0.0.1:11434/api/generate\"\n22\tRESULT = ROOT / \"eval\" / \"results\" / \"phase2c\" / \"local_throughput.json\"\n23\tSHORT = \"Label this newspaper article for the ghost-report archive. Answer with the label's JSON.\"\n24\tCANDIDATES = 1_236_122\n25\t\n26\t\n27\tdef one(row: dict, system: str = INSTRUCTIONS) -> dict:\n28\t    body = {\n29\t        \"model\": MODEL,\n30\t        \"prompt\": rendered(system, article_text(row)),\n31\t        \"raw\": True,\n32\t        \"stream\": False,\n33\t        \"options\": {\n34\t            \"temperature\": 0,\n35\t            \"num_predict\": 700,\n36\t            \"num_ctx\": 8192,\n37\t            \"stop\": [\"<|im_end|>\"],\n38\t        },\n39\t    }\n40\t    answer = httpx.post(URL, json=body, timeout=600).json()\n41\t    return {\n42\t        \"article_id\": row[\"article_id\"],\n43\t        \"prompt_tokens\": answer.get(\"prompt_eval_count\", 0),\n44\t        \"output_tokens\": answer.get(\"eval_count\", 0),\n45\t        \"seconds\": answer.get(\"total_duration\", 0) / 1e9,\n46\t        \"prompt_seconds\": answer.get(\"prompt_eval_duration\", 0) / 1e9,\n47\t    }\n48\t\n49\t\n50\tdef timed(rows: list, workers: int, system: str = INSTRUCTIONS) -> tuple[dict, list]:\n51\t    started = time.time()\n52\t    with ThreadPoolExecutor(workers) as pool:\n53\t        out = list(pool.map(lambda row: one(row, system), rows))\n54\t    wall = time.time() - started\n55\t    per_hour = len(rows) / wall * 3600\n56\t    return {\n57\t        \"concurrent\": workers,\n58\t        \"wall_seconds\": round(wall, 1),\n59\t        \"articles_per_hour\": round(per_hour),\n60\t        \"prompt_tokens\": sum(o[\"prompt_tokens\"] for o in out),\n61\t        \"output_tokens\": sum(o[\"output_tokens\"] for o in out),\n62\t        \"full_pass_days\": round(CANDIDATES / per_hour / 24, 1),\n63\t    }, out\n64\t\n65\t\n66\tdef main(run: str = \"long\") -> None:\n67\t    picked = json.loads(CREDIT.read_text())[\"sample\"]\n68\t    rows = rows_of(set(picked))\n69\t    rows = [rows[aid] for aid in picked]\n70\t    found = (\n71\t        json.loads(RESULT.read_text())\n72\t        if RESULT.exists()\n73\t        else {\"model\": MODEL, \"articles\": len(rows)}\n74\t    )\n75\t    if run == \"long\":\n76\t        one(rows[0])  # load the model before timing\n77\t        found[\"runs\"] = [timed(rows, workers)[0] for workers in (1, 4, 8)]\n78\t    elif run == \"short\":\n79\t        one(rows[0], SHORT)\n80\t        found[\"short\"] = timed(rows, 4, SHORT)[0] | {\"instruction\": SHORT}\n81\t    elif run == \"prefix\":\n82\t        one(rows[0])\n83\t        _, out = timed(rows, 1)\n84\t        short_run = [one(row, SHORT) for row in rows]\n85\t        found[\"prefix\"] = {\n86\t            \"long_prompt_tokens_evaluated\": sum(o[\"prompt_tokens\"] for o in out)\n87\t            / len(out),\n88\t            \"long_prompt_seconds\": sum(o[\"prompt_seconds\"] for o in out) / len(out),\n89\t            \"short_prompt_tokens_evaluated\": sum(o[\"prompt_tokens\"] for o in short_run)\n90\t            / len(out),\n91\t            \"short_prompt_seconds\": sum(o[\"prompt_seconds\"] for o in short_run)\n92\t            / len(out),\n93\t        }\n94\t    RESULT.write_text(json.dumps(found, indent=1) + \"\\n\")\n95\t    print(\n96\t        json.dumps(\n97\t            {k: v for k, v in found.items() if k in (\"runs\", \"short\", \"prefix\")},\n98\t            indent=1,\n99\t        )\n100\t    )\n101\t\n102\t\n103\tif __name__ == \"__main__\":\n104\t    import sys\n105\t\n106\t    main(sys.argv[1] if len(sys.argv) > 1 else \"long\")\n</system-reminder>"}],"renderedRole":"system","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2c-reader","slug":"sunny-popping-comet"}
