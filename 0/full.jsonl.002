data\", data,\n             \"--iters\", str(iters), \"--batch-size\", str(batch), \"--num-layers\", \"16\",\n             \"--max-seq-length\", \"2048\", \"--steps-per-report\", \"10\", \"--steps-per-eval\", \"100000\",\n             \"--adapter-path\", adapters],\n            capture_output=True, text=True, check=False,\n        )\n        wall = time.time() - started\n    reports = [tuple(map(float, m.groups())) for m in LINE.finditer(log.stdout + log.stderr)]\n    if not reports:\n        sys.exit(\"no training report in mlx-lm's log:\\n\" + (log.stdout + log.stderr)[-2000:])\n    steady = reports[1:] or reports  # the first report includes the warm-up\n    it_per_sec = sum(r[1] for r in steady) / len(steady)\n    epoch = EXAMPLES / batch / it_per_sec\n    found = {\n        \"model\": MODEL,\n        \"iterations\": iters,\n        \"batch\": batch,\n        \"lora_layers\": 16,\n        \"wall_seconds\": round(wall, 1),\n        \"iterations_per_second\": round(it_per_sec, 3),\n        \"tokens_per_second\": round(sum(r[2] for r in steady) / len(steady)),\n        \"peak_memory_gb\": max(r[3] for r in reports),\n        \"epoch_of_3000_hours\": round(epoch / 3600, 2),\n        \"reports\": reports,\n    }\n    RESULT.write_text(json.dumps(found, indent=1) + \"\\n\")\n    print(json.dumps({k: v for k, v in found.items() if k != \"reports\"}, indent=1))\n\n\nif __name__ == \"__main__\":\n    main(sys.argv[1], *map(int, sys.argv[2:]))\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"512c76ad-f1b2-40f5-96ce-cf7f68a65bde","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2c-reader","slug":"sunny-popping-comet"}
