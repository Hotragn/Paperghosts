","+SEEN = (","+    ROOT / \"data\" / \"gold\" / \"crops.json\"","+)  # each article's crop files, or why it has none"," KINDS = (\"report\", \"fiction\", \"idiom\", \"religious\", \"advert\", \"other\")"," # the schema's values, which POLICY.md writes with spaces: inn_or_hotel is \"inn or hotel\""," CHOICES = {"]},{"oldStart":76,"oldLines":6,"newStart":84,"newLines":79,"lines":["         }"," "," ","+def order_of(rows: dict) -> list:","+    \"\"\"Gold, then dev, each in its seeded shuffle.\"\"\"","+    order = []","+    for name in OUT:","+        ids = sorted(aid for aid, row in rows.items() if row[\"split\"] == name)","+        random.Random(f\"2C.1 labelling order {name}\").shuffle(ids)","+        order += ids","+    return order","+","+","+def warm(rows: dict, crops_for=crops.crops_for, seen: Path = SEEN) -> dict:","+    \"\"\"Each article's crops through crops_for, one article at a time, as crops.get paces the","+    Library of Congress: its crop files, or why it has none. Saved after each article, so a","+    stop loses nothing. A busy answer is left out, so the next run asks again.\"\"\"","+    found = json.loads(seen.read_text()) if seen.exists() else {}","+    for aid in order_of(rows):","+        row = rows[aid]","+        if aid in found:","+            continue","+        try:","+            if not (row.get(\"scan\") and row.get(\"bbox_list\")):","+                raise LookupError(\"the article has no scan or no boxes\")","+            _, paths = crops_for(","+                row[\"member\"], row[\"scan\"], row[\"bbox_list\"], text=row.get(\"text\")","+            )","+            found[aid] = {\"crops\": [str(path) for path in paths]}","+        except crops.Busy:","+            continue","+        except (LookupError, ValueError, httpx.HTTPError) as error:","+            found[aid] = {\"none\": str(error)}","+        seen.parent.mkdir(parents=True, exist_ok=True)","+        seen.write_text(json.dumps(found, indent=1) + \"\\n\")","+    return found","