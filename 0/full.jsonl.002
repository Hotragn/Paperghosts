{"parentUuid":"67684307-54a8-42db-9d2f-ccf3fe753e39","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_gold_measures.py","snippet":"12\t\n13\tdef test_the_story_place_rule_reads_the_state_from_the_text_or_the_dateline():\n14\t    text = \"A Dead Mans Ghost. CUMBERLAxD, Nd, May Am interest ing ghost story comes from the town of Sharpsburg, Md. About ten days ago\"\n15\t    assert story_state(text, place(\"Sharpsburg, Md\")) == \"Maryland\"\n16\t    assert story_state(text, place(\"the town of Sharpsburg\")) == \"Maryland\"\n17\t\n18\t    dated = \"A HAUNTED FARMHOUSE MILFORD, Conn., June 3.-The family of Mr. John Hale\"\n19\t    assert story_state(dated, place(\"the old farmhouse\")) == \"Connecticut\"\n20\t    assert (\n21\t        story_state(\"PHILADELPHIA, Pa, Dec. 22.-That Rev. Dr.\", place(\"St. John's\"))\n22\t        == \"Pennsylvania\"\n23\t    )\n24\t    assert (\n25\t        story_state(\"Albia, Ia., Sept. 19.-Bailey Black\", place(\"the jail\")) == \"Iowa\"\n26\t    )\n27\t\n28\t    # no state in the text: the paper's state is never taken\n29\t    assert story_state(\"NEW YORK, Nov. 30.-The story of the\", place(\"Brooklyn\")) is None\n30\t    assert (\n31\t        story_state(\n32\t            \"Saw Ghosts. correspondent writing from Hilo\", place(\"writing from Hilo\")\n33\t        )\n34\t        is None\n35\t    )\n36\t    assert (\n37\t        story_state(\n38\t            \"la pri- son de Washington. Tellc est\", place(\"la pri- son de Washington\")\n39\t        )\n40\t        is None\n41\t    )\n42\t    assert (\n43\t        story_state(\"Buffalo, New York, Jan. 3\", place(\"Buffalo, New York\"))\n44\t        == \"New York\"\n45\t    )\n46\t\n47\t\n48\tdef test_the_paper_state_is_the_printed_one_or_a_cached_records(tmp_path):\n49\t    assert (\n50\t        paper_state(\n51\t            {\"paper\": \"Burlington free press. [volume] (Burlington, Vt.) 1827-1865\"},\n52\t            tmp_path,\n53\t        )\n54\t        == \"Vermont\"\n55\t    )\n56\t    assert (\n57\t        paper_state(\n58\t            {\n59\t                \"paper\": \"The herald.\",\n60\t                \"article_id\": \"79_1897-04-18_p2_sn85042461_0028.json\",\n61\t            },\n62\t            tmp_path,\n63\t        )\n64\t        is None\n65\t    )\n66\t    (tmp_path / \"sn85042461.json\").write_text(\n67\t        '{\"status\": 200, \"body\": {\"item\": {\"location_str\": \"Los Angeles, California\", \"location_state\": [\"california\"]}}}'\n68\t    )\n69\t    assert (\n70\t        paper_state(\n71\t            {\n72\t                \"paper\": \"The herald.\",\n73\t                \"article_id\": \"79_1897-04-18_p2_sn85042461_0028.json\",\n74\t            },\n75\t            tmp_path,\n76\t        )\n77\t        == \"California\"\n78\t    )\n79\t\n80\t\n81\tdef test_the_final_label_is_the_ruling_where_there_is_one():\n82\t    records = [\n83\t        {\"article_id\": \"a\", \"labeller\": \"Claude\", \"kind\": \"idiom\"},\n84\t        {\"article_id\": \"a\", \"labeller\": \"second pass\", \"kind\": \"other\"},\n85\t        {\"article_id\": \"a\", \"labeller\": \"ruling\", \"kind\": \"other\"},\n86\t        {\"article_id\": \"b\", \"labeller\": \"Claude\", \"kind\": \"report\"},\n87\t        {\"article_id\": \"b\", \"labeller\": \"second pass\", \"kind\": \"report\"},\n88\t    ]\n89\t    assert {aid: r[\"kind\"] for aid, r in final(records).items()} == {\n90\t        \"a\": \"other\",\n91\t        \"b\": \"report\",\n92\t    }\n93\t\n94\t\n95\tdef test_reports_are_counted_by_stratum_beside_the_expectation_and_weighted():\n96\t    items = [\n97\t        {\"article_id\": \"a\", \"stratum\": \"s1\", \"weight\": 10.0},\n98\t        {\"article_id\": \"b\", \"stratum\": \"s1\", \"weight\": 10.0},\n99\t        {\"article_id\": \"c\", \"stratum\": \"s2\", \"weight\": 1000.0},\n100\t    ]\n101\t    kinds = {\"a\": \"report\", \"b\": \"fiction\", \"c\": \"idiom\"}\n102\t    expected = {\n103\t        \"strata\": {\"s1\": {\"reports\": [0.8, 0.2, 1.5]}, \"s2\": {\"reports\": None}},\n104\t        \"total\": [1.0, 0.3, 2.0],\n105\t    }\n106\t\n107\t    rows = by_stratum(items, kinds, expected)\n108\t    assert rows[\"strata\"][\"s1\"] == {\n109\t        \"gold\": 2,\n110\t        \"reports\": 1,\n111\t        \"expected\": [0.8, 0.2, 1.5],\n112\t    }\n113\t    assert rows[\"strata\"][\"s2\"] == {\"gold\": 1, \"reports\": 0, \"expected\": None}\n114\t    assert rows[\"total\"] == {\"gold\": 3, \"reports\": 1, \"expected\": [1.0, 0.3, 2.0]}\n115\t\n116\t    rate = weighted(items, kinds)\n117\t    assert rate[\"rate\"] == pytest.approx(10 / 1020)\n118\t    low, high = rate[\"interval\"]\n119\t    assert 0 <= low <= rate[\"rate\"] <= high\n120\t"},"type":"attachment","uuid":"e429e138-4c33-41b6-b075-829ee5a0e43f","timestamp":"2026-10-31T08:45:41.053Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_gold_measures.py changed on disk since you last read it. That's usually deliberate, so take it as the current state rather than reverting it; if the change looks wrong, say so rather than undoing it yourself — otherwise no need to call it out. Here are the relevant changes (shown with line numbers):\n12\t\n13\tdef test_the_story_place_rule_reads_the_state_from_the_text_or_the_dateline():\n14\t    text = \"A Dead Mans Ghost. CUMBERLAxD, Nd, May Am interest ing ghost story comes from the town of Sharpsburg, Md. About ten days ago\"\n15\t    assert story_state(text, place(\"Sharpsburg, Md\")) == \"Maryland\"\n16\t    assert story_state(text, place(\"the town of Sharpsburg\")) == \"Maryland\"\n17\t\n18\t    dated = \"A HAUNTED FARMHOUSE MILFORD, Conn., June 3.-The family of Mr. John Hale\"\n19\t    assert story_state(dated, place(\"the old farmhouse\")) == \"Connecticut\"\n20\t    assert (\n21\t        story_state(\"PHILADELPHIA, Pa, Dec. 22.-