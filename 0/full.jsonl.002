  transform-origin: top;\n  transition: transform 0.3s ease-out;\n}\n\n.chain:active .chain-pull {\n  transform: scaleY(1.15);\n}\n\n/* the request slip */\n.slip {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr 1fr;\n  gap: 0.75rem 1rem;\n  margin: 1.5rem auto;\n  padding: 1rem 1.25rem 1.25rem;\n  max-width: 52rem;\n  background: var(--card);\n  border: 1px dashed var(--rule);\n}\n\n.slip-head {\n  grid-column: 1 / -1;\n  margin: 0;\n  font-size: 0.8rem;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.slip label {\n  display: grid;\n  gap: 0.25rem;\n  font-family: 'Courier Prime', monospace;\n  font-size: 0.85rem;\n}\n\n.slip input,\n.slip select {\n  font: inherit;\n  font-family: 'Newsreader', serif;\n  font-size: 1.05rem;\n  color: var(--text);\n  background: transparent;\n  border: none;\n  border-bottom: 1px solid var(--rule);\n  padding: 0.3rem 0.1rem;\n  min-height: 2.5rem;\n}\n\n.slip select option {\n  background: var(--card);\n  color: var(--text);\n}\n\n.count {\n58:@media (prefers-reduced-motion: reduce) { 74:.sr-only { 83:.skip { 92:.skip:focus { 96:.masthead, 97:main, 98:.colophon { 104:.masthead { 111:.mark { 118:.nameplate { 126:.ear, 127:.tagline, 128:.label, 129:.slip-head, 130:.count, 131:.filing, 132:.chain, 134:.check, 135:.note { 139:.ear { 145:.tagline { 151:.chain { 164:.chain-pull { 175:.chain:active .chain-pull { 180:.slip { 191:.slip-head { 200:.slip label { 207:.slip input, 208:.slip select { 220:.slip select option { 225:.count { 232:.envelopes { 240:.envelope { 245:.envelope > summary { 259:.envelope > summary::-webkit-details-marker { 263:.label { 272:.headline { 281:.raw-headline { 289:.where { 294:.stamp { 311:.envelope[open] .stamp { 322:@media (prefers-reduced-motion: reduce) { 329:.case { 335:.case-grid { 342:.clipping { 346:.clipping img { 361:.note { 366:.deck { 373:.deck span { 377:.deck-top { 383:.deck-line { 389:.ocr { 402:.index-card { 410:.index-card .row { 417:.index-card dt