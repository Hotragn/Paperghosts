{"parentUuid":"8749d739-9391-4b3d-9058-f143f635acab","isSidechain":false,"promptId":"775e54ef-6487-4f79-8598-643421b87718","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Rj3GKx9HUwxjBJqkBe1vh","type":"tool_result","content":"File created successfully at: /Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_gold_measures.py (file state is current in your context — no need to Read it back)"}]},"uuid":"3e6ed68e-273f-4d6c-a201-52974887182d","timestamp":"2026-10-31T08:43:52.012Z","toolUseResult":{"type":"create","filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/tests/test_gold_measures.py","content":"\"\"\"What the frozen gold labels measure: reports per stratum against the draw's expectation, the\nweighted report rate, the story-place rule against the labelled place_state, and E9 from the\ngrouping.\"\"\"\n\nimport pytest\nfrom gold_measures import by_stratum, e9, final, paper_state, story_state, weighted\n\n\ndef place(quote, value=None):\n    return {\"value\": value or quote, \"quote\": quote}\n\n\ndef test_the_story_place_rule_reads_the_state_from_the_text_or_the_dateline():\n    text = \"A Dead Mans Ghost. CUMBERLAxD, Nd, May Am interest ing ghost story comes from the town of Sharpsburg, Md. About ten days ago\"\n    assert story_state(text, place(\"Sharpsburg, Md\")) == \"Maryland\"\n    assert story_state(text, place(\"the town of Sharpsburg\")) == \"Maryland\"\n\n    dated = \"A HAUNTED FARMHOUSE MILFORD, Conn., June 3.-The family of Mr. John Hale\"\n    assert story_state(dated, place(\"the old farmhouse\")) == \"Connecticut\"\n    assert story_state(\"PHILADELPHIA, Pa, Dec. 22.-That Rev. Dr.\", place(\"St. John's\")) == \"Pennsylvania\"\n    assert story_state(\"Albia, Ia., Sept. 19.-Bailey Black\", place(\"the jail\")) == \"Iowa\"\n\n    # no state in the text: the paper's state is never taken\n    assert story_state(\"NEW YORK, Nov. 30.-The story of the\", place(\"Brooklyn\")) is None\n    assert story_state(\"Saw Ghosts. correspondent writing from Hilo\", place(\"writing from Hilo\")) is None\n    assert story_state(\"la pri- son de Washington. Tellc est\", place(\"la pri- son de Washington\")) is None\n    assert story_state(\"Buffalo, New York, Jan. 3\", place(\"Buffalo, New York\")) == \"New York\"\n\n\ndef test_the_paper_state_is_the_printed_one_or_a_cached_records(tmp_path):\n    assert paper_state({\"paper\": \"Burlington free press. [volume] (Burlington, Vt.) 1827-1865\"}, tmp_path) == \"Vermont\"\n    assert paper_state({\"paper\": \"The herald.\", \"article_id\": \"79_1897-04-18_p2_sn85042461_0028.json\"}, tmp_path) is None\n    (tmp_path / \"sn85042461.json\").write_text(\n        '{\"status\": 200, \"body\": {\"item\": {\"location_str\": \"Los Angeles, California\", \"location_state\": [\"california\"]}}}'\n    )\n    assert paper_state({\"paper\": \"The herald.\", \"article_id\": \"79_1897-04-18_p2_sn85042461_0028.json\"}, tmp_path) == \"California\"\n\n\ndef test_the_final_label_is_the_ruling_where_there_is_one():\n    records = [\n        {\"article_id\": \"a\", \"labeller\": \"Claude\", \"kind\": \"idiom\"},\n        {\"article_id\": \"a\", \"labeller\": \"second pass\", \"kind\": \"other\"},\n        {\"article_id\": \"a\", \"labeller\": \"ruling\", \"kind\": \"other\"},\n        {\"article_id\": \"b\", \"labeller\": \"Claude\", \"kind\": \"report\"},\n        {\"article_id\": \"b\", \"labeller\": \"second pass\", \"kind\": \"report\"},\n    ]\n    assert {aid: r[\"kind\"] for aid, r in final(records).items()} == {\"a\": \"other\", \"b\": \"report\"}\n\n\ndef test_reports_are_counted_by_stratum_beside_the_expectation_and_weighted():\n    items = [\n        {\"article_id\": \"a\", \"stratum\": \"s1\", \"weight\": 10.0},\n        {\"article_id\": \"b\", \"stratum\": \"s1\", \"weight\": 10.0},\n        {\"article_id\": \"c\", \"stratum\": \"s2\", \"weight\": 1000.0},\n    ]\n    kinds = {\"a\": \"report\", \"b\": \"fiction\", \"c\": \"idiom\"}\n    expected = {\"strata\": {\"s1\": {\"reports\": [0.8, 0.2, 1.5]}, \"s2\": {\"reports\": None}}, \"total\": [1.0, 0.3, 2.0]}\n\n    rows = by_stratum(items, kinds, expected)\n    assert rows[\"strata\"][\"s1\"] == {\"gold\": 2, \"reports\": 1, \"expected\": [0.8, 0.2, 1.5]}\n    assert rows[\"strata\"][\"s2\"] == {\"gold\": 1, \"reports\": 0, \"expected\": None}\n    assert rows[\"total\"] == {\"gold\": 3, \"reports\": 1, \"expected\": [1.0, 0.3, 2.0]}\n\n    rate = weighted(items, kinds)\n    assert rate[\"rate\"] == pytest.approx(10 / 1020)\n    low, high = rate[\"interval\"]\n    assert 0 <= low <= rate[\"rate\"] <= high\n\n\ndef test_e9_is_an_article_whose_group_has_another_member():\n    frame = {\"ids\": [\"a\", \"b\", \"c\", \"d\"], \"group\": [\"a\", \"a\", \"c\", \"d\"]}\n    assert e9(frame, [\"a\", \"b\", \"c\"]) == {\"a\", \"b\"}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"8749d739-9391-4b3d-9058-f143f635acab","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"phase-2c-reader","slug":"sunny-popping-comet"}
