ranch":"main","slug":"sunny-popping-comet"}
{"parentUuid":"e626b4f0-a899-48fc-be32-dfeefb8595cb","isSidechain":false,"promptId":"1cd403ea-e7e5-47ea-921d-b458c11322bb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q3WKptSPDUGpxbe5NxKfrP","type":"tool_result","content":"1\timport { useEffect, useMemo, useRef, useState } from 'react'\n2\timport type { ReactNode } from 'react'\n3\timport Method from './Method.tsx'\n4\t\n5\ttype Field = {\n6\t  value: string\n7\t  quote: string\n8\t  verified: boolean\n9\t  in_text: [number, number] | null\n10\t  in_headline: [number, number] | null\n11\t}\n12\t\n13\ttype Report = {\n14\t  article_id: string\n15\t  paper: string\n16\t  date: string\n17\t  headline: string\n18\t  text: string\n19\t  place: Field | null\n20\t  place_state: Field | null\n21\t  seen: Field | null\n22\t  outcome: Field | null\n23\t  specific_place: Field | null\n24\t  place_type: Field | null\n25\t  precision: Field | null\n26\t  people: Field[]\n27\t  printed_in: { lccn: string; place: string | null; state: string | null; from: string }\n28\t  headline_legible: number\n29\t  text_legible: number\n30\t  like?: { article_id: string; score: number }[]\n31\t  clippings: { src: string; loc: string | null }[]\n32\t  issue_page: string | null\n33\t}\n34\t\n35\t// the index card's rows, in the order a reader asks for them\n36\tconst ROWS: [keyof Report, string][] = [\n37\t  ['place', 'Place'],\n38\t  ['place_state', 'State'],\n39\t  ['seen', 'What was seen'],\n40\t  ['outcome', 'Outcome'],\n41\t  ['specific_place', 'Building or spot'],\n42\t  ['place_type', 'Kind of place'],\n43\t  ['precision', 'Precision'],\n44\t]\n45\tconst OUTCOMES = ['unknown', 'unexplained', 'explained', 'hoax']\n46\tconst STAMPS: Record<string, string> = {\n47\t  unknown: 'Outcome unknown',\n48\t  unexplained: 'Unexplained',\n49\t  explained: 'Explained',\n50\t  hoax: 'Hoax',\n51\t}\n52\t\n53\tconst year = (r: Report) => r.date.slice(0, 4)\n54\tconst decade = (r: Report) => `${r.date.slice(0, 3)}0s`\n55\tconst printedIn = (r: Report) => [r.printed_in.place, r.printed_in.state].filter(Boolean).join(', ')\n56\t// a headline the OCR garbled gets a plain title; its raw text still shows beneath\n57\tconst garbled = (r: Report) => r.headline_legible < 0.5\n58\tconst span = (rs: Report[]) => {\n59\t  const years = rs.map(year).sort()\n60\t  return `${years[0]}–${years[years.length - 1]}`\n61\t}\n62\tconst paperName = (paper: string) => paper.replace(/\\s*\\[volume\\]/i, '').replace(/\\s+\\d{4}-(\\d{4})?$/, '')\n63\t\n64\tfunction fieldsOf(r: Report): [string, Field][] {\n65\t  const named = ROWS.flatMap(([key, label]) => {\n66\t    const f = r[key] as Field | null\n67\t    return f ? [[label, f] as [string, Field]] : []\n68\t  })\n69\t  return [...named, ...r.people.map((p): [string, Field] => ['Person', p])]\n70\t}\n71\t\n72\t// the text with each quoted span marked; spans that share a range share one mark\n73\tfunction marked(text: string, fields: [string, Field][], key: 'in_text' | 'in_headline'): ReactNode[] {\n74\t  const spans: { start: number; end: number; labels: string[] }[] = []\n75\t  for (const [label, f] of fields) {\n76\t    const at = f[key]\n77\t    if (!at) continue\n78\t    const same = spans.find((s) => s.start === at[0] && s.end === at[1])\n79\t    if (same) {\n80\t      if (!same.labels.includes(label)) same.labels.push(label)\n81\t    } else spans.push({ start: at[0], end: at[1], labels: [label] })\n82\t  }\n83\t  spans.sort((a, b) => a.start - b.start)\n84\t  const out: ReactNode[] = []\n85\t  let at = 0\n86\t  for (const s of spans) {\n87\t    if (s.start < at) continue\n88\t    if (s.start > at) out.push(text.slice(at, s.start))\n89\t    const labels = s.labels.join(', ').toLowerCase()\n90\t    out.push(\n91\t      <mark key={s.start} title={labels}>\n92\t        {text.slice(s.start, s.end)}\n93\t        <span className=\"sr-only\"> ({labels})</span>\n94\t      </mark>,\n95\t    )\n96\t    at = s.end\n97\t  }\n98\t  out.push(text.slice(at))\n99\t  return out\n100\t}\n101\t\n102\tfunction Stamp({ outcome }: { outcome: Field | null }) {\n103\t  const value = outcome?.value ?? 'unknown'\n104\t  return <span className={`stamp stamp-${value}`}>{STAMPS[value] ?? value}</span>\n105\t}\n106\t\n107\tfunction Value({ field }: { field: Field | null }) {\n108\t  if (!field) return <span className=\"not-stated\">Not stated</span>\n109\t  return (\n110\t    <>\n111\t      <span className=\"value\">{field.value.replaceAll('_', ' ')}</span>\n112\t      <q className=\"quote\">{field.quote}</q>\n113\t      <span className={field.verified ? 'check' : 'check unverified'}>\n114\t        {field.verified ? 'Quote verified in the scan’s text' : 'Quote not found in the text'}\n115\t      </span>\n116\t    </>\n117\t  )\n118\t}\n119\t\n120\tfunction Case({ r, byId, opened }: { r: Report; byId: Map<string, Report>; opened: boolean }) {\n121\t  const fields = fieldsOf(r)\n122\t  const lines = r.headline.split(/\\n+/).map((l) => l.trim()).filter(Boolean)\n123\t  return (\n124\t    <div className=\"case\">\n125\t      <div className=\"case-grid\">\n126\t        <figure className=\"clipping\">\n127\t          {r.clippings.map((c, i) => (\n128\t            <img\n129\t              key={c.src}\n130\t              src={c.src}\n131\t              loading={opened ? 'eager' : 'lazy'}\n132\t              alt={`The scanned clipping${r.clippings.length > 1 ? `, part ${i + 1} of ${r.clippings.length}` : ''}. Its transcription is beside it.`}\n133\t            />\n134\t          ))}\n135\t          <figcaption>Scanned by the Library of Congress, Chronicling America</figcaption>\n136\t        </figure>\n137\t        <div className=\"transcription\">\n138\t          <h2 className=\"deck\">\n139\t            {lines.map((line, i) => (\n140\t              <span key={i} className={i === 0 ? 'deck-top' : 'deck-line'}>\n141\t                {line}\n142\t              </span>\n143\t            ))}\n144\t          </h2>\n145\t          <p className=\"ocr\">{marked(r.text, fields, 'in_text')}</p>\n146\t          <p className=\"note\">The text is the scan’s OCR as printed, errors and all. Marked words are the quotes the label rests on.</p>\n147\t        </div>\n148\t      </div>\n149\t      <dl className=\"index-card\">\n150\t        {ROWS.map(([key, label]) => (\n151\t          <div key={key} className=\"row\">\n152\t            <dt>{label}</dt>\n153\t            <dd>\n154\t              <Value field={r[key] as Field | null} />\n155\t            </dd>\n156\t          </div>\n157\t        ))}\n158\t        <div className=\"row\">\n159\t          <dt>Printed in</dt>\n160\t          <dd>\n161\t            <span className=\"value\">{printedIn(r) || 'Not recorded'}</span>\n162\t            <span className=\"check\">The paper’s place, from its {r.printed_in.from} (LCCN {r.printed_in.lccn}), not the story’s</span>\n163\t          </dd>\n164\t        </div>\n165\t        <div className=\"row\">\n166\t          <dt>People</dt>\n167\t          <dd>\n168\t            {r.people.length === 0 ? (\n169\t              <span className=\"not-stated\">Not stated</span>\n170\t            ) : (\n171\t              <ul>\n172\t                {r.people.map((p, i) => (\n173\t                  <li key={i}>\n174\t                    <Value field={p} />\n175\t                  </li>\n176\t                ))}\n177\t              </ul>\n178\t            )}\n179\t          </dd>\n180\t        </div>\n181\t      </dl>\n182\t      <p className=\"sources\">\n183\t        {r.issue_page && (\n184\t          <a href={r.issue_page} rel=\"noreferrer\">\n185\t            The issue at the Library of Congress\n186\t          </a>\n187\t        )}\n188\t        {r.clippings\n189\t          .filter((c) => c.loc)\n190\t          .map((c, i) => (\n191\t            <a key={c.src} href={c.loc ?? undefined} rel=\"noreferrer\">\n192\t              Clipping {r.clippings.length > 1 ? i + 1 : ''} at full size\n193\t            </a>\n194\t          ))}\n195\t        <span className=\"filing\">Filed as {r.article_id.replace(/\\.json$/, '')}</span>\n196\t      </p>\n197\t      {r.like && r.like.length > 0 && (\n198\t        <nav className=\"like\" aria-label=\"Ghosts like this one\">\n199\t          <h3>Ghosts like this one</h3>\n200\t          <ul>\n201\t            {r.like.map((l) => {\n202\t              const o = byId.get(l.article_id)\n203\t              return o ? (\n204\t                <li key={l.article_id}>\n205\t                  <a href={`#/report/${encodeURIComponent(l.article_id)}`}>{titleOf(o)}</a>\n206\t                  <span className=\"label\"> {o.date}</span>\n207\t                </li>\n208\t              ) : null\n209\t            })}\n210\t          </ul>\n211\t          <p className=\"note\">Ranked by Atlas Search’s moreLikeThis on the headline and text.</p>\n212\t        </nav>\n213\t      )}\n214\t      <p className=\"thirty\" aria-label=\"End of the report\">\n215\t        -30-\n216\t      </p>\n217\t    </div>\n218\t  )\n219\t}\n220\t\n221\tfunction titleOf(r: Report) {\n222\t  return garbled(r)\n223\t    ? `${r.place?.value || printedIn(r) || 'A paper'}: a ghost report`\n224\t    : r.headline.split(/\\n+/).map((l) => l.trim())[0]\n225\t}\n226\t\n227\tfunction Envelope({ r, byId, opened }: { r: Report; byId: Map<string, Report>; opened: boolean }) {\n228\t  const state = r.place_state?.value\n229\t  // a place the paper wrote with its state (\"Davenport, Iowa\") doesn't take the state again\n230\t  const where = [r.place?.value, state && !r.place?.value.includes(state) ? state : null].filter(Boolean).join(', ')\n231\t  const first = titleOf(r)\n232\t  const ref = useRef<HTMLDetailsElement>(null)\n233\t  useEffect(() => {\n234\t    // a linked report is shown alone, just under the slip, so it opens without a scroll\n235\t    if (opened && ref.current) ref.current.open = true\n236\t  }, [opened])\n237\t  return (\n238\t    <li>\n239\t      <details className=\"envelope\" ref={ref} id={`report-${r.article_id}`}>\n240\t        <summary>\n241\t          <span className=\"label\">\n242\t            <span className=\"date\">{r.date}</span>\n243\t            <span className=\"paper\">{paperName(r.paper)}</span>\n244\t            <span className=\"printed\">Printed in {printedIn(r) || `LCCN ${r.printed_in.lccn}`}</span>\n245\t          </span>\n246\t          <span className=\"headline\">{first}</span>\n247\t          {garbled(r) && r.headline && <span className=\"raw-headline\">Headline as scanned: {r.headline.slice(0, 80)}</span>}\n248\t          <span className=\"where\">{where ? `Story place: ${where}` : 'Story place not stated'}</span>\n249\t          <Stamp outcome={r.outcome} />\n250\t        </summary>\n251\t        <Case r={r} byId={byId} opened={opened} />\n252\t      </details>\n253\t    </li>\n254\t  )\n255\t}\n256\t\n257\t// one clipping for each outcome: the most legible report whose sight and outcome both have verified\n258\t// quotes, captioned with those quotes and nothing else\n259\tfunction Samples({ reports }: { reports: Report[] }) {\n260\t  const picked = OUTCOMES.flatMap((o) => {\n261\t    const best = reports\n262\t      .filter((r) => r.outcome?.value === o && r.seen?.verified && r.outcome?.verified && r.clippings.length)\n263\t      .sort((a, b) => b.text_legible - a.text_legible)[0]\n264\t    return best ? [best] : []\n265\t  })\n266\t  return (\n267\t    <article className=\"samples\">\n268\t      <h2 className=\"page-title\">Paper samples</h2>\n269\t      <p className=\"lede\">One clipping for each way a report can end, chosen as the clearest scan of its kind. Each caption is the paper’s own words.</p>\n270\t      {picked.map((r) => (\n271\t        <figure key={r.article_id} className=\"sample\">\n272\t          {r.clippings.slice(0, 3).map((c, i) => (\n273\t            <img key={c.src} src={c.src} alt={i === 0 ? `The scanned clipping. ${r.seen?.quote ?? ''}` : ''} loading=\"lazy\" />\n274\t          ))}\n275\t          <figcaption>\n276\t            <Stamp outcome={r.outcome} />\n277\t            <q className=\"quote\">{r.seen?.quote}</q>\n278\t            <q className=\"quote\">{r.outcome?.quote}</q>\n279\t            <span className=\"label\">\n280\t              {r.date} · {paperName(r.paper)}\n281\t            </span>\n282\t            <a href={`#/report/${encodeURIComponent(r.article_id)}`}>Read the report</a>\n283\t          </figcaption>\n284\t        </figure>\n285\t      ))}\n286\t      <p className=\"thirty\">-30-</p>\n287\t    </article>\n288\t  )\n289\t}\n290\t\n291\tfunction useLights(): ['on' | 'off', () => void] {\n292\t  const [lights, setLights] = useState<'on' | 'off'>(() => {\n293\t    try {\n294\t      const kept = localStorage.getItem('lights')\n295\t      if (kept === 'on' || kept === 'off') return kept\n296\t    } catch {\n297\t      // storage can be blocked; the device's setting decides then\n298\t    }\n299\t    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'off' : 'on'\n300\t  })\n301\t  useEffect(() => {\n302\t    document.documentElement.dataset.lights = lights\n303\t    try {\n304\t      localStorage.setItem('lights', lights)\n305\t    } catch {\n306\t      // nothing to keep\n307\t    }\n308\t  }, [lights])\n309\t  return [lights, () => setLights((l) => (l === 'on' ? 'off' : 'on'))]\n310\t}\n311\t\n312\t// the reading lamp follows the pointer and keyboard focus; with reduced motion it stays put\n313\tfunction useLamp() {\n314\t  useEffect(() => {\n315\t    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return\n316\t    const root = document.documentElement\n317\t    let frame = 0\n318\t    const move = (x: number, y: number) => {\n319\t      cancelAnimationFrame(frame)\n320\t      frame = requestAnimationFrame(() => {\n321\t        root.style.setProperty('--lamp-x', `${x}px`)\n322\t        root.style.setProperty('--lamp-y', `${y}px`)\n323\t      })\n324\t    }\n325\t    const onPointer = (e: PointerEvent) => move(e.clientX, e.clientY)\n326\t    const onFocus = (e: FocusEvent) => {\n327\t      const box = (e.target as Element).getBoundingClientRect?.()\n328\t      if (box) move(box.left + box.width / 2, box.top + box.height / 2)\n329\t    }\n330\t    window.addEventListener('pointermove', onPointer, { passive: true })\n331\t    window.addEventListener('focusin', onFocus)\n332\t    return () => {\n333\t      window.removeEventListener('pointermove', onPointer)\n334\t      window.removeEventListener('focusin', onFocus)\n335\t    }\n336\t  }, [])\n337\t}\n338\t\n339\tfunction App() {\n340\t  const [reports, setReports] = useState<Report[]>()\n341\t  const [error, setError] = useState<string>()\n342\t  const [query, setQuery] = useState('')\n343\t  const [era, setEra] = useState('')\n344\t  const [outcome, setOutcome] = useState('')\n345\t  const [printed, setPrinted] = useState('')\n346\t  const [lights, toggle] = useLights()\n347\t  const [hash, setHash] = useState(() => window.location.hash)\n348\t  useEffect(() => {\n349\t    const onHash = () => setHash(window.location.hash)\n350\t    window.addEventListener('hashchange', onHash)\n351\t    return () => window.removeEventListener('hashchange', onHash)\n352\t  }, [])\n353\t  const page = hash.startsWith('#/how') ? 'how' : hash.startsWith('#/samples') ? 'samples' : 'drawer'\n354\t  const openId = hash.startsWith('#/report/') ? decodeURIComponent(hash.slice(9)) : ''\n355\t  const byId = useMemo(() => new Map((reports ?? []).map((r) => [r.article_id, r])), [reports])\n356\t  useLamp()\n357\t\n358\t  useEffect(() => {\n359\t    fetch('reports.json')\n360\t      .then((response) => (response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`))))\n361\t      .then(setReports, (failure: Error) => setError(failure.message))\n362\t  }, [])\n363\t\n364\t  const printedStates = useMemo(\n365\t    () => [...new Set((reports ?? []).map((r) => r.printed_in.state).filter((s): s is string => !!s))].sort(),\n366\t    [reports],\n367\t  )\n368\t  const decades = useMemo(() => [...new Set((reports ?? []).map(decade))].sort(), [reports])\n369\t  const shown = useMemo(() => {\n370\t    const words = query.toLowerCase().split(/\\s+/).filter(Boolean)\n371\t    return (reports ?? []).filter((r) => {\n372\t      if (openId) return r.article_id === openId\n373\t      if (era && decade(r) !== era) return false\n374\t      if (outcome && (r.outcome?.value ?? 'unknown') !== outcome) return false\n375\t      if (printed && r.printed_in.state !== printed) return false\n376\t      const hay = [r.place?.value, r.place_state?.value, r.specific_place?.value, printedIn(r), r.headline, r.text, r.paper]\n377\t        .join(' ')\n378\t        .toLowerCase()\n379\t      return words.every((w) => hay.includes(w))\n380\t    })\n381\t  }, [reports, query, era, outcome, printed, openId])\n382\t\n383\t  return (\n384\t    <>\n385\t      <a className=\"skip\" href=\"#main\">\n386\t        Skip to the content\n387\t      </a>\n388\t      <header className=\"masthead\">\n389\t        <button type=\"button\" className=\"chain\" onClick={toggle} aria-pressed={lights === 'on'}>\n390\t          <span className=\"chain-pull\" aria-hidden=\"true\" />\n391\t          {lights === 'on' ? 'Lights off' : 'Lights on'}\n392\t        </button>\n393\t        <p className=\"ear\">\n394\t          {reports ? `${reports.length} reports on file, ${span(reports)}` : 'The morgue'}\n395\t        </p>\n396\t        <img className=\"mark\" src=\"brand/logo.svg\" alt=\"\" width=\"72\" height=\"72\" />\n397\t        <h1 className=\"nameplate\">Paper Ghosts</h1>\n398\t        <nav className=\"rooms\" aria-label=\"The Morgue’s rooms\">\n399\t          <a href=\"#/\" aria-current={page === 'drawer' ? 'page' : undefined}>The drawer</a>\n400\t          <a href=\"#/samples\" aria-current={page === 'samples' ? 'page' : undefined}>Paper samples</a>\n401\t          <a href=\"#/how\" aria-current={page === 'how' ? 'page' : undefined}>How we know</a>\n402\t        </nav>\n403\t        <p className=\"tagline\">A morgue of ghost reports from American newspapers, each one filed with the words it rests on.</p>\n404\t      </header>\n405\t\n406\t      <main id=\"main\">\n407\t        {page === 'how' && <Method />}\n408\t        {page === 'samples' && reports && <Samples reports={reports} />}\n409\t        {page === 'drawer' && (<>\n410\t        <form className=\"slip\" role=\"search\" onSubmit={(e) => e.preventDefault()}>\n411\t          <p className=\"slip-head\">Request slip</p>\n412\t          <label>\n413\t            Town, state or word\n414\t            <input type=\"search\" value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Georgetown, Ohio, knocking…\" />\n415\t          </label>\n416\t          <label>\n417\t            Decade\n418\t            <select value={era} onChange={(e) => setEra(e.target.value)}>\n419\t              <option value=\"\">Any</option>\n420\t              {decades.map((d) => (\n421\t                <option key={d}>{d}</option>\n422\t              ))}\n423\t            </select>\n424\t          </label>\n425\t          <label>\n426\t            Outcome\n427\t            <select value={outcome} onChange={(e) => setOutcome(e.target.value)}>\n428\t              <option value=\"\">Any</option>\n429\t              {OUTCOMES.map((o) => (\n430\t                <option key={o} value={o}>\n431\t                  {STAMPS[o]}\n432\t                </option>\n433\t              ))}\n434\t            </select>\n435\t          </label>\n436\t          <label>\n437\t            Printed in\n438\t            <select value={printed} onChange={(e) => setPrinted(e.target.value)}>\n439\t              <option value=\"\">Any state</option>\n440\t              {printedStates.map((st) => (\n441\t                <option key={st}>{st}</option>\n442\t              ))}\n443\t            </select>\n444\t          </label>\n445\t        </form>\n446\t\n447\t        <section id=\"drawer\" aria-live=\"polite\" aria-busy={!reports && !error}>\n448\t          {error && <p className=\"count\">The drawer could not be opened ({error}).</p>}\n449\t          {!reports && !error && <p className=\"count\">Opening the drawer…</p>}\n450\t          {reports && (\n451\t            <p className=\"count\">\n452\t              {openId ? (\n453\t                <a href=\"#/\">Back to all {reports.length} reports</a>\n454\t              ) : shown.length === 0\n455\t                ? 'Nothing filed under that.'\n456\t                : `${shown.length} report${shown.length === 1 ? '' : 's'}, ${span(shown)}. Clearest scans first.`}\n457\t            </p>\n458\t          )}\n459\t          <ol className=\"envelopes\">\n460\t            {shown.map((r) => (\n461\t              <Envelope key={r.article_id} r={r} byId={byId} opened={r.article_id === openId} />\n462\t            ))}\n463\t          </ol>\n464\t        </section>\n465\t        </>)}\n466\t      </main>\n467\t\n468\t      <footer className=\"colophon\">\n469\t        <h2>How this was made</h2>\n470\t        <p>\n471\t          These are the reports among 450 articles drawn from the archive and labelled one at a time under the project’s\n472\t          labelling policy (POLICY.md) by an AI labeller, Claude, working article by article in a labelling page. A blind second pass relabelled every gold\n473\t          article and a seeded fifth of the rest, and fresh judges ruled every disagreement blind. Each value carries the\n474\t          exact words of the scan that state it, and a quote verifier checks that those words are in the text.\n475\t        </p>\n476\t        <p>\n477\t          The automatic reader that will label the rest of the archive is still being trained, on labels from an open-weight model run\n478\t          locally. Nothing on this page was written by it.\n479\t        </p>\n480\t        <p>\n481\t          Text: the AmericanStories dataset’s OCR of Chronicling America. Scans: the Library of Congress, Chronicling\n482\t          America.\n483\t        </p>\n484\t      </footer>\n485\t    </>\n486\t  )\n487\t}\n488\t\n489\texport default App\n490\t"}]},"uuid":"816318fb-e919-400f-b515-99b4200c2102","timestamp":"2026-11-01T06:35:01.117Z","toolUseResult":{"type":"text","file":{"filePath":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/App.tsx","content":"import { useEffect, useMemo, useRef, useState } from 'react'\nimport type { ReactNode } from 'react'\nimport Method from './Method.tsx'\n\ntype Field = {\n  value: string\n  quote: string\n  verified: boolean\n  in_text: [number, number] | null\n  in_headline: [number, number] | null\n}\n\ntype Report = {\n  article_id: string\n  paper: string\n  date: string\n  headline: string\n  text: string\n  place: Field | null\n  place_state: Field | null\n  seen: Field | null\n  outcome: Field | null\n  specific_place: Field | null\n  place_type: Field | null\n  precision: Field | null\n  people: Field[]\n  printed_in: { lccn: string; place: string | null; state: string | null; from: string }\n  headline_legible: number\n  text_legible: number\n  like?: { article_id: string; score: number }[]\n  clippings: { src: string; loc: string | null }[]\n  issue_page: string | null\n}\n\n// the index card's rows, in the order a reader asks for them\nconst ROWS: [keyof Report, string][] = [\n  ['place', 'Place'],\n  ['place_state', 'State'],\n  ['seen', 'What was seen'],\n  ['outcome', 'Outcome'],\n  ['specific_place', 'Building or spot'],\n  ['place_type', 'Kind of place'],\n  ['precision', 'Precision'],\n]\nconst OUTCOMES = ['unknown', 'unexplained', 'explained', 'hoax']\nconst STAMPS: Record<string, string> = {\n  unknown: 'Outcome unknown',\n  unexplained: 'Unexplained',\n  explained: 'Explained',\n  hoax: 'Hoax',\n}\n\nconst year = (r: Report) => r.date.slice(0, 4)\nconst decade = (r: Report) => `${r.date.slice(0, 3)}0s`\nconst printedIn = (r: Report) => [r.printed_in.place, r.printed_in.state].filter(Boolean).join(', ')\n// a headline the OCR garbled gets a plain title; its raw text still shows beneath\nconst garbled = (r: Report) => r.headline_legible < 0.5\nconst span = (rs: Report[]) => {\n  const years = rs.map(year).sort()\n  return `${years[0]}–${years[years.length - 1]}`\n}\nconst paperName = (paper: string) => paper.replace(/\\s*\\[volume\\]/i, '').replace(/\\s+\\d{4}-(\\d{4})?$/, '')\n\nfunction fieldsOf(r: Report): [string, Field][] {\n  const named = ROWS.flatMap(([key, label]) => {\n    const f = r[key] as Field | null\n    return f ? [[label, f] as [string, Field]] : []\n  })\n  return [...named, ...r.people.map((p): [string, Field] => ['Person', p])]\n}\n\n// the text with each quoted span marked; spans that share a range share one mark\nfunction marked(text: string, fields: [string, Field][], key: 'in_text' | 'in_headline'): ReactNode[] {\n  const spans: { start: number; end: number; labels: string[] }[] = []\n  for (const [label, f] of fields) {\n    const at = f[key]\n    if (!at) continue\n    const same = spans.find((s) => s.start === at[0] && s.end === at[1])\n    if (same) {\n      if (!same.labels.includes(label)) same.labels.push(label)\n    } else spans.push({ start: at[0], end: at[1], labels: [label] })\n  }\n  spans.sort((a, b) => a.start - b.start)\n  const out: ReactNode[] = []\n  let at = 0\n  for (const s of spans) {\n    if (s.start < at) continue\n    if (s.start > at) out.push(text.slice(at, s.start))\n    const labels = s.labels.join(', ').toLowerCase()\n    out.push(\n      <mark key={s.start} title={labels}>\n        {text.slice(s.start, s.end)}\n        <span className=\"sr-only\"> ({labels})</span>\n      </mark>,\n    )\n    at = s.end\n  }\n  out.push(text.slice(at))\n  return out\n}\n\nfunction Stamp({ outcome }: { outcome: Field | null }) {\n  const value = outcome?.value ?? 'unknown'\n  return <span className={`stamp stamp-${value}`}>{STAMPS[value] ?? value}</span>\n}\n\nfunction Value({ field }: { field: Field | null }) {\n  if (!field) return <span className=\"not-stated\">Not stated</span>\n  return (\n    <>\n      <span className=\"value\">{field.value.replaceAll('_', ' ')}</span>\n      <q className=\"quote\">{field.quote}</q>\n      <span className={field.verified ? 'check' : 'check unverified'}>\n        {field.verified ? 'Quote verified in the scan’s text' : 'Quote not found in the text'}\n      </span>\n    </>\n  )\n}\n\nfunction Case({ r, byId, opened }: { r: Report; byId: Map<string, Report>; opened: boolean }) {\n  const fields = fieldsOf(r)\n  const lines = r.headline.split(/\\n+/).map((l) => l.trim()).filter(Boolean)\n  return (\n    <div className=\"case\">\n      <div className=\"case-grid\">\n        <figure className=\"clipping\">\n          {r.clippings.map((c, i) => (\n            <img\n              key={c.src}\n              src={c.src}\n              loading={opened ? 'eager' : 'lazy'}\n              alt={`The scanned clipping${r.clippings.length > 1 ? `, part ${i + 1} of ${r.clippings.length}` : ''}. Its transcription is beside it.`}\n            />\n          ))}\n          <figcaption>Scanned by the Library of Congress, Chronicling America</figcaption>\n        </figure>\n        <div className=\"transcription\">\n          <h2 className=\"deck\">\n            {lines.map((line, i) => (\n              <span key={i} className={i === 0 ? 'deck-top' : 'deck-line'}>\n                {line}\n              </span>\n            ))}\n          </h2>\n          <p className=\"ocr\">{marked(r.text, fields, 'in_text')}</p>\n          <p className=\"note\">The text is the scan’s OCR as printed, errors and all. Marked words are the quotes the label rests on.</p>\n        </div>\n      </div>\n      <dl className=\"index-card\">\n        {ROWS.map(([key, label]) => (\n          <div key={key} className=\"row\">\n            <dt>{label}</dt>\n            <dd>\n              <Value field={r[key] as Field | null} />\n            </dd>\n          </div>\n        ))}\n        <div className=\"row\">\n          <dt>Printed in</dt>\n          <dd>\n            <span className=\"value\">{printedIn(r) || 'Not recorded'}</span>\n            <span className=\"check\">The paper’s place, from its {r.printed_in.from} (LCCN {r.printed_in.lccn}), not the story’s</span>\n          </dd>\n        </div>\n        <div className=\"row\">\n          <dt>People</dt>\n          <dd>\n            {r.people.length === 0 ? (\n              <span className=\"not-stated\">Not stated</span>\n            ) : (\n              <ul>\n                {r.people.map((p, i) => (\n                  <li key={i}>\n                    <Value field={p} />\n                  </li>\n                ))}\n              </ul>\n            )}\n          </dd>\n        </div>\n      </dl>\n      <p className=\"sources\">\n        {r.issue_page && (\n          <a href={r.issue_page} rel=\"noreferrer\">\n            The issue at the Library of Congress\n          </a>\n        )}\n        {r.clippings\n          .filter((c) => c.loc)\n          .map((c, i) => (\n            <a key={c.src} href={c.loc ?? undefined} rel=\"noreferrer\">\n              Clipping {r.clippings.length > 1 ? i + 1 : ''} at full size\n            </a>\n          ))}\n        <span className=\"filing\">Filed as {r.article_id.replace(/\\.json$/, '')}</span>\n      </p>\n      {r.like && r.like.length > 0 && (\n        <nav className=\"like\" aria-label=\"Ghosts like this one\">\n          <h3>Ghosts like this one</h3>\n          <ul>\n            {r.like.map((l) => {\n              const o = byId.get(l.article_id)\n              return o ? (\n                <li key={l.article_id}>\n                  <a href={`#/report/${encodeURIComponent(l.article_id)}`}>{titleOf(o)}</a>\n                  <span className=\"label\"> {o.date}</span>\n                </li>\n              ) : null\n            })}\n          </ul>\n          <p className=\"note\">Ranked by Atlas Search’s moreLikeThis on the headline and text.</p>\n        </nav>\n      )}\n      <p className=\"thirty\" aria-label=\"End of the report\">\n        -30-\n      </p>\n    </div>\n  )\n}\n\nfunction titleOf(r: Report) {\n  return garbled(r)\n    ? `${r.place?.value || printedIn(r) || 'A paper'}: a ghost report`\n    : r.headline.split(/\\n+/).map((l) => l.trim())[0]\n}\n\nfunction Envelope({ r, byId, opened }: { r: Report; byId: Map<string, Report>; opened: boolean }) {\n  const state = r.place_state?.value\n  // a place the paper wrote with its state (\"Davenport, Iowa\") doesn't take the state again\n  const where = [r.place?.value, state && !r.place?.value.includes(state) ? state : null].filter(Boolean).join(', ')\n  const first = titleOf(r)\n  const ref = useRef<HTMLDetailsElement>(null)\n  useEffect(() => {\n    // a linked report is shown alone, just under the slip, so it opens without a scroll\n    if (opened && ref.current) ref.current.open = true\n  }, [opened])\n  return (\n    <li>\n      <details className=\"envelope\" ref={ref} id={`report-${r.article_id}`}>\n        <summary>\n          <span className=\"label\">\n            <span className=\"date\">{r.date}</span>\n            <span className=\"paper\">{paperName(r.paper)}</span>\n            <span className=\"printed\">Printed in {printedIn(r) || `LCCN ${r.printed_in.lccn}`}</span>\n          </span>\n          <span className=\"headline\">{first}</span>\n          {garbled(r) && r.headline && <span className=\"raw-headline\">Headline as scanned: {r.headline.slice(0, 80)}</span>}\n          <span className=\"where\">{where ? `Story place: ${where}` : 'Story place not stated'}</span>\n          <Stamp outcome={r.outcome} />\n        </summary>\n        <Case r={r} byId={byId} opened={opened} />\n      </details>\n    </li>\n  )\n}\n\n// one clipping for each outcome: the most legible report whose sight and outcome both have verified\n// quotes, captioned with those quotes and nothing else\nfunction Samples({ reports }: { reports: Report[] }) {\n  const picked = OUTCOMES.flatMap((o) => {\n    const best = reports\n      .filter((r) => r.outcome?.value === o && r.seen?.verified && r.outcome?.verified && r.clippings.length)\n      .sort((a, b) => b.text_legible - a.text_legible)[0]\n    return best ? [best] : []\n  })\n  return (\n    <article className=\"samples\">\n      <h2 className=\"page-title\">Paper samples</h2>\n      <p className=\"lede\">One clipping for each way a report can end, chosen as the clearest scan of its kind. Each caption is the paper’s own words.</p>\n      {picked.map((r) => (\n        <figure key={r.article_id} className=\"sample\">\n          {r.clippings.slice(0, 3).map((c, i) => (\n            <img key={c.src} src={c.src} alt={i === 0 ? `The scanned clipping. ${r.seen?.quote ?? ''}` : ''} loading=\"lazy\" />\n          ))}\n          <figcaption>\n            <Stamp outcome={r.outcome} />\n            <q className=\"quote\">{r.seen?.quote}</q>\n            <q className=\"quote\">{r.outcome?.quote}</q>\n            <span className=\"label\">\n              {r.date} · {paperName(r.paper)}\n            </span>\n            <a href={`#/report/${encodeURIComponent(r.article_id)}`}>Read the report</a>\n          </figcaption>\n        </figure>\n      ))}\n      <p className=\"thirty\">-30-</p>\n    </article>\n  )\n}\n\nfunction useLights(): ['on' | 'off', () => void] {\n  const [lights, setLights] = useState<'on' | 'off'>(() => {\n    try {\n      const kept = localStorage.getItem('lights')\n      if (kept === 'on' || kept === 'off') return kept\n    } catch {\n      // storage can be blocked; the device's setting decides then\n    }\n    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'off' : 'on'\n  })\n  useEffect(() => {\n    document.documentElement.dataset.lights = lights\n    try {\n      localStorage.setItem('lights', lights)\n    } catch {\n      // nothing to keep\n    }\n  }, [lights])\n  return [lights, () => setLights((l) => (l === 'on' ? 'off' : 'on'))]\n}\n\n// the reading lamp follows the pointer and keyboard focus; with reduced motion it stays put\nfunction useLamp() {\n  useEffect(() => {\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return\n    const root = document.documentElement\n    let frame = 0\n    const move = (x: number, y: number) => {\n      cancelAnimationFrame(frame)\n      frame = requestAnimationFrame(() => {\n        root.style.setProperty('--lamp-x', `${x}px`)\n        root.style.setProperty('--lamp-y', `${y}px`)\n      })\n    }\n    const onPointer = (e: PointerEvent) => move(e.clientX, e.clientY)\n    const onFocus = (e: FocusEvent) => {\n      const box = (e.target as Element).getBoundingClientRect?.()\n      if (box) move(box.left + box.width / 2, box.top + box.height / 2)\n    }\n    window.addEventListener('pointermove', onPointer, { passive: true })\n    window.addEventListener('focusin', onFocus)\n    return () => {\n      window.removeEventListener('pointermove', onPointer)\n      window.removeEventListener('focusin', onFocus)\n    }\n  }, [])\n}\n\nfunction App() {\n  const [reports, setReports] = useState<Report[]>()\n  const [error, setError] = useState<string>()\n  const [query, setQuery] = useState('')\n  const [era, setEra] = useState('')\n  const [outcome, setOutcome] = useState('')\n  const [printed, setPrinted] = useState('')\n  const [lights, toggle] = useLights()\n  const [hash, setHash] = useState(() => window.location.hash)\n  useEffect(() => {\n    const onHash = () => setHash(window.location.hash)\n    window.addEventListener('hashchange', onHash)\n    return () => window.removeEventListener('hashchange', onHash)\n  }, [])\n  const page = hash.startsWith('#/how') ? 'how' : hash.startsWith('#/samples') ? 'samples' : 'drawer'\n  const openId = hash.startsWith('#/report/') ? decodeURIComponent(hash.slice(9)) : ''\n  const byId = useMemo(() => new Map((reports ?? []).map((r) => [r.article_id, r])), [reports])\n  useLamp()\n\n  useEffect(() => {\n    fetch('reports.json')\n      .then((response) => (response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`))))\n      .then(setReports, (failure: Error) => setError(failure.message))\n  }, [])\n\n  const printedStates = useMemo(\n    () => [...new Set((reports ?? []).map((r) => r.printed_in.state).filter((s): s is string => !!s))].sort(),\n    [reports],\n  )\n  const decades = useMemo(() => [...new Set((reports ?? []).map(decade))].sort(), [reports])\n  const shown = useMemo(() => {\n    const words = query.toLowerCase().split(/\\s+/).filter(Boolean)\n    return (reports ?? []).filter((r) => {\n      if (openId) return r.article_id === openId\n      if (era && decade(r) !== era) return false\n      if (outcome && (r.outcome?.value ?? 'unknown') !== outcome) return false\n      if (printed && r.printed_in.state !== printed) return false\n      const hay = [r.place?.value, r.place_state?.value, r.specific_place?.value, printedIn(r), r.headline, r.text, r.paper]\n        .join(' ')\n        .toLowerCase()\n      return words.every((w) => hay.includes(w))\n    })\n  }, [reports, query, era, outcome, printed, openId])\n\n  return (\n    <>\n      <a className=\"skip\" href=\"#main\">\n        Skip to the content\n      </a>\n      <header className=\"masthead\">\n        <button type=\"button\" className=\"chain\" onClick={toggle} aria-pressed={lights === 'on'}>\n          <span className=\"chain-pull\" aria-hidden=\"true\" />\n          {lights === 'on' ? 'Lights off' : 'Lights on'}\n        </button>\n        <p className=\"ear\">\n          {reports ? `${reports.length} reports on file, ${span(reports)}` : 'The morgue'}\n        </p>\n        <img className=\"mark\" src=\"brand/logo.svg\" alt=\"\" width=\"72\" height=\"72\" />\n        <h1 className=\"nameplate\">Paper Ghosts</h1>\n        <nav className=\"rooms\" aria-label=\"The Morgue’s rooms\">\n          <a href=\"#/\" aria-current={page === 'drawer' ? 'page' : undefined}>The drawer</a>\n          <a href=\"#/samples\" aria-current={page === 'samples' ? 'page' : undefined}>Paper samples</a>\n          <a href=\"#/how\" aria-current={page === 'how' ? 'page' : undefined}>How we know</a>\n        </nav>\n        <p className=\"tagline\">A morgue of ghost reports from American newspapers, each one filed with the words it rests on.</p>\n      </header>\n\n      <main id=\"main\">\n        {page === 'how' && <Method />}\n        {page === 'samples' && reports && <Samples reports={reports} />}\n        {page === 'drawer' && (<>\n        <form className=\"slip\" role=\"search\" onSubmit={(e) => e.preventDefault()}>\n          <p className=\"slip-head\">Request slip</p>\n          <label>\n            Town, state or word\n            <input type=\"search\" value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Georgetown, Ohio, knocking…\" />\n          </label>\n          <label>\n            Decade\n            <select value={era} onChange={(e) => setEra(e.target.value)}>\n              <option value=\"\">Any</option>\n              {decades.map((d) => (\n                <option key={d}>{d}</option>\n              ))}\n            </select>\n          </label>\n          <label>\n            Outcome\n            <select value={outcome} onChange={(e) => setOutcome(e.target.value)}>\n              <option value=\"\">Any</option>\n              {OUTCOMES.map((o) => (\n                <option key={o} value={o}>\n                  {STAMPS[o]}\n                </option>\n              ))}\n            </select>\n          </label>\n          <label>\n            Printed in\n            <select value={printed} onChange={(e) => setPrinted(e.target.value)}>\n              <option value=\"\">Any state</option>\n              {printedStates.map((st) => (\n                <option key={st}>{st}</option>\n              ))}\n            </select>\n          </label>\n        </form>\n\n        <section id=\"drawer\" aria-live=\"polite\" aria-busy={!reports && !error}>\n          {error && <p className=\"count\">The drawer could not be opened ({error}).</p>}\n          {!reports && !error && <p className=\"count\">Opening the drawer…</p>}\n          {reports && (\n            <p className=\"count\">\n              {openId ? (\n                <a href=\"#/\">Back to all {reports.length} reports</a>\n              ) : shown.length === 0\n                ? 'Nothing filed under that.'\n                : `${shown.length} report${shown.length === 1 ? '' : 's'}, ${span(shown)}. Clearest scans first.`}\n            </p>\n          )}\n          <ol className=\"envelopes\">\n            {shown.map((r) => (\n              <Envelope key={r.article_id} r={r} byId={byId} opened={r.article_id === openId} />\n            ))}\n          </ol>\n        </section>\n        </>)}\n      </main>\n\n      <footer className=\"colophon\">\n        <h2>How this was made</h2>\n        <p>\n          These are the reports among 450 articles drawn from the archive and labelled one at a time under the project’s\n          labelling policy (POLICY.md) by an AI labeller, Claude, working article by article in a labelling page. A blind second pass relabelled every gold\n          article and a seeded fifth of the rest, and fresh judges ruled every disagreement blind. Each value carries the\n          exact words of the scan that state it, and a quote verifier checks that those words are in the text.\n        </p>\n        <p>\n          The automatic reader that will label the rest of the archive is still being trained, on labels from an open-weight model run\n          locally. Nothing on this page was written by it.\n        </p>\n        <p>\n          Text: the AmericanStories dataset’s OCR of Chronicling America. Scans: the Library of Congress, Chronicling\n          America.\n        </p>\n      </footer>\n    </>\n  )\n}\n\nexport default App\n","numLines":490,"startLine":1,"totalLines":490}},"sourceToolAssistantUUID":"e626b4f0-a899-48fc-be32-dfeefb8595cb","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-desktop","cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts","sessionId":"1f5be3b0-ab69-4299-a8b5-d7494c65687b","version":"2.1.309","gitBranch":"main","slug":"sunny-popping-comet"}
