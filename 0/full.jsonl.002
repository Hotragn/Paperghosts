it(/\\\\n+/).map((l) => l.trim())[0]\"\"\", \"\"\"function titleOf(r: Report) {\n  return garbled(r)\n    ? `${r.place?.value || printedIn(r) || 'A paper'}: a ghost report`\n    : r.headline.split(/\\\\n+/).map((l) => l.trim())[0]\n}\n\nfunction Envelope({ r, byId, opened }: { r: Report; byId: Map<string, Report>; opened: boolean }) {\n  const where = [r.place?.value, r.place_state?.value].filter(Boolean).join(', ')\n  const first = titleOf(r)\n  const ref = useRef<HTMLDetailsElement>(null)\n  useEffect(() => {\n    if (opened && ref.current) {\n      ref.current.open = true\n      ref.current.scrollIntoView({ block: 'start' })\n    }\n  }, [opened])\"\"\")\nrep(\"\"\"      <details className=\"envelope\">\"\"\", \"\"\"      <details className=\"envelope\" ref={ref} id={`report-${r.article_id}`}>\"\"\")\nrep(\"        <Case r={r} />\", \"        <Case r={r} byId={byId} />\")\nrep(\"import { useEffect, useMemo, useState } from 'react'\", \"import { useEffect, useMemo, useRef, useState } from 'react'\")\n# routing state\nrep(\"  const [lights, toggle] = useLights()\\n\", \"\"\"  const [lights, toggle] = useLights()\n  const [hash, setHash] = useState(() => window.location.hash)\n  useEffect(() => {\n    const onHash = () => setHash(window.location.hash)\n    window.addEventListener('hashchange', onHash)\n    return () => window.removeEventListener('hashchange', onHash)\n  }, [])\n  const page = hash.startsWith('#/how') ? 'how' : hash.startsWith('#/samples') ? 'samples' : 'drawer'\n  const openId = hash.startsWith('#/report/') ? decodeURIComponent(hash.slice(9)) : ''\n  const byId = useMemo(() => new Map((reports ?? []).map((r) => [r.article_id, r])), [reports])\n\"\"\")\n# a deep link shows its report even under filters\nrep(\"    return (reports ?? []).filter((r) => {\\n\", \"    return (reports ?? []).filter((r) => {\\n      if (openId) return true\\n\")\nrep(\"  }, [reports, query, era, outcome, printed])\", \"  }, [reports, query, era, outcome, printed, openId])\")\n# nav after masthead tagline\nrep(\"\"\"        <p className=\"tagline\">\"\"\", \"\"\"        <nav className=\"rooms\" aria-label=\"The Morgue’s rooms\">\n          <a href=\"#/\" aria-current={page === 'drawer' ? 'page' : undefined}>The drawer</a>\n          <a href=\"#/samples\" aria-current={page === 'samples' ? 'page' : undefined}>Paper samples</a>\n          <a href=\"#/how\" aria-current={page === 'how' ? 'page' : undefined}>How we know</a>\n        </nav>\n        <p className=\"tagline\">\"\"\")\n# main: switch pages\nrep(\"\"\"      <main>\n        <form className=\"slip\\\"\"\"\", \"\"\"      <main id=\"main\">\n        {page === 'how' && <Method />}\n        {page === 'samples' && reports && <Samples reports={reports} />}\n        {page === 'drawer' && (<>\n        <form className=\"slip\\\"\"\"\")\nrep(\"\"\"            {shown.map((r) => (\n              <Envelope key={r.article_id} r={r} />\n            ))}\n          </ol>\n        </section>\n      </main>\"\"\", \"\"\"            {shown.map((r) => (\n              <Envelope key={r.article_id} r={r} byId={byId} opened={r.article_id === openId} />\n            ))}\n          </ol>\n        </section>\n        </>)}\n      </main>\"\"\")\nrep('''      <a className=\"skip\" href=\"#drawer\">\n        Skip to the reports\n      </a>''', '''      <a className=\"skip\" href=\"#main\">\n        Skip to the content\n      </a>''')\n# Samples component before useLights\nrep(\"function useLights()\", \"\"\"// one clipping for each outcome: the most legible report whose sight and outcome both have verified\n// quotes, captioned with those quotes and nothing else\nfunction Samples({ reports }: { reports: Report[] }) {\n  const picked = OUTCOMES.flatMap((o) => {\n    const best = reports\n      .filter((r) => r.outcome?.value === o && r.seen?.verified && r.outcome?.verified && r.clippings.length)\n      .sort((a, b) => b.text_legible - a.text_legible)[0]\n    return best ? [best] : []\n  })\n  return (\n    <a