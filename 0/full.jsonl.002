nt = t.replace(\"def main(args: list) -> None:\\n\", \"def main(args: list) -> None:\\n    init_sentry(\\\"pipeline\\\")\\n\", 1)\nt = t.replace('    print(f\"{len(results)} found in {ms:.0f} ms\")\\n', '    print(f\"{len(results)} found in {ms:.0f} ms\")\\n    sentry_sdk.flush()\\n', 1)\nq.write_text(t)\np = Path(\"scripts/load_demo_places.py\"); w = p.read_text()\nw = w.replace(\"from paperghosts.config import setting\\n\", \"from paperghosts.config import setting\\nfrom paperghosts.observability.sentry import atlas_query, init_sentry\\n\", 1)\nold = \"\"\"        started = time.perf_counter()\n        found = list(collection.aggregate(pipeline))\n        ms = (time.perf_counter() - started) * 1000\n\"\"\"\nassert old in w\nw = w.replace(old, \"\"\"        with atlas_query(\"places near\", \"load_demo_places\"):\n            started = time.perf_counter()\n            found = list(collection.aggregate(pipeline))\n            ms = (time.perf_counter() - started) * 1000\n\"\"\")\nw = w.replace(\"def near(town: str, state: str, km: float = 300) -> None:\\n\", \"def near(town: str, state: str, km: float = 300) -> None:\\n    init_sentry(\\\"pipeline\\\")\\n\", 1)\nw = w.replace('    print(f\"{len(found)} towns in {ms:.0f} ms\")\\n', '    print(f\"{len(found)} towns in {ms:.0f} ms\")\\n    sentry_sdk.flush()\\n', 1)\nw = w.replace(\"from pymongo import MongoClient\\n\", \"import sentry_sdk\\nfrom pymongo import MongoClient\\n\", 1)\np.write_text(w)\nPY\nuv run ruff check --fix scripts/query_demo_atlas.py scripts/load_demo_places.py paperghosts/observability/sentry.py >/dev/null; uv run ruff format scripts/query_demo_atlas.py scripts/load_demo_places.py paperghosts/observability/sentry.py >/dev/null; uv run ruff check scripts/query_demo_atlas.py scripts/load_demo_places.py paperghosts/observability/sentry.py && uv run pytest -q tests -k \"sentry or export or load_demo\" 2>&1 | tail -1","description":"Trace the scripts' Atlas queries as Sentry transactions"},"caller":{"ty