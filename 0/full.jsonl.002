,"             Town, state or word","-            <input type=\"search\" value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Georgetown, Ohio, knocking…\" />","+            <input ref={search} type=\"search\" value={query} onChange={(e) => setQuery(e.target.value)} placeholder=\"Georgetown, Ohio, knocking…\" />","           </label>","           <label>","             Decade"]},{"oldStart":456,"oldLines":9,"newStart":570,"newLines":27,"lines":["                 : `${shown.length} report${shown.length === 1 ? '' : 's'}, ${span(shown)}. Clearest scans first.`}","             </p>","           )}","+          {reports && !openId && shown.length === 0 && (","+            <p className=\"empty\">","+              Try{' '}","+              {TRY.map((w, i) => (","+                <span key={w}>","+                  <button type=\"button\" onClick={() => ask(w)}>","+                    {w}","+                  </button>","+                  {i < TRY.length - 2 ? ', ' : i === TRY.length - 2 ? ' or ' : ''}","+                </span>","+              ))}","+              , or{' '}","+              <button type=\"button\" onClick={() => ask('')}>","+                clear the slip","+              </button>","+              .","+            </p>","+          )}","           <ol className=\"envelopes\">","             {shown.map((r) => (","-              <Envelope key={r.article_id} r={r} byId={byId} opened={r.article_id === openId} />","+              <Envelope key={r.article_id} r={r} byId={byId} opened={r.article_id === openId} hint={hint} />","             ))}","           </ol>","         </section>"]}]}],"moreFiles":0,"changedFiles":["/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src/App.tsx"]}},"serverClassifierContext":{"request":"1c50d5fb-0158-46cc-b2ce-f894214125ec","context":{"git_state":{"cwd":"/Users/hotragn/Documents/Claude Code/HacktoberFest/week4/Paperghosts/web/src","root":"/Users/hotragn/Documents/Claude Code/Hacktobe