ghts\"}},\n68\t    ]\n69\t\n70\t\n71\tdef matched(found: dict) -> str:\n72\t    words = {\n73\t        t[\"value\"]\n74\t        for h in found.get(\"highlights\") or []\n75\t        for t in h[\"texts\"]\n76\t        if t[\"type\"] == \"hit\"\n77\t    }\n78\t    return \", \".join(sorted(words)[:6])\n79\t\n80\t\n81\tdef main(args: list) -> None:\n82\t    with MongoClient(\n83\t        setting(\"MONGODB_URI\").get(), serverSelectionTimeoutMS=10_000\n84\t    ) as client:\n85\t        reports = client[DATABASE][\"reports\"]\n86\t        if args[0] == \"--like\":\n87\t            doc = reports.find_one({\"_id\": f\"r_{args[1]}\"}, {\"headline\": 1, \"text\": 1})\n88\t            if doc is None:\n89\t                sys.exit(f\"{args[1]} is not in the Morgue\")\n90\t            print(\n91\t                f\"ghosts like {doc['headline'].splitlines()[0] if doc['headline'] else args[1]}:\"\n92\t            )\n93\t            pipeline = like(doc)\n94\t        else:\n95\t            print(f\"search: {args[0]!r}, fuzzy up to 2 edits\")\n96\t            pipeline = fuzzy(args[0])\n97\t        started = time.perf_counter()\n98\t        results = list(reports.aggregate(pipeline))\n99\t        ms = (time.perf_counter() - started) * 1000\n100\t    for r in results:\n101\t        title = (r.get(\"display_headline\") or \"\").splitlines()[0][:70]\n102\t        print(f\"  {r['date']}  {title}\\n    {r.get('paper') or ''}\")\n103\t        print(\n104\t            f\"    story place: {r.get('place') or 'not stated'}   score {r['score']:.2f}\"\n105\t        )\n106\t        if r.get(\"highlights\"):\n107\t            print(f\"    matched: {matched(r)}\")\n108\t    print(f\"{len(results)} found in {ms:.0f} ms\")\n109\t\n110\t\n111\tif __name__ == \"__main__\":\n112\t    main(sys.argv[1:])"},"type":"attachment","uuid":"fb889423-7425-4a8f-ae62-6a219aee6bcd","timestamp":"2026-10-31T22:09:48.614Z","rendered":[{"content":"<system-reminder>\nNote: /Users/hotragn/Documents/Claude Code/HacktoberF